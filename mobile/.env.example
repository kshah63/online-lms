# MathVision Global — native app environment. Copy to .env and fill in.
# EXPO_PUBLIC_* vars are inlined into the app at build/start time.

# Same Supabase project as the web app (the anon key is safe on the client —
# Row Level Security enforces access). Find these in Supabase → Project settings
# → API. NEVER put the service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Your deployed web app, e.g. https://online-lms-blush.vercel.app
# Used to (a) open lessons in the browser (lessons stay on iPad/laptop) and
# (b) call the booking API. Without it, viewing still works; booking is disabled.
EXPO_PUBLIC_WEB_URL=
