+  const { data: hands } = await admin
+    .from('department_members')
+    .select('user_id, member:profiles!department_members_user_id_fkey (role, deactivated_at)')
+    .eq('department_id', next.department_id)
+    .eq('is_incharge', true);
+  const recipients = new Set<string>();
+  for (const h of (hands ?? []) as unknown as {
