+// ---------------------------------------------------------------------------
+// An online lesson's report draft is ready → the teacher who taught it.
+// ---------------------------------------------------------------------------
+
+/**
+ * lesson-finalize wrote the draft through worker_store_lesson_results, and
+ * the assigned teacher is the one person who turns it into a report. One
+ * push per lesson: the row is replaced when Daily's stored transcript lands
+ * after the end, and the trigger is on INSERT alone, so a better draft says
+ * nothing twice. A lesson already a day old is stored under app.push_quiet
+ * and never reaches here — backfill, not news.
+ *
+ * The link is the session itself, which is where the teacher's Write tab
+ * shows the draft: a push about one lesson that lands on a list of lessons
+ * has made the reader do the finding twice.
+ */
+async function buildLessonDraftNotification(payload: WebhookPayload): Promise<ExpoMessage[]> {
+  const next = payload.record;
+  if (payload.type !== 'INSERT' || !next?.session_id) return [];
+
+  const { data: session } = await admin
+    .from('session_requests')
+    .select('assigned_teacher_id, student_name, topic, subject')
+    .eq('id', next.session_id)
+    .maybeSingle();
+  if (!session?.assigned_teacher_id) return [];
+
+  const first =
+    ((session.student_name as string | null) ?? '').trim().split(' ')[0] || 'The student';
+  const topic =
+    ((session.topic as string | null) ?? '').trim() ||
+    ((session.subject as string | null) ?? '').trim() ||
+    'the lesson';
+  return buildForRecipients([session.assigned_teacher_id as string], (badge) => ({
+    title: 'Your report draft is ready',
+    body: truncate(`${first} · ${topic}`, 120),
+    badge,
+    data: {
+      kind: 'session',
+      sessionRequestId: next.session_id,
+      url: `https://mathvisionapp.com/sessions/${next.session_id}`,
+    },
+    channelId: 'messages',
+  }));
+}
+
+// ---------------------------------------------------------------------------
+// A follow-up the teacher said yes to → the room's in-charges, who send it.
+// ---------------------------------------------------------------------------
+
+/**
+ * approve_followup keeps every family-facing word a person's: the teacher's
+ * yes only moves the row from proposed to approved, and an in-charge of the
+ * lesson's department (or an admin) sends it as themselves. This is the
+ * buzz between the two. The deciders are sweep_report_nudges' — the
+ * in-charge seat (is_incharge, #706), an office role, an open account. The
+ * teacher who said yes is left out even when they hold such a seat: an
+ * in-charge's own yes is a send, and the row goes to done, not here.
+ *
+ * Every other move of status is quiet. Done was done BY an in-charge, a
+ * dismissal is nobody's work, and a row that arrives already approved was
+ * never proposed to anybody.
+ */
+async function buildFollowupApprovedNotification(payload: WebhookPayload): Promise<ExpoMessage[]> {
+  const next = payload.record;
+  const prev = payload.old_record;
+  if (payload.type !== 'UPDATE' || !next || !prev) return [];
+  if (prev.status !== 'proposed' || next.status !== 'approved') return [];
+  if (!next.department_id) return [];
