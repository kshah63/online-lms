diff --git a/supabase/functions/recordings-cleanup/index.ts b/supabase/functions/recordings-cleanup/index.ts
new file mode 100644
index 0000000..78d439f
--- /dev/null
+++ b/supabase/functions/recordings-cleanup/index.ts
@@ -0,0 +1,112 @@
+// Supabase Edge Function — removes at Daily the recordings the retention
+// sweep marked.
+//
+//   supabase functions deploy recordings-cleanup
+//   (JWT verification ON. Driven by a schedule — mv-recordings-cleanup, every
+//   thirty minutes through invoke_edge_function, which sends the service-role
+//   key as bearer, exactly as storage-cleanup is driven; see DEPLOYMENT.)
+//
+// sweep_lesson_retention stamps lesson_recordings.deleted_at once a recording
+// is older than retention_settings.recording_months, but SQL cannot reach
+// Daily. This is the other half, the same shape as storage-cleanup:
+//
+//   1. Remove the bytes at Daily.
+//   2. Only then stamp the row purged_at.
+//
+// The other order stamps a row whose bytes are still at Daily, invisibly and
+// forever. This order means a crash between the two leaves a row the next run
+// deletes again and finds gone — Daily's 404 counts as purged — which is
+// harmless. A row that fails stays unstamped and is tried next time; a run
+// says in its one log line how many it purged, how many it kept, and whether
+// the batch was full, so a backlog never reads as an all-clear.
+//
+// Secrets:
+//   DAILY_API_KEY   the same key lesson-finalize reads. Without it nothing is
+//                   purged and the function says so, once per isolate.
+
+import { createClient } from 'jsr:@supabase/supabase-js@2';
+
+import { captureError } from '../_shared/report.ts';
+import { BATCH, purgeAtDaily } from './purge.ts';
+
+const SUPABASE_URL = Deno.env.get('SUPABASE_URL')!;
+const SERVICE_ROLE_KEY = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;
+
+/** Well inside the runtime's limit; whatever is left waits for the next run. */
+const BUDGET_MS = 40_000;
+
+/** So the line below is worth reading when it appears. See its comment. */
+let saidTheKeyIsMissing = false;
+
+Deno.serve(async (req) => {
+  if (req.method !== 'POST') return json({ error: 'method not allowed' }, 405);
+
+  // Said once per isolate: the caller is pg_net, which never reads the
+  // response, so this line is the only place the reason exists.
+  const apiKey = (Deno.env.get('DAILY_API_KEY') ?? '').trim();
+  if (!apiKey) {
+    if (!saidTheKeyIsMissing) {
+      saidTheKeyIsMissing = true;
+      console.error('recordings-cleanup has no DAILY_API_KEY set. Nothing is purged.');
+    }
+    return json({ error: 'DAILY_API_KEY is not set' }, 503);
+  }
+
+  const started = Date.now();
+  const admin = createClient(SUPABASE_URL, SERVICE_ROLE_KEY, {
+    auth: { persistSession: false },
+  });
+
+  // Marked, not yet purged, and with something at Daily to purge. A row the
+  // sweep marked that never had a provider id (a recording that failed to
+  // land) has no bytes anywhere and is nobody's job.
+  const { data, error } = await admin
+    .from('lesson_recordings')
+    .select('session_id, provider_recording_id')
+    .not('deleted_at', 'is', null)
+    .is('purged_at', null)
+    .not('provider_recording_id', 'is', null)
+    .order('deleted_at', { ascending: true })
+    .limit(BATCH);
+  if (error) {
+    await captureError(error, 'recordings-cleanup/list');
+    return json({ error: error.message }, 500);
+  }
+
+  const batch = (data ?? []) as { session_id: string; provider_recording_id: string }[];
+  let purged = 0;
+  const problems: string[] = [];
+  for (const row of batch) {
+    if (Date.now() - started > BUDGET_MS) break;
+    const outcome = await purgeAtDaily({ recordingId: row.provider_recording_id, apiKey });
+    if (!outcome.purged) {
+      // Leave the row alone: it stays marked and the next run tries again.
+      problems.push(`${row.session_id}: ${outcome.reason}`);
+      continue;
+    }
+    const { error: stampError } = await admin
+      .from('lesson_recordings')
+      .update({ purged_at: new Date().toISOString() })
+      .eq('session_id', row.session_id);
+    if (stampError) problems.push(`${row.session_id}: ${stampError.message}`);
+    else purged += 1;
+  }
+
+  // Counts only — a session id names a child's lesson, and the log is not
+  // where that belongs. The problems go to the sink, which is where somebody
+  // who can ask Daily why will read them.
+  const more = batch.length === BATCH;
+  console.log(`recordings-cleanup: purged ${purged}, kept ${problems.length}${more ? ', batch full' : ''}`);
+  if (problems.length > 0) {
+    await captureError(new Error(`${problems.length} recording(s) could not be purged`), 'recordings-cleanup', {
+      purged,
+      kept: problems.length,
+      first: problems[0],
+    });
+  }
+  return json({ purged, kept: problems.length, more }, problems.length > 0 ? 207 : 200);
+});
+
+function json(body: unknown, status = 200): Response {
+  return Response.json(body, { status });
+}
diff --git a/supabase/functions/recordings-cleanup/purge.ts b/supabase/functions/recordings-cleanup/purge.ts
new file mode 100644
index 0000000..407c518
--- /dev/null
+++ b/supabase/functions/recordings-cleanup/purge.ts
@@ -0,0 +1,45 @@
+// The one call to Daily that removes a recording's bytes, and how its answer
+// is read.
+//
+// Its own module, with no Deno imports, so the smoke suite can run it against
+// a stubbed fetch rather than a regex over index.ts: the failure on one side
+// is a recording that outlives the retention somebody chose, on the other a
+// row stamped purged while the bytes are still at Daily — and neither is
+// visible from anywhere in the app.
+
+export const DAILY_API = 'https://api.daily.co/v1';
+
+/** How many rows one run takes on; the rest wait for the next half hour. */
+export const BATCH = 50;
+
+export type PurgeOutcome =
+  | { purged: true; status: number }
+  | { purged: false; status: number | null; reason: string };
+
+/**
+ * DELETE the recording at Daily. A 2xx is purged. A 404 is purged too: a
+ * recording Daily no longer has — its own expiry, or a run that deleted and
+ * crashed before stamping — is exactly the state this is for, and the
+ * alternative is retrying it every half hour forever. Anything else leaves
+ * the row for the next run: a 401 is a key to fix, a 5xx is Daily's
+ * afternoon, and a thrown fetch is the network's.
+ */
+export async function purgeAtDaily(args: {
+  recordingId: string;
+  apiKey: string;
+  fetchImpl?: typeof fetch;
+}): Promise<PurgeOutcome> {
+  const fetchImpl = args.fetchImpl ?? fetch;
+  let response: Response;
+  try {
+    response = await fetchImpl(`${DAILY_API}/recordings/${encodeURIComponent(args.recordingId)}`, {
+      method: 'DELETE',
+      headers: { Authorization: `Bearer ${args.apiKey}` },
+      signal: AbortSignal.timeout(15_000),
+    });
+  } catch (error) {
+    return { purged: false, status: null, reason: error instanceof Error ? error.message : String(error) };
+  }
+  if (response.ok || response.status === 404) return { purged: true, status: response.status };
+  return { purged: false, status: response.status, reason: `Daily answered ${response.status}` };
+}
