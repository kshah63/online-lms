+async function buildPracticeFinishedNotification(payload: WebhookPayload): Promise<ExpoMessage[]> {
+  const next = payload.record;
+  const prev = payload.old_record;
+  if (payload.type !== 'UPDATE' || !next || !prev) return [];
+  if (prev.status !== 'in_progress' || !['submitted', 'marked'].includes(String(next.status))) {
