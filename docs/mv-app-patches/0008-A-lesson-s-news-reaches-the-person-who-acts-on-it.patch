+    badge,
+    data: { kind: 'practice', attemptId: next.id, assignmentId: next.assignment_id },
+    channelId: 'messages',
+  }));
+}
+
+/** A numeric column as a person reads it: 7, 7.5 — never 7.00 or "null". */
+function scoreText(value: unknown): string {
+  const n = Number(value);
+  return value == null || !Number.isFinite(n) ? '0' : String(n);
+}
