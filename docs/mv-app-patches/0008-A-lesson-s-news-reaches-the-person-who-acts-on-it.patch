+++ b/__smoke__/a-lessons-news-reaches-the-person-who-acts-on-it.test.ts
@@ -0,0 +1,176 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * What an online lesson leaves behind reaches the one person who acts on it.
+ *
+ * Four rows, four audiences, and none of them is "everybody in the room":
+ *
+ *   lesson_report_drafts INSERT   the draft is the assigned teacher's to
+ *                                 turn into a report — nobody else's;
+ *   lesson_followups     UPDATE   the teacher's yes (proposed → approved)
+ *                                 asks the department's in-charges, who send
+ *                                 it as themselves (approve_followup); every
+ *                                 other move of status is quiet;
+ *   practice_assignments INSERT   a set for home goes to the student and the
+ *                                 household's parents; a set for the room
+ *                                 goes to nobody's phone;
+ *   practice_attempts    UPDATE   an at-home set leaving in_progress tells
+ *                                 the teacher who set it, and only them.
+ *
+ * A source-shape test, like a-named-teammate-is-buzzed, because each
+ * audience is decided inside an edge function jest cannot run. It pins the
+ * gate at the top of each builder (the quiet cases return [] before any
+ * read), the one recipient rule each applies, and that each table reaches
+ * its builder from the dispatch chain and nothing else does — a case that
+ * fires for the wrong row looks like a working day with an extra buzz, and
+ * one that never fires looks exactly like a quiet one.
+ */
+
+const ROOT = join(__dirname, '..');
+const PUSH = readFileSync(join(ROOT, 'supabase', 'functions', 'send-push', 'index.ts'), 'utf8');
+
+/** One builder on its own — the file is thousands of lines. */
+function builder(name: string): string {
+  const start = PUSH.indexOf(`async function ${name}(`);
+  expect(start).toBeGreaterThan(-1);
+  const next = PUSH.indexOf('\nasync function ', start + 1);
+  return PUSH.slice(start, next === -1 ? undefined : next);
+}
+
+/** The same block with its prose taken out, so a comment cannot satisfy a regex. */
+function code(name: string): string {
+  return builder(name)
+    .replace(/\/\*[\s\S]*?\*\//g, '')
+    .split('\n')
+    .filter((l) => !l.trim().startsWith('//'))
+    .join('\n');
+}
+
+/** The dispatch chain: from the first table test to the send. */
+function chain(): string {
+  const from = PUSH.indexOf('const messages =');
+  const to = PUSH.indexOf('const sent = await sendToExpo(messages);');
+  expect(from).toBeGreaterThan(-1);
+  expect(to).toBeGreaterThan(from);
+  return PUSH.slice(from, to);
+}
+
+const CASES: [table: string, fn: string][] = [
+  ['lesson_report_drafts', 'buildLessonDraftNotification'],
+  ['lesson_followups', 'buildFollowupApprovedNotification'],
+  ['practice_assignments', 'buildPracticeAssignedNotification'],
+  ['practice_attempts', 'buildPracticeFinishedNotification'],
+];
+
+describe('each table reaches its builder, and nothing else reaches it', () => {
+  it.each(CASES)('%s → %s', (table, fn) => {
+    const dispatch = chain();
+    expect(dispatch).toMatch(new RegExp(`payload\\.table === '${table}'\\s*\\?\\s*await ${fn}\\(payload\\)`));
+    // Once: a builder listed under a second table would fire for rows it
+    // never reads the shape of, and return [] by luck or buzz by accident.
+    expect(dispatch.split(`${fn}(payload)`).length - 1).toBe(1);
+    expect(dispatch.split(`payload.table === '${table}'`).length - 1).toBe(1);
+  });
+
+  it('says so in the header, where the three-place list is read', () => {
+    for (const [table] of CASES) {
+      expect(PUSH).toMatch(new RegExp(`•\\s+(INSERT|UPDATE) on public\\.${table}\\b`));
+    }
+  });
+});
+
+describe('a report draft goes to the teacher who taught', () => {
+  const block = code('buildLessonDraftNotification');
+
+  it('fires for the insert alone — a replaced draft says nothing twice', () => {
+    expect(block).toMatch(/if \(payload\.type !== 'INSERT' \|\| !next\?\.session_id\) return \[\];/);
+  });
+
+  it('is the assigned teacher, read off the session, or nobody', () => {
+    expect(block).toMatch(/\.from\('session_requests'\)\s*\.select\('assigned_teacher_id, student_name, topic, subject'\)/);
+    expect(block).toMatch(/if \(!session\?\.assigned_teacher_id\) return \[\];/);
+    expect(block).toMatch(/buildForRecipients\(\[session\.assigned_teacher_id as string\]/);
+    expect(block).not.toMatch(/adminRecipients|department_members|family_id/);
+  });
+
+  it("says what it is and names the lesson, and the link is the session's own page", () => {
+    expect(block).toMatch(/title: 'Your report draft is ready'/);
+    expect(block).toMatch(/body: truncate\(`\$\{first\} · \$\{topic\}`/);
+    expect(block).toMatch(/url: `https:\/\/mathvisionapp\.com\/sessions\/\$\{next\.session_id\}`/);
+    expect(block).toMatch(/kind: 'session',\s*sessionRequestId: next\.session_id/);
+  });
+});
+
+describe("a follow-up the teacher said yes to asks the room's in-charges", () => {
+  const block = code('buildFollowupApprovedNotification');
+
+  it('fires for proposed → approved and for no other move of status', () => {
+    expect(block).toMatch(/if \(payload\.type !== 'UPDATE' \|\| !next \|\| !prev\) return \[\];/);
+    expect(block).toMatch(/if \(prev\.status !== 'proposed' \|\| next\.status !== 'approved'\) return \[\];/);
+    expect(block).toMatch(/if \(!next\.department_id\) return \[\];/);
+  });
+
+  it("is sweep_report_nudges' decider half: the in-charge seat, an office role, an open account", () => {
+    expect(block).toMatch(/\.from\('department_members'\)[\s\S]*?\.eq\('department_id', next\.department_id\)\s*\.eq\('is_incharge', true\)/);
+    expect(block).toMatch(/\['staff', 'support', 'admin'\]\.includes\(String\(h\.member\.role\)\)/);
+    expect(block).toMatch(/h\.member\.deactivated_at == null/);
+    // #706: the in-charge seat, not the head's — and never the whole zone.
+    expect(block).not.toMatch(/is_head|adminRecipients|centreRecipients/);
+  });
+
+  it('leaves out the person whose yes this was', () => {
+    expect(block).toMatch(/h\.user_id !== next\.decided_by/);
+  });
+
+  it('says a follow-up is waiting, with its title as the body', () => {
+    expect(block).toMatch(/title: 'A follow-up is waiting to be sent'/);
+    expect(block).toMatch(/\(next\.title as string \| null\)/);
+    expect(block).toMatch(/data: \{ kind: 'followup', followupId: next\.id/);
+  });
+});
+
+describe('a practice set for home reaches the student and the household', () => {
+  const block = code('buildPracticeAssignedNotification');
+
+  it('fires for an at_home insert only; a set for the room is quiet here as well as at the trigger', () => {
+    expect(block).toMatch(/if \(payload\.type !== 'INSERT' \|\| !next\) return \[\];/);
+    expect(block).toMatch(/if \(next\.mode !== 'at_home' \|\| !next\.student_id \|\| !next\.set_id\) return \[\];/);
+  });
+
+  it("is the student and the family's parents — a sibling is not the one with homework", () => {
+    expect(block).toMatch(/new Set<string>\(\[next\.student_id as string\]\)/);
+    expect(block).toMatch(/\.eq\('family_id', student\.family_id\)/);
+    expect(block).toMatch(/if \(p\.role === 'parent' \|\| p\.id === next\.student_id\) recipients\.add\(p\.id\);/);
+    expect(block).not.toMatch(/adminRecipients|department_members|assigned_by/);
+  });
+
+  it("names the set, and the link is the app's Sessions tab — a room link needs a ticket a push cannot carry", () => {
+    expect(block).toMatch(/title: truncate\(`New practice: \$\{title\}`/);
+    expect(block).toMatch(/url: 'https:\/\/mathvisionapp\.com\/sessions'/);
+    expect(block).not.toMatch(/room\.mathvisionapp\.com|\/lesson\/|\/join/);
+  });
+});
+
+describe('an at-home set finished reaches the teacher who set it', () => {
+  const block = code('buildPracticeFinishedNotification');
+
+  it('fires when the attempt leaves in_progress for submitted or marked, and for nothing else', () => {
+    expect(block).toMatch(/if \(payload\.type !== 'UPDATE' \|\| !next \|\| !prev\) return \[\];/);
+    expect(block).toMatch(/if \(prev\.status !== 'in_progress' \|\| !\['submitted', 'marked'\]\.includes\(String\(next\.status\)\)\)/);
+    expect(block).toMatch(/if \(!next\.assignment_id\) return \[\];/);
+  });
+
+  it("is decided by the assignment's mode, not the set's kind, and goes to assigned_by alone", () => {
+    expect(block).toMatch(/\.from\('practice_assignments'\)\s*\.select\('mode, assigned_by, set_id'\)/);
+    expect(block).toMatch(/if \(assignment\?\.mode !== 'at_home' \|\| !assignment\.assigned_by\) return \[\];/);
+    expect(block).toMatch(/buildForRecipients\(\[assignment\.assigned_by as string\]/);
+    expect(block).not.toMatch(/\.kind|family_id|adminRecipients|department_members/);
+  });
+
+  it('names the student, the set and the score, and says flagged only when the attempt is', () => {
+    expect(block).toMatch(/const score = `\$\{scoreText\(next\.score\)\}\/\$\{scoreText\(next\.out_of\)\}`;/);
+    expect(block).toMatch(/const flagged = next\.integrity_flagged === true \? ' · flagged' : '';/);
+    expect(block).toMatch(/title: truncate\(`\$\{student\} finished \$\{title\}: \$\{score\}\$\{flagged\}`/);
+  });
+});
diff --git a/__smoke__/a-ready-transcript-finalises-the-lesson-again.test.ts b/__smoke__/a-ready-transcript-finalises-the-lesson-again.test.ts
new file mode 100644
index 0000000..361ac6c
--- /dev/null
+++ b/__smoke__/a-ready-transcript-finalises-the-lesson-again.test.ts
@@ -0,0 +1,63 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * Daily's stored transcript lands after the lesson ended, so the lesson is
+ * finalised twice: once from lesson_end on the room's own segments, and
+ * once more when the webhook says the stored WebVTT is ready. This is the
+ * second knock, and it goes through the same door the database uses, with
+ * the same bearer invoke_edge_function sends — the service-role key, which
+ * lesson-finalize compares in constant time.
+ *
+ * A source-shape test, because Deno.serve keeps the webhook out of jest. It
+ * pins that the knock happens only for transcript.ready-to-download (a
+ * failed transcript has nothing to finalise on), only after the room's row
+ * says 'ready' (so a refused knock leaves a transcript the next run can
+ * still fetch), and that what it sends is what lesson-finalize reads.
+ */
+
+const ROOT = join(__dirname, '..');
+const WEBHOOK = readFileSync(join(ROOT, 'supabase', 'functions', 'daily-webhook', 'index.ts'), 'utf8');
+const FINALIZE = readFileSync(join(ROOT, 'supabase', 'functions', 'lesson-finalize', 'index.ts'), 'utf8');
+
+/** The webhook's transcript arm, both outcomes of it. */
+function transcriptArm(): string {
+  const from = WEBHOOK.indexOf("case 'transcript_ready':");
+  const to = WEBHOOK.indexOf("case 'recording_error':");
+  expect(from).toBeGreaterThan(-1);
+  expect(to).toBeGreaterThan(from);
+  return WEBHOOK.slice(from, to);
+}
+
+describe('a ready transcript finalises the lesson again', () => {
+  it('knocks for the ready event and not for the failed one', () => {
+    const arm = transcriptArm();
+    expect(arm).toMatch(/if \(event\.type === 'transcript\.ready-to-download'\) await finalizeLesson\(outcome\.session_id\);/);
+    // One call site in the whole file, and it is the guarded one above.
+    const calls = WEBHOOK.split('finalizeLesson(').length - 1;
+    expect(calls).toBe(2); // the definition and the one call
+  });
+
+  it("knocks after the room's row says ready, never before", () => {
+    const arm = transcriptArm();
+    const wrote = arm.indexOf('if (error) throw error;');
+    const knocked = arm.indexOf('await finalizeLesson(');
+    expect(wrote).toBeGreaterThan(-1);
+    expect(knocked).toBeGreaterThan(wrote);
+  });
+
+  it('is the service role at the functions gateway, with session_id and reason transcript', () => {
+    const fn = WEBHOOK.slice(WEBHOOK.indexOf('async function finalizeLesson('));
+    expect(fn).toMatch(/fetch\(`\$\{Deno\.env\.get\('SUPABASE_URL'\)\}\/functions\/v1\/lesson-finalize`/);
+    expect(fn).toMatch(/method: 'POST'/);
+    expect(fn).toMatch(/Authorization: `Bearer \$\{Deno\.env\.get\('SUPABASE_SERVICE_ROLE_KEY'\)\}`/);
+    expect(fn).toMatch(/body: JSON\.stringify\(\{ session_id: sessionId, reason: 'transcript' \}\)/);
+    // A refusal is a throw, which apply's catch reports — not a swallowed 401.
+    expect(fn).toMatch(/if \(!response\.ok\) throw new Error\(`lesson-finalize answered \$\{response\.status\}`\);/);
+  });
+
+  it('sends the reason lesson-finalize reads, and nothing it would ignore', () => {
+    expect(FINALIZE).toMatch(/body\.reason === 'transcript'/);
+    expect(FINALIZE).toMatch(/isUuid\(body\.session_id\)/);
+  });
+});
diff --git a/__smoke__/a-recording-marked-deleted-leaves-daily.test.ts b/__smoke__/a-recording-marked-deleted-leaves-daily.test.ts
