+  const [{ data: set }, { data: who }] = await Promise.all([
+    admin
+      .from('practice_sets')
+      .select('title')
+      .eq('id', next.set_id ?? assignment.set_id)
+      .maybeSingle(),
+    admin.from('profiles').select('full_name, preferred_name').eq('id', next.student_id).maybeSingle(),
