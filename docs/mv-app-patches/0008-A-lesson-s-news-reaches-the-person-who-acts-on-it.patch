+  const what =
+    ((next.title as string | null) ?? '').trim() ||
+    ((next.detail as string | null) ?? '').trim() ||
+    'From an online lesson';
+  return buildForRecipients([...recipients], (badge) => ({
+    title: 'A follow-up is waiting to be sent',
+    body: truncate(what, 140),
+    badge,
+    data: { kind: 'followup', followupId: next.id, sessionRequestId: next.session_id },
+    channelId: 'messages',
