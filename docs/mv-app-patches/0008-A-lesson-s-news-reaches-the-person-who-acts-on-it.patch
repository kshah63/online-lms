+++ b/__smoke__/a-recording-marked-deleted-leaves-daily.test.ts
@@ -0,0 +1,141 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+import { BATCH, DAILY_API, purgeAtDaily } from '../supabase/functions/recordings-cleanup/purge';
+
+/**
+ * A recording the retention sweep marked deleted leaves Daily, and the row
+ * says so only once it has.
+ *
+ * sweep_lesson_retention stamps deleted_at; SQL cannot reach Daily, so
+ * recordings-cleanup does, on a schedule, and stamps purged_at afterwards.
+ * Two failures this guards, neither visible from the app: a recording that
+ * outlives the months somebody chose on the admin screen, and a row stamped
+ * purged while the bytes are still at Daily. The call itself is run here
+ * against a stubbed fetch; the order of the two writes, and which rows are
+ * asked for, are read off index.ts, which Deno.serve keeps out of jest.
+ */
+
+const ROOT = join(__dirname, '..');
+const SOURCE = readFileSync(join(ROOT, 'supabase', 'functions', 'recordings-cleanup', 'index.ts'), 'utf8');
+const WORKFLOW = readFileSync(join(ROOT, '.github', 'workflows', 'functions.yml'), 'utf8');
+
+type Seen = { url: string; init: RequestInit };
+
+function answering(status: number): { fetchImpl: typeof fetch; seen: Seen[] } {
+  const seen: Seen[] = [];
+  const fetchImpl = (async (url: string | URL | Request, init?: RequestInit) => {
+    seen.push({ url: String(url), init: init ?? {} });
+    return new Response(status === 204 ? null : JSON.stringify({ deleted: status < 300 }), { status });
+  }) as typeof fetch;
+  return { fetchImpl, seen };
+}
+
+describe('the call to Daily', () => {
+  it('is a DELETE of that recording, with the key as bearer', async () => {
+    const { fetchImpl, seen } = answering(200);
+    await purgeAtDaily({ recordingId: 'rec-1', apiKey: 'daily-key', fetchImpl });
+    expect(seen).toHaveLength(1);
+    expect(seen[0].url).toBe(`${DAILY_API}/recordings/rec-1`);
+    expect(seen[0].init.method).toBe('DELETE');
+    expect((seen[0].init.headers as Record<string, string>).Authorization).toBe('Bearer daily-key');
+  });
+
+  it('escapes the id, so an odd one cannot name a different path', async () => {
+    const { fetchImpl, seen } = answering(200);
+    await purgeAtDaily({ recordingId: '../webhooks', apiKey: 'k', fetchImpl });
+    expect(seen[0].url).toBe(`${DAILY_API}/recordings/..%2Fwebhooks`);
+  });
+
+  it('a 2xx is purged', async () => {
+    const { fetchImpl } = answering(200);
+    await expect(purgeAtDaily({ recordingId: 'rec-1', apiKey: 'k', fetchImpl })).resolves.toEqual({ purged: true, status: 200 });
+  });
+
+  it('a 404 is purged too — Daily no longer has it, and that is the state this is for', async () => {
+    const { fetchImpl } = answering(404);
+    await expect(purgeAtDaily({ recordingId: 'rec-1', apiKey: 'k', fetchImpl })).resolves.toEqual({ purged: true, status: 404 });
+  });
+
+  it('anything else leaves the row for the next run, with the reason', async () => {
+    for (const status of [401, 429, 500, 503]) {
+      const { fetchImpl } = answering(status);
+      await expect(purgeAtDaily({ recordingId: 'rec-1', apiKey: 'k', fetchImpl })).resolves.toEqual({
+        purged: false,
+        status,
+        reason: `Daily answered ${status}`,
+      });
+    }
+  });
+
+  it('and so does a network that did not answer at all', async () => {
+    const fetchImpl = (async () => {
+      throw new Error('connection reset');
+    }) as typeof fetch;
+    await expect(purgeAtDaily({ recordingId: 'rec-1', apiKey: 'k', fetchImpl })).resolves.toEqual({
+      purged: false,
+      status: null,
+      reason: 'connection reset',
+    });
+  });
+});
+
+describe('which rows, and in which order', () => {
+  it('asks for rows marked deleted, not yet purged, that have something at Daily — fifty at a time', () => {
+    expect(BATCH).toBe(50);
+    expect(SOURCE).toMatch(
+      /\.from\('lesson_recordings'\)\s*\.select\('session_id, provider_recording_id'\)\s*\.not\('deleted_at', 'is', null\)\s*\.is\('purged_at', null\)\s*\.not\('provider_recording_id', 'is', null\)[\s\S]*?\.limit\(BATCH\)/,
+    );
+  });
+
+  it('stamps purged_at only after Daily said the bytes are gone', () => {
+    const asked = SOURCE.indexOf('await purgeAtDaily({');
+    const refused = SOURCE.indexOf('if (!outcome.purged) {');
+    const stamped = SOURCE.indexOf('.update({ purged_at: new Date().toISOString() })');
+    expect(asked).toBeGreaterThan(-1);
+    expect(refused).toBeGreaterThan(asked);
+    expect(stamped).toBeGreaterThan(refused);
+    // The refusal keeps the row: `continue`, never a stamp.
+    const refusal = SOURCE.slice(refused, stamped);
+    expect(refusal).toMatch(/continue;/);
+    expect(refusal).not.toMatch(/purged_at/);
+  });
+
+  it('says in its one log line whether the batch was full, so a backlog is not an all-clear', () => {
+    expect(SOURCE).toMatch(/const more = batch\.length === BATCH;/);
+    expect(SOURCE).toMatch(/console\.log\(`recordings-cleanup: purged \$\{purged\}, kept \$\{problems\.length\}\$\{more \? ', batch full' : ''\}`\);/);
+    // Counts only: a session id in a log names a child's lesson.
+    expect(SOURCE).not.toMatch(/console\.log\([^)]*session_id/);
+  });
+
+  it('without DAILY_API_KEY it purges nothing and says so, once', () => {
+    expect(SOURCE).toMatch(/console\.error\('recordings-cleanup has no DAILY_API_KEY set\. Nothing is purged\.'\);/);
+    expect(SOURCE).toMatch(/return json\(\{ error: 'DAILY_API_KEY is not set' \}, 503\);/);
+    expect(SOURCE.indexOf("'DAILY_API_KEY is not set'")).toBeLessThan(SOURCE.indexOf("createClient(SUPABASE_URL"));
+  });
+});
+
+describe('how it is deployed', () => {
+  it('keeps JWT verification, like storage-cleanup: cron sends the service bearer through invoke_edge_function', () => {
+    const list = WORKFLOW.match(/NO_JWT="([^"]+)"/);
+    expect(list).not.toBeNull();
+    expect(list![1].split(/\s+/)).not.toContain('recordings-cleanup');
+    expect(list![1].split(/\s+/)).not.toContain('lesson-finalize');
+    expect(SOURCE).toMatch(/JWT verification ON/);
+  });
+
+  it('is on the deploy menu with lesson-finalize', () => {
