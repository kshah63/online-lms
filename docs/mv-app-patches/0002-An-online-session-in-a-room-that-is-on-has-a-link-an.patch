+  -- The switch, the seat and the link stamp.
+  select '20261013152315', 'an online session in a room that is on has a link and a seat',
+         'edge_config.room_url, lesson_platform_rooms and lesson_tickets exist; tickets are closed to clients; room_access is STABLE and refuses nobody by accident',
+         exists (select 1 from information_schema.columns
+                  where table_schema = 'public' and table_name = 'edge_config'
+                    and column_name = 'room_url')
+           and to_regclass('public.lesson_platform_rooms') is not null
+           and to_regclass('public.lesson_tickets') is not null
+           and coalesce((select relrowsecurity from pg_class where oid = to_regclass('public.lesson_tickets')), false)
+           and not has_table_privilege('authenticated', to_regclass('public.lesson_tickets')::oid, 'select')
+           and not has_table_privilege('anon', to_regclass('public.lesson_tickets')::oid, 'select')
+           and (select provolatile = 's'
+                  from pg_proc where oid = to_regprocedure('public.room_access(uuid, uuid)'))
+           and to_regprocedure('public.manages_course(uuid, uuid)') is not null
+           and to_regprocedure('public.lesson_platform_enabled(uuid)') is not null
+           and to_regprocedure('public.enable_lesson_platform(uuid, boolean)') is not null
+
+  union all
+
+  -- The stamp fires on INSERT only (never refilling a cleared link), and
+  -- sorts after apply_routing so the department is already decided.
+  select '20261013152315', 'an online session in a room that is on has a link and a seat',
+         'session_requests_the_room_link is BEFORE INSERT only, after session_requests_apply_routing, and never fires on UPDATE',
+         exists (select 1 from pg_trigger t
+                  where t.tgrelid = to_regclass('public.session_requests')
+                    and t.tgname = 'session_requests_the_room_link'
+                    and t.tgfoid = to_regprocedure('public.stamp_the_room_link()')
+                    and not t.tgisinternal
+                    and t.tgenabled <> 'D'
+                    and (t.tgtype & 1) <> 0     -- BEFORE
+                    and (t.tgtype & 4) <> 0     -- INSERT
+                    and (t.tgtype & 16) = 0     -- not UPDATE
+                    and (t.tgtype & 8) = 0      -- not DELETE
+                    and t.tgname > 'session_requests_apply_routing')
+
+  union all
+
+  -- The ticket doors belong to the service role alone.
+  select '20261013152315', 'an online session in a room that is on has a link and a seat',
+         'redeem_lesson_ticket and sweep_lesson_tickets: service_role may execute, authenticated and anon may not',
+         has_function_privilege('service_role', to_regprocedure('public.redeem_lesson_ticket(text)'), 'execute')
+           and not has_function_privilege('authenticated', to_regprocedure('public.redeem_lesson_ticket(text)'), 'execute')
+           and not has_function_privilege('anon', to_regprocedure('public.redeem_lesson_ticket(text)'), 'execute')
+           and has_function_privilege('service_role', to_regprocedure('public.sweep_lesson_tickets()'), 'execute')
+           and not has_function_privilege('authenticated', to_regprocedure('public.sweep_lesson_tickets()'), 'execute')
+           and coalesce((select prosrc like '%redeemed_at is null%'
+                             and prosrc like '%expires_at > now()%'
+                           from pg_proc
+                          where oid = to_regprocedure('public.redeem_lesson_ticket(text)')), false)
diff --git a/supabase/probes/20261013152316.sql b/supabase/probes/20261013152316.sql
new file mode 100644
index 0000000..3b8bf49
--- /dev/null
+++ b/supabase/probes/20261013152316.sql
@@ -0,0 +1,54 @@
+  -- What a lesson leaves behind: every table is there with row security on.
+  select '20261013152316', 'the room writes arrival and departure onto the booking and nothing else',
+         'lesson_rooms, lesson_notebooks, lesson_consents, lesson_course_materials, lesson_transcripts, lesson_events and lesson_report_drafts exist with RLS on, and the draft refuses a prev_hw or an OTR the report form would',
+         (select count(*) = 7 and bool_and(c.relrowsecurity)
+            from pg_class c
+            join pg_namespace n on n.oid = c.relnamespace
+           where n.nspname = 'public'
+             and c.relname in ('lesson_rooms', 'lesson_notebooks', 'lesson_consents',
+                               'lesson_course_materials', 'lesson_transcripts',
+                               'lesson_events', 'lesson_report_drafts'))
+           and exists (select 1 from pg_constraint
+                        where conname = 'lesson_report_drafts_prev_hw_check'
+                          and conrelid = to_regclass('public.lesson_report_drafts')
+                          and pg_get_constraintdef(oid) like '%Did Not Bring Exercise Book%')
+           and exists (select 1 from pg_constraint
+                        where conname = 'lesson_report_drafts_otr_check'
+                          and conrelid = to_regclass('public.lesson_report_drafts')
+                          and pg_get_constraintdef(oid) like '%% 5%')
+
+  union all
+
+  -- The webhook door is quiet, narrow and the service role's alone: its
+  -- body never names the columns a signed-out writer must not reach.
+  select '20261013152316', 'the room writes arrival and departure onto the booking and nothing else',
+         'import_lesson_room_facts sets app.portal_import, never names status, confirmed_start, requested_start, assigned_teacher_id or meeting_url, and authenticated cannot execute it',
+         coalesce((select prosrc like '%app.portal_import%'
+                       and prosrc !~ '\y(status|confirmed_start|requested_start|assigned_teacher_id|meeting_url)\y'
+                       and prosrc ~ '\yarrived_at\s*='
+                       and prosrc ~ '\ydeparted_at\s*='
+                     from pg_proc
+                    where oid = to_regprocedure('public.import_lesson_room_facts(jsonb)')), false)
+           and has_function_privilege('service_role', to_regprocedure('public.import_lesson_room_facts(jsonb)'), 'execute')
+           and not has_function_privilege('authenticated', to_regprocedure('public.import_lesson_room_facts(jsonb)'), 'execute')
+           and not has_function_privilege('anon', to_regprocedure('public.import_lesson_room_facts(jsonb)'), 'execute')
+
+  union all
+
+  -- The user-facing doors exist for signed-in callers, and neither of the
+  -- two that touch the booking ever assigns its status.
+  select '20261013152316', 'the room writes arrival and departure onto the booking and nothing else',
+         'lesson_room_state, my_online_lessons, lesson_join, lesson_end, save_lesson_notebook, log_lesson_event and set_lesson_consent are callable by authenticated; lesson_join and lesson_end never set status',
+         has_function_privilege('authenticated', to_regprocedure('public.lesson_room_state(uuid)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.my_online_lessons(integer)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.lesson_join(uuid)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.lesson_end(uuid, jsonb)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.save_lesson_notebook(uuid, jsonb)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.log_lesson_event(uuid, text, jsonb)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.set_lesson_consent(uuid, text, boolean)'), 'execute')
+           and coalesce((select prosrc !~ '\ystatus\s*=' and prosrc ~ '\yarrived_at\s*='
+                           from pg_proc where oid = to_regprocedure('public.lesson_join(uuid)')), false)
+           and coalesce((select prosrc !~ '\ystatus\s*=' and prosrc ~ '\ydeparted_at\s*='
+                           from pg_proc where oid = to_regprocedure('public.lesson_end(uuid, jsonb)')), false)
+           and pg_get_function_result(to_regprocedure('public.my_online_lessons(integer)'))
+                 like '%draft_ready boolean%seat text%'
diff --git a/supabase/tests/rls/20261013152317-an_online_session_in_a_room_that_is_on_has_a_link_and_a_seat.sql b/supabase/tests/rls/20261013152317-an_online_session_in_a_room_that_is_on_has_a_link_and_a_seat.sql
