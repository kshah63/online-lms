+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal
+select public.set_lesson_consent('22222222-2222-2222-2222-222222222222', 'transcript', true);
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada
+select public.set_lesson_consent('22222222-2222-2222-2222-222222222222', 'transcript', true);
+select test_ok(
+  'an admin may consent, and re-granting a consent in force keeps who gave it',
+  (select c.granted_by = '88888888-8888-8888-8888-888888888888' and c.revoked_at is null
+     from public.lesson_consents c
