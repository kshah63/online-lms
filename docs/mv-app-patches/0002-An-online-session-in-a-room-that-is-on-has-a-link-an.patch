+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes)
+values
+  ('ab1e5502-0000-0000-0000-000000000001', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '10 minutes', now() - interval '10 minutes', 60),
+  ('ab1e5502-0000-0000-0000-000000000002', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Physics HL', 'Waves',
+   'cccccccc-0000-0000-0000-0000000000fc', 'dddddddd-0000-0000-0000-0000000000fd',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '10 minutes', now() - interval '10 minutes', 60),
+  ('ab1e5502-0000-0000-0000-000000000003', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() + interval '1 day', now() + interval '1 day', 60),
+  ('ab1e5502-0000-0000-0000-000000000004', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '10 minutes', now() - interval '10 minutes', 60);
+
+insert into public.lesson_rooms (session_id, room_name, room_url)
+values ('ab1e5502-0000-0000-0000-000000000004',
+        'lesson-ab1e5502-0000-0000-0000-000000000004',
+        'https://daily.test/lesson-ab1e5502-0000-0000-0000-000000000004');
