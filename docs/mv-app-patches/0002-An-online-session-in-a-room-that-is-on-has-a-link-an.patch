@@ -0,0 +1,496 @@
+-- ---------------------------------------------------------------------------
+-- An online session in a room that is on has a link and a seat
+-- (migration 20261013152315; online-lms/docs/INTEGRATION.md, "Sessions seam")
+--
+-- The switch is an admin's and nobody else's; turning a department on stamps
+-- the room link on its FUTURE online sessions that have none, and leaves a
+-- pasted Zoom link, an in-person session, a past session and the other room
+-- exactly as they were, quietly. The trigger stamps a new booking the same
+-- way -- after routing has decided its room -- and never refills a link a
+-- person cleared. room_access hands out seats only in the window, only in a
+-- room that is on, and to nobody a policy would not also admit. Tickets are
+-- the service role's: nobody signed in can read, redeem or sweep one, and
+-- one redeems exactly once.
+-- ---------------------------------------------------------------------------
+begin;
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+
+-- The room has an address (with a trailing slash the link must not double),
+-- Erin runs Maths, and Ben has a spread of bookings: 01 future with no link,
+-- 02 future with a Zoom link somebody pasted, 03 future in person, 04 two
+-- days ago, 05 future in Science, 06 live now (started ten minutes ago, an
+-- hour long), 07 tomorrow, 08 live but cancelled, 09 live in Science.
+update public.edge_config set room_url = 'https://room.test/' where id = 1;
+update public.department_members set is_incharge = true
+ where department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+   and user_id = '55555555-5555-5555-5555-555555555555';
+
+create function pg_temp.fam() returns uuid language sql stable as $$
+  select family_id from public.profiles where id = '11111111-1111-1111-1111-111111111111'
+$$;
+
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes, meeting_url)
+values
+  ('ab1e5501-0000-0000-0000-000000000001', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   roll('2026-09-08 09:00:00+00'), roll('2026-09-08 09:00:00+00'), 60, null),
+  ('ab1e5501-0000-0000-0000-000000000002', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   roll('2026-09-08 11:00:00+00'), roll('2026-09-08 11:00:00+00'), 60, 'https://zoom.us/j/2'),
+  ('ab1e5501-0000-0000-0000-000000000003', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'in_person', 'confirmed',
+   roll('2026-09-08 13:00:00+00'), roll('2026-09-08 13:00:00+00'), 60, null),
+  ('ab1e5501-0000-0000-0000-000000000004', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '2 days', now() - interval '2 days', 60, null),
+  ('ab1e5501-0000-0000-0000-000000000005', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Physics HL', 'Waves',
+   'cccccccc-0000-0000-0000-0000000000fc', 'dddddddd-0000-0000-0000-0000000000fd',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   roll('2026-09-08 15:00:00+00'), roll('2026-09-08 15:00:00+00'), 60, null),
+  ('ab1e5501-0000-0000-0000-000000000006', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '10 minutes', now() - interval '10 minutes', 60, null),
+  ('ab1e5501-0000-0000-0000-000000000007', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() + interval '1 day', now() + interval '1 day', 60, null),
+  ('ab1e5501-0000-0000-0000-000000000008', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'cancelled',
+   now() - interval '10 minutes', now() - interval '10 minutes', 60, null),
+  ('ab1e5501-0000-0000-0000-000000000009', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Physics HL', 'Waves',
+   'cccccccc-0000-0000-0000-0000000000fc', 'dddddddd-0000-0000-0000-0000000000fd',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '10 minutes', now() - interval '10 minutes', 60, null);
+
+create function pg_temp.link(p_id uuid) returns text language sql stable as $$
+  select meeting_url from public.session_requests where id = p_id
+$$;
+
+-- Where the listeners stand before the switch, so "quiet" can be measured.
+create temp table marks as
+  select (select count(*) from net.http_request_queue) as pushes,
+         (select count(*) from public.sync_outbox)      as outbox;
+
+-- ---------------------------------------------------------------------------
+-- Before the switch: a live Maths lesson has no host and no learner, however
+-- live it is, because the room is off. The in-charge and the admin may look.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank, assigned
+select test_ok(
+  'a room that is off seats no host, even in the window',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('22222222-2222-2222-2222-222222222222');   -- Ben
+select test_ok(
+  'and no learner',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin, in charge of Maths
+select test_ok(
+  'the in-charge observes whether or not the room is on',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') = 'observer'
+);
+select test_ok(
+  'the platform reads as off for Maths',
+  not public.lesson_platform_enabled('dddddddd-0000-0000-0000-0000000000fc')
+);
+
+-- ---------------------------------------------------------------------------
+-- The switch is an admin's.
+-- ---------------------------------------------------------------------------
+select act_as('44444444-4444-4444-4444-444444444444');   -- Dana, support desk
+select test_ok(
+  'the support desk cannot turn the platform on',
+  raises_matching($$select public.enable_lesson_platform('dddddddd-0000-0000-0000-0000000000fc', true)$$,
+                  'only an admin')
+);
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin, in charge
+select test_ok(
+  'nor can the in-charge of the room',
+  raises_matching($$select public.enable_lesson_platform('dddddddd-0000-0000-0000-0000000000fc', true)$$,
+                  'only an admin')
+);
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada
+select test_ok(
+  'nor a parent',
+  raises_matching($$select public.enable_lesson_platform('dddddddd-0000-0000-0000-0000000000fc', true)$$,
+                  'only an admin')
+);
+select test_ok(
+  'but anybody signed in may read which rooms are on (none yet)',
+  (select count(*) from public.lesson_platform_rooms) = 0
+);
+select test_ok(
+  'and nobody writes the list by hand',
+  raises($$insert into public.lesson_platform_rooms (department_id)
+           values ('dddddddd-0000-0000-0000-0000000000fc')$$)
+);
+
+set local role postgres;
+update public.edge_config set room_url = null where id = 1;
+set local role authenticated;
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal, admin
+select test_ok(
+  'with no room address there is nothing to turn on',
+  raises_matching($$select public.enable_lesson_platform('dddddddd-0000-0000-0000-0000000000fc', true)$$,
+                  'room_url')
+);
+select test_ok(
+  'a null department is off while the room has no address',
+  not public.lesson_platform_enabled(null)
+);
+set local role postgres;
+update public.edge_config set room_url = 'https://room.test/' where id = 1;
+set local role authenticated;
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal
+select public.enable_lesson_platform('dddddddd-0000-0000-0000-0000000000fc', true);
+select test_ok(
+  'the admin turns Maths on',
+  public.lesson_platform_enabled('dddddddd-0000-0000-0000-0000000000fc')
+  and (select enabled_by from public.lesson_platform_rooms
+        where department_id = 'dddddddd-0000-0000-0000-0000000000fc')
+      = '88888888-8888-8888-8888-888888888888'
+);
+select test_ok(
+  'Science stays off',
+  not public.lesson_platform_enabled('dddddddd-0000-0000-0000-0000000000fd')
+);
+select test_ok(
+  'and a null department is on once the room has an address',
+  public.lesson_platform_enabled(null)
+);
+select test_ok(
+  'turning it on twice is not an error',
+  not raises($$select public.enable_lesson_platform('dddddddd-0000-0000-0000-0000000000fc', true)$$)
+);
+select test_ok(
+  'the quiet flag did not walk out of the switch',
+  coalesce(current_setting('app.push_quiet', true), '') = ''
+);
+
+-- ---------------------------------------------------------------------------
+-- The backfill: only future online sessions in Maths with no link, with no
+-- doubled slash, and nothing told to anybody.
+-- ---------------------------------------------------------------------------
+select test_ok(
+  'a future online Maths session with no link gets the room link',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000001')
+    = 'https://room.test/lesson/ab1e5501-0000-0000-0000-000000000001'
+);
+select test_ok(
+  'and so does tomorrow''s',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000007')
+    = 'https://room.test/lesson/ab1e5501-0000-0000-0000-000000000007'
+);
+select test_ok(
+  'a Zoom link somebody pasted is not overwritten',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000002') = 'https://zoom.us/j/2'
+);
+select test_ok(
+  'an in-person session gets no link',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000003') is null
+);
+select test_ok(
+  'a session two days ago gets no link',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000004') is null
+);
+select test_ok(
+  'a session already under way is not future and gets no link',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select test_ok(
+  'the other room''s session gets no link',
+  pg_temp.link('ab1e5501-0000-0000-0000-000000000005') is null
+);
+set local role postgres;
+select test_ok(
+  'the backfill pushed nobody and told the portal nothing',
+  (select count(*) from net.http_request_queue) = (select pushes from marks)
+  and (select count(*) from public.sync_outbox) = (select outbox from marks)
+);
+
+-- ---------------------------------------------------------------------------
+-- Seats, with the room on.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank, assigned
+select test_ok(
+  'the assigned teacher is the host of the live lesson',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') = 'host'
+);
+select test_ok(
+  'but not of tomorrow''s: outside the window there is no seat',
+  public.room_access('ab1e5501-0000-0000-0000-000000000007') is null
+);
+select test_ok(
+  'nor of a cancelled one, however live',
+  public.room_access('ab1e5501-0000-0000-0000-000000000008') is null
+);
+select test_ok(
+  'nor of a live lesson in a room that is off',
+  public.room_access('ab1e5501-0000-0000-0000-000000000009') is null
+);
+select act_as('22222222-2222-2222-2222-222222222222');   -- Ben
+select test_ok(
+  'the student is the learner of the live lesson',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') = 'learner'
+);
+select test_ok(
+  'and has no seat tomorrow',
+  public.room_access('ab1e5501-0000-0000-0000-000000000007') is null
+);
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada, Ben's parent
+select test_ok(
+  'a parent has no seat in a one-to-one lesson',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('33333333-3333-3333-3333-333333333333');   -- Cleo, another family
+select test_ok(
+  'a parent in another family has no seat',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('77777777-7777-7777-7777-777777777777');   -- Gita, teacher, not assigned
+select test_ok(
+  'a teacher in the department who is not assigned has no seat',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('cccc9999-9999-9999-9999-999999999999');   -- Tara, teaches Ben elsewhere
+select test_ok(
+  'a teacher who teaches the child but not this session has no seat',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('44444444-4444-4444-4444-444444444444');   -- Dana, support desk
+select test_ok(
+  'the support desk has no seat',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') is null
+);
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin
+select test_ok(
+  'the in-charge observes the live lesson and tomorrow''s',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') = 'observer'
+  and public.room_access('ab1e5501-0000-0000-0000-000000000007') = 'observer'
+);
+select test_ok(
+  'but not a cancelled one, and not the other room''s',
+  public.room_access('ab1e5501-0000-0000-0000-000000000008') is null
+  and public.room_access('ab1e5501-0000-0000-0000-000000000009') is null
+);
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal
+select test_ok(
+  'an admin observes any online room, on or off',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006') = 'observer'
+  and public.room_access('ab1e5501-0000-0000-0000-000000000009') = 'observer'
+);
+select test_ok(
+  'but an in-person session is not a room, and a cancelled one is not either',
+  public.room_access('ab1e5501-0000-0000-0000-000000000003') is null
+  and public.room_access('ab1e5501-0000-0000-0000-000000000008') is null
+);
+select test_ok(
+  'nobody at all has no seat',
+  public.room_access('ab1e5501-0000-0000-0000-000000000006', null) is null
+);
+
+-- ---------------------------------------------------------------------------
+-- manages_course: the course's own room, or a room a rule sends it to.
+-- ---------------------------------------------------------------------------
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin
+select test_ok(
+  'the in-charge of Maths manages a Maths course and not a Science one',
+  public.manages_course('cccccccc-0000-0000-0000-0000000000fa')
+  and not public.manages_course('cccccccc-0000-0000-0000-0000000000fc')
+);
+set local role postgres;
+insert into public.routing_rules (course_id, department_id, note)
+values ('cccccccc-0000-0000-0000-0000000000fc', 'dddddddd-0000-0000-0000-0000000000fc',
+        'Physics taught in the Maths room');
+set local role authenticated;
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin
+select test_ok(
+  'a routing rule into Maths makes the Science course Erin''s to manage',
+  public.manages_course('cccccccc-0000-0000-0000-0000000000fc')
+);
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank, teacher in Maths
+select test_ok(
+  'a teacher in the department manages no course',
+  not public.manages_course('cccccccc-0000-0000-0000-0000000000fa')
+);
+select act_as('44444444-4444-4444-4444-444444444444');   -- Dana, support, not in charge
+select test_ok(
+  'support staff who are in charge of no room manage no course',
+  not public.manages_course('cccccccc-0000-0000-0000-0000000000fa')
+);
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal
+select test_ok(
+  'an admin manages every course',
+  public.manages_course('cccccccc-0000-0000-0000-0000000000fa')
+  and public.manages_course('cccccccc-0000-0000-0000-0000000000fc')
+);
+
+-- ---------------------------------------------------------------------------
+-- The stamp on a new booking: after routing, online only, in a room that is
+-- on, and never on UPDATE.
+-- ---------------------------------------------------------------------------
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada books for Ben
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   mode, requested_start, duration_minutes)
+values
+  ('ab1e5501-0000-0000-0000-00000000000a', public.my_family_id(),
+   '11111111-1111-1111-1111-111111111111', '22222222-2222-2222-2222-222222222222',
+   'Ben Ashford', 'IB Math AA HL', 'Vectors', 'cccccccc-0000-0000-0000-0000000000fa',
+   'online', roll('2026-09-10 03:30:00+00'), 60);
+select test_ok(
+  'a family''s new online booking is routed to Maths and carries the room link',
+  (select department_id from public.session_requests
+    where id = 'ab1e5501-0000-0000-0000-00000000000a') = 'dddddddd-0000-0000-0000-0000000000fc'
+  and pg_temp.link('ab1e5501-0000-0000-0000-00000000000a')
+      = 'https://room.test/lesson/ab1e5501-0000-0000-0000-00000000000a'
+);
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   mode, requested_start, duration_minutes)
+values
+  ('ab1e5501-0000-0000-0000-00000000000b', public.my_family_id(),
+   '11111111-1111-1111-1111-111111111111', '22222222-2222-2222-2222-222222222222',
+   'Ben Ashford', 'IB Math AA HL', 'Vectors', 'cccccccc-0000-0000-0000-0000000000fa',
+   'in_person', roll('2026-09-10 06:30:00+00'), 60);
+select test_ok(
+  'an in-person booking in the same room gets no link',
+  pg_temp.link('ab1e5501-0000-0000-0000-00000000000b') is null
+);
+
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal clears the link
+update public.session_requests set meeting_url = null
+ where id = 'ab1e5501-0000-0000-0000-00000000000a';
+select test_ok(
+  'a link a person cleared is not refilled: the stamp never runs on UPDATE',
