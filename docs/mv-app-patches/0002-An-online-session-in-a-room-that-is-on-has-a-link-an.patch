+-- ---------------------------------------------------------------------------
+-- The notebook: the student, the assigned teacher within a day, the course's
+-- in-charge, an admin.
+-- ---------------------------------------------------------------------------
+set local role postgres;
+create temp table nb as
+  select n.id from public.lesson_notebooks n
+   where n.student_id = '22222222-2222-2222-2222-222222222222'
+     and n.course_id = 'cccccccc-0000-0000-0000-0000000000fa';
