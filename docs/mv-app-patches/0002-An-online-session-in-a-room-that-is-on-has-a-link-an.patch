+  (select at is not null from joined)
+  and (select b.arrived_at = (select at from joined) and b.no_show = false
+         from pg_temp.booking('ab1e5502-0000-0000-0000-000000000001') b)
+);
+select test_ok(
+  'the booking''s status, time and teacher did not move',
+  (select b.status = 'confirmed'
+          and b.confirmed_start = now() - interval '10 minutes'
+          and b.assigned_teacher_id = '66666666-6666-6666-6666-666666666666'
+     from pg_temp.booking('ab1e5502-0000-0000-0000-000000000001') b)
