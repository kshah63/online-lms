index 0000000..ddf0324
--- /dev/null
+++ b/supabase/migrations/20261013152315_an_online_session_in_a_room_that_is_on_has_a_link_and_a_seat.sql
@@ -0,0 +1,352 @@
+-- ---------------------------------------------------------------------------
+-- An online session in a room that is on has a link and a seat.
+--
+-- The lesson platform (docs in online-lms/docs/INTEGRATION.md, "Sessions
+-- seam"): the booking IS the lesson. Nothing here creates a session; this
+-- hands an existing online booking a room link and decides who may sit in
+-- that room. Stage 1 of the hand-off: the flag per department, the ticket
+-- table the edge functions mint and redeem, the seat helpers the room and
+-- the app both ask, and the link stamp.
+--
+-- WHERE THE FLAG LIVES. lesson_platform_rooms, a table of our own keyed by
+-- department: departments and courses are both upserted by the sync
+-- daemon's directory pass, so a column on either would be nulled by it. A
+-- department whose row exists has the platform on; edge_config.room_url is
+-- the one address every link is built from (null = off everywhere).
+--
+-- THE LINK IS STAMPED ONCE, ON INSERT, NEVER ON UPDATE. A cleared
+-- meeting_url is a person's decision and must not be silently refilled.
+-- enable_lesson_platform backfills the department's FUTURE online sessions
+-- whose link is empty, and the trigger stamps new ones the same way. A Zoom
+-- link somebody pasted before the flag is never overwritten by either.
+-- The trigger's name sorts after session_requests_apply_routing (triggers
+-- fire in name order) so department_id is already decided when it reads it.
+--
+-- meeting_url is not in enqueue_session_sync's change list, so neither the
+-- backfill nor the stamp tells the portal anything; the backfill still runs
+-- under app.push_quiet because it is a mirror catching up, not news.
+--
+-- SEATS. room_access(session, uid) is the one rule for who is in the room:
+-- 'host' for the assigned teacher and 'learner' for the student, both only
+-- while the lesson is live (fifteen minutes before, thirty after) and the
+-- room is on; 'observer' for an admin or the room's in-charge. A cancelled
+-- or in-person session has no seats at all. Every lesson_ policy and RPC
+-- after this re-asks this function rather than copying its clauses.
+--
+-- TICKETS. lesson_tickets carries the hash of a token the room-ticket edge
+-- function mints for a zero-login hand-off into the browser. RLS on with no
+-- policy and every privilege revoked from clients (the portal_session_notes
+-- pattern): only the service role, through redeem_lesson_ticket, ever reads
+-- one, and that read marks it redeemed in the same statement.
+-- ---------------------------------------------------------------------------
+
+alter table public.edge_config add column if not exists room_url text;
+
+comment on column public.edge_config.room_url is
+  'The lesson room''s origin (https://room.mathvisionapp.com). Every room link '
+  'is room_url || ''/lesson/'' || session id. Null means the lesson platform '
+  'is off everywhere, whatever lesson_platform_rooms says.';
+
+create table if not exists public.lesson_platform_rooms (
+  department_id uuid primary key references public.departments (id) on delete cascade,
+  enabled_at    timestamptz not null default now(),
+  enabled_by    uuid references public.profiles (id) on delete set null
+);
+
+comment on table public.lesson_platform_rooms is
+  'A department whose row is here runs its online sessions in the lesson '
+  'platform. Written only by enable_lesson_platform (admin).';
+
+alter table public.lesson_platform_rooms enable row level security;
+-- A stranger with the publishable key holds no write here (20260901060458):
+-- the default grant to anon is taken back on every new table.
+revoke insert, update, delete, truncate, references, trigger
+  on public.lesson_platform_rooms from anon;
+
+drop policy if exists lesson_platform_rooms_select on public.lesson_platform_rooms;
+create policy lesson_platform_rooms_select on public.lesson_platform_rooms
+  for select to authenticated using (true);
+
+create table if not exists public.lesson_tickets (
+  id          uuid primary key default gen_random_uuid(),
+  token_hash  text not null unique,
+  user_id     uuid not null references public.profiles (id) on delete cascade,
+  session_id  uuid references public.session_requests (id) on delete cascade,
+  purpose     text not null check (purpose in ('join', 'test', 'page')),
+  next_path   text,
+  attempt_id  uuid,
+  expires_at  timestamptz not null,
+  redeemed_at timestamptz,
+  created_at  timestamptz not null default now()
+);
+
+comment on table public.lesson_tickets is
+  'One-shot hand-off tickets into the lesson room: the hex sha256 of a token '
+  'the room-ticket edge function minted, who it is for, where it lands. '
+  'Service role only; redeemed once by redeem_lesson_ticket and swept by '
+  'sweep_lesson_tickets.';
+
+alter table public.lesson_tickets enable row level security;
+revoke all on public.lesson_tickets from public, anon, authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Is the platform on for this department?
+--
+-- A department is on when its row exists. A session with NO department is
+-- on when the room has an address at all: room_access and the link stamp
+-- both ask this one function, so a null room cannot be a seat in one and
+-- not a link in the other.
+-- ---------------------------------------------------------------------------
+create or replace function public.lesson_platform_enabled(p_department_id uuid)
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select case
+           when p_department_id is null
+             then exists (select 1 from public.edge_config ec
+                           where ec.id = 1 and ec.room_url is not null)
+           else exists (select 1 from public.lesson_platform_rooms r
+                         where r.department_id = p_department_id)
+         end;
+$$;
+
+comment on function public.lesson_platform_enabled(uuid) is
+  'True when the department runs online sessions in the lesson platform; for '
+  'a null department, when edge_config.room_url is set at all.';
+
+revoke all on function public.lesson_platform_enabled(uuid) from public;
+grant execute on function public.lesson_platform_enabled(uuid) to authenticated;
+
+-- The room link for a session, or null while the room has no address.
+create or replace function public.lesson_room_link(p_session_id uuid)
+returns text
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select rtrim(ec.room_url, '/') || '/lesson/' || p_session_id::text
+    from public.edge_config ec
+   where ec.id = 1 and ec.room_url is not null;
+$$;
+
+revoke all on function public.lesson_room_link(uuid) from public, anon, authenticated;
+
+-- ---------------------------------------------------------------------------
+-- room_access: the seat, or none.
+-- ---------------------------------------------------------------------------
+create or replace function public.room_access(p_session_id uuid, uid uuid default auth.uid())
+returns text
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select case
+           when s.assigned_teacher_id = uid and live.is_live then 'host'
+           when s.student_id = uid and live.is_live then 'learner'
+           when public.is_admin(uid)
+                or (s.department_id is not null
+                    and public.is_incharge_of(s.department_id, uid))
+             then 'observer'
+         end
+    from public.session_requests s
+    cross join lateral (
+      select now() between s.effective_start - interval '15 minutes'
+                       and coalesce(s.ends_at,
+                                    s.effective_start
+                                    + make_interval(mins => s.duration_minutes))
+                           + interval '30 minutes'
+             and public.lesson_platform_enabled(s.department_id) as is_live
+    ) live
+   where s.id = p_session_id
+     and uid is not null
+     -- A room is an online thing, and a cancelled, declined or still-held
+     -- booking has no room: no seat for anybody, observers included.
+     and s.mode = 'online'
+     and s.status in ('confirmed', 'completed');
+$$;
+
+comment on function public.room_access(uuid, uuid) is
+  'The caller''s seat in a lesson room: host (assigned teacher) or learner '
+  '(the student) while the online session is live and its department is on; '
+  'observer for an admin or the department''s in-charge; null otherwise. '
+  'The one rule every lesson_ policy and RPC asks.';
+
+revoke all on function public.room_access(uuid, uuid) from public;
+grant execute on function public.room_access(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- manages_course: who curates a course's materials, syllabus and bank.
+-- An admin, or an in-charge (role staff or support, still with the centre)
+-- of the course's own department or of any department a routing rule sends
+-- the course to.
+-- ---------------------------------------------------------------------------
+create or replace function public.manages_course(p_course_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select public.is_admin(uid)
+      or exists (
+           select 1
+             from public.profiles p
+             join public.department_members dm on dm.user_id = p.id and dm.is_incharge
+            where p.id = uid
+              and p.role in ('staff', 'support')
+              and p.deactivated_at is null
+              and (dm.department_id = (select c.department_id
+                                         from public.courses c where c.id = p_course_id)
+                   or dm.department_id in (select rr.department_id
+                                             from public.routing_rules rr
+                                            where rr.course_id = p_course_id
+                                              and rr.is_active))
+         );
+$$;
+
+comment on function public.manages_course(uuid, uuid) is
+  'An admin, or an in-charge of the course''s department or of a department a '
+  'routing rule sends the course to.';
+
+revoke all on function public.manages_course(uuid, uuid) from public;
+grant execute on function public.manages_course(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- enable_lesson_platform: the admin's switch.
+-- ---------------------------------------------------------------------------
+create or replace function public.enable_lesson_platform(p_department_id uuid, p_on boolean)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_quiet text;
+begin
+  if not public.is_admin() then
+    raise exception 'only an admin turns the lesson platform on or off'
+      using errcode = '42501';
+  end if;
+  if p_department_id is null then
+    raise exception 'a department is needed' using errcode = '22023';
+  end if;
+
+  if not p_on then
+    -- Off leaves every meeting_url exactly as it is: a link already handed
+    -- to a family is theirs, and clearing it is a person's decision.
+    delete from public.lesson_platform_rooms where department_id = p_department_id;
+    return;
+  end if;
+
+  if not exists (select 1 from public.edge_config ec
+                  where ec.id = 1 and ec.room_url is not null) then
+    raise exception 'edge_config.room_url is not set, so there is no room to link to'
+      using errcode = 'P0001';
+  end if;
+
+  insert into public.lesson_platform_rooms (department_id, enabled_by)
+  values (p_department_id, auth.uid())
+  on conflict (department_id) do nothing;
+
+  -- The backfill is a mirror catching up, not news: quiet toward phones.
+  -- Saved and restored rather than cleared (20260901055516): the flag is
+  -- transaction-scoped and outlives this call.
+  v_quiet := coalesce(current_setting('app.push_quiet', true), '');
+  perform set_config('app.push_quiet', '1', true);
+  update public.session_requests s
+     set meeting_url = public.lesson_room_link(s.id)
+   where s.department_id = p_department_id
+     and s.mode = 'online'
+     and s.meeting_url is null
+     and s.effective_start > now();
+  perform set_config('app.push_quiet', v_quiet, true);
+end;
+$$;
+
+comment on function public.enable_lesson_platform(uuid, boolean) is
+  'Admin only. On: records the department in lesson_platform_rooms and stamps '
+  'the room link on its future online sessions that have no link yet. Off: '
+  'removes the row and leaves every meeting_url alone.';
+
+revoke all on function public.enable_lesson_platform(uuid, boolean) from public;
+grant execute on function public.enable_lesson_platform(uuid, boolean) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- The stamp: BEFORE INSERT only.
+-- ---------------------------------------------------------------------------
+create or replace function public.stamp_the_room_link()
+returns trigger
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+begin
+  if new.mode = 'online'
+     and new.meeting_url is null
+     and public.lesson_platform_enabled(new.department_id) then
+    -- lesson_room_link is null while edge_config.room_url is, so a room
+    -- with no address stamps nothing.
+    new.meeting_url := public.lesson_room_link(new.id);
+  end if;
+  return new;
+end;
+$$;
+
+revoke all on function public.stamp_the_room_link() from public, anon, authenticated;
+
+drop trigger if exists session_requests_the_room_link on public.session_requests;
+create trigger session_requests_the_room_link
+  before insert on public.session_requests
+  for each row execute function public.stamp_the_room_link();
+
+-- ---------------------------------------------------------------------------
+-- The ticket doors: service role only.
+-- ---------------------------------------------------------------------------
+create or replace function public.redeem_lesson_ticket(p_token_hash text)
+returns table(user_id uuid, session_id uuid, purpose text, next_path text, attempt_id uuid)
+language sql
+security definer
+set search_path to 'public'
+as $$
+  -- Single use: the read IS the redemption, in one statement, so two
+  -- redeemers racing on one token cannot both win.
+  update public.lesson_tickets t
+     set redeemed_at = now()
+   where t.token_hash = p_token_hash
+     and t.redeemed_at is null
+     and t.expires_at > now()
+  returning t.user_id, t.session_id, t.purpose, t.next_path, t.attempt_id;
+$$;
+
+comment on function public.redeem_lesson_ticket(text) is
+  'Service role only (room-redeem). Marks the live, unredeemed ticket with '
+  'this hash redeemed and returns who it was for; nothing for a spent, '
+  'expired or unknown one.';
+
+revoke all on function public.redeem_lesson_ticket(text) from public, anon, authenticated;
+grant execute on function public.redeem_lesson_ticket(text) to service_role;
+
+create or replace function public.sweep_lesson_tickets()
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  n int;
+begin
+  delete from public.lesson_tickets where created_at < now() - interval '1 day';
+  get diagnostics n = row_count;
+  return n;
+end;
+$$;
+
+comment on function public.sweep_lesson_tickets() is
+  'Deletes tickets older than a day (they live two minutes). Scheduled by hand '
+  'in the SQL editor as mv-lesson-tickets, hourly; see docs/RUNBOOK.md.';
+
+revoke all on function public.sweep_lesson_tickets() from public, anon, authenticated;
+grant execute on function public.sweep_lesson_tickets() to service_role;
+
+notify pgrst, 'reload schema';
