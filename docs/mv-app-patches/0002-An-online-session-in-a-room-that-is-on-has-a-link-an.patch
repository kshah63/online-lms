@@ -0,0 +1,1004 @@
+-- ---------------------------------------------------------------------------
+-- The room writes arrival and departure onto the booking, and nothing else.
+--
+-- Stage 2 of the lesson platform (online-lms/docs/INTEGRATION.md, "Sessions
+-- seam", "Data model"): what a live lesson leaves behind, and the doors the
+-- room and the app use to read and write it.
+--
+-- ATTENDANCE. Nothing in mv-app sets arrived_at for an online session today
+-- (sweep_no_shows skips them, and the check-in doors are for the building),
+-- so without this the teacher's Write tab never lists an online lesson and
+-- nobody is nudged for its report. Two doors write it, and both write only
+-- arrived_at / departed_at / no_show -- never status, never a time, never the
+-- teacher, never meeting_url:
+--
+--   lesson_join(session)   the learner, by their own hand, under room_access
+--   import_lesson_room_facts(rows)   the video provider's webhook, service
+--                          role only, under app.portal_import like every
+--                          other import door (the suite's "an import door
+--                          that writes where a push lives says so" covers it
+--                          by its import_ prefix). auth.uid() is null for it,
+--                          so every BEFORE UPDATE guard on session_requests
+--                          steps aside -- which is exactly why its body may
+--                          not name the columns above, and a probe reads
+--                          pg_proc.prosrc to hold it to that.
+--
+-- Both pass the seventeen BEFORE UPDATE triggers on session_requests because
+-- guard_session_edit only engages when a reschedule column moves and
+-- enqueue_session_sync compares none of these columns, so the portal hears
+-- nothing. The RLS section runs lesson_join as the student to prove it.
+--
+-- THE PORTAL STAYS THE RECORD. A later wp_enter keyed by the office for the
+-- same booking makes import_portal_checkins overwrite arrived_at, and status
+-- is not touched here at all: it is in enqueue_session_sync's change list
+-- and would push a row to the portal whose applier's acceptance of an
+-- app-side 'completed' is unverified. Whatever closes online sessions today
+-- keeps doing it.
+--
+-- WHO READS WHAT. Rooms, transcripts, events and report drafts: the assigned
+-- teacher of the session, the department's in-charge (is_incharge_of) and
+-- an admin, through one helper, reads_lesson(). Families read none of them
+-- on purpose (a transcript holds the teacher's every word). Notebooks: the
+-- student, the teacher assigned to a session for that student and course
+-- within a day, manages_course, admin. Consents: the household, the room's
+-- in-charges through room_reaches, admin. Never is_staff() alone.
+--
+-- lesson_report_drafts is created here because my_online_lessons reports
+-- draft_ready from it; stage 3 fills it (lesson-finalize) and wires its
+-- push trigger. Its two CHECKs mirror session_reports_prev_hw_check and the
+-- OTR bands, so a draft can never propose a value the report form refuses.
+-- ---------------------------------------------------------------------------
+
+create table if not exists public.lesson_rooms (
+  session_id             uuid primary key references public.session_requests (id) on delete cascade,
+  provider               text not null default 'daily',
+  room_name              text unique,
+  room_url               text,
+  created_at             timestamptz not null default now(),
+  opened_at              timestamptz,
+  closed_at              timestamptz,
+  recording_enabled      boolean not null default false,
+  transcript_status      text not null default 'none'
+                         check (transcript_status in ('none', 'pending', 'ready', 'failed')),
+  provider_transcript_id text,
+  provider_recording_id  text
+);
+
+comment on table public.lesson_rooms is
+  'The video room behind an online session: lesson-<session id> at the '
+  'provider, when it was first opened and last closed. Created by the '
+  'room-ticket edge function or by lesson_join, closed by lesson_end and '
+  'the provider''s webhook.';
+
+create table if not exists public.lesson_notebooks (
+  id              uuid primary key default gen_random_uuid(),
+  student_id      uuid not null references public.profiles (id) on delete cascade,
+  course_id       uuid not null references public.courses (id) on delete cascade,
+  tldraw_snapshot jsonb,
+  updated_at      timestamptz not null default now(),
+  unique (student_id, course_id)
+);
+
+comment on table public.lesson_notebooks is
+  'One shared whiteboard per student and course, carried from lesson to '
+  'lesson. Created lazily by lesson_room_state, saved by save_lesson_notebook.';
+
+create table if not exists public.lesson_consents (
+  student_id uuid not null references public.profiles (id) on delete cascade,
+  kind       text not null check (kind in ('recording', 'transcript', 'ai_analysis', 'integrity_camera')),
+  granted_by uuid references public.profiles (id) on delete set null,
+  granted_at timestamptz not null default now(),
+  revoked_at timestamptz,
+  primary key (student_id, kind)
+);
+
+comment on table public.lesson_consents is
+  'What a parent has agreed to for a child''s online lessons. A row with '
+  'revoked_at null is a consent in force. Written only by set_lesson_consent.';
+
+create table if not exists public.lesson_course_materials (
+  course_id           uuid primary key references public.courses (id) on delete cascade,
+  materials_course_id uuid not null,
+  mapped_by           uuid references public.profiles (id) on delete set null,
+  mapped_at           timestamptz not null default now()
+);
+
+comment on table public.lesson_course_materials is
+  'Which course on the materials portal an mv-app course is, picked by an '
+  'admin. Its own table rather than a column on courses, which the sync '
+  'daemon upserts.';
+
+create table if not exists public.lesson_transcripts (
+  session_id uuid primary key references public.session_requests (id) on delete cascade,
+  segments   jsonb not null default '[]'::jsonb,
+  word_count integer,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+comment on table public.lesson_transcripts is
+  'The lesson''s transcript as the room held it: segments [{speaker, text, '
+  'at_ms, ...}]. Written by lesson_end; read by the teacher, the in-charge '
+  'and admins, never by a family.';
+
+create table if not exists public.lesson_events (
+  id         bigserial primary key,
+  session_id uuid not null references public.session_requests (id) on delete cascade,
+  at         timestamptz not null default now(),
+  kind       text not null,
+  payload    jsonb not null default '{}'::jsonb,
+  actor_id   uuid references public.profiles (id) on delete set null
+);
+
+create index if not exists lesson_events_session_idx
+  on public.lesson_events (session_id, at);
+
+comment on table public.lesson_events is
+  'Append-only log of what happened in a lesson room (teacher_note, '
+  'quick_check, ...): any seat may write through log_lesson_event.';
+
+create table if not exists public.lesson_report_drafts (
+  session_id uuid primary key references public.session_requests (id) on delete cascade,
+  draft      jsonb not null,
+  rationale  text,
+  source     text not null check (source in ('ai', 'heuristic')),
+  created_at timestamptz not null default now(),
+  used_at    timestamptz
+);
+
+comment on table public.lesson_report_drafts is
+  'A proposed report for an online lesson, in submit_report''s parameter '
+  'shape, for the teacher to confirm in the app''s form. Never a report '
+  'itself: the one door into session_reports stays submit_report.';
+
+-- The nine portal strings, exactly as session_reports_prev_hw_check holds them.
+alter table public.lesson_report_drafts drop constraint if exists lesson_report_drafts_prev_hw_check;
+alter table public.lesson_report_drafts add constraint lesson_report_drafts_prev_hw_check check (
+  (draft->>'prev_hw') is null
+  or (draft->>'prev_hw') in ('Yes', 'Most of it Done', 'Partially Done', 'Little Done',
+                             'Not Done', 'No Homework Given',
+                             'Did Not Bring / Did Not Send Through Email/Whatsapp',
+                             'Did Not Bring Exercise Book',
+                             'Done And Sent Through Email/Skype/Whatsapp'));
+
+-- OTR is offered to the teacher as bands, so the draft may only hold one.
+alter table public.lesson_report_drafts drop constraint if exists lesson_report_drafts_otr_check;
+alter table public.lesson_report_drafts add constraint lesson_report_drafts_otr_check check (
+  (draft->>'otr') is null
+  or ((draft->>'otr')::int between 5 and 95 and (draft->>'otr')::int % 5 = 0));
+
+alter table public.lesson_rooms            enable row level security;
+alter table public.lesson_notebooks        enable row level security;
+alter table public.lesson_consents         enable row level security;
+alter table public.lesson_course_materials enable row level security;
+alter table public.lesson_transcripts      enable row level security;
+alter table public.lesson_events           enable row level security;
+alter table public.lesson_report_drafts    enable row level security;
+
+-- A stranger with the publishable key holds no write on any of these
+-- (20260901060458): the default grant to anon is taken back on every new
+-- table.
+revoke insert, update, delete, truncate, references, trigger on public.lesson_rooms            from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_notebooks        from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_consents         from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_course_materials from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_transcripts      from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_events           from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_report_drafts    from anon;
+
+-- ---------------------------------------------------------------------------
+-- reads_lesson: the assigned teacher, the room's in-charge, an admin.
+-- ---------------------------------------------------------------------------
+create or replace function public.reads_lesson(p_session_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select exists (
+    select 1
+      from public.session_requests s
+     where s.id = p_session_id
+       and uid is not null
+       and (s.assigned_teacher_id = uid
+            or public.is_admin(uid)
+            or (s.department_id is not null
+                and public.is_incharge_of(s.department_id, uid)))
+  );
+$$;
+
+comment on function public.reads_lesson(uuid, uuid) is
+  'Who reads what a lesson left behind (room, transcript, events, draft): '
+  'the session''s assigned teacher, the department''s in-charge, an admin. '
+  'Families, deliberately, never.';
+
+revoke all on function public.reads_lesson(uuid, uuid) from public;
+grant execute on function public.reads_lesson(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- lesson_notebook_access: the student, the teacher assigned to a session for
+-- that student and course within a day of now, manages_course, admin.
+-- ---------------------------------------------------------------------------
+create or replace function public.lesson_notebook_access(p_notebook_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select exists (
+    select 1
+      from public.lesson_notebooks n
+     where n.id = p_notebook_id
+       and uid is not null
+       and (n.student_id = uid
+            or public.is_admin(uid)
+            or public.manages_course(n.course_id, uid)
+            or exists (select 1
+                         from public.session_requests s
+                        where s.student_id = n.student_id
+                          and s.course_id = n.course_id
+                          and s.assigned_teacher_id = uid
+                          and s.status not in ('cancelled', 'declined')
+                          and s.effective_start between now() - interval '1 day'
+                                                    and now() + interval '1 day'))
+  );
+$$;
+
+revoke all on function public.lesson_notebook_access(uuid, uuid) from public;
+grant execute on function public.lesson_notebook_access(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Policies. Every write goes through an RPC below, so only reads are here
+-- (lesson_course_materials excepted: the admin's mapping screen writes it).
+-- ---------------------------------------------------------------------------
+drop policy if exists lesson_rooms_select on public.lesson_rooms;
+create policy lesson_rooms_select on public.lesson_rooms
+  for select to authenticated using (public.reads_lesson(session_id));
+
+drop policy if exists lesson_transcripts_select on public.lesson_transcripts;
+create policy lesson_transcripts_select on public.lesson_transcripts
+  for select to authenticated using (public.reads_lesson(session_id));
+
+drop policy if exists lesson_events_select on public.lesson_events;
+create policy lesson_events_select on public.lesson_events
+  for select to authenticated using (public.reads_lesson(session_id));
+
+drop policy if exists lesson_report_drafts_select on public.lesson_report_drafts;
+create policy lesson_report_drafts_select on public.lesson_report_drafts
+  for select to authenticated using (public.reads_lesson(session_id));
+
+drop policy if exists lesson_notebooks_select on public.lesson_notebooks;
+create policy lesson_notebooks_select on public.lesson_notebooks
+  for select to authenticated using (public.lesson_notebook_access(id));
+
+drop policy if exists lesson_consents_select on public.lesson_consents;
+create policy lesson_consents_select on public.lesson_consents
+  for select to authenticated using (
+    public.shares_family(student_id)
+    or public.is_admin()
+    or public.room_reaches(
+         (select p.family_id from public.profiles p where p.id = lesson_consents.student_id),
+         student_id, false)
+  );
+
+drop policy if exists lesson_course_materials_select on public.lesson_course_materials;
+create policy lesson_course_materials_select on public.lesson_course_materials
+  for select to authenticated using (true);
+drop policy if exists lesson_course_materials_insert on public.lesson_course_materials;
+create policy lesson_course_materials_insert on public.lesson_course_materials
+  for insert to authenticated with check (public.is_admin());
+drop policy if exists lesson_course_materials_update on public.lesson_course_materials;
+create policy lesson_course_materials_update on public.lesson_course_materials
+  for update to authenticated using (public.is_admin()) with check (public.is_admin());
+drop policy if exists lesson_course_materials_delete on public.lesson_course_materials;
+create policy lesson_course_materials_delete on public.lesson_course_materials
+  for delete to authenticated using (public.is_admin());
+
+-- ---------------------------------------------------------------------------
+-- lesson_room_state: everything the room page needs, one row or none.
+-- ---------------------------------------------------------------------------
+create or replace function public.lesson_room_state(p_session_id uuid)
+returns table(
+  session_id uuid, seat text, status public.request_status, mode public.session_mode,
+  effective_start timestamptz, ends_at timestamptz, duration_minutes integer,
+  time_zone text, topic text, subject text, course_id uuid, course_name text,
+  department_id uuid, department_name text, student_id uuid, student_name text,
+  student_grade text, teacher_id uuid, teacher_name text, family_id uuid,
+  arrived_at timestamptz, departed_at timestamptz, meeting_url text,
+  materials_course_id uuid, notebook_id uuid, room_opened_at timestamptz,
+  room_closed_at timestamptz, recording_enabled boolean, consents jsonb)
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+-- The OUT columns are plpgsql variables too, so an unqualified column name
+-- in a statement below (the ON CONFLICT target) would be "ambiguous";
+-- columns win, and every reference to a variable is spelled v_*.
+#variable_conflict use_column
+declare
+  v_seat     text;
+  v_s        public.session_requests%rowtype;
+  v_notebook uuid;
+begin
+  v_seat := public.room_access(p_session_id);
+  if v_seat is null then
+    return;
+  end if;
+
+  select * into v_s from public.session_requests s where s.id = p_session_id;
+
+  -- The notebook is per student and course, and exists from the first time
+  -- either of them opens the room.
+  if v_seat in ('host', 'learner')
+     and v_s.student_id is not null and v_s.course_id is not null then
+    insert into public.lesson_notebooks (student_id, course_id)
+    values (v_s.student_id, v_s.course_id)
+    on conflict (student_id, course_id) do nothing;
+  end if;
+  select n.id into v_notebook
+    from public.lesson_notebooks n
+   where n.student_id = v_s.student_id and n.course_id = v_s.course_id;
+
+  return query
+    select v_s.id, v_seat, v_s.status, v_s.mode,
+           v_s.effective_start, v_s.ends_at, v_s.duration_minutes,
+           v_s.time_zone, v_s.topic, v_s.subject, v_s.course_id, c.name,
+           v_s.department_id, d.name,
+           v_s.student_id,
+           coalesce(public.display_name(sp.full_name, sp.preferred_name), v_s.student_name),
+           sp.grade_level,
+           v_s.assigned_teacher_id,
+           public.display_name(tp.full_name, tp.preferred_name),
+           v_s.family_id, v_s.arrived_at, v_s.departed_at, v_s.meeting_url,
+           m.materials_course_id, v_notebook,
+           r.opened_at, r.closed_at, coalesce(r.recording_enabled, false),
+           (select jsonb_object_agg(k.kind,
+                     exists (select 1 from public.lesson_consents lc
+                              where lc.student_id = v_s.student_id
+                                and lc.kind = k.kind
+                                and lc.revoked_at is null))
+              from unnest(array['recording', 'transcript', 'ai_analysis', 'integrity_camera']) k(kind))
+      from (select 1) one
+      left join public.courses c                 on c.id = v_s.course_id
+      left join public.departments d             on d.id = v_s.department_id
+      left join public.profiles sp               on sp.id = v_s.student_id
+      left join public.profiles tp               on tp.id = v_s.assigned_teacher_id
+      left join public.lesson_course_materials m on m.course_id = v_s.course_id
+      left join public.lesson_rooms r            on r.session_id = v_s.id;
+end;
+$$;
+
+comment on function public.lesson_room_state(uuid) is
+  'The lesson room page''s one read: the booking, the people in it by '
+  'display name, the room, the materials mapping, the notebook (created on '
+  'first open by the host or learner) and the consents in force. One row for '
+  'a seat, none without one.';
+
+revoke all on function public.lesson_room_state(uuid) from public;
+grant execute on function public.lesson_room_state(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- my_online_lessons: the caller's online sessions, a fortnight each way.
+-- ---------------------------------------------------------------------------
+create or replace function public.my_online_lessons(p_days integer default 14)
+returns table(
+  session_id uuid, student_id uuid, student_name text, subject text, topic text,
+  effective_start timestamptz, ends_at timestamptz, duration_minutes integer,
+  status public.request_status, mode public.session_mode,
+  arrived_at timestamptz, departed_at timestamptz, meeting_url text,
+  teacher_id uuid, teacher_name text, report_id uuid, report_status public.report_status,
+  draft_ready boolean, time_zone text, seat text)
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  with me as (
+    select p.id, p.role, p.family_id, public.is_admin(p.id) as admin
+      from public.profiles p
+     where p.id = auth.uid()
+  ),
+  span as (
+    select make_interval(days => greatest(coalesce(p_days, 14), 0)) as width
+  )
+  select s.id, s.student_id,
+         coalesce(public.display_name(sp.full_name, sp.preferred_name), s.student_name),
+         s.subject, s.topic, s.effective_start, s.ends_at, s.duration_minutes,
+         s.status, s.mode, s.arrived_at, s.departed_at, s.meeting_url,
+         s.assigned_teacher_id, public.display_name(tp.full_name, tp.preferred_name),
+         r.id, r.status,
+         exists (select 1 from public.lesson_report_drafts d where d.session_id = s.id),
+         s.time_zone,
+         case
+           when s.assigned_teacher_id = me.id then 'host'
+           when s.student_id = me.id then 'learner'
+           when me.role = 'parent' and s.family_id = me.family_id then 'family'
+           else 'observer'
+         end
+    from me
+    cross join span
+    join public.session_requests s
+      on s.mode = 'online'
+     and s.status not in ('cancelled', 'declined')
+     and s.effective_start between now() - span.width and now() + span.width
+     and (s.assigned_teacher_id = me.id
+          or s.student_id = me.id
+          or (me.role = 'parent' and me.family_id is not null and s.family_id = me.family_id)
+          or (s.department_id is not null and public.is_incharge_of(s.department_id, me.id))
+          or (me.admin and public.lesson_platform_enabled(s.department_id)))
+    left join public.profiles sp        on sp.id = s.student_id
+    left join public.profiles tp        on tp.id = s.assigned_teacher_id
+    left join public.session_reports r  on r.session_request_id = s.id
+   order by s.effective_start, s.id
+   limit 200;
+$$;
+
+comment on function public.my_online_lessons(integer) is
+  'Online sessions within p_days either side of now where the caller is the '
+  'teacher (host), the student (learner), a parent of the household (family), '
+  'an in-charge of the department (observer) or an admin (observer, rooms '
+  'that are on). Oldest first, at most 200.';
+
+revoke all on function public.my_online_lessons(integer) from public;
+grant execute on function public.my_online_lessons(integer) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- lesson_join: the learner arrives.
+-- ---------------------------------------------------------------------------
+create or replace function public.lesson_join(p_session_id uuid)
+returns timestamptz
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_quiet   text;
+  v_arrived timestamptz;
+begin
+  if public.room_access(p_session_id) is distinct from 'learner' then
+    raise exception 'only the student joins the lesson from here'
+      using errcode = '42501';
+  end if;
+
+  -- Quiet toward phones (no push builder fires on an arrival alone, but the
+  -- invocation would still cost); saved and restored, not cleared.
+  v_quiet := coalesce(current_setting('app.push_quiet', true), '');
+  perform set_config('app.push_quiet', '1', true);
+
+  update public.session_requests s
+     set arrived_at = coalesce(s.arrived_at, now()),
+         no_show    = false
+   where s.id = p_session_id;
+
+  insert into public.lesson_rooms (session_id, room_name, opened_at)
+  values (p_session_id, 'lesson-' || p_session_id::text, now())
+  on conflict (session_id) do update
+    set opened_at = coalesce(public.lesson_rooms.opened_at, excluded.opened_at);
+
+  perform set_config('app.push_quiet', v_quiet, true);
+
+  select s.arrived_at into v_arrived
+    from public.session_requests s where s.id = p_session_id;
+  return v_arrived;
+end;
+$$;
+
+comment on function public.lesson_join(uuid) is
+  'The student joining their own live online lesson: stamps arrived_at (once) '
+  'and clears no_show on the booking, opens the room. Returns arrived_at.';
+
+revoke all on function public.lesson_join(uuid) from public;
+grant execute on function public.lesson_join(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- lesson_end: the host, the in-charge or an admin closes the lesson.
+-- ---------------------------------------------------------------------------
+create or replace function public.lesson_end(p_session_id uuid, p_segments jsonb default '[]'::jsonb)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_quiet text;
+  v_words integer;
+begin
+  if not public.reads_lesson(p_session_id)
+     or not exists (select 1 from public.session_requests s
+                     where s.id = p_session_id
+                       and s.mode = 'online'
+                       and s.status in ('confirmed', 'completed')) then
+    raise exception 'only the teacher, the room''s in-charge or an admin ends an online lesson'
+      using errcode = '42501';
+  end if;
+
+  v_quiet := coalesce(current_setting('app.push_quiet', true), '');
+  perform set_config('app.push_quiet', '1', true);
+
+  -- departed_at only. Not the booking's status: that is in
+  -- enqueue_session_sync's change list, and whatever closes online sessions
+  -- today keeps doing it.
+  update public.session_requests s
+     set departed_at = coalesce(s.departed_at, now())
+   where s.id = p_session_id;
+
+  insert into public.lesson_rooms (session_id, room_name, closed_at)
+  values (p_session_id, 'lesson-' || p_session_id::text, now())
+  on conflict (session_id) do update set closed_at = excluded.closed_at;
+
+  -- The transcript the room held. An end with no segments (a reconnect, a
+  -- second closer) leaves a transcript already written alone.
+  if jsonb_typeof(p_segments) = 'array' and jsonb_array_length(p_segments) > 0 then
+    select coalesce(sum(array_length(regexp_split_to_array(btrim(seg->>'text'), '\s+'), 1)), 0)::int
+      into v_words
+      from jsonb_array_elements(p_segments) seg
+     where nullif(btrim(coalesce(seg->>'text', '')), '') is not null;
+
+    insert into public.lesson_transcripts (session_id, segments, word_count)
+    values (p_session_id, p_segments, v_words)
+    on conflict (session_id) do update
+      set segments   = excluded.segments,
+          word_count = excluded.word_count,
+          updated_at = now();
+  end if;
+
+  perform set_config('app.push_quiet', v_quiet, true);
+end;
+$$;
+
+comment on function public.lesson_end(uuid, jsonb) is
+  'Closes an online lesson: departed_at on the booking (once, never the '
+  'status), closed_at on the room, and the transcript segments the room held '
+  'with their word count. The teacher, the department''s in-charge or an admin.';
+
+revoke all on function public.lesson_end(uuid, jsonb) from public;
+grant execute on function public.lesson_end(uuid, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- save_lesson_notebook
+-- ---------------------------------------------------------------------------
+create or replace function public.save_lesson_notebook(p_notebook_id uuid, p_snapshot jsonb)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+begin
+  if not public.lesson_notebook_access(p_notebook_id) then
+    raise exception 'this notebook is not yours to write'
+      using errcode = '42501';
+  end if;
+  update public.lesson_notebooks n
+     set tldraw_snapshot = p_snapshot,
+         updated_at      = now()
+   where n.id = p_notebook_id;
+end;
+$$;
+
+revoke all on function public.save_lesson_notebook(uuid, jsonb) from public;
+grant execute on function public.save_lesson_notebook(uuid, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- log_lesson_event: any seat appends.
+-- ---------------------------------------------------------------------------
+create or replace function public.log_lesson_event(p_session_id uuid, p_kind text, p_payload jsonb default '{}'::jsonb)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+begin
+  if nullif(btrim(coalesce(p_kind, '')), '') is null or length(p_kind) > 40 then
+    raise exception 'an event kind is one to forty characters'
+      using errcode = '22023';
+  end if;
+  if public.room_access(p_session_id) is null then
+    raise exception 'no seat in this lesson' using errcode = '42501';
+  end if;
+  insert into public.lesson_events (session_id, kind, payload, actor_id)
+  values (p_session_id, p_kind, coalesce(p_payload, '{}'::jsonb), auth.uid());
+end;
+$$;
+
+revoke all on function public.log_lesson_event(uuid, text, jsonb) from public;
+grant execute on function public.log_lesson_event(uuid, text, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- import_lesson_room_facts: the provider's webhook, service role only.
+--
+-- Rows: [{room_name, event ('joined' | 'left' | 'ended'), user_id, at}].
+-- The student's own events land on the booking (arrival once, departure
+-- the latest); anybody else's touch the room's opened_at and closed_at and
+-- nothing more. A room nobody knows is skipped. Returns the rows applied.
+--
+-- Deliberately narrow: no signed-in user means no guard on session_requests
+-- engages, so this body names only the two columns it may write, and the
+-- probe reads it back to make sure.
+-- ---------------------------------------------------------------------------
+create or replace function public.import_lesson_room_facts(p_rows jsonb)
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  r         jsonb;
+  v_session uuid;
+  v_student uuid;
+  v_user    uuid;
+  v_at      timestamptz;
+  v_event   text;
+  v_import  text;
+  v_news    text;
+  n         integer := 0;
+begin
+  -- Quiet toward the portal and toward phones, the way every import door
+  -- is; restored afterwards rather than cleared.
+  v_import := coalesce(current_setting('app.portal_import', true), '');
+  v_news   := coalesce(current_setting('app.portal_news', true), '');
+  perform set_config('app.portal_import', '1', true);
+  perform set_config('app.portal_news', '', true);
+
+  for r in select * from jsonb_array_elements(coalesce(p_rows, '[]'::jsonb)) loop
+    v_event := r->>'event';
+    v_at    := nullif(r->>'at', '')::timestamptz;
+    v_user  := nullif(r->>'user_id', '')::uuid;
+    if v_event not in ('joined', 'left', 'ended') or v_at is null then
+      continue;
+    end if;
+
+    v_session := null;
+    select lr.session_id, s.student_id
+      into v_session, v_student
+      from public.lesson_rooms lr
+      join public.session_requests s on s.id = lr.session_id
+     where lr.room_name = r->>'room_name';
+    if v_session is null then
+      continue;
+    end if;
+
+    if v_user is not null and v_user = v_student then
+      if v_event = 'joined' then
+        update public.session_requests s
+           set arrived_at = coalesce(s.arrived_at, v_at)
+         where s.id = v_session;
+      else
+        update public.session_requests s
+           set departed_at = greatest(coalesce(s.departed_at, v_at), v_at)
+         where s.id = v_session;
+      end if;
+    else
+      if v_event = 'joined' then
+        update public.lesson_rooms lr
+           set opened_at = coalesce(lr.opened_at, v_at)
+         where lr.session_id = v_session;
+      else
+        update public.lesson_rooms lr
+           set closed_at = greatest(coalesce(lr.closed_at, v_at), v_at)
+         where lr.session_id = v_session;
+      end if;
+    end if;
+    n := n + 1;
+  end loop;
+
+  perform set_config('app.portal_import', v_import, true);
+  perform set_config('app.portal_news', v_news, true);
+  return n;
+end;
+$$;
+
+comment on function public.import_lesson_room_facts(jsonb) is
+  'Service role only (daily-webhook). The video provider''s joined/left/ended '
+  'events: the student''s land as arrived_at and departed_at on the booking, '
+  'anybody else''s as the room''s opened_at and closed_at. Writes nothing else.';
+
+revoke all on function public.import_lesson_room_facts(jsonb) from public, anon, authenticated;
+grant execute on function public.import_lesson_room_facts(jsonb) to service_role;
+
+-- ---------------------------------------------------------------------------
+-- set_lesson_consent: a parent in the household, or an admin.
+-- ---------------------------------------------------------------------------
+create or replace function public.set_lesson_consent(p_student_id uuid, p_kind text, p_granted boolean)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+begin
+  if p_kind is null
+     or p_kind not in ('recording', 'transcript', 'ai_analysis', 'integrity_camera') then
+    raise exception 'consent is one of recording, transcript, ai_analysis, integrity_camera'
+      using errcode = '22023';
+  end if;
+  if not (public.is_admin()
+          or (public.shares_family(p_student_id)
+              and exists (select 1 from public.profiles p
+                           where p.id = auth.uid() and p.role = 'parent'))) then
+    raise exception 'only a parent in the student''s household, or an admin, sets a consent'
+      using errcode = '42501';
+  end if;
+
+  if p_granted then
+    insert into public.lesson_consents (student_id, kind, granted_by, granted_at, revoked_at)
+    values (p_student_id, p_kind, auth.uid(), now(), null)
+    on conflict (student_id, kind) do update
+      set granted_by = excluded.granted_by,
+          granted_at = excluded.granted_at,
+          revoked_at = null
+      -- A consent already in force keeps who gave it and when.
+      where public.lesson_consents.revoked_at is not null;
+  else
+    update public.lesson_consents c
+       set revoked_at = now()
+     where c.student_id = p_student_id
+       and c.kind = p_kind
+       and c.revoked_at is null;
+  end if;
+end;
+$$;
+
+comment on function public.set_lesson_consent(uuid, text, boolean) is
+  'Grants (insert, or clear revoked_at) or revokes (stamp revoked_at) one '
+  'consent for a student. A parent sharing the student''s household, or an admin.';
+
+revoke all on function public.set_lesson_consent(uuid, text, boolean) from public;
+grant execute on function public.set_lesson_consent(uuid, text, boolean) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Two more tables point at a course, so the twin merge learns them.
+--
+-- retire_seed_course_twins (20261006101925) moves every row that references
+-- a seed course onto its portal twin, and the RLS suite reads the list of
+-- foreign keys into courses out of the catalogue and fails when the
+-- function does not name one of them. lesson_notebooks (one per student and
+-- course) and lesson_course_materials (one per course) are moved under their
+-- own keys like student_courses is: a row the twin already has stays on the
+-- retired course and is counted among what was left behind.
+--
+-- Re-emitted from pg_get_functiondef() against a database with every
+-- migration applied; the two moves and their two lines in the leftover
+-- count are the only change.
+-- ---------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.retire_seed_course_twins()
+ RETURNS jsonb
+ LANGUAGE plpgsql
+ SET search_path TO 'public'
+AS $function$
+declare
+  locked  regclass[];
+  tbl     regclass;
+  n       int;
+  retired int   := 0;
+  revived int   := 0;
+  rooms   int   := 0;
+  names   text[] := '{}';
+  moved   jsonb := '{}';
+  skipped jsonb := '{}';
+begin
+  -- The pairs, once: every seed row beside a keyed row of its name, live or
+  -- not, and one portal row per seed (a live one first) so no row is asked
+  -- to move twice.
+  if to_regclass('pg_temp.course_twins') is not null then
+    drop table pg_temp.course_twins;
+  end if;
+  create temp table course_twins as
+    select distinct on (seed.id)
+           seed.id            as seed_id,
+           seed.name          as name,
+           seed.is_active     as seed_live,
+           seed.department_id as seed_room,
+           real.id            as portal_id
+      from public.courses seed
+      join public.courses real
+        on real.name = seed.name
+       and real.external_id is not null
+       and real.id <> seed.id
+     where seed.external_id is null
+     order by seed.id, real.is_active desc, real.id;
+
+  -- Nothing below is news to anybody (see the migration header). The flag
+  -- is what every import door sets and what the outbox, the pushes and the
+  -- guards read; the triggers that do not read it -- the schedule-change
+  -- stamp among them -- are switched off, on exactly the tables that carry
+  -- one. Both sets are read from the catalogue.
+  perform set_config('app.portal_import', '1', true);
+  select coalesce(array_agg(distinct c.conrelid::regclass), '{}')
+    into locked
+    from pg_constraint c
+    join pg_trigger t on t.tgrelid = c.conrelid and not t.tgisinternal
+   where c.contype = 'f' and c.confrelid = 'public.courses'::regclass;
+  foreach tbl in array locked loop
+    execute format('alter table %s disable trigger user', tbl);
+  end loop;
+
+  -- Plain moves: nothing on these tables is unique by course. One
+  -- statement per table, so the big one is read once, not once per pair.
+  update public.session_requests s set course_id = t.portal_id
+    from course_twins t where s.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('session_requests', n);
+
+  update public.booking_rules b set course_id = t.portal_id
+    from course_twins t where b.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('booking_rules', n);
+
+  update public.conversations c set course_id = t.portal_id
+    from course_twins t where c.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('conversations', n);
+
+  update public.announcements a set course_id = t.portal_id
+    from course_twins t where a.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('announcements', n);
+
+  update public.portal_attendance a set course_id = t.portal_id
+    from course_twins t where a.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('portal_attendance', n);
+
+  update public.portal_mismatches m set course_id = t.portal_id
+    from course_twins t where m.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('portal_mismatches', n);
+
+  -- Moves guarded by each table's own key: a row the portal twin already
+  -- has stays on the retired row and is counted as left behind.
+  update public.student_courses sc set course_id = t.portal_id
+    from course_twins t
+   where sc.course_id = t.seed_id
+     and not exists (select 1 from public.student_courses p
+                      where p.student_id = sc.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('student_courses', n);
+
+  update public.routing_rules rr set course_id = t.portal_id
+    from course_twins t
+   where rr.course_id = t.seed_id
+     and not exists (select 1 from public.routing_rules p
+                      where p.course_id = t.portal_id
+                        and p.school_id   is not distinct from rr.school_id
+                        and p.grade_level is not distinct from rr.grade_level);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('routing_rules', n);
+
+  -- (course, grade, label), nulls not distinct: a year-11 Vectors beside an
+  -- all-years Vectors is two topics, not one.
+  update public.course_topics ct set course_id = t.portal_id
+    from course_twins t
+   where ct.course_id = t.seed_id
+     and not exists (select 1 from public.course_topics p
+                      where p.course_id = t.portal_id
+                        and p.grade_level is not distinct from ct.grade_level
+                        and p.label = ct.label);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('course_topics', n);
+
+  update public.department_hours dh set course_id = t.portal_id
+    from course_twins t
+   where dh.course_id = t.seed_id
+     and not exists (select 1 from public.department_hours p
+                      where p.course_id = t.portal_id
+                        and p.weekday = dh.weekday
+                        and p.open_minutes = dh.open_minutes
+                        and p.kind = dh.kind);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('department_hours', n);
+
+  -- One OPEN request per student and course; a decided one moves freely.
+  update public.enrolment_change_requests e set course_id = t.portal_id
+    from course_twins t
+   where e.course_id = t.seed_id
+     and not (e.status = 'pending'
+              and exists (select 1 from public.enrolment_change_requests p
+                           where p.student_id = e.student_id
+                             and p.course_id = t.portal_id
+                             and p.status = 'pending'));
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('enrolment_change_requests', n);
+
+  -- First-course history: where both twins hold a day, the portal row
+  -- takes the earlier; where only the seed does, the row moves.
+  update public.student_course_first p
+     set first_on        = least(p.first_on, s.first_on),
+         portal_first_on = least(p.portal_first_on, s.portal_first_on)
+    from public.student_course_first s
+    join course_twins t on t.seed_id = s.course_id
+   where p.course_id = t.portal_id
+     and p.student_id = s.student_id;
+  update public.student_course_first s set course_id = t.portal_id
+    from course_twins t
+   where s.course_id = t.seed_id
+     and not exists (select 1 from public.student_course_first p
+                      where p.student_id = s.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('student_course_first', n);
+
+  -- One notebook per student and course (20261013152316): a student who
+  -- already has one on the portal twin keeps it; the seed's stays behind.
+  update public.lesson_notebooks ln set course_id = t.portal_id
+    from course_twins t
+   where ln.course_id = t.seed_id
+     and not exists (select 1 from public.lesson_notebooks p
+                      where p.student_id = ln.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('lesson_notebooks', n);
+
+  -- One materials mapping per course: a twin already mapped keeps its own.
+  update public.lesson_course_materials lm set course_id = t.portal_id
+    from course_twins t
+   where lm.course_id = t.seed_id
+     and not exists (select 1 from public.lesson_course_materials p
+                      where p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('lesson_course_materials', n);
+
+  -- The seed row's default room, only where the portal row has none.
+  update public.courses c set department_id = t.seed_room
+    from course_twins t
+   where c.id = t.portal_id and c.department_id is null and t.seed_room is not null;
+  get diagnostics rooms = row_count;
+
+  -- A live course must still have a live row: a portal twin somebody
+  -- switched off by hand (the twins were the symptom) comes back when the
+  -- seed row it replaces was the live one. The sync never writes is_active.
+  update public.courses c set is_active = true
+    from course_twins t
+   where c.id = t.portal_id and t.seed_live and not c.is_active;
+  get diagnostics revived = row_count;
+
+  update public.courses c set is_active = false
+    from course_twins t
+   where c.id = t.seed_id and c.is_active;
+  get diagnostics retired = row_count;
+  select coalesce(array_agg(t.name order by t.name), '{}') into names
+    from course_twins t where t.seed_live;
+
+  foreach tbl in array locked loop
+    execute format('alter table %s enable trigger user', tbl);
+  end loop;
+
+  -- What stayed behind on the rows this run retired, by table, so the
+  -- notice in the release log says it rather than leaving it to be found.
+  select coalesce(jsonb_object_agg(x.tbl, x.n) filter (where x.n > 0), '{}'::jsonb)
+    into skipped
+    from (
+      select 'student_courses' as tbl, count(*) as n
+        from public.student_courses r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'routing_rules', count(*)
+        from public.routing_rules r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'course_topics', count(*)
+        from public.course_topics r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'department_hours', count(*)
+        from public.department_hours r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'enrolment_change_requests', count(*)
+        from public.enrolment_change_requests r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'student_course_first', count(*)
+        from public.student_course_first r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'lesson_notebooks', count(*)
+        from public.lesson_notebooks r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'lesson_course_materials', count(*)
+        from public.lesson_course_materials r join course_twins t on t.seed_id = r.course_id
+    ) x;
+
+  drop table pg_temp.course_twins;
+
+  return jsonb_build_object(
+    'retired',       retired,
+    'names',         to_jsonb(names),
+    'revived',       revived,
+    'rooms_carried', rooms,
+    'moved',         moved,
+    'left_on_retired_rows', skipped
+  );
+end;
+$function$;
+
+notify pgrst, 'reload schema';
