+create function pg_temp.booking(p_id uuid) returns public.session_requests
+language sql stable as $$
+  select * from public.session_requests where id = p_id
+$$;
+
+-- Where the listeners stand, so "quiet" is measured rather than assumed.
+create temp table marks (what text, pushes bigint, outbox bigint);
+create function pg_temp.mark(p_what text) returns void language sql as $$
+  insert into marks
+  select p_what, (select count(*) from net.http_request_queue),
+         (select count(*) from public.sync_outbox)
+$$;
+create function pg_temp.quiet_since(p_what text) returns boolean language sql stable as $$
+  select (select count(*) from net.http_request_queue) = m.pushes
+     and (select count(*) from public.sync_outbox) = m.outbox
+    from marks m where m.what = p_what
+$$;
+select pg_temp.mark('before join');
+
+-- ---------------------------------------------------------------------------
+-- lesson_join: the learner, in the window, in a room that is on.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank, the host
+select test_ok(
+  'the teacher cannot join as the learner',
