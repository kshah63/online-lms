+);
+select test_ok(
+  'and pushed nobody and told the portal nothing',
+  pg_temp.quiet_since('before join')
+);
+select test_ok(
+  'the quiet flag did not walk out of the join',
+  coalesce(current_setting('app.push_quiet', true), '') = ''
+);
+
+-- ---------------------------------------------------------------------------
+-- lesson_room_state: one row for a seat, none without.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('22222222-2222-2222-2222-222222222222');   -- Ben
+select test_ok(
+  'the learner reads the room: the people by name, the room, the consents, a notebook',
+  (select s.seat = 'learner'
+          and s.student_name = 'Ben Ashford'
+          and s.teacher_name = 'Frank Teach'
+          and s.department_name = 'Mathematics'
+          and s.course_name = 'IB Math AA HL'
+          and s.room_opened_at is not null
+          and s.arrived_at is not null
+          and s.notebook_id is not null
+          and s.consents = '{"recording": false, "transcript": false, "ai_analysis": false, "integrity_camera": false}'::jsonb
+     from public.lesson_room_state('ab1e5502-0000-0000-0000-000000000001') s)
+);
+select test_ok(
+  'the notebook is the student''s for this course, made on first open',
+  exists (select 1 from public.lesson_notebooks n
+           where n.student_id = '22222222-2222-2222-2222-222222222222'
+             and n.course_id = 'cccccccc-0000-0000-0000-0000000000fa'
+             and n.id = (select notebook_id
+                           from public.lesson_room_state('ab1e5502-0000-0000-0000-000000000001')))
+);
+select test_ok(
+  'a room that is off has no state for the learner',
+  not exists (select 1 from public.lesson_room_state('ab1e5502-0000-0000-0000-000000000002'))
+);
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank
+select test_ok(
+  'the host reads the same room with the same notebook',
+  (select s.seat = 'host' and s.notebook_id is not null
+     from public.lesson_room_state('ab1e5502-0000-0000-0000-000000000001') s)
+  and (select count(*) from public.lesson_notebooks n
+        where n.student_id = '22222222-2222-2222-2222-222222222222'
+          and n.course_id = 'cccccccc-0000-0000-0000-0000000000fa') = 1
+);
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin
+select test_ok(
+  'the in-charge observes',
+  (select s.seat = 'observer'
+     from public.lesson_room_state('ab1e5502-0000-0000-0000-000000000001') s)
+);
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada
+select test_ok(
+  'a parent gets no room state',
+  not exists (select 1 from public.lesson_room_state('ab1e5502-0000-0000-0000-000000000001'))
+);
+select act_as('33333333-3333-3333-3333-333333333333');   -- Cleo
+select test_ok(
