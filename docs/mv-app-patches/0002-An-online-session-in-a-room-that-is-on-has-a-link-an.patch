+-- ---------------------------------------------------------------------------
+-- The room writes arrival and departure onto the booking, and nothing else
+-- (migration 20261013152316; online-lms/docs/INTEGRATION.md, "Attendance
+-- write-back")
+--
+-- The learner's own join stamps arrived_at and clears no_show, through every
+-- BEFORE UPDATE guard on session_requests, as the student, quietly; the host
+-- or the in-charge ends it with departed_at and the transcript, and the
+-- booking's status is never theirs to move. The webhook door is the service
+-- role's and writes the same two columns and the room's own clock. Every
+-- reader is a role a policy already admits -- the assigned teacher, the
+-- room's in-charge, an admin -- and a family, a sibling, a parent in another
+-- family, a teacher who is not assigned and the support desk read nothing.
+-- ---------------------------------------------------------------------------
+begin;
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+
+update public.edge_config set room_url = 'https://room.test' where id = 1;
+insert into public.lesson_platform_rooms (department_id)
+values ('dddddddd-0000-0000-0000-0000000000fc')
+on conflict (department_id) do nothing;
+update public.department_members set is_incharge = true
+ where department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+   and user_id = '55555555-5555-5555-5555-555555555555';
+
+create function pg_temp.fam() returns uuid language sql stable as $$
+  select family_id from public.profiles where id = '11111111-1111-1111-1111-111111111111'
+$$;
