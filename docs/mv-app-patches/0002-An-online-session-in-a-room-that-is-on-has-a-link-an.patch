+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank
+select public.log_lesson_event('ab1e5502-0000-0000-0000-000000000001', 'teacher_note',
+                               '{"text": "struggled with dot products"}');
+select test_ok(
+  'an event kind is at most forty characters',
+  raises_matching($$select public.log_lesson_event('ab1e5502-0000-0000-0000-000000000001',
+                     'a_kind_that_goes_on_and_on_and_on_and_on_1')$$, 'forty')
+);
+select act_as('33333333-3333-3333-3333-333333333333');   -- Cleo
+select test_ok(
+  'no seat, no event',
