+  select pg_temp.sees('lesson_metrics') = 0 and pg_temp.sees('lesson_feedback') = 0
+     and pg_temp.sees('lesson_report_drafts') = 0 and pg_temp.sees('lesson_followups') = 0
+     and pg_temp.sees('lesson_recordings') = 0
+$$;
