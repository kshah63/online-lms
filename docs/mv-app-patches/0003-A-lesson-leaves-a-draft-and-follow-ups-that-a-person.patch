+-- ---------------------------------------------------------------------------
+-- A lesson leaves a draft and follow-ups that a person approves.
+--
+-- Stage 3 of the lesson platform (online-lms/docs/INTEGRATION.md, "Reports"
+-- and "Follow-ups and notifications"): what the lesson-finalize function
+-- computes once a lesson has ended, and the one way any of it reaches a
+-- family or a task list -- through a person with the role the app already
+-- gives them, by the door that role already has.
+--
+-- WHAT THE WORKER WRITES. lesson_metrics (talk time, questions, wait time),
+-- lesson_feedback (the teacher's own coaching, never a family's business),
+-- lesson_report_drafts (a proposal in submit_report's shape; the table is
+-- 20261013152316's, this wires its push), lesson_followups (wins, concerns,
+-- misconceptions, logistics, exams, things to relay, tech trouble -- each
+-- with an action and a quote). lesson_recordings is the recording
+-- pipeline's. ai_usage is the model bill, an admin's to read. All of it
+-- lands through worker_store_lesson_results, service role only, which is
+-- quiet (app.push_quiet) when the caller says the lesson is old news.
+--
+-- NOTHING REACHES A FAMILY ON ITS OWN. A follow-up is proposed, and stays
+-- proposed until approve_followup. The assigned teacher's yes only moves it
+-- to approved -- the in-charge sends. The in-charge of the room (or an
+-- admin) creates the thing: a message to the household from themselves as a
+-- person (start_family_direct, then messages with sender_id = auth.uid(),
+-- because there is no system sender and the household should see a name),
+-- a message_tasks row the way schedule_call_back files one, or a standing
+-- note through add_student_note for the next two lessons. Every created id
+-- is written back onto the row. The one exception is a concern: the worker
+-- files its task in the room's pool at once, because a wellbeing worry
+-- waits for nobody's approval queue -- and it is a staff call, never an
+-- automatic message.
+--
+-- WHO READS WHAT. Metrics, feedback, recordings: reads_lesson (the assigned
+-- teacher, the room's in-charge, an admin). Follow-ups: the same three,
+-- through decides_followup, which is also the gate on approving and
+-- dismissing one. Families read nothing here, except a recording once the
+-- household has consented to recording -- and then only their own. Never
+-- is_staff() alone.
+--
+-- PUSH. notify_push is wired to lesson_report_drafts INSERT (the teacher:
+-- "your draft is ready") and lesson_followups UPDATE OF status (the
+-- in-charge: a teacher said yes, send it). send-push grows its cases
+-- separately; until then it ignores tables it does not know.
+-- ---------------------------------------------------------------------------
+
+create table if not exists public.lesson_metrics (
+  session_id        uuid primary key references public.session_requests (id) on delete cascade,
+  teacher_talk_pct  real,
+  student_talk_pct  real,
+  question_count    integer,
+  open_question_pct real,
+  avg_wait_ms       integer,
+  student_turns     integer,
+  praise_count      integer,
+  computed_at       timestamptz not null default now()
+);
+
+comment on table public.lesson_metrics is
+  'What the transcript measures about a lesson: who talked, how many '
+  'questions, how long the teacher waited. Written by lesson-finalize '
+  'through worker_store_lesson_results; read by the teacher, the room''s '
+  'in-charge and admins.';
+
+create table if not exists public.lesson_feedback (
+  session_id       uuid primary key references public.session_requests (id) on delete cascade,
+  teacher_id       uuid references public.profiles (id) on delete set null,
+  summary          text,
+  strengths        jsonb,
+  suggestions      jsonb,
+  dimension_scores jsonb,
+  moments          jsonb,
+  created_at       timestamptz not null default now()
+);
+
+comment on table public.lesson_feedback is
+  'Coaching feedback on how the lesson was taught, for the teacher who '
+  'taught it. Never a family''s to read.';
+
+create table if not exists public.lesson_recordings (
+  session_id            uuid primary key references public.session_requests (id) on delete cascade,
+  provider_recording_id text,
+  storage_path          text,
+  duration_s            integer,
+  recorded_at           timestamptz,
+  expires_at            timestamptz,
+  deleted_at            timestamptz
+);
+
+comment on table public.lesson_recordings is
+  'The recording of a lesson, where it is kept and until when. Written by '
+  'the recording pipeline (service role). A household reads its own once '
+  'the recording consent is in force.';
+
+create table if not exists public.lesson_followups (
+  id                       uuid primary key default gen_random_uuid(),
+  session_id               uuid not null references public.session_requests (id) on delete cascade,
+  student_id               uuid references public.profiles (id) on delete set null,
+  family_id                uuid references public.families (id) on delete set null,
+  department_id            uuid references public.departments (id) on delete set null,
+  kind                     text not null check (kind in ('win', 'concern', 'misconception', 'logistics',
+                                                         'exam_upcoming', 'ask_to_relay', 'tech_issue')),
+  action                   text not null check (action in ('share_with_parent', 'staff_task',
+                                                           'note_for_next_lesson', 'staff_call')),
+  priority                 text not null default 'normal' check (priority in ('low', 'normal', 'high')),
+  title                    text,
+  detail                   text,
+  quote                    text,
+  at_ms                    integer,
+  suggested_parent_message text,
+  status                   text not null default 'proposed'
+                           check (status in ('proposed', 'approved', 'dismissed', 'done')),
+  decided_by               uuid references public.profiles (id) on delete set null,
+  decided_at               timestamptz,
+  message_task_id          uuid references public.message_tasks (id) on delete set null,
+  note_id                  uuid references public.student_notes (id) on delete set null,
+  message_id               uuid references public.messages (id) on delete set null,
+  created_at               timestamptz not null default now()
+);
+
+comment on table public.lesson_followups is
+  'What the lesson transcript suggests somebody should do next, proposed by '
+  'lesson-finalize and decided by a person: the teacher''s yes moves it to '
+  'approved, the room''s in-charge (or an admin) sends it -- a message to '
+  'the household, a task, or a note -- and the created id is written back. '
+  'A concern files its task at once.';
+
+create index if not exists lesson_followups_session_idx
+  on public.lesson_followups (session_id);
+create index if not exists lesson_followups_queue_idx
+  on public.lesson_followups (department_id, status, created_at desc);
+
+create table if not exists public.ai_usage (
+  id         bigserial primary key,
+  user_id    uuid references public.profiles (id) on delete set null,
+  kind       text,
+  model      text,
+  tokens_in  integer,
+  tokens_out integer,
+  session_id uuid,
+  at         timestamptz not null default now()
+);
+
+comment on table public.ai_usage is
+  'One row per model call the edge functions make, for the bill. Written by '
+  'the service role; an admin''s to read.';
+
+alter table public.lesson_metrics    enable row level security;
+alter table public.lesson_feedback   enable row level security;
+alter table public.lesson_recordings enable row level security;
+alter table public.lesson_followups  enable row level security;
+alter table public.ai_usage          enable row level security;
+
+-- A stranger with the publishable key holds no write on any of these
+-- (20260901060458): the default grant to anon is taken back on every new
+-- table.
+revoke insert, update, delete, truncate, references, trigger on public.lesson_metrics    from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_feedback   from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_recordings from anon;
+revoke insert, update, delete, truncate, references, trigger on public.lesson_followups  from anon;
+revoke insert, update, delete, truncate, references, trigger on public.ai_usage          from anon;
+
+-- The service role writes the bill directly, so it needs the sequence too
+-- (the way sync_outbox_id_seq is granted in 20260728000700): a project's
+-- default privileges hand it out, a scratch database's do not.
+grant usage, select on sequence public.ai_usage_id_seq to service_role;
+
+-- ---------------------------------------------------------------------------
+-- decides_followup: the assigned teacher of the session, the in-charge of
+-- the room the follow-up sits in, an admin. The read policy and both doors
+-- ask this one function.
+-- ---------------------------------------------------------------------------
+create or replace function public.decides_followup(p_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select exists (
+    select 1
+      from public.lesson_followups f
+      join public.session_requests s on s.id = f.session_id
+     where f.id = p_id
+       and uid is not null
+       and (s.assigned_teacher_id = uid
+            or public.is_admin(uid)
+            or (f.department_id is not null
+                and public.is_incharge_of(f.department_id, uid)))
+  );
+$$;
+
+comment on function public.decides_followup(uuid, uuid) is
+  'Who reads, approves or dismisses a follow-up: the session''s assigned '
+  'teacher, the in-charge of the room it sits in, an admin.';
+
+revoke all on function public.decides_followup(uuid, uuid) from public;
+grant execute on function public.decides_followup(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Policies: reads only. Every write is a door below, or the service role's.
+-- ---------------------------------------------------------------------------
+drop policy if exists lesson_metrics_select on public.lesson_metrics;
+create policy lesson_metrics_select on public.lesson_metrics
+  for select to authenticated using (public.reads_lesson(session_id));
+
+drop policy if exists lesson_feedback_select on public.lesson_feedback;
+create policy lesson_feedback_select on public.lesson_feedback
+  for select to authenticated using (public.reads_lesson(session_id));
+
+-- The household's one read in this migration: its own lesson's recording,
+-- while the recording consent for that child is in force.
+drop policy if exists lesson_recordings_select on public.lesson_recordings;
+create policy lesson_recordings_select on public.lesson_recordings
+  for select to authenticated using (
+    public.reads_lesson(session_id)
+    or exists (
+      select 1
+        from public.session_requests s
+        join public.profiles me on me.id = auth.uid()
+       where s.id = lesson_recordings.session_id
+         and s.family_id is not null
+         and me.family_id = s.family_id
+         and exists (select 1 from public.lesson_consents c
+                      where c.student_id = s.student_id
+                        and c.kind = 'recording'
+                        and c.revoked_at is null)
+    )
+  );
+
+drop policy if exists lesson_followups_select on public.lesson_followups;
+create policy lesson_followups_select on public.lesson_followups
+  for select to authenticated using (public.decides_followup(id));
+
+drop policy if exists ai_usage_select on public.ai_usage;
+create policy ai_usage_select on public.ai_usage
+  for select to authenticated using (public.is_admin());
+
+-- ---------------------------------------------------------------------------
+-- worker_store_lesson_results: lesson-finalize's one write, service role.
+--
+-- p_metrics, p_feedback and p_draft are objects or null (null leaves that
+-- table alone); p_followups is an array of {kind, action, priority, title,
+-- detail, quote, at_ms, suggested_parent_message}. A second run for the
+-- same lesson replaces the metrics, the feedback and the draft, and leaves
+-- the follow-ups it already proposed alone -- a retry must not propose
+-- everything twice, and a concern's task has already been filed.
+-- ---------------------------------------------------------------------------
+create or replace function public.worker_store_lesson_results(
+  p_session_id uuid,
+  p_metrics jsonb,
+  p_feedback jsonb,
+  p_draft jsonb,
+  p_draft_rationale text,
+  p_draft_source text,
+  p_followups jsonb,
+  p_quiet boolean default false)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  s       public.session_requests%rowtype;
+  v_quiet text;
+  r       jsonb;
+  v_id    uuid;
+  v_task  uuid;
+begin
+  select * into s from public.session_requests x where x.id = p_session_id;
+  if s.id is null then
+    raise exception 'no such session' using errcode = 'P0002';
+  end if;
+
+  -- Old news stays quiet toward phones; saved and restored, not cleared.
+  v_quiet := coalesce(current_setting('app.push_quiet', true), '');
+  if p_quiet then
+    perform set_config('app.push_quiet', '1', true);
+  end if;
+
+  if jsonb_typeof(p_metrics) = 'object' then
+    insert into public.lesson_metrics
+      (session_id, teacher_talk_pct, student_talk_pct, question_count,
+       open_question_pct, avg_wait_ms, student_turns, praise_count, computed_at)
+    values
+      (p_session_id,
+       (p_metrics->>'teacher_talk_pct')::real,
+       (p_metrics->>'student_talk_pct')::real,
+       (p_metrics->>'question_count')::integer,
+       (p_metrics->>'open_question_pct')::real,
+       (p_metrics->>'avg_wait_ms')::integer,
+       (p_metrics->>'student_turns')::integer,
+       (p_metrics->>'praise_count')::integer,
+       now())
+    on conflict (session_id) do update
+      set teacher_talk_pct  = excluded.teacher_talk_pct,
+          student_talk_pct  = excluded.student_talk_pct,
+          question_count    = excluded.question_count,
+          open_question_pct = excluded.open_question_pct,
+          avg_wait_ms       = excluded.avg_wait_ms,
+          student_turns     = excluded.student_turns,
+          praise_count      = excluded.praise_count,
+          computed_at       = excluded.computed_at;
+  end if;
+
+  if jsonb_typeof(p_feedback) = 'object' then
+    insert into public.lesson_feedback
+      (session_id, teacher_id, summary, strengths, suggestions, dimension_scores, moments)
+    values
+      (p_session_id, s.assigned_teacher_id,
+       p_feedback->>'summary', p_feedback->'strengths', p_feedback->'suggestions',
+       p_feedback->'dimension_scores', p_feedback->'moments')
+    on conflict (session_id) do update
+      set teacher_id       = excluded.teacher_id,
+          summary          = excluded.summary,
+          strengths        = excluded.strengths,
+          suggestions      = excluded.suggestions,
+          dimension_scores = excluded.dimension_scores,
+          moments          = excluded.moments;
+  end if;
+
+  if jsonb_typeof(p_draft) = 'object' then
+    -- The INSERT is what tells the teacher the draft is ready; a replaced
+    -- draft tells nobody twice.
+    insert into public.lesson_report_drafts (session_id, draft, rationale, source)
+    values (p_session_id, p_draft, p_draft_rationale, coalesce(p_draft_source, 'heuristic'))
+    on conflict (session_id) do update
+      set draft     = excluded.draft,
+          rationale = excluded.rationale,
+          source    = excluded.source;
+  end if;
+
+  if jsonb_typeof(p_followups) = 'array'
+     and not exists (select 1 from public.lesson_followups f where f.session_id = p_session_id) then
+    for r in select * from jsonb_array_elements(p_followups) loop
+      insert into public.lesson_followups
+        (session_id, student_id, family_id, department_id, kind, action, priority,
+         title, detail, quote, at_ms, suggested_parent_message)
+      values
+        (p_session_id, s.student_id, s.family_id, s.department_id,
+         r->>'kind', r->>'action', coalesce(r->>'priority', 'normal'),
+         r->>'title', r->>'detail', r->>'quote', (r->>'at_ms')::integer,
+         r->>'suggested_parent_message')
+      returning id into v_id;
+
+      -- A concern waits for nobody: a task in the room's pool, from the
+      -- teacher who taught the lesson, the way schedule_call_back files one.
+      -- A lesson with no room has no pool; the row stays proposed for an
+      -- admin to decide.
+      if r->>'kind' = 'concern' and s.department_id is not null then
+        insert into public.message_tasks
+          (department_id, assigned_by, student_id, family_id, note, due_at)
+        values
+          (s.department_id, s.assigned_teacher_id, s.student_id, s.family_id,
+           concat_ws(' — ', nullif(btrim(coalesce(r->>'title', '')), ''),
+                             nullif(btrim(coalesce(r->>'detail', '')), ''))
+             || ' (AI-extracted from the lesson transcript; verify before acting)',
+           now() + interval '1 day')
+        returning id into v_task;
+        update public.lesson_followups set message_task_id = v_task where id = v_id;
+      end if;
+    end loop;
+  end if;
+
+  perform set_config('app.push_quiet', v_quiet, true);
+end;
+$$;
+
+comment on function public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean) is
+  'Service role only (lesson-finalize). Stores a lesson''s metrics, coaching '
+  'feedback, report draft and proposed follow-ups; a concern files a task in '
+  'the room''s pool at once. Quiet toward phones when p_quiet. Follow-ups '
+  'already proposed for the session are left as they are.';
+
+revoke all on function public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean)
+  from public, anon, authenticated;
+grant execute on function public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean)
+  to service_role;
+
+-- ---------------------------------------------------------------------------
+-- approve_followup: a person says yes.
+--
+-- The assigned teacher's yes moves a proposed row to approved and creates
+-- nothing; the room's in-charge or an admin creates the thing and the row
+-- is done. By action:
+--   share_with_parent     a thread with the household (start_family_direct,
+--                         whose can_message_family is the whole rule on who
+--                         may) and a message from the approver as a person,
+--                         prefixed with whose lesson it was; p_text is the
+--                         approver's edit of the suggested wording
+--   note_for_next_lesson  add_student_note, standing, for the next two
+--                         lessons (its own rule: the centre, never a family)
+--   anything else         a message_tasks row in the room's pool, or to
+--                         p_assignee, from the approver, due tomorrow
+-- A row that already carries its task (a concern) is marked done without a
+-- second one.
+-- ---------------------------------------------------------------------------
+create or replace function public.approve_followup(p_id uuid, p_text text default null, p_assignee uuid default null)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  f         public.lesson_followups%rowtype;
+  v_teacher uuid;
+  v_sends   boolean;
+  v_text    text;
+  v_first   text;
+  v_conv    public.conversations%rowtype;
+  v_note    public.student_notes%rowtype;
+  v_task    public.message_tasks%rowtype;
+  v_msg     uuid;
+begin
+  select * into f from public.lesson_followups x where x.id = p_id;
+  if f.id is null then
+    raise exception 'no such follow-up' using errcode = 'P0002';
+  end if;
+  if not public.decides_followup(p_id) then
+    raise exception 'this follow-up is not yours to decide' using errcode = '42501';
+  end if;
+  if f.status not in ('proposed', 'approved') then
+    raise exception 'this follow-up has already been decided' using errcode = '22023';
+  end if;
+
+  select s.assigned_teacher_id into v_teacher
+    from public.session_requests s where s.id = f.session_id;
+  v_sends := public.is_admin()
+             or (f.department_id is not null and public.is_incharge_of(f.department_id));
+  v_text  := nullif(btrim(coalesce(p_text, '')), '');
+
+  if not v_sends then
+    -- The teacher's yes. The status change is what tells the in-charge.
+    if f.status <> 'approved' then
+      update public.lesson_followups
+         set status = 'approved', decided_by = auth.uid(), decided_at = now()
+       where id = p_id;
+    end if;
+    return;
+  end if;
+
+  if f.action = 'share_with_parent' then
+    if f.family_id is null then
+      raise exception 'this lesson has no household to share with' using errcode = '22023';
+    end if;
+    select split_part(public.display_name(p.full_name, p.preferred_name), ' ', 1)
+      into v_first
+      from public.profiles p where p.id = v_teacher;
+
+    -- The household thread. can_message_family inside is the one rule on
+    -- who may open one; a stranger to the family is refused there with its
+    -- own words. The child is passed so the thread is tagged whenever the
+    -- door tags one (it does so only when a person is named or seats are
+    -- chosen; the household thread itself stays untagged and seats everyone).
+    select * into v_conv
+      from public.start_family_direct(
+             f.family_id, coalesce(f.title, 'From the lesson'), null,
+             case when f.student_id is null then null else array[f.student_id] end, null);
+
+    -- The message is the approver's own, under the same rules the thread
+    -- holds anybody to.
+    if not public.is_approved() or not public.can_access_conversation(v_conv.id) then
+      raise exception 'you cannot write in that thread' using errcode = '42501';
+    end if;
+    insert into public.messages (conversation_id, sender_id, body)
+    values (v_conv.id, auth.uid(),
+            case when v_first is not null then 'From ' || v_first || '''s lesson today: '
+                 else 'From today''s lesson: ' end
+            || coalesce(v_text, nullif(btrim(coalesce(f.suggested_parent_message, '')), ''),
+                        concat_ws(' — ', f.title, f.detail)))
+    returning id into v_msg;
+
+    update public.lesson_followups
+       set message_id = v_msg, status = 'done', decided_by = auth.uid(), decided_at = now()
+     where id = p_id;
+
+  elsif f.action = 'note_for_next_lesson' then
+    if f.student_id is null then
+      raise exception 'this lesson names no student to write a note about' using errcode = '22023';
+    end if;
+    select * into v_note
+      from public.add_student_note(
+             left(coalesce(v_text, concat_ws(' — ', f.title, f.detail)), 2000),
+             f.student_id, null, null, null, 2);
+
+    update public.lesson_followups
+       set note_id = v_note.id, status = 'done', decided_by = auth.uid(), decided_at = now()
+     where id = p_id;
+
+  else
+    if f.message_task_id is null then
+      if p_assignee is not null and not exists (
+        select 1
+          from public.profiles p
+         where p.id = p_assignee
+           and p.role = 'staff'
+           and exists (select 1
+                         from public.department_members dm
+                         join public.departments d on d.id = dm.department_id
+                        where dm.user_id = p.id and d.kind = 'academic')
+      ) then
+        raise exception 'tasks go to an in-charge' using errcode = '42501';
+      end if;
+      if p_assignee is null and f.department_id is null then
+        raise exception 'this lesson has no room for the task to wait in; name an in-charge'
+          using errcode = '22023';
+      end if;
+
+      insert into public.message_tasks
+        (department_id, assigned_to, assigned_by, student_id, family_id, note, due_at)
+      values
+        (case when p_assignee is null then f.department_id end, p_assignee, auth.uid(),
+         f.student_id, f.family_id,
+         coalesce(v_text, concat_ws(' — ', f.title, f.detail))
+           || ' (AI-extracted from the lesson transcript; verify before acting)',
+         now() + interval '1 day')
+      returning * into v_task;
+
+      update public.lesson_followups set message_task_id = v_task.id where id = p_id;
+    end if;
+
+    update public.lesson_followups
+       set status = 'done', decided_by = auth.uid(), decided_at = now()
+     where id = p_id;
+  end if;
+end;
+$$;
+
+comment on function public.approve_followup(uuid, text, uuid) is
+  'Says yes to a proposed follow-up. The session''s teacher only moves it to '
+  'approved; the room''s in-charge or an admin creates the thing -- a message '
+  'to the household from themselves, a task (in the room''s pool, or to '
+  'p_assignee), or a standing note for the next two lessons -- writes its id '
+  'back and marks the row done. p_text is the approver''s wording.';
+
+revoke all on function public.approve_followup(uuid, text, uuid) from public;
+grant execute on function public.approve_followup(uuid, text, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- dismiss_followup: the same three people say no.
+-- ---------------------------------------------------------------------------
+create or replace function public.dismiss_followup(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_status text;
+begin
+  select f.status into v_status from public.lesson_followups f where f.id = p_id;
+  if v_status is null then
+    raise exception 'no such follow-up' using errcode = 'P0002';
+  end if;
+  if not public.decides_followup(p_id) then
+    raise exception 'this follow-up is not yours to decide' using errcode = '42501';
+  end if;
+  if v_status not in ('proposed', 'approved') then
+    raise exception 'this follow-up has already been decided' using errcode = '22023';
+  end if;
+
+  update public.lesson_followups
+     set status = 'dismissed', decided_by = auth.uid(), decided_at = now()
+   where id = p_id;
+end;
+$$;
+
+comment on function public.dismiss_followup(uuid) is
+  'Says no to a proposed or approved follow-up: the session''s teacher, the '
+  'room''s in-charge or an admin. A task a concern already filed stays filed.';
+
+revoke all on function public.dismiss_followup(uuid) from public;
+grant execute on function public.dismiss_followup(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Push. Two more pairs on notify_push, the way every other table carries it
+-- (20260809000100): AFTER, FOR EACH ROW. The draft's arrival is news to the
+-- teacher; a follow-up's status moving is news to the room's in-charge.
+-- ---------------------------------------------------------------------------
+drop trigger if exists push_lesson_report_drafts_insert on public.lesson_report_drafts;
+create trigger push_lesson_report_drafts_insert
+  after insert on public.lesson_report_drafts
+  for each row execute function public.notify_push();
+
+drop trigger if exists push_lesson_followups_update on public.lesson_followups;
+create trigger push_lesson_followups_update
+  after update of status on public.lesson_followups
+  for each row execute function public.notify_push();
+
+notify pgrst, 'reload schema';
diff --git a/supabase/probes/20261013155425.sql b/supabase/probes/20261013155425.sql
new file mode 100644
index 0000000..9613a91
--- /dev/null
+++ b/supabase/probes/20261013155425.sql
@@ -0,0 +1,83 @@
+  -- What the worker leaves behind is there, row-secured, and readable only
+  -- through a policy that names a role.
+  select '20261013155425', 'a lesson leaves a draft and follow ups that a person approves',
+         'lesson_metrics, lesson_feedback, lesson_recordings, lesson_followups and ai_usage exist with RLS on and a select policy each; anon holds no write on any',
+         (select count(*) = 5 and bool_and(c.relrowsecurity)
+                 and bool_and(exists (select 1 from pg_policy p
+                                       where p.polrelid = c.oid and p.polcmd = 'r'))
+                 and bool_and(not has_table_privilege('anon', c.oid, 'insert')
+                              and not has_table_privilege('anon', c.oid, 'update')
+                              and not has_table_privilege('anon', c.oid, 'delete'))
+            from pg_class c
+            join pg_namespace n on n.oid = c.relnamespace
+           where n.nspname = 'public'
+             and c.relname in ('lesson_metrics', 'lesson_feedback', 'lesson_recordings',
+                               'lesson_followups', 'ai_usage'))
+           and to_regprocedure('public.decides_followup(uuid, uuid)') is not null
+
+  union all
+
+  -- The draft refuses what the report form would: a tenth prev_hw string
+  -- (the list is closed at nine) and an OTR of 83 (bands of five, 5..95).
+  select '20261013155425', 'a lesson leaves a draft and follow ups that a person approves',
+         'lesson_report_drafts_prev_hw_check admits exactly nine strings and lesson_report_drafts_otr_check only multiples of five between 5 and 95, so a tenth string and an OTR of 83 are refused',
+         coalesce((select (select count(*)
+                             from regexp_matches(substring(pg_get_constraintdef(oid) from 'ARRAY\[(.*)\]'),
+                                                 '::text', 'g')) = 9
+                     from pg_constraint
+                    where conname = 'lesson_report_drafts_prev_hw_check'
+                      and conrelid = to_regclass('public.lesson_report_drafts')), false)
+           and coalesce((select pg_get_constraintdef(oid) like '%>= 5%'
+                             and pg_get_constraintdef(oid) like '%<= 95%'
+                             and pg_get_constraintdef(oid) like '%% 5) = 0%'
+                           from pg_constraint
+                          where conname = 'lesson_report_drafts_otr_check'
+                            and conrelid = to_regclass('public.lesson_report_drafts')), false)
+
+  union all
+
+  -- The two new push pairs, wired the way every other one is: AFTER, FOR
+  -- EACH ROW, onto notify_push -- and the follow-up one scoped to status
+  -- alone, so writing an id back onto a row posts nothing.
+  select '20261013155425', 'a lesson leaves a draft and follow ups that a person approves',
+         'push_lesson_report_drafts_insert (AFTER INSERT) and push_lesson_followups_update (AFTER UPDATE OF status only) run notify_push for each row',
+         exists (select 1 from pg_trigger t
+                  where t.tgrelid = to_regclass('public.lesson_report_drafts')
+                    and t.tgname = 'push_lesson_report_drafts_insert'
+                    and t.tgfoid = to_regprocedure('public.notify_push()')
+                    and not t.tgisinternal and t.tgenabled <> 'D'
+                    and (t.tgtype & 1) <> 0      -- row
+                    and (t.tgtype & 2) = 0       -- after
+                    and (t.tgtype & 4) <> 0      -- insert
+                    and (t.tgtype & 16) = 0)     -- not update
+           and exists (select 1 from pg_trigger t
+                        where t.tgrelid = to_regclass('public.lesson_followups')
+                          and t.tgname = 'push_lesson_followups_update'
+                          and t.tgfoid = to_regprocedure('public.notify_push()')
+                          and not t.tgisinternal and t.tgenabled <> 'D'
+                          and (t.tgtype & 1) <> 0
+                          and (t.tgtype & 2) = 0
+                          and (t.tgtype & 16) <> 0
+                          and (t.tgtype & 4) = 0
+                          and (select array_agg(a.attname::text)
+                                 from unnest(t.tgattr) k(k)
+                                 join pg_attribute a on a.attrelid = t.tgrelid and a.attnum = k.k)
+                              = array['status'])
+
+  union all
+
+  -- The doors: the worker is the service role's alone and knows how to be
+  -- quiet; a person approves or dismisses.
+  select '20261013155425', 'a lesson leaves a draft and follow ups that a person approves',
+         'worker_store_lesson_results is executable by service_role only and sets app.push_quiet; approve_followup and dismiss_followup are callable by authenticated',
+         has_function_privilege('service_role',
+             to_regprocedure('public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean)'), 'execute')
+           and not has_function_privilege('authenticated',
+             to_regprocedure('public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean)'), 'execute')
+           and not has_function_privilege('anon',
+             to_regprocedure('public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean)'), 'execute')
+           and coalesce((select prosrc like '%app.push_quiet%'
+                           from pg_proc
+                          where oid = to_regprocedure('public.worker_store_lesson_results(uuid, jsonb, jsonb, jsonb, text, text, jsonb, boolean)')), false)
+           and has_function_privilege('authenticated', to_regprocedure('public.approve_followup(uuid, text, uuid)'), 'execute')
+           and has_function_privilege('authenticated', to_regprocedure('public.dismiss_followup(uuid)'), 'execute')
