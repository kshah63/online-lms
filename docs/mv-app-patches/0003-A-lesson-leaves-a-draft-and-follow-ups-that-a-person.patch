index 0000000..15b5eba
--- /dev/null
+++ b/supabase/tests/rls/20261013155426-a_lesson_leaves_a_draft_and_follow_ups_that_a_person_approves.sql
@@ -0,0 +1,653 @@
+-- ---------------------------------------------------------------------------
+-- A lesson leaves a draft and follow-ups that a person approves
+-- (migration 20261013155425; online-lms/docs/INTEGRATION.md, "Reports" and
+-- "Follow-ups and notifications")
+--
+-- The worker's door is the service role's alone, and what it stores is read
+-- by the three people a policy already admits -- the assigned teacher, the
+-- room's in-charge, an admin -- and by nobody else: not a parent, not the
+-- child, not a teacher who was not assigned, not the desk. A recording is
+-- the one thing a household reads, and only once it has said yes to being
+-- recorded. The draft refuses a prev_hw the report form would not offer and
+-- an OTR that is not a band. Nothing a follow-up proposes reaches a family
+-- or a task list until a person approves it: the teacher's yes moves the
+-- row and creates nothing; the in-charge's yes creates a message from
+-- themselves, a task, or a note, under the rules those doors already hold
+-- (an unstarred in-charge cannot share with a family, a task cannot go to a
+-- teacher). A concern files its task at once. Every created id lands on the
+-- row, and a decided row is decided.
+-- ---------------------------------------------------------------------------
+begin;
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+
+update public.edge_config set room_url = 'https://room.test' where id = 1;
+insert into public.lesson_platform_rooms (department_id)
+values ('dddddddd-0000-0000-0000-0000000000fc')
+on conflict (department_id) do nothing;
+update public.department_members set is_incharge = true
+ where department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+   and user_id = '55555555-5555-5555-5555-555555555555';
+
+create function pg_temp.fam() returns uuid language sql stable as $$
+  select family_id from public.profiles where id = '11111111-1111-1111-1111-111111111111'
+$$;
+
+-- 01 Ben with Frank in Maths, ended an hour ago; 02 the same three days
+-- ago; 03 in Science, a day ago, for the draft's own constraints.
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes, arrived_at, departed_at)
+values
+  ('ab1e5503-0000-0000-0000-000000000001', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '2 hours', now() - interval '2 hours', 60,
+   now() - interval '2 hours', now() - interval '1 hour'),
+  ('ab1e5503-0000-0000-0000-000000000002', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '3 days', now() - interval '3 days', 60,
+   now() - interval '3 days', now() - interval '3 days' + interval '1 hour'),
+  ('ab1e5503-0000-0000-0000-000000000003', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Physics HL', 'Waves',
+   'cccccccc-0000-0000-0000-0000000000fc', 'dddddddd-0000-0000-0000-0000000000fd',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '1 day', now() - interval '1 day', 60,
+   now() - interval '1 day', now() - interval '1 day' + interval '1 hour');
+
+insert into public.lesson_recordings
+  (session_id, provider_recording_id, storage_path, duration_s, recorded_at, expires_at)
+values ('ab1e5503-0000-0000-0000-000000000001', 'rec-5503-1',
+        'lesson-recordings/ab1e5503-0000-0000-0000-000000000001.mp4', 3500,
+        now() - interval '1 hour', now() + interval '30 days');
+
+-- Definer, so a person under test can name a row the policy hides from
+-- them: the refusal under test is the door's, not the lookup's.
+create function pg_temp.followup(p_kind text, p_session uuid default 'ab1e5503-0000-0000-0000-000000000001')
+returns public.lesson_followups language sql stable security definer as $$
+  select * from public.lesson_followups where kind = p_kind and session_id = p_session
+$$;
+
+-- Where the listeners stand, so "quiet" is measured rather than assumed.
+create temp table marks (what text, pushes bigint);
+create function pg_temp.mark(p_what text) returns void language sql as $$
+  insert into marks select p_what, (select count(*) from net.http_request_queue)
+$$;
+create function pg_temp.quiet_since(p_what text) returns boolean language sql stable as $$
+  select (select count(*) from net.http_request_queue) = (select pushes from marks where what = p_what)
+$$;
+delete from net.http_request_queue;
+select pg_temp.mark('before the worker');
+
+-- ---------------------------------------------------------------------------
+-- The worker's door is the service role's.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal, admin
+select test_ok(
+  'an admin signed in through the app cannot store lesson results',
+  raises_matching($$select public.worker_store_lesson_results(
+                     'ab1e5503-0000-0000-0000-000000000001', null, null, null, null, null, null)$$,
+                  'permission denied')
+);
+set local role anon;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok(
+  'nor can a stranger',
+  raises_matching($$select public.worker_store_lesson_results(
+                     'ab1e5503-0000-0000-0000-000000000001', null, null, null, null, null, null)$$,
+                  'permission denied')
+);
+
+set local role service_role;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok(
+  'a lesson nobody booked has nothing to store against',
+  raises_matching($$select public.worker_store_lesson_results(
+                     'ab1e5503-0000-0000-0000-0000000000ff', null, null, null, null, null, null)$$,
+                  'no such session')
+);
+select public.worker_store_lesson_results(
+  'ab1e5503-0000-0000-0000-000000000001',
+  '{"teacher_talk_pct": 61.5, "student_talk_pct": 38.5, "question_count": 14,
+    "open_question_pct": 42.9, "avg_wait_ms": 2100, "student_turns": 31, "praise_count": 6}',
+  '{"summary": "Clear explanations; wait a beat longer after a question.",
+    "strengths": ["worked examples"], "suggestions": ["longer wait time"],
+    "dimension_scores": {"clarity": 4, "wait_time": 2}, "moments": []}',
+  '{"topic": "Vectors", "topic_completed": true, "understanding": 7, "otr": "85",
+    "prev_hw": "Yes", "homework": "Ex 4B q1-10", "remarks": "Ben worked steadily."}',
+  'understanding from 31 student turns and the oral check at 85%',
+  'ai',
+  '[{"kind": "win", "action": "share_with_parent", "priority": "normal",
+     "title": "Cracked the cross product", "detail": "Got every example right unaided",
+     "quote": "oh, I see it now", "at_ms": 1820000,
+     "suggested_parent_message": "Ben cracked the cross product today."},
+    {"kind": "misconception", "action": "note_for_next_lesson", "priority": "normal",
+     "title": "Mixed up dot and cross product", "detail": "Revisit next time"},
+    {"kind": "logistics", "action": "staff_task", "priority": "low",
+     "title": "Needs the Paper 2 formula booklet", "detail": "Did not have it on screen"},
+    {"kind": "concern", "action": "staff_call", "priority": "high",
+     "title": "Seemed very tired", "detail": "Said he had not slept before the exam week",
+     "quote": "I did not sleep", "at_ms": 600000},
+    {"kind": "exam_upcoming", "action": "staff_task", "priority": "normal",
+     "title": "Paper 1 mock on Friday", "detail": "Wants a past paper before then"}]',
+  false);
+
+set local role postgres;
+select test_ok(
+  'the metrics, the feedback (for the teacher who taught) and the draft are stored',
+  (select m.question_count = 14 and m.teacher_talk_pct = 61.5
+     from public.lesson_metrics m where m.session_id = 'ab1e5503-0000-0000-0000-000000000001')
+  and (select f.teacher_id = '66666666-6666-6666-6666-666666666666'
