diff --git a/supabase/tests/rls/20261013155426-a_lesson_leaves_a_draft_and_follow_ups_that_a_person_approves.sql b/supabase/tests/rls/20261013155426-a_lesson_leaves_a_draft_and_follow_ups_that_a_person_approves.sql
