+create function pg_temp.sees(p_what text) returns bigint language plpgsql stable as $$
+declare n bigint;
+begin
+  execute format('select count(*) from public.%I where session_id = %L',
+                 p_what, 'ab1e5503-0000-0000-0000-000000000001') into n;
+  return n;
+end;
+$$;
+create function pg_temp.sees_all() returns boolean language sql stable as $$
