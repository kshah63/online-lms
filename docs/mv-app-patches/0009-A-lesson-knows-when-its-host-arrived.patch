diff --git a/supabase/tests/rls/20261013174253-a_lesson_knows_when_its_host_arrived.sql b/supabase/tests/rls/20261013174253-a_lesson_knows_when_its_host_arrived.sql
new file mode 100644
index 0000000..2a6a4e9
--- /dev/null
+++ b/supabase/tests/rls/20261013174253-a_lesson_knows_when_its_host_arrived.sql
@@ -0,0 +1,145 @@
+-- ---------------------------------------------------------------------------
+-- A lesson knows when its host arrived
+-- (migration 20261013174253)
+--
+-- A student who arrives first opens the room; that is not a teacher being
+-- there. The host's own arrival is its own fact: said by the host alone
+-- (the student, a teacher who is not the host and the in-charge watching
+-- are refused), stamped once, and also stamped by Daily's word when the
+-- participant who joined is not the student. The no-join sweep reads it:
+-- a student waiting alone is "Teacher has not joined", a teacher waiting
+-- alone is "Student has not joined", each once.
+-- ---------------------------------------------------------------------------
+begin;
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+
+update public.edge_config set room_url = 'https://room.test' where id = 1;
+insert into public.lesson_platform_rooms (department_id)
+values ('dddddddd-0000-0000-0000-0000000000fc')
+on conflict (department_id) do nothing;
+update public.department_members set is_incharge = true
+ where department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+   and user_id = '55555555-5555-5555-5555-555555555555';
+
+create function pg_temp.hj_fam() returns uuid language sql stable as $$
+  select family_id from public.profiles where id = '11111111-1111-1111-1111-111111111111'
+$$;
+
+-- Three SAT Math lessons of Ben's with Frank in a room that is on: 01 and 02
+-- a quarter of an hour in (01 the student arrives first and waits; 02 the
+-- teacher arrives first and waits); 03 five minutes in, outside the sweep's
+-- window, for Daily to report on.
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes)
+select ('b7057a5e-0000-0000-0000-0000000000' || x.n)::uuid, pg_temp.hj_fam(), '11111111-1111-1111-1111-111111111111',
+       '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'SAT Math',
+       'cccccccc-0000-0000-0000-0000000000fb', 'dddddddd-0000-0000-0000-0000000000fc',
+       '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+       now() - x.ago, now() - x.ago, 60
+  from (values ('01', interval '15 minutes'), ('02', interval '15 minutes'), ('03', interval '5 minutes')) as x(n, ago);
+
+-- Earlier sections leave online lessons inside the sweep's window; marked as
+-- already filed, by the sweep's own rule, so the counts below are this
+-- section's.
+insert into public.lesson_events (session_id, kind, payload)
+select s.id, 'no_join_task', '{"note": "fixture from an earlier section"}'::jsonb
+  from public.session_requests s
+ where s.mode = 'online'
+   and s.id::text not like 'b7057a5e-%'
+   and s.effective_start between now() - interval '1 hour' and now()
+   and not exists (select 1 from public.lesson_events e
+                    where e.session_id = s.id and e.kind = 'no_join_task');
+
+create function pg_temp.hj_task(p_session uuid) returns text language sql stable security definer as $$
+  select t.note
+    from public.lesson_events e
+    join public.message_tasks t on t.id = (e.payload ->> 'task_id')::uuid
+   where e.session_id = p_session and e.kind = 'no_join_task'
+   limit 1
+$$;
+create function pg_temp.host_at(p_session uuid) returns timestamptz language sql stable security definer as $$
+  select host_joined_at from public.lesson_rooms where session_id = p_session
+$$;
+create function pg_temp.opened_at(p_session uuid) returns timestamptz language sql stable security definer as $$
+  select opened_at from public.lesson_rooms where session_id = p_session
+$$;
+
+-- ---------------------------------------------------------------------------
+-- The student arrives in 01: the room is open, and nobody is teaching in it.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('22222222-2222-2222-2222-222222222222');
+select test_ok('the student arrives in the room',
+  public.lesson_join('b7057a5e-0000-0000-0000-000000000001') is not null);
+select test_ok('the room is open', pg_temp.opened_at('b7057a5e-0000-0000-0000-000000000001') is not null);
+select test_ok('and no host has arrived', pg_temp.host_at('b7057a5e-0000-0000-0000-000000000001') is null);
+
+-- ---------------------------------------------------------------------------
+-- Only the host says the host arrived.
+-- ---------------------------------------------------------------------------
+select test_ok('the student cannot say the host arrived',
+  raises_matching($$select public.lesson_host_join('b7057a5e-0000-0000-0000-000000000001')$$, 'host says'));
+select act_as('cccc9999-9999-9999-9999-999999999999');   -- Tara: a teacher, not this lesson's
+select test_ok('nor can a teacher who is not the host',
+  raises_matching($$select public.lesson_host_join('b7057a5e-0000-0000-0000-000000000001')$$, 'host says'));
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin: in charge, watching
+select test_ok('nor the in-charge watching',
+  raises_matching($$select public.lesson_host_join('b7057a5e-0000-0000-0000-000000000001')$$, 'host says'));
+select test_ok('and still no host has arrived', pg_temp.host_at('b7057a5e-0000-0000-0000-000000000001') is null);
+
+-- ---------------------------------------------------------------------------
+-- The teacher arrives first in 02, then the sweep looks at both.
+-- ---------------------------------------------------------------------------
+select act_as('66666666-6666-6666-6666-666666666666');
+select test_ok('the host arrives in 02',
+  public.lesson_host_join('b7057a5e-0000-0000-0000-000000000002') is not null);
+select test_ok('which opens the room too', pg_temp.opened_at('b7057a5e-0000-0000-0000-000000000002') is not null);
+
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok('the sweep files for both lessons', public.sweep_lesson_no_joins() = 2);
+select test_ok('a student waiting in an open room is a teacher who has not joined',
+  pg_temp.hj_task('b7057a5e-0000-0000-0000-000000000001') = 'Teacher has not joined the online lesson');
+select test_ok('a teacher waiting is a student who has not joined',
+  pg_temp.hj_task('b7057a5e-0000-0000-0000-000000000002') = 'Student has not joined the online lesson');
+
+-- ---------------------------------------------------------------------------
+-- The host arrives in 01, once.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');
+select test_ok('the host arrives in 01',
+  public.lesson_host_join('b7057a5e-0000-0000-0000-000000000001') is not null);
+create temp table hj_first as select pg_temp.host_at('b7057a5e-0000-0000-0000-000000000001') as at;
+select test_ok('and a second arrival keeps the first',
+  public.lesson_host_join('b7057a5e-0000-0000-0000-000000000001') = (select at from hj_first));
+
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok('a second pass files nothing', public.sweep_lesson_no_joins() = 0);
+
+-- ---------------------------------------------------------------------------
+-- Daily's word on 03: the teacher's joined stamps the host's arrival, the
+-- student's stamps the booking's — and nothing the door must not name.
+-- ---------------------------------------------------------------------------
+insert into public.lesson_rooms (session_id, room_name)
+values ('b7057a5e-0000-0000-0000-000000000003', 'lesson-b7057a5e-0000-0000-0000-000000000003');
+select test_ok('the teacher''s joined is applied',
+  public.import_lesson_room_facts(jsonb_build_array(jsonb_build_object(
+    'room_name', 'lesson-b7057a5e-0000-0000-0000-000000000003', 'event', 'joined',
+    'user_id', '66666666-6666-6666-6666-666666666666', 'at', now()))) = 1);
+select test_ok('and stamps the host''s arrival', pg_temp.host_at('b7057a5e-0000-0000-0000-000000000003') is not null);
+select test_ok('but not the student''s',
+  (select arrived_at is null from public.session_requests where id = 'b7057a5e-0000-0000-0000-000000000003'));
+select test_ok('the student''s joined is applied',
+  public.import_lesson_room_facts(jsonb_build_array(jsonb_build_object(
+    'room_name', 'lesson-b7057a5e-0000-0000-0000-000000000003', 'event', 'joined',
+    'user_id', '22222222-2222-2222-2222-222222222222', 'at', now()))) = 1);
+select test_ok('and stamps the booking''s arrival',
+  (select arrived_at is not null from public.session_requests where id = 'b7057a5e-0000-0000-0000-000000000003'));
+select test_ok('with both there, the sweep has nothing to say about 03', public.sweep_lesson_no_joins() = 0);
+
+commit;
