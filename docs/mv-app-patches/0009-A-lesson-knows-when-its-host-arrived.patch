@@ -0,0 +1,174 @@
+-- A lesson knows when its host arrived.
+--
+-- lesson_join (the student's door) and the Daily webhook both set
+-- lesson_rooms.opened_at, so "the room was opened" never meant "the teacher
+-- is here" -- and sweep_lesson_no_joins' teacher branch, gated on opened_at,
+-- could not fire for the common case it exists for: a student waiting in a
+-- room nobody is teaching in. The room now records the host's own arrival
+-- (host_joined_at), written by the host from the room (lesson_host_join) and
+-- by the webhook when Daily sees a participant who is not the student, and
+-- the sweep asks that column instead. opened_at keeps its meaning: anybody
+-- was in the room. Run-twice: add column if not exists; functions are
+-- create or replace (privileges survive), re-emitted from
+-- pg_get_functiondef with the one change each.
+
+alter table public.lesson_rooms add column if not exists host_joined_at timestamptz;
+comment on column public.lesson_rooms.host_joined_at is
+  'When the teacher first arrived in the room: lesson_host_join from the room, or Daily''s '
+  'participant.joined for somebody who is not the student. Null while the student waits alone.';
+
+-- The host says they arrived. room_access decides who the host is (the
+-- assigned teacher, inside the window, in a room that is on); a learner, an
+-- observer or a stranger is refused. Idempotent: the first arrival stands.
+create or replace function public.lesson_host_join(p_session_id uuid)
+returns timestamptz
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_at timestamptz;
+begin
+  if coalesce(public.room_access(p_session_id) = 'host', false) is not true then
+    raise exception 'only the lesson''s host says they have arrived' using errcode = '42501';
+  end if;
+
+  insert into public.lesson_rooms (session_id, room_name, opened_at, host_joined_at)
+  values (p_session_id, 'lesson-' || p_session_id::text, now(), now())
+  on conflict (session_id) do update
+    set opened_at      = coalesce(public.lesson_rooms.opened_at, excluded.opened_at),
+        host_joined_at = coalesce(public.lesson_rooms.host_joined_at, excluded.host_joined_at)
+  returning host_joined_at into v_at;
+  return v_at;
+end;
+$$;
+
+comment on function public.lesson_host_join(uuid) is
+  'The host''s own arrival in the lesson room, stamped once; room_access says who the host is.';
+revoke all on function public.lesson_host_join(uuid) from public;
+grant execute on function public.lesson_host_join(uuid) to authenticated;
+
+-- import_lesson_room_facts: re-emitted from pg_get_functiondef; the one change
+-- is that a 'joined' by somebody who is not the student also stamps
+-- host_joined_at. It still never names status, confirmed_start,
+-- requested_start, assigned_teacher_id or meeting_url.
+CREATE OR REPLACE FUNCTION public.import_lesson_room_facts(p_rows jsonb)
+ RETURNS integer
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+declare
+  r         jsonb;
+  v_session uuid;
+  v_student uuid;
+  v_user    uuid;
+  v_at      timestamptz;
+  v_event   text;
+  v_import  text;
+  v_news    text;
+  n         integer := 0;
+begin
+  -- Quiet toward the portal and toward phones, the way every import door
+  -- is; restored afterwards rather than cleared.
+  v_import := coalesce(current_setting('app.portal_import', true), '');
+  v_news   := coalesce(current_setting('app.portal_news', true), '');
+  perform set_config('app.portal_import', '1', true);
+  perform set_config('app.portal_news', '', true);
+
+  for r in select * from jsonb_array_elements(coalesce(p_rows, '[]'::jsonb)) loop
+    v_event := r->>'event';
+    v_at    := nullif(r->>'at', '')::timestamptz;
+    v_user  := nullif(r->>'user_id', '')::uuid;
+    if v_event not in ('joined', 'left', 'ended') or v_at is null then
+      continue;
+    end if;
+
+    v_session := null;
+    select lr.session_id, s.student_id
+      into v_session, v_student
+      from public.lesson_rooms lr
+      join public.session_requests s on s.id = lr.session_id
+     where lr.room_name = r->>'room_name';
+    if v_session is null then
+      continue;
+    end if;
+
+    if v_user is not null and v_user = v_student then
+      if v_event = 'joined' then
+        update public.session_requests s
+           set arrived_at = coalesce(s.arrived_at, v_at)
+         where s.id = v_session;
+      else
+        update public.session_requests s
+           set departed_at = greatest(coalesce(s.departed_at, v_at), v_at)
+         where s.id = v_session;
+      end if;
+    else
+      if v_event = 'joined' then
+        update public.lesson_rooms lr
+           set opened_at = coalesce(lr.opened_at, v_at),
+               host_joined_at = coalesce(lr.host_joined_at, v_at)
+         where lr.session_id = v_session;
+      else
+        update public.lesson_rooms lr
+           set closed_at = greatest(coalesce(lr.closed_at, v_at), v_at)
+         where lr.session_id = v_session;
+      end if;
+    end if;
+    n := n + 1;
+  end loop;
+
+  perform set_config('app.portal_import', v_import, true);
+  perform set_config('app.portal_news', v_news, true);
+  return n;
+end;
+$function$;
+
+-- sweep_lesson_no_joins: re-emitted; the teacher branch now asks
+-- host_joined_at instead of opened_at.
+CREATE OR REPLACE FUNCTION public.sweep_lesson_no_joins()
+ RETURNS integer
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+declare
+  r      record;
+  v_note text;
+  v_task uuid;
+  n      integer := 0;
+begin
+  for r in
+    select s.id, s.department_id, s.student_id, s.family_id, s.arrived_at, lr.host_joined_at
+      from public.session_requests s
+      left join public.lesson_rooms lr on lr.session_id = s.id
+     where s.mode = 'online'
+       and s.status = 'confirmed'
+       and s.department_id is not null
+       and s.effective_start between now() - interval '30 minutes'
+                               and now() - interval '10 minutes'
+       and public.lesson_platform_enabled(s.department_id)
+       and (s.arrived_at is null or lr.host_joined_at is null)
+       and not exists (select 1 from public.lesson_events e
+                        where e.session_id = s.id and e.kind = 'no_join_task')
+     order by s.effective_start, s.id
+  loop
+    v_note := case when r.arrived_at is null
+                   then 'Student has not joined the online lesson'
+                   else 'Teacher has not joined the online lesson' end;
+
+    insert into public.message_tasks (department_id, student_id, family_id, note, due_at)
+    values (r.department_id, r.student_id, r.family_id, v_note, now())
+    returning id into v_task;
+
+    insert into public.lesson_events (session_id, kind, payload)
+    values (r.id, 'no_join_task', jsonb_build_object('task_id', v_task, 'note', v_note));
+
+    n := n + 1;
+  end loop;
+  return n;
+end;
+$function$;
+
+notify pgrst, 'reload schema';
