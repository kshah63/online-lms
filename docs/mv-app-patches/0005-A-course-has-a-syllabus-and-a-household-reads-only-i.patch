+);
+select test_ok(
+  'and tomorrow''s Maths lesson is still not hers to brief on',
+  raises_matching($$select pg_temp.brief()$$, 'reads its brief')
+);
+
+-- ---------------------------------------------------------------------------
+-- The no-join sweep: one task per session, never twice.
+-- ---------------------------------------------------------------------------
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+-- Eight SAT Math bookings a quarter of an hour in (so the Maths attendance
+-- above is untouched): 11 nobody joined; 12 the student arrived and the
+-- room never opened; 13 five minutes in; 14 in a room that is off; 15 in
+-- the building; 16 both there; 17 three quarters of an hour in; 18 cancelled.
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes, arrived_at)
+select ('a5111ab5-0000-0000-0000-0000000000' || x.n)::uuid, pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+       '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'SAT Math',
+       case when x.n = '14' then 'cccccccc-0000-0000-0000-0000000000fc' else 'cccccccc-0000-0000-0000-0000000000fb' end::uuid,
+       case when x.n = '14' then 'dddddddd-0000-0000-0000-0000000000fd' else 'dddddddd-0000-0000-0000-0000000000fc' end::uuid,
+       '66666666-6666-6666-6666-666666666666',
+       case when x.n = '15' then 'in_person' else 'online' end::public.session_mode,
+       case when x.n = '18' then 'cancelled' else 'confirmed' end::public.request_status,
+       now() - x.ago, now() - x.ago, 60,
+       case when x.n in ('12', '16') then now() - x.ago + interval '1 minute' end
+  from (values ('11', interval '15 minutes'), ('12', interval '15 minutes'),
+               ('13', interval '5 minutes'),  ('14', interval '15 minutes'),
+               ('15', interval '15 minutes'), ('16', interval '15 minutes'),
+               ('17', interval '45 minutes'), ('18', interval '15 minutes')) as x(n, ago);
+-- 16 "both there": the host's own arrival is what the sweep reads (20261013174253),
+-- so the room carries host_joined_at as well as opened_at.
+insert into public.lesson_rooms (session_id, room_name, opened_at, host_joined_at) values
+  ('a5111ab5-0000-0000-0000-000000000012', 'lesson-a5111ab5-0000-0000-0000-000000000012', null, null),
+  ('a5111ab5-0000-0000-0000-000000000016', 'lesson-a5111ab5-0000-0000-0000-000000000016', now() - interval '14 minutes', now() - interval '14 minutes');
+
+-- An earlier section commits an online Maths lesson of its own inside the
+-- sweep's window; marked as already filed, by the sweep's own rule, so the
+-- counts below are this section's.
+insert into public.lesson_events (session_id, kind, payload)
+select s.id, 'no_join_task', '{"note": "fixture from an earlier section"}'::jsonb
+  from public.session_requests s
+ where s.mode = 'online'
+   and s.id::text not like 'a5111ab5-%'
+   and s.effective_start between now() - interval '1 hour' and now();
+
+create function pg_temp.no_join_tasks() returns bigint language sql stable security definer as $$
+  select count(*) from public.message_tasks
+   where note in ('Student has not joined the online lesson', 'Teacher has not joined the online lesson')
+$$;
+
+set local role authenticated;
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal, admin
+select test_ok(
+  'an admin signed in through the app cannot run the no-join sweep',
+  raises_matching($$select public.sweep_lesson_no_joins()$$, 'permission denied')
+);
+set local role anon;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok('nor can a stranger', raises_matching($$select public.sweep_lesson_no_joins()$$, 'permission denied'));
+
+set local role postgres;
+delete from net.http_request_queue;
+set local role service_role;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok('the sweep files two tasks', public.sweep_lesson_no_joins() = 2);
+set local role postgres;
+select test_ok(
+  'the student who never joined: a task in the room''s pool, about him, due now',
+  (select t.department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+          and t.assigned_to is null and t.assigned_by is null
+          and t.student_id = '22222222-2222-2222-2222-222222222222'
+          and t.family_id = pg_temp.fam()
+          and t.status = 'pending'
+          and t.due_at between now() - interval '1 minute' and now()
+     from public.message_tasks t
+    where t.id = (select (e.payload->>'task_id')::uuid from public.lesson_events e
+                   where e.session_id = 'a5111ab5-0000-0000-0000-000000000011' and e.kind = 'no_join_task'))
+  and (select e.payload->>'note' from public.lesson_events e
+        where e.session_id = 'a5111ab5-0000-0000-0000-000000000011' and e.kind = 'no_join_task')
+      = 'Student has not joined the online lesson'
+);
+select test_ok(
+  'the teacher who never opened the room the student is waiting in: the other task',
+  (select t.note = 'Teacher has not joined the online lesson'
+          and t.department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+     from public.message_tasks t
+    where t.id = (select (e.payload->>'task_id')::uuid from public.lesson_events e
+                   where e.session_id = 'a5111ab5-0000-0000-0000-000000000012' and e.kind = 'no_join_task'))
+);
+select test_ok(
+  'and nothing for the lesson five minutes in, the room that is off, the building, both present, three quarters of an hour in, or a cancelled booking',
+  pg_temp.no_join_tasks() = 2
+  and (select count(*) from public.lesson_events
+        where kind = 'no_join_task' and session_id::text like 'a5111ab5-%') = 2
+  and not exists (select 1 from public.lesson_events e
+                   where e.kind = 'no_join_task'
+                     and e.session_id in ('a5111ab5-0000-0000-0000-000000000013', 'a5111ab5-0000-0000-0000-000000000014',
+                                          'a5111ab5-0000-0000-0000-000000000015', 'a5111ab5-0000-0000-0000-000000000016',
+                                          'a5111ab5-0000-0000-0000-000000000017', 'a5111ab5-0000-0000-0000-000000000018'))
+);
+select test_ok(
+  'a task nobody has joined a lesson for is news: the pool''s push went out',
+  (select count(*) from net.http_request_queue q
+     where q.body->>'table' = 'message_tasks' and q.body->>'type' = 'INSERT') = 2
+);
+-- The first task is done and gone; the sweep still remembers it.
+delete from public.message_tasks
+ where id = (select (e.payload->>'task_id')::uuid from public.lesson_events e
+              where e.session_id = 'a5111ab5-0000-0000-0000-000000000011' and e.kind = 'no_join_task');
+set local role service_role;
+select test_ok('a second pass files nothing', public.sweep_lesson_no_joins() = 0);
+set local role postgres;
+select test_ok('and never a second task for a session, even once the first is gone', pg_temp.no_join_tasks() = 1);
+
+-- ---------------------------------------------------------------------------
+-- The retention sweep: only what is older than recording_months.
+-- ---------------------------------------------------------------------------
+insert into public.lesson_recordings (session_id, provider_recording_id, recorded_at, deleted_at) values
+  ('a5111ab5-0000-0000-0000-000000000001', 'rec-01', now() - interval '4 months', null),
+  ('a5111ab5-0000-0000-0000-000000000002', 'rec-02', now() - interval '2 months', null),
+  ('a5111ab5-0000-0000-0000-000000000004', 'rec-04', now() - interval '5 months', now() - interval '1 day');
+select test_ok(
+  'recordings are kept three months unless an admin says otherwise',
+  (select recording_months from public.retention_settings where id = 1) = 3
+);
+set local role authenticated;
+select act_as('88888888-8888-8888-8888-888888888888');   -- Hal
+select test_ok(
+  'an admin signed in through the app cannot run the retention sweep',
+  raises_matching($$select public.sweep_lesson_retention()$$, 'permission denied')
+);
+set local role service_role;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok('the sweep marks the one recording older than three months', public.sweep_lesson_retention() = 1);
+set local role postgres;
+select test_ok(
+  'the four-month-old one is marked now, the two-month-old one is not, the one already marked keeps its date, and nothing is purged',
+  (select r.deleted_at between now() - interval '1 minute' and now() and r.purged_at is null
+     from public.lesson_recordings r where r.session_id = 'a5111ab5-0000-0000-0000-000000000001')
+  and (select r.deleted_at is null from public.lesson_recordings r
+        where r.session_id = 'a5111ab5-0000-0000-0000-000000000002')
+  and (select r.deleted_at < now() - interval '23 hours' from public.lesson_recordings r
+        where r.session_id = 'a5111ab5-0000-0000-0000-000000000004')
+);
+set local role service_role;
+select test_ok('a second pass marks nothing', public.sweep_lesson_retention() = 0);
+set local role postgres;
+update public.retention_settings set recording_months = 1 where id = 1;
+set local role service_role;
+select test_ok('shortened to a month, the two-month-old one goes too', public.sweep_lesson_retention() = 1);
+set local role postgres;
+select test_ok(
+  'and the one already marked is still not marked twice',
+  (select r.deleted_at < now() - interval '23 hours' from public.lesson_recordings r
+    where r.session_id = 'a5111ab5-0000-0000-0000-000000000004')
+);
+
+rollback;
