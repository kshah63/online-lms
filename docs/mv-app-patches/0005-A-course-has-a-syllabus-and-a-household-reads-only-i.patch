+-- ---------------------------------------------------------------------------
+-- A course has a syllabus, and a household reads only its own progress.
+--
+-- Stage 4 of the lesson platform, section A of the shared contracts
+-- (CONTRACTS-stage4.md; online-lms/docs/INTEGRATION.md, "Syllabus and
+-- progress"). A course's syllabus, a teacher's word on where a child stands
+-- in it, which topics a report taught, and the two readers the room builds
+-- its progress page and its pre-lesson brief from.
+--
+-- THE SYLLABUS IS THE IN-CHARGE'S. syllabus_topics is seeded from the
+-- portal's course_topics (one row per portal topic, remembered by
+-- course_topic_id so the seed can run twice) and extended by whoever
+-- manages_course. Labels are not sensitive, so any signed-in person reads
+-- them; every write is a door.
+--
+-- STATUSES ARE NOT STORED. The room derives a topic's status from signals
+-- (online-lms/src/lib/syllabus/progress.ts); child_progress only gathers
+-- them: which published reports taught the topic, the practice and tests
+-- on it, and the teacher's explicit mark. The one rule the database keeps is
+-- who may ask: the child, the household, the room's in-charge
+-- (room_reaches), the teacher who has a session with that child on that
+-- course a fortnight either way, an admin. Nobody else -- another family's
+-- parent is refused, and so is a teacher whose only session with the child
+-- is on some other course or in some other month.
+--
+-- THE BRIEF WIDENS ONE THING, ON PURPOSE. lesson_brief_facts hands the
+-- assigned teacher the last PUBLISHED reports for this student and course
+-- by ANY teacher -- which session_reports' own policy does not: today a
+-- teacher reads only their own. The owner's approval of that widening is
+-- recorded in the contracts file; everything else in the brief (the
+-- caller's own unwritten draft, their own coaching moments) stays theirs.
+-- The reader is reads_lesson (the assigned teacher at any time, the room's
+-- in-charge, an admin), the same gate as the transcript.
+--
+-- THE PRACTICE TABLES ARE STAMPED AFTER THIS MIGRATION (section B of the
+-- contracts). A fresh database applies the directory in order, so the
+-- signals that come from practice_* are read inside a branch guarded on
+-- to_regclass(): plpgsql plans a statement the first time it runs, so a
+-- branch not taken names tables that do not exist yet without failing.
+-- Until section B lands the practice signals are empty, honestly; once it
+-- has, the guard is always true and may be dropped by a later migration.
+--
+-- TWO SWEEPS, SERVICE ROLE ONLY. sweep_lesson_no_joins files a task in the
+-- room's pool when the student (or the teacher) has not joined a live
+-- online lesson ten minutes in -- news, so it is not quiet, and once per
+-- session, remembered as a lesson_events row. sweep_lesson_retention marks
+-- recordings older than retention_settings.recording_months deleted; the
+-- bytes at the provider are the recordings-cleanup function's to remove,
+-- which is what purged_at on lesson_recordings is for.
+--
+-- A fourth foreign key into courses, so retire_seed_course_twins is
+-- re-emitted at the bottom with syllabus_topics among its moves.
+-- ---------------------------------------------------------------------------
+
+create table if not exists public.syllabus_topics (
+  id              uuid primary key default gen_random_uuid(),
+  course_id       uuid not null references public.courses (id) on delete cascade,
+  label           text not null,
+  parent_id       uuid references public.syllabus_topics (id) on delete set null,
+  sort_order      integer not null default 0,
+  course_topic_id uuid references public.course_topics (id) on delete set null,
+  is_active       boolean not null default true,
+  created_at      timestamptz not null default now(),
+  updated_at      timestamptz not null default now()
+);
+
+comment on table public.syllabus_topics is
+  'A course''s syllabus as the in-charge keeps it: seeded from the portal''s '
+  'course_topics (course_topic_id remembers which) and extended by hand. '
+  'Written only by seed_syllabus_from_course_topics and upsert_syllabus_topic.';
+
+create index if not exists syllabus_topics_course_idx
+  on public.syllabus_topics (course_id, sort_order);
+
+-- One syllabus row per portal topic, as a fact of the schema rather than a
+-- habit of the seed.
+create unique index if not exists syllabus_topics_course_topic_key
+  on public.syllabus_topics (course_topic_id)
+  where course_topic_id is not null;
+
+create table if not exists public.syllabus_teacher_marks (
+  student_id        uuid not null references public.profiles (id) on delete cascade,
+  syllabus_topic_id uuid not null references public.syllabus_topics (id) on delete cascade,
+  status            text not null
+                    check (status in ('not_started', 'in_progress', 'covered', 'secure', 'needs_work')),
+  note              text,
+  marked_by         uuid references public.profiles (id) on delete set null,
+  marked_at         timestamptz not null default now(),
+  primary key (student_id, syllabus_topic_id)
+);
+
+comment on table public.syllabus_teacher_marks is
+  'A teacher''s explicit word on where a student stands on a topic, which '
+  'the room''s progress model takes over every other signal. Written only '
+  'by set_topic_status.';
+
+create table if not exists public.session_report_topics (
+  report_id         uuid not null references public.session_reports (id) on delete cascade,
+  syllabus_topic_id uuid not null references public.syllabus_topics (id) on delete cascade,
+  primary key (report_id, syllabus_topic_id)
+);
+
+comment on table public.session_report_topics is
+  'Which syllabus topics a session report taught. Written only by '
+  'link_report_topics; read through child_progress and lesson_brief_facts, '
+  'and directly by admins alone.';
+
+create index if not exists session_report_topics_topic_idx
+  on public.session_report_topics (syllabus_topic_id);
+
+alter table public.syllabus_topics        enable row level security;
+alter table public.syllabus_teacher_marks enable row level security;
+alter table public.session_report_topics  enable row level security;
+
+-- A stranger with the publishable key holds no write on any of these
+-- (20260901060458): the default grant to anon is taken back on every new
+-- table.
+revoke insert, update, delete, truncate, references, trigger on public.syllabus_topics        from anon;
+revoke insert, update, delete, truncate, references, trigger on public.syllabus_teacher_marks from anon;
+revoke insert, update, delete, truncate, references, trigger on public.session_report_topics  from anon;
+
+-- ---------------------------------------------------------------------------
+-- teaches_student_within: the assigned teacher of a live booking for this
+-- student, on this course (null: on any course), within p_days either way
+-- of now. The window is what keeps a teacher who taught the child once,
+-- months ago, from reading where the child stands today.
+--
+-- p_course_id null means "any course" -- the one caller that passes null
+-- is the marks policy, where the contract says any session; every door
+-- names the course. The RLS section asserts that a teacher whose session
+-- is on another course is refused where the course is named.
+-- ---------------------------------------------------------------------------
+create or replace function public.teaches_student_within(
+  p_student_id uuid, p_course_id uuid, p_days integer, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and p_student_id is not null
+     and exists (
+           select 1
+             from public.session_requests s
+            where s.student_id = p_student_id
+              and s.assigned_teacher_id = uid
+              and (p_course_id is null or s.course_id = p_course_id)
+              and s.status not in ('cancelled', 'declined')
+              and s.effective_start between now() - make_interval(days => p_days)
+                                        and now() + make_interval(days => p_days)
+         );
+$$;
+
+comment on function public.teaches_student_within(uuid, uuid, integer, uuid) is
+  'True when uid is the assigned teacher of a live booking for the student, '
+  'on the course (null: any course), within p_days either side of now.';
+
+revoke all on function public.teaches_student_within(uuid, uuid, integer, uuid) from public;
+grant execute on function public.teaches_student_within(uuid, uuid, integer, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Policies: reads only. Every write is a door below.
+-- ---------------------------------------------------------------------------
+drop policy if exists syllabus_topics_select on public.syllabus_topics;
+create policy syllabus_topics_select on public.syllabus_topics
+  for select to authenticated using (true);
+
+drop policy if exists syllabus_teacher_marks_select on public.syllabus_teacher_marks;
+create policy syllabus_teacher_marks_select on public.syllabus_teacher_marks
+  for select to authenticated using (
+    student_id = auth.uid()
+    or public.shares_family(student_id)
+    or public.is_admin()
+    or public.room_reaches(
+         (select p.family_id from public.profiles p where p.id = syllabus_teacher_marks.student_id),
+         student_id, false)
+    -- The teacher of THIS course, within a fortnight: a teacher of the child in
+    -- another subject reads nothing here, as set_topic_status and child_progress
+    -- already hold (CLAUDE.md: teachers see what their own session needs).
+    or public.teaches_student_within(
+         student_id,
+         (select t.course_id from public.syllabus_topics t
+           where t.id = syllabus_teacher_marks.syllabus_topic_id),
+         14)
+  );
+
+-- Admins alone: everybody else reaches a report's topics through
+-- child_progress and lesson_brief_facts, which re-ask who may.
+drop policy if exists session_report_topics_select on public.session_report_topics;
+create policy session_report_topics_select on public.session_report_topics
+  for select to authenticated using (public.is_admin());
+
+-- ---------------------------------------------------------------------------
+-- seed_syllabus_from_course_topics: one syllabus row per portal topic of the
+-- course, carrying the portal's label, order and is_active; a portal topic
+-- already seeded is left exactly as the in-charge has since edited it.
+-- Returns the rows added, so a second run says 0.
+-- ---------------------------------------------------------------------------
+create or replace function public.seed_syllabus_from_course_topics(p_course_id uuid)
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  n integer;
+begin
+  if not public.manages_course(p_course_id) then
+    raise exception 'only the course''s in-charge or an admin edits its syllabus'
+      using errcode = '42501';
+  end if;
+
+  insert into public.syllabus_topics (course_id, label, sort_order, course_topic_id, is_active)
+  select ct.course_id, ct.label, ct.sort_order, ct.id, ct.is_active
+    from public.course_topics ct
+   where ct.course_id = p_course_id
+     and not exists (select 1 from public.syllabus_topics st where st.course_topic_id = ct.id)
+   order by ct.sort_order, ct.label;
+  get diagnostics n = row_count;
+  return n;
+end;
+$$;
+
+comment on function public.seed_syllabus_from_course_topics(uuid) is
+  'manages_course. Adds a syllabus topic for every course_topics row of the '
+  'course that has none yet (label, sort_order, is_active carried over); '
+  'returns how many were added. Idempotent.';
+
+revoke all on function public.seed_syllabus_from_course_topics(uuid) from public;
+grant execute on function public.seed_syllabus_from_course_topics(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- upsert_syllabus_topic: p_id null inserts; otherwise the topic, which must
+-- be on this course, is updated. A parent must be a topic on the same
+-- course and not the topic itself.
+-- ---------------------------------------------------------------------------
+create or replace function public.upsert_syllabus_topic(
+  p_course_id uuid, p_id uuid, p_label text, p_parent_id uuid, p_sort_order integer, p_is_active boolean)
+returns uuid
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_label text;
+  v_id    uuid;
+begin
+  if not public.manages_course(p_course_id) then
+    raise exception 'only the course''s in-charge or an admin edits its syllabus'
+      using errcode = '42501';
+  end if;
+
+  v_label := nullif(btrim(coalesce(p_label, '')), '');
+  if v_label is null or length(v_label) > 200 then
+    raise exception 'a topic needs a label of up to 200 characters' using errcode = '22023';
+  end if;
+  if p_parent_id is not null then
+    if p_parent_id = p_id then
+      raise exception 'a topic cannot be its own parent' using errcode = '22023';
+    end if;
+    if not exists (select 1 from public.syllabus_topics t
+                    where t.id = p_parent_id and t.course_id = p_course_id) then
+      raise exception 'the parent is not a topic on this course' using errcode = '22023';
+    end if;
+  end if;
+
+  if p_id is null then
+    insert into public.syllabus_topics (course_id, label, parent_id, sort_order, is_active)
+    values (p_course_id, v_label, p_parent_id, coalesce(p_sort_order, 0), coalesce(p_is_active, true))
+    returning id into v_id;
+    return v_id;
+  end if;
+
+  update public.syllabus_topics t
+     set label      = v_label,
+         parent_id  = p_parent_id,
+         sort_order = coalesce(p_sort_order, t.sort_order),
+         is_active  = coalesce(p_is_active, t.is_active),
+         updated_at = now()
+   where t.id = p_id
+     and t.course_id = p_course_id
+  returning t.id into v_id;
+  if v_id is null then
+    raise exception 'no such topic on this course' using errcode = 'P0002';
+  end if;
+  return v_id;
+end;
+$$;
+
+comment on function public.upsert_syllabus_topic(uuid, uuid, text, uuid, integer, boolean) is
+  'manages_course. Adds (p_id null) or edits a syllabus topic of the course; '
+  'returns its id. A topic on another course is "no such topic".';
+
+revoke all on function public.upsert_syllabus_topic(uuid, uuid, text, uuid, integer, boolean) from public;
+grant execute on function public.upsert_syllabus_topic(uuid, uuid, text, uuid, integer, boolean) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- set_topic_status: the teacher's word. The assigned teacher of a session
+-- for that student on the topic's course within a week either way, whoever
+-- manages the course, or an admin. One row per student and topic; a second
+-- mark replaces the first.
+-- ---------------------------------------------------------------------------
+create or replace function public.set_topic_status(
+  p_student_id uuid, p_topic_id uuid, p_status text, p_note text default null)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_course uuid;
+begin
+  if p_status is null
+     or p_status not in ('not_started', 'in_progress', 'covered', 'secure', 'needs_work') then
+    raise exception 'a status is one of not_started, in_progress, covered, secure, needs_work'
+      using errcode = '22023';
+  end if;
+
+  select t.course_id into v_course from public.syllabus_topics t where t.id = p_topic_id;
+  if v_course is null then
+    raise exception 'no such topic' using errcode = 'P0002';
+  end if;
+  if p_student_id is null
+     or not exists (select 1 from public.profiles p where p.id = p_student_id) then
+    raise exception 'no such student' using errcode = 'P0002';
+  end if;
+
+  if not (public.teaches_student_within(p_student_id, v_course, 7)
+          or public.manages_course(v_course)
+          or public.is_admin()) then
+    raise exception 'only a teacher with a session for this student on the course this week, '
+                    'the course''s in-charge or an admin marks a topic'
+      using errcode = '42501';
+  end if;
+
+  insert into public.syllabus_teacher_marks (student_id, syllabus_topic_id, status, note, marked_by, marked_at)
+  values (p_student_id, p_topic_id, p_status, nullif(btrim(coalesce(p_note, '')), ''), auth.uid(), now())
+  on conflict (student_id, syllabus_topic_id) do update
+    set status    = excluded.status,
+        note      = excluded.note,
+        marked_by = excluded.marked_by,
+        marked_at = excluded.marked_at;
+end;
+$$;
+
+comment on function public.set_topic_status(uuid, uuid, text, text) is
+  'Marks where a student stands on a syllabus topic (replacing an earlier '
+  'mark): the assigned teacher of a session for the student on the topic''s '
+  'course within seven days, the course''s in-charge, or an admin.';
+
+revoke all on function public.set_topic_status(uuid, uuid, text, text) from public;
+grant execute on function public.set_topic_status(uuid, uuid, text, text) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- link_report_topics: which syllabus topics a report taught. The report's
+-- author, the in-charge of its department, or an admin; replaces the
+-- report's rows. Every topic must exist, and sit on the session's course
+-- when the session names one.
+-- ---------------------------------------------------------------------------
+create or replace function public.link_report_topics(p_report_id uuid, p_topic_ids uuid[])
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_author uuid;
+  v_dept   uuid;
+  v_course uuid;
+  v_ids    uuid[];
+begin
+  select r.author_id, r.department_id, s.course_id
+    into v_author, v_dept, v_course
+    from public.session_reports r
+    left join public.session_requests s on s.id = r.session_request_id
+   where r.id = p_report_id;
+  if not found then
+    raise exception 'no such report' using errcode = 'P0002';
+  end if;
+
+  if not (v_author = auth.uid()
+          or (v_dept is not null and public.is_incharge_of(v_dept))
+          or public.is_admin()) then
+    raise exception 'only the report''s author, the room''s in-charge or an admin links its topics'
+      using errcode = '42501';
+  end if;
+
+  select coalesce(array_agg(distinct x.id), '{}'::uuid[])
+    into v_ids
+    from unnest(coalesce(p_topic_ids, '{}'::uuid[])) x(id)
+   where x.id is not null;
+
+  if exists (select 1
+               from unnest(v_ids) x(id)
+               left join public.syllabus_topics t on t.id = x.id
+              where t.id is null
+                 or (v_course is not null and t.course_id <> v_course)) then
+    raise exception 'every topic must be a syllabus topic of the session''s course'
+      using errcode = '22023';
+  end if;
+
+  delete from public.session_report_topics where report_id = p_report_id;
+  insert into public.session_report_topics (report_id, syllabus_topic_id)
+  select p_report_id, x.id from unnest(v_ids) x(id);
+end;
+$$;
+
+comment on function public.link_report_topics(uuid, uuid[]) is
+  'Replaces the syllabus topics a report taught: the report''s author, the '
+  'in-charge of its department, or an admin. Topics must be the session''s '
+  'course''s. An empty array clears them.';
+
+revoke all on function public.link_report_topics(uuid, uuid[]) from public;
+grant execute on function public.link_report_topics(uuid, uuid[]) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- child_progress: the signals behind one child's progress on one course, in
+-- exactly the shape online-lms/src/lib/syllabus/progress.ts consumes.
+-- ---------------------------------------------------------------------------
+create or replace function public.child_progress(p_student_id uuid, p_course_id uuid)
+returns jsonb
+language plpgsql
+stable security definer
+set search_path to 'public'
+as $$
+declare
+  v_family    uuid;
+  v_student   jsonb;
+  v_course    jsonb;
+  v_topics    jsonb;
+  v_practice  jsonb := '{}'::jsonb;   -- topic id -> [{at, correct, total}]
+  v_tests     jsonb := '{}'::jsonb;   -- topic id -> [{at, score, out_of}]
+  v_weeks     jsonb := '{}'::jsonb;   -- week start -> items
+  v_weekly    jsonb;
+  v_accuracy  jsonb := '{"current": {"correct": 0, "total": 0}, "previous": {"correct": 0, "total": 0}}'::jsonb;
+  v_attend    jsonb;
+  v_tests_top jsonb := '[]'::jsonb;
+  v_reports   jsonb;
+  v_monday    date := date_trunc('week', now() at time zone 'UTC')::date;
+begin
+  select jsonb_build_object(
+           'id', p.id,
+           'first_name', split_part(public.display_name(p.full_name, p.preferred_name), ' ', 1)),
+         p.family_id
+    into v_student, v_family
+    from public.profiles p
+   where p.id = p_student_id;
+  if v_student is null then
+    raise exception 'no such student' using errcode = 'P0002';
+  end if;
+  select jsonb_build_object('id', c.id, 'name', c.name) into v_course
+    from public.courses c where c.id = p_course_id;
+  if v_course is null then
+    raise exception 'no such course' using errcode = 'P0002';
+  end if;
+
+  if not (p_student_id = auth.uid()
+          or public.shares_family(p_student_id)
+          or public.room_reaches(v_family, p_student_id, false)
+          or public.teaches_student_within(p_student_id, p_course_id, 14)
+          or public.is_admin()) then
+    raise exception 'this child''s progress is not yours to read' using errcode = '42501';
+  end if;
+
+  -- The practice signals, only once section B's tables exist (see the
+  -- header). Grouped per topic here so the topic list below is one pass.
+  if to_regclass('public.practice_answers') is not null then
+    select coalesce(jsonb_object_agg(g.topic_id::text, g.items), '{}'::jsonb)
+      into v_practice
+      from (
+        select per.topic_id,
+               jsonb_agg(jsonb_build_object('at', per.at, 'correct', per.correct, 'total', per.total)
+                         order by per.at desc) as items
+          from (
+            select q.syllabus_topic_id as topic_id,
+                   pa.id as attempt_id,
+                   coalesce(pa.submitted_at, pa.started_at) as at,
+                   (count(*) filter (where a.is_correct))::int as correct,
+                   count(*)::int as total
+              from public.practice_attempts pa
+              join public.practice_sets ps on ps.id = pa.set_id
+              join public.practice_answers a on a.attempt_id = pa.id
+              join public.practice_questions q on q.id = a.question_id
+              join public.syllabus_topics t on t.id = q.syllabus_topic_id
+             where pa.student_id = p_student_id
+               and t.course_id = p_course_id
+               and ps.kind <> 'test'
+               and pa.status in ('submitted', 'marked')
+               and a.is_correct is not null
+             group by q.syllabus_topic_id, pa.id, coalesce(pa.submitted_at, pa.started_at)
+          ) per
+         group by per.topic_id
+      ) g;
+
+    select coalesce(jsonb_object_agg(g.topic_id::text, g.items), '{}'::jsonb)
+      into v_tests
+      from (
+        select ps.syllabus_topic_id as topic_id,
+               jsonb_agg(jsonb_build_object('at', pa.submitted_at, 'score', pa.score, 'out_of', pa.out_of)
+                         order by pa.submitted_at desc) as items
+          from public.practice_attempts pa
+          join public.practice_sets ps on ps.id = pa.set_id
+          join public.syllabus_topics t on t.id = ps.syllabus_topic_id
+         where pa.student_id = p_student_id
+           and t.course_id = p_course_id
+           and ps.kind = 'test'
+           and pa.status in ('submitted', 'marked')
+           and pa.submitted_at is not null
+           and pa.score is not null
+           and pa.out_of is not null
+         group by ps.syllabus_topic_id
+      ) g;
+
+    select coalesce(jsonb_object_agg(w.week_start::text, w.n), '{}'::jsonb)
+      into v_weeks
+      from (
+        select ((a.answered_at at time zone 'UTC')::date
+                - ((extract(isodow from a.answered_at at time zone 'UTC')::int) - 1)) as week_start,
+               count(*)::int as n
+          from public.practice_answers a
+          join public.practice_attempts pa on pa.id = a.attempt_id
+          join public.practice_sets ps on ps.id = pa.set_id
+         where pa.student_id = p_student_id
+           and ps.course_id = p_course_id
+           and a.answered_at >= (v_monday - 49)::timestamp at time zone 'UTC'
+         group by 1
+      ) w;
+
+    select jsonb_build_object(
+             'current',  jsonb_build_object(
+               'correct', (count(*) filter (where a.is_correct and a.answered_at >= now() - interval '56 days'))::int,
+               'total',   (count(*) filter (where a.answered_at >= now() - interval '56 days'))::int),
+             'previous', jsonb_build_object(
+               'correct', (count(*) filter (where a.is_correct and a.answered_at < now() - interval '56 days'))::int,
+               'total',   (count(*) filter (where a.answered_at < now() - interval '56 days'))::int))
+      into v_accuracy
+      from public.practice_answers a
+      join public.practice_attempts pa on pa.id = a.attempt_id
+      join public.practice_sets ps on ps.id = pa.set_id
+     where pa.student_id = p_student_id
+       and ps.course_id = p_course_id
+       and a.is_correct is not null
+       and a.answered_at >= now() - interval '112 days';
+
+    select coalesce(jsonb_agg(jsonb_build_object(
+             'attempt_id', x.id, 'name', x.title, 'at', x.submitted_at,
+             'score', x.score, 'out_of', x.out_of, 'topic_label', x.topic_label,
+             'flagged', x.flagged) order by x.submitted_at desc), '[]'::jsonb)
+      into v_tests_top
+      from (
+        select pa.id, ps.title, pa.submitted_at, pa.score, pa.out_of, t.label as topic_label,
+               coalesce(pa.integrity_flagged, false) as flagged
+          from public.practice_attempts pa
+          join public.practice_sets ps on ps.id = pa.set_id
+          left join public.syllabus_topics t on t.id = ps.syllabus_topic_id
+         where pa.student_id = p_student_id
+           and ps.course_id = p_course_id
+           and ps.kind = 'test'
+           and pa.status in ('submitted', 'marked')
+           and pa.submitted_at is not null
+         order by pa.submitted_at desc
+         limit 10
+      ) x;
+  end if;
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'id', t.id, 'label', t.label, 'sort_order', t.sort_order,
+           'sessions', coalesce((
+             select jsonb_agg(jsonb_build_object(
+                      'at', coalesce(x.effective_start, r.published_at),
+                      'completed', coalesce(r.topic_completed, false))
+                    order by coalesce(x.effective_start, r.published_at) desc)
+               from public.session_report_topics srt
+               join public.session_reports r on r.id = srt.report_id
+               left join public.session_requests x on x.id = r.session_request_id
+              where srt.syllabus_topic_id = t.id
+                and r.status = 'published'
+                and r.student_id = p_student_id), '[]'::jsonb),
+           'practice', coalesce(v_practice -> t.id::text, '[]'::jsonb),
+           'tests',    coalesce(v_tests -> t.id::text, '[]'::jsonb),
+           'teacher_mark', (
+             select jsonb_build_object('status', m.status, 'at', m.marked_at, 'note', m.note)
+               from public.syllabus_teacher_marks m
+              where m.student_id = p_student_id and m.syllabus_topic_id = t.id))
+         order by t.sort_order, t.label, t.id), '[]'::jsonb)
+    into v_topics
+    from public.syllabus_topics t
+   where t.course_id = p_course_id
+     and t.is_active;
+
+  -- Eight ISO weeks, oldest first, zero-filled, the way practiceByWeek
+  -- buckets them (Monday, UTC).
+  select jsonb_agg(jsonb_build_object(
+           'week_start', w.week_start,
+           'items', coalesce((v_weeks ->> w.week_start::text)::int, 0))
+         order by w.week_start)
+    into v_weekly
+    from (select (v_monday - 7 * i)::date as week_start from generate_series(7, 0, -1) as i) w;
+
+  select jsonb_build_object(
+           'attended', (count(*) filter (where s.arrived_at is not null))::int,
+           'booked',   count(*)::int,
+           'weeks',    8)
+    into v_attend
+    from public.session_requests s
+   where s.student_id = p_student_id
+     and s.course_id = p_course_id
+     and s.status in ('confirmed', 'completed')
+     and s.effective_start >= now() - interval '56 days'
+     and s.effective_start <= now();
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'id', r.id, 'at', r.published_at, 'topic', r.topic,
+           'understanding', r.understanding, 'homework', r.homework)
+         order by r.published_at desc), '[]'::jsonb)
+    into v_reports
+    from (
+      select r.id, r.published_at, r.topic, r.understanding, r.homework
+        from public.session_reports r
+        join public.session_requests x on x.id = r.session_request_id
+       where r.student_id = p_student_id
+         and x.course_id = p_course_id
+         and r.status = 'published'
+       order by r.published_at desc nulls last
+       limit 5
+    ) r;
+
+  return jsonb_build_object(
+    'student',         v_student,
+    'course',          v_course,
+    'generated_at',    now(),
+    'topics',          v_topics,
+    'weekly_practice', v_weekly,
+    'accuracy',        v_accuracy,
+    'attendance',      v_attend,
+    'tests',           v_tests_top,
+    'reports',         v_reports);
+end;
+$$;
+
+comment on function public.child_progress(uuid, uuid) is
+  'The signals behind a child''s progress on a course (topics with their '
+  'lessons, practice, tests and the teacher''s mark; weekly practice; '
+  'accuracy; attendance; recent tests and reports) for the room to derive '
+  'statuses from. The child, the household, the room''s in-charge, the '
+  'teacher with a session for the child on that course within a fortnight, '
+  'or an admin; anybody else is refused.';
+
+revoke all on function public.child_progress(uuid, uuid) from public;
+grant execute on function public.child_progress(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- lesson_brief_facts: what the pre-lesson brief is built from.
+-- ---------------------------------------------------------------------------
+create or replace function public.lesson_brief_facts(p_session_id uuid)
+returns jsonb
+language plpgsql
+stable security definer
+set search_path to 'public'
+as $$
+declare
+  s          public.session_requests%rowtype;
+  v_reports  jsonb;
+  v_draft    jsonb;
+  v_moments  jsonb := '[]'::jsonb;
+  v_practice jsonb := '[]'::jsonb;
+  v_marks    jsonb;
+  v_prev     uuid;
+begin
+  select * into s from public.session_requests x where x.id = p_session_id;
+  if s.id is null then
+    raise exception 'no such session' using errcode = 'P0002';
+  end if;
+  if not public.reads_lesson(p_session_id) then
+    raise exception 'only the lesson''s teacher, the room''s in-charge or an admin reads its brief'
+      using errcode = '42501';
+  end if;
+
+  -- The last three published reports for this student and course, whoever
+  -- wrote them (the widening the header names).
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'id', r.id, 'at', r.published_at, 'topic', r.topic,
+           'topic_completed', r.topic_completed, 'topics_not_done', r.topics_not_done,
+           'understanding', r.understanding, 'homework', r.homework, 'remarks', r.remarks,
+           'prev_hw', r.prev_hw, 'teacher_name', r.teacher_name)
+         order by r.published_at desc), '[]'::jsonb)
+    into v_reports
+    from (
+      select r.id, r.published_at, r.topic, r.topic_completed, r.topics_not_done,
+             r.understanding, r.homework, r.remarks, r.prev_hw,
+             public.display_name(a.full_name, a.preferred_name) as teacher_name
+        from public.session_reports r
+        join public.session_requests x on x.id = r.session_request_id
+        left join public.profiles a on a.id = r.author_id
+       where r.student_id = s.student_id
+         and s.student_id is not null
+         and x.course_id is not distinct from s.course_id
+         and r.status = 'published'
+       order by r.published_at desc nulls last
+       limit 3
+    ) r;
+
+  -- The caller's own previous lesson with this student: its draft while the
+  -- report is unwritten (or sent back), and the coaching moments from it.
+  -- An observer has no previous lesson here, so both stay empty for them.
+  select x.id into v_prev
+    from public.session_requests x
+   where x.student_id = s.student_id
+     and s.student_id is not null
+     and x.assigned_teacher_id = auth.uid()
+     and x.id <> s.id
+     and x.effective_start < s.effective_start
+     and x.status not in ('cancelled', 'declined')
+   order by x.effective_start desc
+   limit 1;
+
+  if v_prev is not null then
+    select jsonb_build_object('session_id', d.session_id, 'created_at', d.created_at, 'draft', d.draft)
+      into v_draft
+      from public.lesson_report_drafts d
+     where d.session_id = v_prev
+       and not exists (select 1 from public.session_reports r
+                        where r.session_request_id = v_prev and r.status <> 'rejected');
+
+    select coalesce(jsonb_agg(jsonb_build_object('kind', m->>'kind', 'comment', m->>'comment')), '[]'::jsonb)
+      into v_moments
+      from public.lesson_feedback f
+      cross join lateral jsonb_array_elements(
+        case when jsonb_typeof(f.moments) = 'array' then f.moments else '[]'::jsonb end) m
+     where f.session_id = v_prev;
+  end if;
+
+  -- Open practice, once section B's tables exist (see the header).
+  if to_regclass('public.practice_assignments') is not null then
+    select coalesce(jsonb_agg(jsonb_build_object(
+             'assignment_id', x.assignment_id, 'set_title', x.set_title, 'kind', x.kind,
+             'due_at', x.due_at, 'attempt_status', x.attempt_status,
+             'score', x.score, 'out_of', x.out_of)
+           order by x.created_at desc), '[]'::jsonb)
+      into v_practice
+      from (
+        select pa.id as assignment_id, ps.title as set_title, ps.kind, pa.due_at, pa.created_at,
+               att.status as attempt_status, att.score, att.out_of
+          from public.practice_assignments pa
+          join public.practice_sets ps on ps.id = pa.set_id
+          left join lateral (
+            select a.status, a.score, a.out_of
+              from public.practice_attempts a
+             where a.assignment_id = pa.id
+             order by a.started_at desc
+             limit 1
+          ) att on true
+         where pa.student_id = s.student_id
+           and s.student_id is not null
+           and ps.course_id = s.course_id
+           and pa.created_at >= now() - interval '30 days'
+      ) x;
+  end if;
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'topic_id', t.id, 'label', t.label, 'status', m.status, 'at', m.marked_at)
+         order by t.sort_order, t.label, t.id), '[]'::jsonb)
+    into v_marks
+    from public.syllabus_teacher_marks m
+    join public.syllabus_topics t on t.id = m.syllabus_topic_id
+   where m.student_id = s.student_id
+     and s.student_id is not null
+     and t.course_id = s.course_id;
+
+  return jsonb_build_object(
+    'last_reports',  v_reports,
+    'last_draft',    v_draft,
+    'moments',       v_moments,
+    'open_practice', v_practice,
+    'teacher_marks', v_marks,
+    'homework_last', v_reports -> 0 ->> 'homework');
+end;
+$$;
+
+comment on function public.lesson_brief_facts(uuid) is
+  'What the pre-lesson brief is built from: the last three published reports '
+  'for this student and course by any teacher, the caller''s own unwritten '
+  'draft and coaching moments from their previous lesson with the student, '
+  'open practice, the teacher marks, and the last homework. reads_lesson: '
+  'the assigned teacher, the room''s in-charge, an admin.';
+
+revoke all on function public.lesson_brief_facts(uuid) from public;
+grant execute on function public.lesson_brief_facts(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- sweep_lesson_no_joins: a live online lesson somebody has not joined.
+--
+-- Ten to thirty minutes after a confirmed online session's start, in a room
+-- that is on: the student not arrived (arrived_at null) files "Student has
+-- not joined"; the student arrived but the room never opened by anybody
+-- else files "Teacher has not joined". One task per session, ever, kept as
+-- a lesson_events row of kind no_join_task -- the task itself may be done
+-- and gone by the next pass. News, so not quiet: the pool's push tells the
+-- room's in-charges, the way a handover does. A session with no room has
+-- no pool and is skipped.
+-- ---------------------------------------------------------------------------
+create or replace function public.sweep_lesson_no_joins()
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  r      record;
+  v_note text;
+  v_task uuid;
+  n      integer := 0;
+begin
+  for r in
+    select s.id, s.department_id, s.student_id, s.family_id, s.arrived_at, lr.opened_at
+      from public.session_requests s
+      left join public.lesson_rooms lr on lr.session_id = s.id
+     where s.mode = 'online'
+       and s.status = 'confirmed'
+       and s.department_id is not null
+       and s.effective_start between now() - interval '30 minutes'
+                               and now() - interval '10 minutes'
+       and public.lesson_platform_enabled(s.department_id)
+       and (s.arrived_at is null or lr.opened_at is null)
+       and not exists (select 1 from public.lesson_events e
+                        where e.session_id = s.id and e.kind = 'no_join_task')
+     order by s.effective_start, s.id
+  loop
+    v_note := case when r.arrived_at is null
+                   then 'Student has not joined the online lesson'
+                   else 'Teacher has not joined the online lesson' end;
+
+    insert into public.message_tasks (department_id, student_id, family_id, note, due_at)
+    values (r.department_id, r.student_id, r.family_id, v_note, now())
+    returning id into v_task;
+
+    insert into public.lesson_events (session_id, kind, payload)
+    values (r.id, 'no_join_task', jsonb_build_object('task_id', v_task, 'note', v_note));
+
+    n := n + 1;
+  end loop;
+  return n;
+end;
+$$;
+
+comment on function public.sweep_lesson_no_joins() is
+  'Service role only, every five minutes (mv-lesson-no-joins). Files one '
+  'task in the room''s pool for a confirmed online lesson 10-30 minutes in '
+  'that the student (or, the student having arrived, the teacher) has not '
+  'joined; once per session, remembered in lesson_events. Returns tasks filed.';
+
+revoke all on function public.sweep_lesson_no_joins() from public, anon, authenticated;
+grant execute on function public.sweep_lesson_no_joins() to service_role;
+
+-- ---------------------------------------------------------------------------
+-- Recordings: how long they are kept, and the mark that says they are not.
+-- ---------------------------------------------------------------------------
+alter table public.retention_settings
+  add column if not exists recording_months integer not null default 3;
+
+comment on column public.retention_settings.recording_months is
+  'How many months a lesson recording is kept before sweep_lesson_retention '
+  'marks it deleted. Picked from a list on the admin screen, never typed.';
+
+alter table public.lesson_recordings
+  add column if not exists purged_at timestamptz;
+
+comment on column public.lesson_recordings.purged_at is
+  'When the recordings-cleanup function removed the bytes at the provider; '
+  'null while a row marked deleted_at still has them.';
+
+create or replace function public.sweep_lesson_retention()
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  n integer;
+begin
+  update public.lesson_recordings r
+     set deleted_at = now()
+    from public.retention_settings st
+   where st.id = 1
+     and r.deleted_at is null
+     and r.recorded_at is not null
+     and r.recorded_at < now() - make_interval(months => st.recording_months);
+  get diagnostics n = row_count;
+  return n;
+end;
+$$;
+
+comment on function public.sweep_lesson_retention() is
+  'Service role only, daily (mv-lesson-retention). Marks lesson recordings '
+  'older than retention_settings.recording_months deleted; the bytes at the '
+  'provider are removed by recordings-cleanup, which stamps purged_at. '
+  'Returns rows marked.';
+
+revoke all on function public.sweep_lesson_retention() from public, anon, authenticated;
+grant execute on function public.sweep_lesson_retention() to service_role;
+
+-- ---------------------------------------------------------------------------
+-- A fourth table points at a course, so the twin merge learns it.
+--
+-- retire_seed_course_twins (20261006101925) moves every row that references
+-- a seed course onto its portal twin, and the RLS suite reads the list of
+-- foreign keys into courses out of the catalogue and fails when the
+-- function does not name one of them. syllabus_topics moves under the same
+-- guard course_topics does, by label: a topic the twin's syllabus already
+-- has by that name stays on the retired course and is counted among what
+-- was left behind.
+--
+-- Re-emitted from pg_get_functiondef() against a database with every
+-- migration applied; the move and its line in the leftover count are the
+-- only change.
+-- ---------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.retire_seed_course_twins()
+ RETURNS jsonb
+ LANGUAGE plpgsql
+ SET search_path TO 'public'
+AS $function$
+declare
+  locked  regclass[];
+  tbl     regclass;
+  n       int;
+  retired int   := 0;
+  revived int   := 0;
+  rooms   int   := 0;
+  names   text[] := '{}';
+  moved   jsonb := '{}';
+  skipped jsonb := '{}';
+begin
+  -- The pairs, once: every seed row beside a keyed row of its name, live or
+  -- not, and one portal row per seed (a live one first) so no row is asked
+  -- to move twice.
+  if to_regclass('pg_temp.course_twins') is not null then
+    drop table pg_temp.course_twins;
+  end if;
+  create temp table course_twins as
+    select distinct on (seed.id)
+           seed.id            as seed_id,
+           seed.name          as name,
+           seed.is_active     as seed_live,
+           seed.department_id as seed_room,
+           real.id            as portal_id
+      from public.courses seed
+      join public.courses real
+        on real.name = seed.name
+       and real.external_id is not null
+       and real.id <> seed.id
+     where seed.external_id is null
+     order by seed.id, real.is_active desc, real.id;
+
+  -- Nothing below is news to anybody (see the migration header). The flag
+  -- is what every import door sets and what the outbox, the pushes and the
+  -- guards read; the triggers that do not read it -- the schedule-change
+  -- stamp among them -- are switched off, on exactly the tables that carry
+  -- one. Both sets are read from the catalogue.
+  perform set_config('app.portal_import', '1', true);
+  select coalesce(array_agg(distinct c.conrelid::regclass), '{}')
+    into locked
+    from pg_constraint c
+    join pg_trigger t on t.tgrelid = c.conrelid and not t.tgisinternal
+   where c.contype = 'f' and c.confrelid = 'public.courses'::regclass;
+  foreach tbl in array locked loop
+    execute format('alter table %s disable trigger user', tbl);
+  end loop;
+
+  -- Plain moves: nothing on these tables is unique by course. One
+  -- statement per table, so the big one is read once, not once per pair.
+  update public.session_requests s set course_id = t.portal_id
+    from course_twins t where s.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('session_requests', n);
+
+  update public.booking_rules b set course_id = t.portal_id
+    from course_twins t where b.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('booking_rules', n);
+
+  update public.conversations c set course_id = t.portal_id
+    from course_twins t where c.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('conversations', n);
+
+  update public.announcements a set course_id = t.portal_id
+    from course_twins t where a.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('announcements', n);
+
+  update public.portal_attendance a set course_id = t.portal_id
+    from course_twins t where a.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('portal_attendance', n);
+
+  update public.portal_mismatches m set course_id = t.portal_id
+    from course_twins t where m.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('portal_mismatches', n);
+
+  -- Moves guarded by each table's own key: a row the portal twin already
+  -- has stays on the retired row and is counted as left behind.
+  update public.student_courses sc set course_id = t.portal_id
+    from course_twins t
+   where sc.course_id = t.seed_id
+     and not exists (select 1 from public.student_courses p
+                      where p.student_id = sc.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('student_courses', n);
+
+  update public.routing_rules rr set course_id = t.portal_id
+    from course_twins t
+   where rr.course_id = t.seed_id
+     and not exists (select 1 from public.routing_rules p
+                      where p.course_id = t.portal_id
+                        and p.school_id   is not distinct from rr.school_id
+                        and p.grade_level is not distinct from rr.grade_level);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('routing_rules', n);
+
+  -- (course, grade, label), nulls not distinct: a year-11 Vectors beside an
+  -- all-years Vectors is two topics, not one.
+  update public.course_topics ct set course_id = t.portal_id
+    from course_twins t
+   where ct.course_id = t.seed_id
+     and not exists (select 1 from public.course_topics p
+                      where p.course_id = t.portal_id
+                        and p.grade_level is not distinct from ct.grade_level
+                        and p.label = ct.label);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('course_topics', n);
+
+  update public.department_hours dh set course_id = t.portal_id
+    from course_twins t
+   where dh.course_id = t.seed_id
+     and not exists (select 1 from public.department_hours p
+                      where p.course_id = t.portal_id
+                        and p.weekday = dh.weekday
+                        and p.open_minutes = dh.open_minutes
+                        and p.kind = dh.kind);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('department_hours', n);
+
+  -- One OPEN request per student and course; a decided one moves freely.
+  update public.enrolment_change_requests e set course_id = t.portal_id
+    from course_twins t
+   where e.course_id = t.seed_id
+     and not (e.status = 'pending'
+              and exists (select 1 from public.enrolment_change_requests p
+                           where p.student_id = e.student_id
+                             and p.course_id = t.portal_id
+                             and p.status = 'pending'));
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('enrolment_change_requests', n);
+
+  -- First-course history: where both twins hold a day, the portal row
+  -- takes the earlier; where only the seed does, the row moves.
+  update public.student_course_first p
+     set first_on        = least(p.first_on, s.first_on),
+         portal_first_on = least(p.portal_first_on, s.portal_first_on)
+    from public.student_course_first s
+    join course_twins t on t.seed_id = s.course_id
+   where p.course_id = t.portal_id
+     and p.student_id = s.student_id;
+  update public.student_course_first s set course_id = t.portal_id
+    from course_twins t
+   where s.course_id = t.seed_id
+     and not exists (select 1 from public.student_course_first p
+                      where p.student_id = s.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('student_course_first', n);
+
+  -- One notebook per student and course (20261013152316): a student who
+  -- already has one on the portal twin keeps it; the seed's stays behind.
+  update public.lesson_notebooks ln set course_id = t.portal_id
+    from course_twins t
+   where ln.course_id = t.seed_id
+     and not exists (select 1 from public.lesson_notebooks p
+                      where p.student_id = ln.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('lesson_notebooks', n);
+
+  -- One materials mapping per course: a twin already mapped keeps its own.
+  update public.lesson_course_materials lm set course_id = t.portal_id
+    from course_twins t
+   where lm.course_id = t.seed_id
+     and not exists (select 1 from public.lesson_course_materials p
+                      where p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('lesson_course_materials', n);
+
+  -- A syllabus topic by label (20261013163422): the twin's syllabus
+  -- already holding that label keeps its own; the seed's stays behind.
+  update public.syllabus_topics st set course_id = t.portal_id
+    from course_twins t
+   where st.course_id = t.seed_id
+     and not exists (select 1 from public.syllabus_topics p
+                      where p.course_id = t.portal_id and p.label = st.label);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('syllabus_topics', n);
+
+  -- The seed row's default room, only where the portal row has none.
+  update public.courses c set department_id = t.seed_room
+    from course_twins t
+   where c.id = t.portal_id and c.department_id is null and t.seed_room is not null;
+  get diagnostics rooms = row_count;
+
+  -- A live course must still have a live row: a portal twin somebody
+  -- switched off by hand (the twins were the symptom) comes back when the
+  -- seed row it replaces was the live one. The sync never writes is_active.
+  update public.courses c set is_active = true
+    from course_twins t
+   where c.id = t.portal_id and t.seed_live and not c.is_active;
+  get diagnostics revived = row_count;
+
+  update public.courses c set is_active = false
+    from course_twins t
+   where c.id = t.seed_id and c.is_active;
+  get diagnostics retired = row_count;
+  select coalesce(array_agg(t.name order by t.name), '{}') into names
+    from course_twins t where t.seed_live;
+
+  foreach tbl in array locked loop
+    execute format('alter table %s enable trigger user', tbl);
+  end loop;
+
+  -- What stayed behind on the rows this run retired, by table, so the
+  -- notice in the release log says it rather than leaving it to be found.
+  select coalesce(jsonb_object_agg(x.tbl, x.n) filter (where x.n > 0), '{}'::jsonb)
+    into skipped
+    from (
+      select 'student_courses' as tbl, count(*) as n
+        from public.student_courses r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'routing_rules', count(*)
+        from public.routing_rules r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'course_topics', count(*)
+        from public.course_topics r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'department_hours', count(*)
+        from public.department_hours r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'enrolment_change_requests', count(*)
+        from public.enrolment_change_requests r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'student_course_first', count(*)
+        from public.student_course_first r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'lesson_notebooks', count(*)
+        from public.lesson_notebooks r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'lesson_course_materials', count(*)
+        from public.lesson_course_materials r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'syllabus_topics', count(*)
+        from public.syllabus_topics r join course_twins t on t.seed_id = r.course_id
+    ) x;
+
+  drop table pg_temp.course_twins;
+
+  return jsonb_build_object(
+    'retired',       retired,
+    'names',         to_jsonb(names),
+    'revived',       revived,
+    'rooms_carried', rooms,
+    'moved',         moved,
+    'left_on_retired_rows', skipped
+  );
+end;
+$function$;
+
+notify pgrst, 'reload schema';
diff --git a/supabase/probes/20261013163422.sql b/supabase/probes/20261013163422.sql
new file mode 100644
index 0000000..a35c7ac
--- /dev/null
+++ b/supabase/probes/20261013163422.sql
@@ -0,0 +1,82 @@
+  -- The syllabus, the marks and the report-to-topic links are there,
+  -- row-secured, with the readers the contract names: labels for anybody
+  -- signed in, links for admins alone; anon holds no write on any.
+  select '20261013163422', 'a course has a syllabus and a household reads only its own progress',
+         'syllabus_topics, syllabus_teacher_marks and session_report_topics exist with RLS on; syllabus_topics is readable by any authenticated, session_report_topics by admins alone; anon holds no write on any; one syllabus row per portal topic is a unique index',
+         (select count(*) = 3 and bool_and(c.relrowsecurity)
+                 and bool_and(exists (select 1 from pg_policy p
+                                       where p.polrelid = c.oid and p.polcmd = 'r'))
+                 and bool_and(not has_table_privilege('anon', c.oid, 'insert')
+                              and not has_table_privilege('anon', c.oid, 'update')
+                              and not has_table_privilege('anon', c.oid, 'delete'))
+            from pg_class c
+            join pg_namespace n on n.oid = c.relnamespace
+           where n.nspname = 'public'
+             and c.relname in ('syllabus_topics', 'syllabus_teacher_marks', 'session_report_topics'))
+           and coalesce((select pg_get_expr(p.polqual, p.polrelid) = 'true'
+                           from pg_policy p
+                          where p.polrelid = to_regclass('public.syllabus_topics')
+                            and p.polname = 'syllabus_topics_select'), false)
+           and coalesce((select pg_get_expr(p.polqual, p.polrelid) = 'is_admin()'
+                           from pg_policy p
+                          where p.polrelid = to_regclass('public.session_report_topics')
+                            and p.polname = 'session_report_topics_select'), false)
+           and coalesce((select i.indisunique and pg_get_expr(i.indpred, i.indrelid) is not null
+                           from pg_index i
+                          where i.indexrelid = to_regclass('public.syllabus_topics_course_topic_key')), false)
+
+  union all
+
+  -- The doors a person uses, and the two readers, are callable by
+  -- authenticated and run as definer; the readers return jsonb.
+  select '20261013163422', 'a course has a syllabus and a household reads only its own progress',
+         'seed_syllabus_from_course_topics, upsert_syllabus_topic, set_topic_status, link_report_topics, child_progress and lesson_brief_facts are SECURITY DEFINER and executable by authenticated; the two readers return jsonb',
+         (select count(*) = 6 and bool_and(p.prosecdef)
+                 and bool_and(has_function_privilege('authenticated', p.oid, 'execute'))
+            from pg_proc p
+           where p.oid in (to_regprocedure('public.seed_syllabus_from_course_topics(uuid)'),
+                           to_regprocedure('public.upsert_syllabus_topic(uuid, uuid, text, uuid, integer, boolean)'),
+                           to_regprocedure('public.set_topic_status(uuid, uuid, text, text)'),
+                           to_regprocedure('public.link_report_topics(uuid, uuid[])'),
+                           to_regprocedure('public.child_progress(uuid, uuid)'),
+                           to_regprocedure('public.lesson_brief_facts(uuid)')))
+           and (select prorettype = 'jsonb'::regtype from pg_proc
+                 where oid = to_regprocedure('public.child_progress(uuid, uuid)'))
+           and (select prorettype = 'jsonb'::regtype from pg_proc
+                 where oid = to_regprocedure('public.lesson_brief_facts(uuid)'))
+
+  union all
+
+  -- The two sweeps belong to the service role alone.
+  select '20261013163422', 'a course has a syllabus and a household reads only its own progress',
+         'sweep_lesson_no_joins and sweep_lesson_retention: service_role may execute, authenticated and anon may not',
+         has_function_privilege('service_role', to_regprocedure('public.sweep_lesson_no_joins()'), 'execute')
+           and not has_function_privilege('authenticated', to_regprocedure('public.sweep_lesson_no_joins()'), 'execute')
+           and not has_function_privilege('anon', to_regprocedure('public.sweep_lesson_no_joins()'), 'execute')
+           and has_function_privilege('service_role', to_regprocedure('public.sweep_lesson_retention()'), 'execute')
+           and not has_function_privilege('authenticated', to_regprocedure('public.sweep_lesson_retention()'), 'execute')
+           and not has_function_privilege('anon', to_regprocedure('public.sweep_lesson_retention()'), 'execute')
+
+  union all
+
+  -- Recordings are kept three months unless an admin picks otherwise, and
+  -- a row marked deleted can say when the bytes actually went.
+  select '20261013163422', 'a course has a syllabus and a household reads only its own progress',
+         'retention_settings.recording_months is integer not null default 3 and lesson_recordings.purged_at exists',
+         coalesce((select c.data_type = 'integer' and c.is_nullable = 'NO' and c.column_default = '3'
+                     from information_schema.columns c
+                    where c.table_schema = 'public' and c.table_name = 'retention_settings'
+                      and c.column_name = 'recording_months'), false)
+           and exists (select 1 from information_schema.columns c
+                        where c.table_schema = 'public' and c.table_name = 'lesson_recordings'
+                          and c.column_name = 'purged_at' and c.data_type = 'timestamp with time zone')
+
+  union all
+
+  -- The twin merge knows the fourth table that points at a course.
+  select '20261013163422', 'a course has a syllabus and a household reads only its own progress',
+         'retire_seed_course_twins moves syllabus_topics and counts what it leaves behind',
+         coalesce((select prosrc ~ 'update\s+public\.syllabus_topics\y'
+                      and prosrc like '%select ''syllabus_topics'', count(*)%'
+                     from pg_proc
+                    where oid = to_regprocedure('public.retire_seed_course_twins()')), false)
diff --git a/supabase/tests/rls/20261013163423-a_course_has_a_syllabus_and_a_household_reads_only_its_own_progress.sql b/supabase/tests/rls/20261013163423-a_course_has_a_syllabus_and_a_household_reads_only_its_own_progress.sql
new file mode 100644
index 0000000..f8268d6
--- /dev/null
+++ b/supabase/tests/rls/20261013163423-a_course_has_a_syllabus_and_a_household_reads_only_its_own_progress.sql
@@ -0,0 +1,772 @@
+-- ---------------------------------------------------------------------------
+-- A course has a syllabus and a household reads only its own progress
+-- (migration 20261013163422; CONTRACTS-stage4.md section A)
+--
+-- The syllabus is the in-charge's to seed and edit, and the seed runs twice
+-- without doubling. A teacher's mark on a topic is written only by somebody
+-- with a session for that child on that course this week (or whoever
+-- manages the course, or an admin); a teacher with no session, a teacher
+-- whose session was three weeks ago, a teacher whose session is on another
+-- course, and the child's own parent are all refused. A report's topics are
+-- linked by its author or the room, replaced rather than added to, and
+-- never from another course. child_progress answers the child, the
+-- household, the room's in-charge, the teacher within a fortnight and an
+-- admin -- and refuses a parent in another family and a teacher outside the
+-- window. lesson_brief_facts is reads_lesson's: the assigned teacher at any
+-- time, the room's in-charge, an admin; an unassigned teacher is refused.
+-- The no-join sweep files one task per session and never a second, and
+-- the retention sweep marks only recordings older than recording_months.
+-- Both sweeps are the service role's alone.
+-- ---------------------------------------------------------------------------
+begin;
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+
+update public.edge_config set room_url = 'https://room.test' where id = 1;
+insert into public.lesson_platform_rooms (department_id)
+values ('dddddddd-0000-0000-0000-0000000000fc')
+on conflict (department_id) do nothing;
+update public.department_members set is_incharge = true
+ where department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+   and user_id = '55555555-5555-5555-5555-555555555555';
+
+create function pg_temp.fam() returns uuid language sql stable as $$
+  select family_id from public.profiles where id = '11111111-1111-1111-1111-111111111111'
+$$;
+
+-- Earlier sections commit lessons of Ben's with Gita and Tara (one of them
+-- tomorrow), and the fortnight rule below is about exactly those two having
+-- none inside it. Cleared here, inside this section's own transaction.
+delete from public.session_requests
+ where student_id = '22222222-2222-2222-2222-222222222222'
+   and assigned_teacher_id in ('77777777-7777-7777-7777-777777777777',
+                               'cccc9999-9999-9999-9999-999999999999');
+
+-- Ben's Maths lessons (IB Math AA HL, the course with a portal topic list):
+-- 01 with Frank two days ago (its report is published); 02 with Gita three
+-- weeks ago, never arrived; 03 with Frank tomorrow (the brief is for it);
+-- 04 with Frank yesterday, draft written, report not.
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes, arrived_at, departed_at)
+values
+  ('a5111ab5-0000-0000-0000-000000000001', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '2 days', now() - interval '2 days', 60,
+   now() - interval '2 days', now() - interval '2 days' + interval '1 hour'),
+  ('a5111ab5-0000-0000-0000-000000000002', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Sequences',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '77777777-7777-7777-7777-777777777777', 'online', 'confirmed',
+   now() - interval '20 days', now() - interval '20 days', 60, null, null),
+  ('a5111ab5-0000-0000-0000-000000000003', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Complex numbers',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() + interval '1 day', now() + interval '1 day', 60, null, null),
+  ('a5111ab5-0000-0000-0000-000000000004', pg_temp.fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Sequences',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '1 day', now() - interval '1 day', 60,
+   now() - interval '1 day', now() - interval '1 day' + interval '1 hour');
+
+insert into public.session_reports
+  (id, session_request_id, student_id, family_id, department_id, author_id, status,
+   course_name, topic, topic_completed, understanding, homework, remarks, prev_hw, published_at)
+values
+  ('a5111ab5-0000-0000-0000-0000000000a1', 'a5111ab5-0000-0000-0000-000000000001',
+   '22222222-2222-2222-2222-222222222222', pg_temp.fam(), 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'published',
+   'IB Math AA HL', 'Vectors', true, 7, 'Ex 4B q1-10', 'Ben worked steadily.', 'Yes',
+   now() - interval '2 days' + interval '2 hours');
+
+insert into public.lesson_report_drafts (session_id, draft, source)
+values ('a5111ab5-0000-0000-0000-000000000004',
+        '{"topic": "Sequences", "understanding": 6, "homework": "Ex 5A"}', 'heuristic');
+insert into public.lesson_feedback (session_id, teacher_id, summary, moments)
+values ('a5111ab5-0000-0000-0000-000000000004', '66666666-6666-6666-6666-666666666666',
+        'Clear and patient.',
+        '[{"at": "03:10", "kind": "strength", "quote": "take your time", "comment": "Good wait time"}]');
+
+create function pg_temp.topic(p_label text,
+                              p_course uuid default 'cccccccc-0000-0000-0000-0000000000fa')
+returns uuid language sql stable security definer as $$
+  select id from public.syllabus_topics where course_id = p_course and label = p_label
+$$;
+
+-- ---------------------------------------------------------------------------
+-- The seed is the in-charge's, and runs twice without doubling.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('77777777-7777-7777-7777-777777777777');   -- Gita, a teacher in Maths
+select test_ok(
+  'a teacher who does not manage the course cannot seed its syllabus',
+  raises_matching($$select public.seed_syllabus_from_course_topics('cccccccc-0000-0000-0000-0000000000fa')$$,
+                  'in-charge or an admin')
+);
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin, in charge of Maths
+select test_ok(
+  'the in-charge of Maths seeds three topics from the portal''s list',
+  public.seed_syllabus_from_course_topics('cccccccc-0000-0000-0000-0000000000fa') = 3
+);
+select test_ok(
+  'and a second seed adds nothing',
+  public.seed_syllabus_from_course_topics('cccccccc-0000-0000-0000-0000000000fa') = 0
+  and (select count(*) from public.syllabus_topics
+        where course_id = 'cccccccc-0000-0000-0000-0000000000fa') = 3
+);
+select test_ok(
+  'each carries the portal topic''s label, order and id',
+  (select count(*) = 3
+          and bool_and(st.course_topic_id = ct.id and st.sort_order = ct.sort_order and st.is_active)
+     from public.syllabus_topics st
+     join public.course_topics ct on ct.course_id = st.course_id and ct.label = st.label
+    where st.course_id = 'cccccccc-0000-0000-0000-0000000000fa')
+);
+select test_ok(
+  'she cannot seed a Science course',
+  raises_matching($$select public.seed_syllabus_from_course_topics('cccccccc-0000-0000-0000-0000000000fc')$$,
+                  'in-charge or an admin')
+);
+select test_ok(
+  'a course with no portal topics seeds nothing',
+  public.seed_syllabus_from_course_topics('cccccccc-0000-0000-0000-0000000000fb') = 0
+);
+
+-- ---------------------------------------------------------------------------
+-- Editing by hand.
+-- ---------------------------------------------------------------------------
+create temp table added as
+  select public.upsert_syllabus_topic('cccccccc-0000-0000-0000-0000000000fa', null,
+                                      'Complex numbers', null, 40, true) as id;
+grant select on added to public;
+select test_ok(
+  'the in-charge adds a topic of her own',
+  (select t.label = 'Complex numbers' and t.sort_order = 40 and t.course_topic_id is null
+     from public.syllabus_topics t where t.id = (select id from added))
+);
+-- Its own statement: a scalar subquery beside the call is an InitPlan,
+-- evaluated before the edit it is meant to read.
+create temp table edited as
+  select public.upsert_syllabus_topic('cccccccc-0000-0000-0000-0000000000fa', (select id from added),
+                                      ' Complex numbers (HL) ', pg_temp.topic('Vectors'), 40, true) as id;
+select test_ok(
+  'and edits it, parent and label, getting the same id back',
+  (select id from edited) = (select id from added)
+  and (select t.label = 'Complex numbers (HL)' and t.parent_id = pg_temp.topic('Vectors')
+         from public.syllabus_topics t where t.id = (select id from added))
+);
+select test_ok(
+  'a topic cannot be its own parent',
+  raises_matching(format($$select public.upsert_syllabus_topic('cccccccc-0000-0000-0000-0000000000fa', %L, 'x', %L, 1, true)$$,
+                         (select id from added), (select id from added)),
+                  'its own parent')
+);
+select test_ok(
+  'nor have no label',
