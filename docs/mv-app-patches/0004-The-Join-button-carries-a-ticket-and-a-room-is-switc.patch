@@ -0,0 +1,161 @@
+import { Alert, Linking } from 'react-native';
+import * as WebBrowser from 'expo-web-browser';
+
+import { env } from './env';
+import { supabase } from './supabase';
+import { colors } from '../theme';
+
+/**
+ * The app's side of the lesson room (room.mathvisionapp.com).
+ *
+ * An online session in a department whose room is switched on carries a
+ * meeting_url on the room's host — the database stamps it
+ * (enable_lesson_platform's backfill, the session_requests_the_room_link
+ * trigger). That link is never opened bare: the room is a different browser
+ * with no session of its own, so the app asks the room-ticket edge function
+ * for a single-use, two-minute ticket and opens THAT, and the room signs the
+ * person in as themself (docs/DEPLOYMENT.md §2c). Nothing secret rides in a
+ * URL the app builds; the token comes back from the function and goes
+ * straight to the browser.
+ *
+ * Two screens hold a Join button — the session page and the teacher's Write
+ * tab — and both ask these two functions rather than deciding for themselves,
+ * so "is this a room link" has one answer (#the-join-button-carries-a-ticket).
+ */
+
+/**
+ * Whether a session's link is the lesson room's, as opposed to Zoom or any
+ * other link somebody pasted.
+ *
+ * The host is matched as a prefix bounded by '/', '?', '#' or the end, so
+ * `https://room.mathvisionapp.com.evil.example/…` is not the room, and the
+ * origin is compared without regard to case because browsers do the same.
+ * An empty room URL — the platform off in this build — is never a match,
+ * whatever the link says: a phone that was not told about the room keeps
+ * opening links the old way.
+ */
+export function isRoomHostUrl(
+  url: string | null | undefined,
+  roomUrl: string = env.roomUrl,
+): boolean {
+  const base = (roomUrl ?? '').trim().replace(/\/+$/, '');
+  if (!base || !url) return false;
+  const link = url.trim();
+  if (link.slice(0, base.length).toLowerCase() !== base.toLowerCase()) return false;
+  const rest = link.slice(base.length);
+  return rest === '' || /^[/?#]/.test(rest);
+}
+
+type Ticket = { purpose: 'join'; session_id: string } | { purpose: 'page'; next: string };
+
+/**
+ * The function's own sentence, when it sent one.
+ *
+ * supabase-js reports every non-2xx as "Edge Function returned a non-2xx
+ * status code" and keeps the body on `context` — the same digging
+ * AuthContext.edgeFunctionMessage and lib/calling do, because the body is
+ * where "That lesson is not yours to join." lives.
+ */
+async function functionMessage(
+  error: unknown,
+): Promise<{ message: string | null; status: number | null }> {
+  const response = (error as { context?: Response } | null)?.context;
+  if (!response || typeof response.json !== 'function') return { message: null, status: null };
+  const status = typeof response.status === 'number' ? response.status : null;
+  try {
+    const body = (await response.json()) as { error?: unknown } | null;
+    const message = body?.error;
+    return { message: typeof message === 'string' && message ? message : null, status };
+  } catch {
+    return { message: null, status };
+  }
+}
+
+/**
+ * The room said no to THIS person — "That lesson is not yours to join.", a
+ * ticket asked for outside the lesson's window, a page the hand-off may not
+ * land on. Zoom is not the answer to that: the teacher is in the room, and a
+ * parent sent to an empty Zoom call has been told nothing. A refusal is
+ * shown in its own words; every other failure (the function down, the room
+ * not configured, the browser declining) still falls back to the link that
+ * exists.
+ */
+class RoomRefusal extends Error {}
+
+/**
+ * Mints a ticket and opens the room on it.
+ *
+ * The in-app browser (SFSafariViewController / Custom Tabs) rather than
+ * openAuthSessionAsync, for the same reason the Portal tab uses it: it keeps
+ * the room's cookie between opens, so the second join of the day is already
+ * signed in, and it does not put up iOS's "wants to sign in" alert every
+ * time. Opened as a sheet, in the app's colours, exactly as the portal is.
+ */
+async function openOnTicket(ticket: Ticket): Promise<void> {
+  const { data, error } = await supabase.functions.invoke('room-ticket', { body: ticket });
+  if (error) {
+    const { message, status } = await functionMessage(error);
+    const sentence = message ?? (error as Error).message;
+    throw status === 400 || status === 403 ? new RoomRefusal(sentence) : new Error(sentence);
+  }
+  const url = (data as { url?: unknown } | null)?.url;
+  if (typeof url !== 'string' || !url) {
+    throw new Error('The lesson room did not send a link to open.');
+  }
+  await WebBrowser.openBrowserAsync(url, {
+    presentationStyle: WebBrowser.WebBrowserPresentationStyle.PAGE_SHEET,
+    controlsColor: colors.brand,
+    toolbarColor: colors.bg,
+  });
+}
+
+/**
+ * Join a lesson: a ticket for this session, then the room.
+ *
+ * Whatever breaks — the function down, the room not set up, the browser
+ * declining to open — the person still has a lesson to get to, so when a
+ * Zoom link exists (the centre's, or the session's own override) it opens
+ * instead; a broken hand-off never cancels a lesson. A refusal is different
+ * (RoomRefusal above): the room's sentence is shown, and nothing else opens.
+ * With nothing to fall back on, the reason is said in a box rather than
+ * swallowed: a tap that does nothing is the one thing a Join button must
+ * never do.
+ */
+export async function openLessonRoom(
+  sessionId: string,
+  fallbackUrl?: string | null,
+): Promise<void> {
+  try {
+    await openOnTicket({ purpose: 'join', session_id: sessionId });
+  } catch (roomError) {
+    if (fallbackUrl && !(roomError instanceof RoomRefusal)) {
+      try {
+        await Linking.openURL(fallbackUrl);
+        return;
+      } catch {
+        // Both doors shut: say so below, naming the room's reason — it is the
+        // one with a sentence in it.
+      }
+    }
+    Alert.alert(
+      'Could not open the lesson room',
+      (roomError as Error)?.message || 'Check your connection and try again.',
+    );
+  }
+}
+
+/**
+ * One of the room's own pages — practice, progress, the bank, a test —
+ * signed in as this person. `next` is a path on the room's host; the function
+ * refuses anything outside the pages a hand-off may land on.
+ */
+export async function openRoomPage(next: string): Promise<void> {
+  try {
+    await openOnTicket({ purpose: 'page', next });
+  } catch (roomError) {
+    Alert.alert(
+      'Could not open the lesson room',
+      (roomError as Error)?.message || 'Check your connection and try again.',
+    );
+  }
+}
