@@ -0,0 +1,385 @@
+/**
+ * The Join button carries a ticket (the lesson room, stage 2).
+ *
+ * An online session in a department whose lesson room is on carries a
+ * meeting_url on the room's host, and that link must never be opened bare:
+ * the room is a different browser with no session of its own, so the bare
+ * link lands on its sign-in page. The session page asks room-ticket for a
+ * single-use ticket and opens THAT in the in-app browser (src/lib/lessons.ts).
+ * If the ticket cannot be had, the centre's Zoom link opens instead — a
+ * broken hand-off never cancels a lesson.
+ *
+ * Held here, for a room link: the ticket is asked for and the browser
+ * opened on its URL, Linking.openURL is never handed the room's link, and
+ * the office is not offered "Different link for this session only" or
+ * "Remove override" — the one thing those can do to a room link is clear
+ * the room away, and the INSERT-only trigger never puts it back. The
+ * breakout caption is gone too: the number is Zoom's. And for a Zoom link,
+ * every one of those is exactly as it was.
+ */
+import React from 'react';
+import { Alert, Linking, Text } from 'react-native';
+import { act, create, type ReactTestRenderer } from 'react-test-renderer';
+import { SafeAreaProvider } from 'react-native-safe-area-context';
+import * as WebBrowser from 'expo-web-browser';
+
+const METRICS = {
+  frame: { x: 0, y: 0, width: 390, height: 844 },
+  insets: { top: 47, left: 0, right: 0, bottom: 34 },
+};
+
+const mockRoom = 'https://room.mathvisionapp.com';
+const mockCentreZoom = 'https://zoom.us/j/centre';
+const mockMe = '00000000-0000-0000-0000-0000000000aa';
+const mockFamilyId = '00000000-0000-0000-0000-0000000000fb';
+const mockId = '00000000-0000-0000-0000-0000000000c1';
+const inAnHour = new Date(Date.now() + 3600_000).toISOString();
+
+const ROOM_LINK = `${mockRoom}/lesson/${mockId}`;
+const ZOOM_LINK = 'https://zoom.us/j/1';
+
+/** The session on the page — its link is what each test changes. */
+const mockSession: { value: Record<string, unknown> } = { value: {} };
+
+function sessionWith(meeting_url: string | null) {
+  return {
+    id: mockId,
+    family_id: mockFamilyId,
+    requested_by: mockMe,
+    student_id: '00000000-0000-0000-0000-0000000000b1',
+    student_name: 'Ben Tester',
+    subject: 'IB - HL Maths (Analysis)',
+    topic: 'Binomial',
+    mode: 'online',
+    requested_start: inAnHour,
+    confirmed_start: inAnHour,
+    alt_start: null,
+    proposed_start: null,
+    duration_minutes: 60,
+    notes: null,
+    status: 'confirmed',
+    department_id: '00000000-0000-0000-0000-0000000000d1',
+    course_id: '00000000-0000-0000-0000-0000000000cc',
+    booking_group_id: null,
+    rating: null,
+    is_ia: false,
+    is_ee: false,
+    has_upcoming_tests: false,
+    assigned_teacher_id: null,
+    location: null,
+    meeting_url,
+    breakout_room: 3,
+    ends_at: null,
+    time_zone: 'Asia/Singapore',
+    staff_note: null,
+    external_id: null,
+    created_at: new Date().toISOString(),
+    updated_at: new Date().toISOString(),
+  };
+}
+
+/** What room-ticket answers — swapped per test. */
+const mockInvoke = jest.fn();
+
+// The build knows the room's address; nothing else in this screen's graph
+// reads env, so the one field is the whole mock. The literal rather than
+// mockRoom: the import of lessons.ts below is hoisted above the const, so
+// the factory runs before it is assigned.
+jest.mock('../src/lib/env', () => ({ env: { roomUrl: 'https://room.mathvisionapp.com' } }));
+
+// setup.js mocks expo-web-browser without the presentation styles; the room
+// opens as a page sheet, so the enum has to exist for the call to be made.
+jest.mock('expo-web-browser', () => ({
+  openBrowserAsync: jest.fn(async () => ({ type: 'dismiss' })),
+  WebBrowserPresentationStyle: { PAGE_SHEET: 'pageSheet' },
+}));
+
+jest.mock('../src/lib/supabase', () => {
+  function chainFor(table: string) {
+    const rows = () =>
+      table === 'session_requests'
+        ? [mockSession.value]
+        : table === 'centre_schedule'
+          ? [{ id: 1, online_meeting_url: mockCentreZoom }]
+          : [];
+    const result: any = Promise.resolve({ data: rows(), error: null });
+    return new Proxy(result, {
+      get(target, prop) {
+        if (prop === 'then' || prop === 'catch' || prop === 'finally')
+          return target[prop].bind(target);
+        if (prop === 'single' || prop === 'maybeSingle')
+          return () => Promise.resolve({ data: rows()[0] ?? null, error: null });
+        return () => chainFor(table);
+      },
+    });
+  }
+  return {
+    supabase: {
+      from: (table: string) => chainFor(table),
+      rpc: () => Promise.resolve({ data: [], error: null }),
+      functions: { invoke: (...args: unknown[]) => mockInvoke(...args) },
+      ...require('./realtimeMock').createRealtime(),
+    },
+    describeError: (e: unknown) => String(e),
+  };
+});
+
+jest.mock('expo-router', () => ({
+  useRouter: () => ({ push: jest.fn(), replace: jest.fn(), back: jest.fn() }),
+  useLocalSearchParams: () => ({ id: mockId }),
+  useFocusEffect: (cb: () => void) => {
+    const { useEffect } = jest.requireActual('react');
+    useEffect(cb, [cb]);
+  },
+  Link: ({ children }: any) => children,
+  Stack: { Screen: () => null },
+  Tabs: { Screen: () => null },
+}));
+
+const mockAuth: { value: any } = { value: null };
+jest.mock('../src/context/AuthContext', () => ({ useAuth: () => mockAuth.value }));
+
+function authAs(role: string) {
+  const staff = role === 'staff' || role === 'support' || role === 'admin';
+  mockAuth.value = {
+    session: { user: { id: mockMe, email: 'x@x.test' } },
+    profile: { id: mockMe, family_id: staff ? null : mockFamilyId, role, full_name: 'T' },
+    isStaff: staff,
+  };
+}
+
+import { isRoomHostUrl } from '../src/lib/lessons';
+
+/** Every string the page renders, flattened. */
+function textIn(tree: ReactTestRenderer): string {
+  const out: string[] = [];
+  const walk = (child: unknown) => {
+    if (typeof child === 'string' || typeof child === 'number') out.push(String(child));
+    else if (Array.isArray(child)) child.forEach(walk);
+  };
+  tree.root
+    .findAll((node: any) => node.props?.children != null, { deep: true })
+    .forEach((node: any) => walk(node.props.children));
+  return out.join('');
+}
+
+const label = (node: { props: { children?: unknown } }) => [node.props.children].flat().join('');
+
+/** The Join button: the pressable whose text is the button's words. */
+function joinButton(tree: ReactTestRenderer) {
+  return tree.root.find(
+    (node) =>
+      typeof node.props.onPress === 'function' &&
+      node.findAllByType(Text).some((t) => label(t) === 'Join online session'),
+  );
+}
+
+async function openSession() {
+  const Screen = require('../app/sessions/[id]').default;
+  let tree!: ReactTestRenderer;
+  await act(async () => {
+    tree = create(
+      React.createElement(SafeAreaProvider, { initialMetrics: METRICS }, React.createElement(Screen)),
+    );
+  });
+  await act(async () => {});
+  await act(async () => {});
+  return tree;
+}
+
+const openBrowser = WebBrowser.openBrowserAsync as jest.Mock;
+let openURL: jest.SpyInstance;
+
+beforeEach(() => {
+  openURL = jest.spyOn(Linking, 'openURL').mockResolvedValue(true);
+  openURL.mockClear();
+  mockInvoke.mockReset();
+  mockInvoke.mockResolvedValue({
+    data: { url: `${mockRoom}/join#t=ticket-token&next=%2Flesson%2F${mockId}` },
+    error: null,
+  });
+  openBrowser.mockClear();
+});
+
+afterEach(() => {
+  jest.restoreAllMocks();
+});
+
+describe('a session whose link is the lesson room', () => {
+  beforeEach(() => {
+    mockSession.value = sessionWith(ROOM_LINK);
+  });
+
+  test.each(['staff', 'support', 'admin'])(
+    'as %s, Join asks for a ticket and opens THAT — never the room link itself',
+    async (role) => {
+      authAs(role);
+      const tree = await openSession();
+
+      await act(async () => {
+        joinButton(tree).props.onPress();
+      });
+
+      expect(mockInvoke).toHaveBeenCalledWith('room-ticket', {
+        body: { purpose: 'join', session_id: mockId },
+      });
+      // The bare link opens the room's sign-in page; it goes nowhere.
+      expect(openURL).not.toHaveBeenCalled();
+      expect(openBrowser).toHaveBeenCalledTimes(1);
+      const [opened, options] = openBrowser.mock.calls[0];
+      expect(opened).toContain('/join#t=ticket-token');
+      expect(opened).not.toBe(ROOM_LINK);
+      // The portal's sheet, so the room's cookie survives between opens.
+      expect(options).toMatchObject({ presentationStyle: 'pageSheet' });
+      await act(async () => tree.unmount());
+    },
+  );
+
+  test('the office is not offered the override, and the breakout room is not mentioned', async () => {
+    authAs('staff');
+    const tree = await openSession();
+    const text = textIn(tree);
+
+    expect(text).not.toContain('Different link for this session only');
+    expect(text).not.toContain('Remove override');
+    expect(text).not.toContain('Join the class link');
+    expect(text).not.toContain('Breakout room');
+    // And the words say where the button goes.
+    expect(text).toContain('Opens the lesson room');
+    expect(text).not.toContain('Zoom');
+    await act(async () => tree.unmount());
+  });
+
+  test('a family joins the same way — the room decides the seat, not the app', async () => {
+    authAs('parent');
+    const tree = await openSession();
+
+    await act(async () => {
+      joinButton(tree).props.onPress();
+    });
+
+    expect(mockInvoke).toHaveBeenCalledTimes(1);
+    expect(openURL).not.toHaveBeenCalled();
+    expect(openBrowser).toHaveBeenCalledTimes(1);
+    await act(async () => tree.unmount());
+  });
+
+  test('when the ticket cannot be had, the centre Zoom link opens instead', async () => {
+    authAs('staff');
+    mockInvoke.mockResolvedValue({
+      data: null,
+      error: {
+        message: 'Edge Function returned a non-2xx status code',
+        context: { json: async () => ({ error: 'The lesson room is not set up on the server.' }) },
+      },
+    });
+    const tree = await openSession();
+
+    await act(async () => {
+      joinButton(tree).props.onPress();
+    });
+
+    expect(openBrowser).not.toHaveBeenCalled();
+    expect(openURL).toHaveBeenCalledTimes(1);
+    expect(openURL).toHaveBeenCalledWith(mockCentreZoom);
+    // Still never the room link.
+    expect(openURL).not.toHaveBeenCalledWith(ROOM_LINK);
+    await act(async () => tree.unmount());
+  });
+
+  test('when the room refuses THIS person, its sentence is shown and Zoom is not opened instead', async () => {
+    // A parent, or a student forty minutes early: the room said no to them,
+    // not to the lesson. Sending them into an empty Zoom call while the
+    // teacher waits in the room tells them nothing; the sentence does.
+    authAs('staff');
+    const alert = jest.spyOn(Alert, 'alert').mockImplementation(() => undefined);
+    mockInvoke.mockResolvedValue({
+      data: null,
+      error: {
+        message: 'Edge Function returned a non-2xx status code',
+        context: { status: 403, json: async () => ({ error: 'That lesson is not yours to join.' }) },
+      },
+    });
+    const tree = await openSession();
+
+    await act(async () => {
+      joinButton(tree).props.onPress();
+    });
+
+    expect(openBrowser).not.toHaveBeenCalled();
+    expect(openURL).not.toHaveBeenCalled();
+    expect(alert).toHaveBeenCalledWith('Could not open the lesson room', 'That lesson is not yours to join.');
+    alert.mockRestore();
+    await act(async () => tree.unmount());
+  });
+});
+
+describe('a session whose link is Zoom', () => {
+  beforeEach(() => {
+    mockSession.value = sessionWith(ZOOM_LINK);
+  });
+
+  test('Join opens the link as it always has, with no ticket and no browser sheet', async () => {
+    authAs('staff');
+    const tree = await openSession();
+
+    await act(async () => {
+      joinButton(tree).props.onPress();
+    });
+
+    expect(openURL).toHaveBeenCalledWith(ZOOM_LINK);
+    expect(mockInvoke).not.toHaveBeenCalled();
+    expect(openBrowser).not.toHaveBeenCalled();
+    await act(async () => tree.unmount());
+  });
+
+  test('the office keeps the override field, and the breakout caption stays', async () => {
+    authAs('staff');
+    const tree = await openSession();
+    const text = textIn(tree);
+
+    expect(text).toContain('Different link for this session only');
+    expect(text).toContain('Join the class link');
+    expect(text).toContain('Breakout room 3');
+    expect(text).not.toContain('Opens the lesson room');
+    await act(async () => tree.unmount());
+  });
+
+  test('with no link of its own, the centre link opens', async () => {
+    mockSession.value = sessionWith(null);
+    authAs('parent');
+    const tree = await openSession();
+
+    await act(async () => {
+      joinButton(tree).props.onPress();
+    });
+
+    expect(openURL).toHaveBeenCalledWith(mockCentreZoom);
+    expect(mockInvoke).not.toHaveBeenCalled();
+    await act(async () => tree.unmount());
+  });
+});
+
+describe('what counts as the room', () => {
+  test('the host, bounded — a look-alike is not the room', () => {
+    expect(isRoomHostUrl(`${mockRoom}/lesson/${mockId}`)).toBe(true);
+    expect(isRoomHostUrl(`${mockRoom}`)).toBe(true);
+    expect(isRoomHostUrl(`${mockRoom}/`)).toBe(true);
+    expect(isRoomHostUrl(`HTTPS://ROOM.mathvisionapp.com/lesson/${mockId}`)).toBe(true);
+    // Not the room: a different host that merely starts the same way.
+    expect(isRoomHostUrl(`${mockRoom}.evil.example/lesson/${mockId}`)).toBe(false);
+    expect(isRoomHostUrl('https://room.mathvisionapp.com-evil.example/')).toBe(false);
+    expect(isRoomHostUrl(ZOOM_LINK)).toBe(false);
+    expect(isRoomHostUrl(null)).toBe(false);
+    expect(isRoomHostUrl('')).toBe(false);
+  });
+
+  test('with the platform off in this build, nothing is the room', () => {
+    // A phone that was never told about the room keeps opening links the
+    // old way, whatever the link says.
+    expect(isRoomHostUrl(`${mockRoom}/lesson/${mockId}`, '')).toBe(false);
+    expect(isRoomHostUrl(`${mockRoom}/lesson/${mockId}`, '   ')).toBe(false);
+    // A trailing slash on the setting is tolerated, as it is on the server.
+    expect(isRoomHostUrl(`${mockRoom}/lesson/${mockId}`, `${mockRoom}/`)).toBe(true);
+  });
+});
