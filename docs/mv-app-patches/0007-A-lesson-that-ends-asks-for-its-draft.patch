+  -- The ask is in the function, after every write and inside its own
+  -- exception block, and the door is still the same people's.
+  select '20261013163945', 'a lesson that ends asks for its draft',
+         'lesson_end invokes lesson-finalize with {session_id, reason: end} after the booking, room and transcript writes, inside an exception block that records finalize_not_asked; authenticated may still execute it and anon may not',
+         coalesce((select prosrc like '%invoke_edge_function(%'
+                      and prosrc like '%''lesson-finalize''%'
+                      and prosrc like '%''reason'', ''end''%'
+                      and strpos(prosrc, '''lesson-finalize''') > strpos(prosrc, 'insert into public.lesson_transcripts')
+                      and strpos(prosrc, '''lesson-finalize''') > strpos(prosrc, 'insert into public.lesson_rooms')
+                      and strpos(prosrc, '''lesson-finalize''') > strpos(prosrc, 'update public.session_requests')
+                      and strpos(prosrc, '''lesson-finalize''') > strpos(prosrc, 'set_config(''app.push_quiet'', v_quiet')
+                      and prosrc ~ 'begin\s+perform public\.invoke_edge_function\(\s*''lesson-finalize''[^;]*;\s*exception when others'
+                      and prosrc like '%finalize_not_asked%'
+                    from pg_proc
+                   where oid = to_regprocedure('public.lesson_end(uuid, jsonb)')), false)
+           and has_function_privilege('authenticated', to_regprocedure('public.lesson_end(uuid, jsonb)'), 'execute')
+           and not has_function_privilege('anon', to_regprocedure('public.lesson_end(uuid, jsonb)'), 'execute')
