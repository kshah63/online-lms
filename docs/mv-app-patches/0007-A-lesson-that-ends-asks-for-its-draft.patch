+import { computeMetrics, segmentsFrom, wordCount, type TranscriptSegment } from '../supabase/functions/_shared/lessonMetrics';
+import { dedupeSegments, mergeTranscripts, parseVtt, segmentKey, speakerRole, transcriptSpanSeconds, vttToSegments } from '../supabase/functions/_shared/transcript';
+
+/**
+ * A lesson's transcript has two witnesses, and its numbers one arithmetic.
+ *
+ * The browsers in the call stream segments live; Daily's stored WebVTT
+ * arrives after the call, authoritative but late and sometimes missing the
+ * first seconds or the tail after a drop. lesson-finalize merges the two
+ * into one transcript with one copy of each utterance, and computes
+ * lesson_metrics from it with the same function the room's live coach ran
+ * -- so the nudge a teacher saw in the room and the row stored afterwards
+ * are the same sums. These are online-lms's own tests
+ * (tests/daily-pipeline.test.ts and metrics.test.ts) run against the
+ * ported modules.
+ */
+
+describe('WebVTT parsing', () => {
+  const vtt = `WEBVTT
+
+1
+00:00:01.000 --> 00:00:04.500
+<v Maya Chen>Let's start with the first question.
+
+00:00:05.000 --> 00:00:07.000
+<v Aarav Sharma>Okay, I think we expand first?
+
+NOTE a comment
+
+00:01:02.250 --> 00:01:03.000
+Teacher: Good thinking.
+`;
+
+  it('reads cues, voice tags and colon labels', () => {
+    const cues = parseVtt(vtt);
+    expect(cues).toHaveLength(3);
+    expect(cues[0]).toEqual({ start_ms: 1000, end_ms: 4500, speaker: 'Maya Chen', text: "Let's start with the first question." });
+    expect(cues[1]!.speaker).toBe('Aarav Sharma');
+    expect(cues[2]).toMatchObject({ start_ms: 62250, speaker: 'Teacher', text: 'Good thinking.' });
+  });
+
+  it('maps speakers to roles, defaulting unknown voices to the student', () => {
+    const names = { teacher: 'Maya Chen', student: 'Aarav Sharma' };
+    expect(speakerRole('Maya Chen', names)).toBe('teacher');
+    expect(speakerRole('Maya', names)).toBe('teacher');
+    expect(speakerRole('Teacher', names)).toBe('teacher');
+    expect(speakerRole('Aarav', names)).toBe('student');
+    expect(speakerRole(null, names)).toBe('student');
+    const segs = vttToSegments(vtt, names);
+    expect(segs.map((s) => s.speaker)).toEqual(['teacher', 'student', 'teacher']);
+  });
+});
+
+describe('transcript merging', () => {
+  const seg = (speaker: 'teacher' | 'student', text: string, s: number, e: number) => ({ speaker, text, start_ms: s, end_ms: e });
+
+  it('dedupes the same utterance seen from two browsers', () => {
+    const a = seg('teacher', "Let's start with the first question.", 1000, 4500);
+    const b = seg('teacher', 'Lets start with the first question', 1200, 4400);
+    expect(segmentKey(a)).toBe(segmentKey(b));
+    expect(dedupeSegments([a, b])).toHaveLength(1);
+  });
+
+  it('keeps different utterances close in time', () => {
+    const d = dedupeSegments([seg('teacher', 'Yes.', 1000, 1500), seg('student', 'Yes.', 1200, 1600), seg('teacher', 'And the next one?', 1800, 3000)]);
+    expect(d).toHaveLength(3);
+  });
+
+  it('merges a stored transcript with the live stream, filling gaps either way', () => {
+    const live = [seg('teacher', 'Hello there', 0, 1000), seg('student', 'Hi', 1200, 1500), seg('teacher', 'Tail after a drop', 90_000, 92_000)];
+    const stored = [seg('student', 'Hi', 1250, 1500), seg('teacher', 'Middle part only in storage', 30_000, 33_000)];
+    const merged = mergeTranscripts(live, stored);
+    expect(merged.map((s) => s.text)).toEqual(['Hello there', 'Hi', 'Middle part only in storage', 'Tail after a drop']);
+    expect(transcriptSpanSeconds(merged)).toBe(92);
+  });
+});
+
+describe('the segments a jsonb column holds', () => {
+  it('reads the room\'s shape, the host as the teacher, and drops what is not a segment', () => {
+    const segs = segmentsFrom([
+      { speaker: 'teacher', text: 'How?', start_ms: 0, end_ms: 1000 },
+      { speaker: 'host', text: 'Why?', start_ms: '2000', end_ms: '3000' },
+      { speaker: 'learner', text: 'Because', start_ms: 4000, end_ms: 3500 },
+      { speaker: 'student', text: '   ', start_ms: 5000, end_ms: 6000 },
+      { text: 'no speaker', start_ms: 7000, end_ms: 8000 },
+      'not a segment',
+      null,
+      { speaker: 'student', text: 'no times' },
+    ]);
+    expect(segs).toEqual([
+      { speaker: 'teacher', text: 'How?', start_ms: 0, end_ms: 1000 },
+      { speaker: 'teacher', text: 'Why?', start_ms: 2000, end_ms: 3000 },
+      { speaker: 'student', text: 'Because', start_ms: 4000, end_ms: 4000 },
+      { speaker: 'student', text: 'no speaker', start_ms: 7000, end_ms: 8000 },
+    ]);
+    expect(segmentsFrom(null)).toEqual([]);
+    expect(segmentsFrom('[]')).toEqual([]);
+  });
+
+  it('counts words the way lesson_end does: whitespace-split, blank segments left out', () => {
+    expect(wordCount([{ speaker: 'teacher', text: ' How do we  expand this? ', start_ms: 0, end_ms: 1 }, { speaker: 'student', text: '', start_ms: 1, end_ms: 2 }])).toBe(5);
+  });
+});
+
+function seg(speaker: 'teacher' | 'student', text: string, startS: number, endS: number): TranscriptSegment {
+  return { speaker, text, start_ms: startS * 1000, end_ms: endS * 1000 };
+}
+
+describe('the lesson\'s numbers', () => {
+  it('returns all-zero metrics for an empty transcript', () => {
+    const m = computeMetrics([]);
+    expect(m.teacher_talk_pct).toBe(0);
+    expect(m.student_talk_pct).toBe(0);
+    expect(m.question_count).toBe(0);
+    expect(m.student_turns).toBe(0);
+  });
+
+  it('splits talk time between teacher and student', () => {
+    const m = computeMetrics([
+      seg('teacher', 'Today we factor quadratics.', 0, 30),
+      seg('student', 'Okay, I remember some of this.', 31, 41),
+    ]);
+    // 30s teacher vs 10s student of 40s total speech
+    expect(m.teacher_talk_pct).toBeCloseTo(0.75, 5);
+    expect(m.student_talk_pct).toBeCloseTo(0.25, 5);
+    expect(m.teacher_talk_pct + m.student_talk_pct).toBeCloseTo(1, 5);
+  });
+
+  it('counts teacher questions and classifies open ones', () => {
+    const m = computeMetrics([
+      seg('teacher', 'How would you start this problem?', 0, 4), // open
+      seg('student', 'Maybe expand the bracket first.', 5, 9),
+      seg('teacher', 'Is that a quadratic?', 10, 12), // closed
+      seg('student', 'Yes.', 13, 14),
+    ]);
+    expect(m.question_count).toBe(2);
+    expect(m.open_question_pct).toBeCloseTo(0.5, 5);
+  });
+
+  it('counts praise moments', () => {
+    const m = computeMetrics([
+      seg('teacher', "Well done, that's exactly the idea.", 0, 3),
+      seg('student', 'Thanks!', 4, 5),
+      seg('teacher', 'Now try the next one.', 6, 8),
+    ]);
+    expect(m.praise_count).toBeGreaterThanOrEqual(1);
+  });
+
+  it('counts student turns', () => {
+    const m = computeMetrics([
+      seg('teacher', 'What is x?', 0, 2),
+      seg('student', 'Two?', 3, 4),
+      seg('teacher', 'Why two?', 5, 6),
+      seg('student', 'Because both factors are x minus two.', 7, 11),
+    ]);
+    expect(m.student_turns).toBe(2);
+    expect(m.avg_student_turn_ms).toBeGreaterThan(0);
+  });
+
+  it('the seven columns lesson_metrics holds are exactly the ones computed', () => {
+    const m = computeMetrics([seg('teacher', 'What is x?', 0, 2), seg('student', 'Two?', 3, 4)]);
+    for (const column of ['teacher_talk_pct', 'student_talk_pct', 'question_count', 'open_question_pct', 'avg_wait_ms', 'student_turns', 'praise_count']) {
+      expect(typeof (m as unknown as Record<string, unknown>)[column]).toBe('number');
+    }
+  });
+});
diff --git a/__smoke__/lesson-finalize-is-the-databases-door.test.ts b/__smoke__/lesson-finalize-is-the-databases-door.test.ts
