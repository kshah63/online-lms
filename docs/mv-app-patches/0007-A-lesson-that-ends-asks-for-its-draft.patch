@@ -0,0 +1,151 @@
+// A lesson's transcript from two witnesses, made one. Pure, no Deno imports.
+//
+// Segments arrive from two places: the browsers in the call (live,
+// incremental, each client sees every transcription message; lesson_end
+// stores what the host's browser held) and Daily's stored WebVTT after the
+// call (authoritative but late, fetched by lesson-finalize on the
+// transcript.ready-to-download webhook). Both can hold the same utterance;
+// both can have gaps. Merging keeps one copy of each utterance and preserves
+// order; the stored one wins where both cover the same seconds.
+//
+// Ported from online-lms src/lib/transcripts/vtt.ts and merge.ts, unchanged.
+// Daily's cues may carry a voice tag like `<v Maya Chen>` naming the speaker;
+// names map to roles with the teacher's and student's names, and an unknown
+// voice is the student's, so a teacher-only transcript is never produced by
+// accident.
+
+import type { TranscriptSegment } from './lessonMetrics.ts';
+
+export interface VttCue {
+  start_ms: number;
+  end_ms: number;
+  speaker: string | null;
+  text: string;
+}
+
+const TIME = /(?:(\d{1,2}):)?(\d{2}):(\d{2})[.,](\d{3})/;
+
+export function parseVttTimestamp(s: string): number | null {
+  const m = s.trim().match(TIME);
+  if (!m) return null;
+  const h = m[1] ? Number(m[1]) : 0;
+  return ((h * 60 + Number(m[2])) * 60 + Number(m[3])) * 1000 + Number(m[4]);
+}
+
+export function parseVtt(text: string): VttCue[] {
+  const lines = text.replace(/\r\n?/g, '\n').split('\n');
+  const cues: VttCue[] = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i]!.trim();
+    if (!line || line === 'WEBVTT' || line.startsWith('NOTE') || line.startsWith('STYLE') || line.startsWith('REGION')) {
+      i++;
+      continue;
+    }
+    // Optional cue identifier line precedes the timing line.
+    let timing = line;
+    if (!timing.includes('-->')) {
+      i++;
+      timing = (lines[i] ?? '').trim();
+    }
+    if (!timing.includes('-->')) {
+      i++;
+      continue;
+    }
+    const [a, b] = timing.split('-->');
+    const start = parseVttTimestamp(a ?? '');
+    const end = parseVttTimestamp((b ?? '').split(/\s+/)[1] ?? b ?? '');
+    i++;
+    const body: string[] = [];
+    while (i < lines.length && lines[i]!.trim() !== '') {
+      body.push(lines[i]!);
+      i++;
+    }
+    if (start === null || end === null) continue;
+    let speaker: string | null = null;
+    let joined = body.join(' ').trim();
+    const voice = joined.match(/^<v(?:\.[^\s>]+)?\s+([^>]+)>/);
+    if (voice) {
+      speaker = voice[1]!.trim();
+      joined = joined.replace(/^<v[^>]*>/, '').replace(/<\/v>/g, '').trim();
+    } else {
+      const colon = joined.match(/^([A-Za-z][\w .'-]{0,40}):\s+(.+)$/);
+      if (colon) {
+        speaker = colon[1]!.trim();
+        joined = colon[2]!.trim();
+      }
+    }
+    joined = joined.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
+    if (joined) cues.push({ start_ms: start, end_ms: Math.max(end, start), speaker, text: joined });
+  }
+  return cues;
+}
+
+/** Decide teacher vs student for a cue's speaker label. */
+export function speakerRole(label: string | null, names: { teacher: string; student: string }): 'teacher' | 'student' {
+  if (!label) return 'student';
+  const l = label.toLowerCase();
+  const t = names.teacher.toLowerCase();
+  const s = names.student.toLowerCase();
+  if (l === t || l.includes(t) || t.includes(l)) return 'teacher';
+  if (l === s || l.includes(s) || s.includes(l)) return 'student';
+  if (/teacher|tutor/.test(l)) return 'teacher';
+  const tFirst = t.split(' ')[0] ?? t;
+  if (tFirst && l.split(' ')[0] === tFirst) return 'teacher';
+  return 'student';
+}
+
+export function vttToSegments(text: string, names: { teacher: string; student: string }): TranscriptSegment[] {
+  return parseVtt(text).map((c) => ({ speaker: speakerRole(c.speaker, names), text: c.text, start_ms: c.start_ms, end_ms: c.end_ms }));
+}
+
+/** A stable key so the same utterance posted twice (two browsers, a retry) is stored once. */
+export function segmentKey(s: TranscriptSegment): string {
+  const t = s.text.toLowerCase().replace(/[^a-z0-9 ]/g, '').replace(/\s+/g, ' ').trim();
+  return `${s.speaker}|${Math.round(s.start_ms / 500)}|${t.slice(0, 48)}`;
+}
+
+function similar(a: string, b: string): boolean {
+  const x = a.toLowerCase().replace(/[^a-z0-9 ]/g, '').trim();
+  const y = b.toLowerCase().replace(/[^a-z0-9 ]/g, '').trim();
+  if (!x || !y) return false;
+  if (x === y || x.includes(y) || y.includes(x)) return true;
+  const wx = x.split(' ');
+  const wy = new Set(y.split(' '));
+  const shared = wx.filter((w) => wy.has(w)).length;
+  return shared / Math.max(wx.length, wy.size) >= 0.7;
+}
+
+/** Deduplicate a stream of segments (same utterance within ~1.5s, same speaker, similar text). */
+export function dedupeSegments(segments: TranscriptSegment[]): TranscriptSegment[] {
+  const sorted = [...segments].sort((a, b) => a.start_ms - b.start_ms || a.end_ms - b.end_ms);
+  const out: TranscriptSegment[] = [];
+  for (const s of sorted) {
+    if (!s.text.trim()) continue;
+    const dup = out.some((o) => o.speaker === s.speaker && Math.abs(o.start_ms - s.start_ms) <= 1500 && similar(o.text, s.text));
+    if (!dup) out.push(s);
+  }
+  return out;
+}
+
+/**
+ * Merge the live stream with the stored transcript. The stored one wins where
+ * both cover the same time; the live stream fills anything the stored file
+ * lacks (it can be missing the first seconds or the tail after a drop).
+ */
+export function mergeTranscripts(live: TranscriptSegment[], stored: TranscriptSegment[]): TranscriptSegment[] {
+  if (stored.length === 0) return dedupeSegments(live);
+  if (live.length === 0) return dedupeSegments(stored);
+  const merged = dedupeSegments([...stored, ...live]);
+  // Prefer the stored text when a live segment was judged a duplicate: dedupe
+  // keeps the first by start time, so re-run with stored first on ties.
+  return merged;
+}
+
+/** Coverage in seconds — how much of the lesson the transcript spans. */
+export function transcriptSpanSeconds(segments: TranscriptSegment[]): number {
+  if (segments.length === 0) return 0;
+  const start = Math.min(...segments.map((s) => s.start_ms));
+  const end = Math.max(...segments.map((s) => s.end_ms));
+  return Math.max(0, Math.round((end - start) / 1000));
+}
