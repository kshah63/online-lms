+import { readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+import {
+  FOLLOWUP_ACTIONS,
+  FOLLOWUP_FORMAT,
+  FOLLOWUP_KINDS,
+  FOLLOWUP_PRIORITIES,
+  FOLLOWUP_SYSTEM,
+  atMs,
+  heuristicFollowups,
+  parseFollowups,
+  similarTitles,
+  toFollowupRow,
+} from '../supabase/functions/_shared/lessonFollowups';
+
+/**
+ * A follow-up is proposed under the centre's rules, whatever the model said.
+ *
+ * lesson-finalize reads the transcript for what the office should know and
+ * what a parent should hear, and proposes rows on lesson_followups for a
+ * person to approve. Four rules hold regardless of the model's answer: a
+ * concern about a child's wellbeing never becomes an automatic message --
+ * it goes to a staff call; a share always carries the words a parent would
+ * read; a deadline follows the priority; and an item already open for the
+ * student is not proposed twice. These are online-lms's own tests
+ * (tests/followups-extract.test.ts) against the ported module, plus the
+ * one thing this side adds: the kinds and actions are held equal to
+ * lesson_followups' CHECKs, read out of the migration, because the port
+ * renamed one action (call_parent became staff_call) and the next rename
+ * must not drift either side quietly.
+ */
+
+const MIGRATIONS = join(__dirname, '..', 'supabase', 'migrations');
+
+/** The strings a CHECK on `column` admits, read from the migration that created lesson_followups. */
+function checkListFor(column: 'kind' | 'action' | 'priority'): string[] {
+  const file = readdirSync(MIGRATIONS).find((f) => f.endsWith('.sql') && readFileSync(join(MIGRATIONS, f), 'utf8').includes('create table if not exists public.lesson_followups'));
+  expect(file).toBeDefined();
+  const sql = readFileSync(join(MIGRATIONS, file!), 'utf8');
+  const table = sql.slice(sql.indexOf('create table if not exists public.lesson_followups'));
+  const match = new RegExp(String.raw`\b${column}\s+text[^,]*?check\s*\(${column}\s+in\s*\(([^)]*)\)`, 's').exec(table);
+  expect(match).not.toBeNull();
+  return [...match![1].matchAll(/'([^']+)'/g)].map((m) => m[1]);
+}
+
+describe('the vocabulary is the table\'s', () => {
+  it('every kind, action and priority the extractor can emit is one the CHECKs admit, and vice versa', () => {
+    expect([...FOLLOWUP_KINDS].sort()).toEqual(checkListFor('kind').sort());
+    expect([...FOLLOWUP_ACTIONS].sort()).toEqual(checkListFor('action').sort());
+    expect([...FOLLOWUP_PRIORITIES].sort()).toEqual(checkListFor('priority').sort());
+  });
+
+  it('the schema the model is held to names the same lists, and the prompt never says call_parent', () => {
+    const items = (FOLLOWUP_FORMAT.schema.properties as { items: { items: { properties: Record<string, { enum?: string[] }> } } }).items.items.properties;
+    expect(items.kind.enum).toEqual([...FOLLOWUP_KINDS]);
+    expect(items.action.enum).toEqual([...FOLLOWUP_ACTIONS]);
+    expect(items.priority.enum).toEqual([...FOLLOWUP_PRIORITIES]);
+    expect(FOLLOWUP_SYSTEM).not.toMatch(/call_parent/);
+    for (const action of ['note_for_next_lesson', 'staff_task', 'share_with_parent']) expect(FOLLOWUP_SYSTEM).toContain(action);
+  });
+});
+
+describe('parseFollowups', () => {
+  const item = (o: Partial<Record<string, unknown>> = {}) => ({
+    kind: 'win',
+    action: 'share_with_parent',
+    priority: 'normal',
+    title: 'Solved quadratics alone',
+    detail: 'First time unaided.',
+    quote: 'I did it!',
+    at: '12:34',
+    suggested_parent_message: null,
+    due_in_days: 3,
+    ...o,
+  });
+
+  it('applies policy: concerns go to a staff call, misconceptions to the next lesson, shares carry a message', () => {
+    const r = parseFollowups({
+      items: [
+        item(),
+        item({ kind: 'concern', action: 'share_with_parent', priority: 'low', title: 'Seemed exhausted', detail: 'Yawning throughout.' }),
+        item({ kind: 'misconception', action: 'share_with_parent', title: 'Sign errors when expanding', detail: 'Three times.' }),
+      ],
+      nothing_notable: false,
+    });
+    expect(r.errors).toEqual([]);
+    const byTitle = Object.fromEntries(r.items.map((i) => [i.title, i]));
+    expect(byTitle['Solved quadratics alone']).toMatchObject({ action: 'share_with_parent', suggested_parent_message: 'First time unaided.', due_in_days: 3 });
+    expect(byTitle['Seemed exhausted']).toMatchObject({ kind: 'concern', action: 'staff_call', priority: 'normal' });
+    expect(byTitle['Sign errors when expanding']).toMatchObject({ action: 'note_for_next_lesson' });
+  });
+
+  it('drops duplicates of open items and within the batch, and sorts by priority', () => {
+    const r = parseFollowups(
+      { items: [item({ priority: 'low' }), item({ title: 'solved quadratics alone!' }), item({ title: 'Exam next Friday', kind: 'exam_upcoming', action: 'staff_task', priority: 'high', due_in_days: 5 })], nothing_notable: false },
+      ['Exam next friday'],
+    );
+    expect(r.items).toHaveLength(1);
+    expect(r.items[0]!.title).toBe('Solved quadratics alone');
+  });
+
+  it('caps due dates by priority and validates timestamps', () => {
+    const r = parseFollowups({ items: [item({ priority: 'high', due_in_days: 9, at: 'bad' })], nothing_notable: false });
+    expect(r.items[0]).toMatchObject({ due_in_days: 1, at: null });
+  });
+
+  it('reports schema errors', () => {
+    expect(parseFollowups({ items: [{ kind: 'nope' }] }).errors.length).toBeGreaterThan(0);
+    expect(parseFollowups({ items: [item({ action: 'call_parent' })] }).errors).toEqual(['items.0.action: Invalid enum value']);
+    expect(parseFollowups('not even an object').errors).toEqual(['Expected object']);
+    expect(parseFollowups({ nothing_notable: true }).errors).toEqual(['items: Expected array']);
+  });
+
+  it('fills the optional fields the way the original schema defaulted them', () => {
+    const r = parseFollowups({ items: [{ kind: 'win', action: 'share_with_parent', priority: 'normal', title: 'A', detail: 'B' }] });
+    expect(r.errors).toEqual([]);
+    expect(r.items[0]).toMatchObject({ quote: null, at: null, suggested_parent_message: 'B', due_in_days: 3 });
+  });
+});
+
+describe('similarTitles', () => {
+  it('matches containment and shared-word overlap', () => {
+    expect(similarTitles('Exam next Friday', 'exam next friday!')).toBe(true);
+    expect(similarTitles('Student mentioned an upcoming test', 'Upcoming test mentioned by student')).toBe(true);
+    expect(similarTitles('Holiday in June', 'Sign errors')).toBe(false);
+  });
+});
+
+describe('heuristicFollowups', () => {
+  it('finds exam mentions, tiredness, logistics and repeated confusion in student speech only', () => {
+    const seg = (speaker: 'teacher' | 'student', text: string, s: number) => ({ speaker, text, start_ms: s * 1000, end_ms: s * 1000 + 2000 });
+    const items = heuristicFollowups([
+      seg('student', 'I have a maths test next Thursday', 60),
+      seg('teacher', 'I have a test next week too', 70),
+      seg('student', "I'm so tired, I didn't sleep", 120),
+      seg('student', "we're on holiday the week after", 180),
+      seg('student', "I don't get it", 200),
+      seg('student', "I'm confused", 210),
+      seg('student', 'no idea', 220),
+    ]);
+    const kinds = items.map((i) => i.kind).sort();
+    expect(kinds).toEqual(['concern', 'exam_upcoming', 'logistics', 'misconception']);
+    expect(items.find((i) => i.kind === 'exam_upcoming')?.at).toBe('01:00');
+    expect(items.find((i) => i.kind === 'concern')?.action).toBe('staff_call');
+  });
+
+  it('proposes nothing from an empty transcript', () => {
+    expect(heuristicFollowups([])).toEqual([]);
+  });
+});
+
+describe('the row the worker takes', () => {
+  it('carries the marker as milliseconds, under the names worker_store_lesson_results reads', () => {
+    expect(atMs('12:34')).toBe(754_000);
+    expect(atMs('01:00')).toBe(60_000);
+    expect(atMs(null)).toBeNull();
+    expect(atMs('bad')).toBeNull();
+    const row = toFollowupRow({
+      kind: 'win',
+      action: 'share_with_parent',
+      priority: 'normal',
+      title: 'Cracked the cross product',
+      detail: 'Got every example right unaided',
+      quote: 'oh, I see it now',
+      at: '30:20',
+      suggested_parent_message: 'Ben cracked the cross product today.',
+      due_in_days: 3,
+    });
+    expect(row).toEqual({
+      kind: 'win',
+      action: 'share_with_parent',
+      priority: 'normal',
+      title: 'Cracked the cross product',
+      detail: 'Got every example right unaided',
+      quote: 'oh, I see it now',
+      at_ms: 1_820_000,
+      suggested_parent_message: 'Ben cracked the cross product today.',
+    });
+    expect(Object.keys(row)).not.toContain('due_in_days');
+    expect(Object.keys(row)).not.toContain('at');
+  });
+});
diff --git a/__smoke__/a-lesson-report-draft-speaks-the-forms-vocabulary.test.ts b/__smoke__/a-lesson-report-draft-speaks-the-forms-vocabulary.test.ts
