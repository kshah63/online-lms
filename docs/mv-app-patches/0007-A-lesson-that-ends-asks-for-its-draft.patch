index 0000000..31a0454
--- /dev/null
+++ b/supabase/functions/_shared/lessonFollowups.ts
@@ -0,0 +1,330 @@
+// Session → follow-ups: what the office should know and what a parent should
+// hear, read out of the transcript. The prompt, the shape the model is held
+// to, the policy applied to whatever it says, the keyword fallback, and the
+// row each item becomes for worker_store_lesson_results. Pure, no Deno
+// imports.
+//
+// Ported from online-lms src/lib/followups/extract.ts (the prompt) and
+// extract-parse.ts (everything else), unchanged except for ONE WORD: the
+// action online-lms calls `call_parent` is `staff_call` here, because that
+// is the spelling lesson_followups_action_check admits and the one
+// approve_followup files a task for. The kinds and the other three actions
+// were already the database's; a-follow-up-is-proposed-under-the-centres-
+// rules.test.ts reads the CHECKs out of the migration and holds these lists
+// to them, so the next rename cannot drift either side quietly.
+//
+// The policy in parseFollowups is the part worth knowing by heart: a concern
+// about wellbeing never becomes an automatic message, whatever the model
+// said -- it goes to a staff call; a share always carries the words a parent
+// would read; a deadline follows the priority; and an item already open for
+// the student is not proposed twice.
+
+import type { TranscriptSegment } from './lessonMetrics.ts';
+
+export type FollowupKind =
+  | 'win' // something worth sharing with the parent
+  | 'concern' // wellbeing, tiredness, distraction, repeated struggle
+  | 'misconception' // a specific error pattern that keeps recurring
+  | 'logistics' // holiday, wants a different time, clash
+  | 'exam_upcoming' // a test or exam the student mentioned
+  | 'ask_to_relay' // "tell my mum …"
+  | 'tech_issue'; // audio, camera, device trouble
+
+export type FollowupAction =
+  | 'share_with_parent' // post in the family thread (a person approves first)
+  | 'staff_call' // staff should speak to the parent
+  | 'note_for_next_lesson' // a standing note for the teacher
+  | 'staff_task'; // internal to-do (reschedule, check equipment)
+
+export type FollowupPriority = 'low' | 'normal' | 'high';
+
+export const FOLLOWUP_KINDS: readonly FollowupKind[] = [
+  'win', 'concern', 'misconception', 'logistics', 'exam_upcoming', 'ask_to_relay', 'tech_issue',
+];
+export const FOLLOWUP_ACTIONS: readonly FollowupAction[] = [
+  'share_with_parent', 'staff_call', 'note_for_next_lesson', 'staff_task',
+];
+export const FOLLOWUP_PRIORITIES: readonly FollowupPriority[] = ['low', 'normal', 'high'];
+
+export interface ExtractedFollowup {
+  kind: FollowupKind;
+  action: FollowupAction;
+  priority: FollowupPriority;
+  title: string;
+  detail: string;
+  quote: string | null;
+  at: string | null; // "mm:ss"
+  suggested_parent_message: string | null;
+  due_in_days: number;
+}
+
+export const FOLLOWUP_FORMAT = {
+  type: 'json_schema' as const,
+  schema: {
+    type: 'object',
+    additionalProperties: false,
+    properties: {
+      items: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: false,
+          properties: {
+            kind: { type: 'string', enum: [...FOLLOWUP_KINDS] },
+            action: { type: 'string', enum: [...FOLLOWUP_ACTIONS] },
+            priority: { type: 'string', enum: [...FOLLOWUP_PRIORITIES] },
+            title: { type: 'string' },
+            detail: { type: 'string' },
+            quote: { type: ['string', 'null'] },
+            at: { type: ['string', 'null'] },
+            suggested_parent_message: { type: ['string', 'null'] },
+            due_in_days: { type: 'integer' },
+          },
+          required: ['kind', 'action', 'priority', 'title', 'detail', 'quote', 'at', 'suggested_parent_message', 'due_in_days'],
+        },
+      },
+      nothing_notable: { type: 'boolean' },
+    },
+    required: ['items', 'nothing_notable'],
+  },
+};
+
+export const FOLLOWUP_SYSTEM = `You read the transcript of a 1-1 online maths lesson with a school-age student and list what the tuition centre should follow up on.
+
+Only report things ACTUALLY in the transcript. Prefer fewer, specific items. Kinds:
+- win: a genuine step forward a parent would like to hear (first time solving X alone, big effort).
+- concern: wellbeing or engagement — tired, upset, distracted, repeatedly disengaged, says something worrying. These always go to a staff phone call, never an automatic message.
+- misconception: an error pattern that recurred (sign errors, dividing by the wrong side). Action note_for_next_lesson.
+- logistics: holidays, wanting a different time, clashes, missed-lesson reasons. Action staff_task.
+- exam_upcoming: any test, exam, mock, assessment the student mentions with a time. Action staff_task, priority normal or high if within a week.
+- ask_to_relay: the student asks for something to be told to a parent. Action share_with_parent.
+- tech_issue: audio/camera/device trouble that cost lesson time. Action staff_task.
+For share_with_parent write suggested_parent_message as a warm, plain two-sentence message from the teacher to the parent, first person, naming the student by first name. quote is a short verbatim excerpt (max 20 words); at is the [mm:ss] of that line. due_in_days: 1 for high, 3 for normal, 7 for low. If nothing is notable, return an empty list and nothing_notable true.`;
+
+export interface ExtractFollowupsInput {
+  segments: TranscriptSegment[];
+  studentFirstName: string;
+  course: string;
+  /** Titles of follow-ups already open for this student, to avoid duplicates. */
+  openTitles: string[];
+  /** Optional one-paragraph summary of what was on the whiteboard. */
+  notebookSummary?: string | null;
+}
+
+const fmt = (ms: number) =>
+  `${String(Math.floor(ms / 60000)).padStart(2, '0')}:${String(Math.floor((ms % 60000) / 1000)).padStart(2, '0')}`;
+
+/** The user turn extract.ts sends. */
+export function followupUserPrompt(input: ExtractFollowupsInput): string {
+  const transcript = input.segments
+    .map((s) => `[${fmt(s.start_ms)}] ${s.speaker === 'teacher' ? 'Teacher' : 'Student'}: ${s.text}`)
+    .join('\n');
+  return `Student: ${input.studentFirstName}. Course: ${input.course}.
+${input.openTitles.length ? `Already being followed up (do not repeat): ${input.openTitles.join('; ')}\n` : ''}${input.notebookSummary ? `Whiteboard summary: ${input.notebookSummary}\n` : ''}
+Transcript:
+${transcript}`;
+}
+
+/** Default owner-facing deadlines by priority, in days. */
+export const DUE_DAYS: Record<FollowupPriority, number> = { high: 1, normal: 3, low: 7 };
+
+function normaliseTitle(t: string): string {
+  return t.toLowerCase().replace(/[^a-z0-9 ]/g, '').replace(/\s+/g, ' ').trim();
+}
+
+/** Two titles are "the same" when one contains the other or they share most words. */
+export function similarTitles(a: string, b: string): boolean {
+  const x = normaliseTitle(a);
+  const y = normaliseTitle(b);
+  if (!x || !y) return false;
+  if (x === y || x.includes(y) || y.includes(x)) return true;
+  const wx = new Set(x.split(' ').filter((w) => w.length > 3));
+  const wy = new Set(y.split(' ').filter((w) => w.length > 3));
+  if (wx.size === 0 || wy.size === 0) return false;
+  let shared = 0;
+  for (const w of wx) if (wy.has(w)) shared++;
+  return shared / Math.min(wx.size, wy.size) >= 0.6;
+}
+
+/** The raw item extract-parse.ts's RawItem admits, with its defaults applied. */
+interface RawItem {
+  kind: FollowupKind;
+  action: FollowupAction;
+  priority: FollowupPriority;
+  title: string;
+  detail: string;
+  quote: string | null;
+  at: string | null;
+  suggested_parent_message: string | null;
+  due_in_days: number;
+}
+
+function oneOf<T extends string>(list: readonly T[], value: unknown): value is T {
+  return typeof value === 'string' && (list as readonly string[]).includes(value);
+}
+
+/**
+ * The same acceptance as RawFollowups.safeParse: a root object with an
+ * `items` array; each item's kind, action and priority from the enums,
+ * title and detail strings; quote, at and suggested_parent_message a string
+ * or null (absent reads as null); due_in_days a number (absent reads as 3);
+ * nothing_notable a boolean (absent reads as false). Errors name the path.
+ */
+function readRaw(raw: unknown): { items: RawItem[]; errors: string[] } {
+  const errors: string[] = [];
+  if (!raw || typeof raw !== 'object') return { items: [], errors: ['Expected object'] };
+  const root = raw as Record<string, unknown>;
+  if (!Array.isArray(root.items)) return { items: [], errors: ['items: Expected array'] };
+  if (root.nothing_notable !== undefined && typeof root.nothing_notable !== 'boolean') {
+    errors.push('nothing_notable: Expected boolean');
+  }
+  const items: RawItem[] = [];
+  root.items.forEach((item, i) => {
+    if (!item || typeof item !== 'object') {
+      errors.push(`items.${i}: Expected object`);
+      return;
+    }
+    const r = item as Record<string, unknown>;
+    if (!oneOf(FOLLOWUP_KINDS, r.kind)) errors.push(`items.${i}.kind: Invalid enum value`);
+    if (!oneOf(FOLLOWUP_ACTIONS, r.action)) errors.push(`items.${i}.action: Invalid enum value`);
+    if (!oneOf(FOLLOWUP_PRIORITIES, r.priority)) errors.push(`items.${i}.priority: Invalid enum value`);
+    if (typeof r.title !== 'string') errors.push(`items.${i}.title: Expected string`);
+    if (typeof r.detail !== 'string') errors.push(`items.${i}.detail: Expected string`);
+    for (const key of ['quote', 'at', 'suggested_parent_message']) {
+      if (r[key] !== undefined && r[key] !== null && typeof r[key] !== 'string') {
+        errors.push(`items.${i}.${key}: Expected string or null`);
+      }
+    }
+    if (r.due_in_days !== undefined && (typeof r.due_in_days !== 'number' || Number.isNaN(r.due_in_days))) {
+      errors.push(`items.${i}.due_in_days: Expected number`);
+    }
+    if (errors.length > 0) return;
+    items.push({
+      kind: r.kind as FollowupKind,
+      action: r.action as FollowupAction,
+      priority: r.priority as FollowupPriority,
+      title: r.title as string,
+      detail: r.detail as string,
+      quote: (r.quote as string | null | undefined) ?? null,
+      at: (r.at as string | null | undefined) ?? null,
+      suggested_parent_message: (r.suggested_parent_message as string | null | undefined) ?? null,
+      due_in_days: (r.due_in_days as number | undefined) ?? 3,
+    });
+  });
+  return { items, errors };
+}
+
+/**
+ * Validate and tidy. Rules applied regardless of what the model said:
+ * - a concern about wellbeing is never auto-shared; it goes to a call.
+ * - share_with_parent always carries a suggested message.
+ * - deadlines follow priority unless the model gave a sooner one.
+ * - items already open for this student (by title) are dropped.
+ */
+export function parseFollowups(raw: unknown, openTitles: string[] = []): { items: ExtractedFollowup[]; errors: string[] } {
+  const parsed = readRaw(raw);
+  if (parsed.errors.length > 0) return { items: [], errors: parsed.errors };
+
+  const out: ExtractedFollowup[] = [];
+  for (const it of parsed.items) {
+    const title = it.title.trim();
+    const detail = it.detail.trim();
+    if (!title || !detail) continue;
+    if (openTitles.some((t) => similarTitles(t, title))) continue;
+    if (out.some((o) => similarTitles(o.title, title))) continue;
+
+    let action = it.action;
+    let priority = it.priority;
+    if (it.kind === 'concern') {
+      action = 'staff_call';
+      if (priority === 'low') priority = 'normal';
+    }
+    if (it.kind === 'exam_upcoming' && priority === 'low') priority = 'normal';
+    if (it.kind === 'misconception' && action === 'share_with_parent') action = 'note_for_next_lesson';
+
+    const suggested = action === 'share_with_parent' ? (it.suggested_parent_message?.trim() || detail) : it.suggested_parent_message?.trim() || null;
+    const due = Math.max(1, Math.min(DUE_DAYS[priority], Math.round(it.due_in_days || DUE_DAYS[priority])));
+
+    out.push({
+      kind: it.kind,
+      action,
+      priority,
+      title,
+      detail,
+      quote: it.quote?.trim() || null,
+      at: it.at && /^\d{1,2}:\d{2}$/.test(it.at.trim()) ? it.at.trim() : null,
+      suggested_parent_message: suggested,
+      due_in_days: due,
+    });
+  }
+  const order: Record<FollowupPriority, number> = { high: 0, normal: 1, low: 2 };
+  out.sort((a, b) => order[a.priority] - order[b.priority]);
+  return { items: out, errors: [] };
+}
+
+// --- heuristic fallback (no API key) --------------------------------------
+
+const EXAM = /\b(exam|test|assessment|mock|paper|quiz)\b.*\b(next|this|tomorrow|on|coming|week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/i;
+const CONFUSED = /\b(don'?t get|don'?t understand|confused|lost|stuck|no idea)\b/i;
+const TIRED = /\b(tired|sleepy|didn'?t sleep|headache|sick|unwell)\b/i;
+const LOGISTICS = /\b(holiday|travelling|away|can'?t make|change (the )?time|move (the )?lesson|reschedule)\b/i;
+const TECH = /\b(can'?t hear|cannot hear|can'?t see|lag|frozen|audio|camera|mic|internet)\b/i;
+const RELAY = /\b(tell my (mum|mom|dad|parents|mother|father))\b/i;
+
+/** Transcript-keyword fallback so the pipeline still produces items without a key. */
+export function heuristicFollowups(
+  segments: { speaker: 'teacher' | 'student'; text: string; start_ms: number }[],
+  openTitles: string[] = [],
+): ExtractedFollowup[] {
+  const items: ExtractedFollowup[] = [];
+  let confusionCount = 0;
+  for (const s of segments) {
+    if (s.speaker !== 'student') continue;
+    const at = fmt(s.start_ms);
+    if (EXAM.test(s.text)) items.push({ kind: 'exam_upcoming', action: 'staff_task', priority: 'normal', title: 'Student mentioned an upcoming test', detail: s.text, quote: s.text, at, suggested_parent_message: null, due_in_days: 3 });
+    if (TIRED.test(s.text)) items.push({ kind: 'concern', action: 'staff_call', priority: 'normal', title: 'Student seemed unwell or tired', detail: s.text, quote: s.text, at, suggested_parent_message: null, due_in_days: 3 });
+    if (LOGISTICS.test(s.text)) items.push({ kind: 'logistics', action: 'staff_task', priority: 'normal', title: 'Scheduling change mentioned', detail: s.text, quote: s.text, at, suggested_parent_message: null, due_in_days: 3 });
+    if (TECH.test(s.text)) items.push({ kind: 'tech_issue', action: 'staff_task', priority: 'low', title: 'Tech trouble during the lesson', detail: s.text, quote: s.text, at, suggested_parent_message: null, due_in_days: 7 });
+    if (RELAY.test(s.text)) items.push({ kind: 'ask_to_relay', action: 'share_with_parent', priority: 'normal', title: 'Student asked for something to be passed on', detail: s.text, quote: s.text, at, suggested_parent_message: s.text, due_in_days: 3 });
+    if (CONFUSED.test(s.text)) confusionCount++;
+  }
+  if (confusionCount >= 3) {
+    items.push({ kind: 'misconception', action: 'note_for_next_lesson', priority: 'normal', title: 'Repeated confusion during the lesson', detail: `The student said they were stuck or confused ${confusionCount} times.`, quote: null, at: null, suggested_parent_message: null, due_in_days: 3 });
+  }
+  return parseFollowups({ items, nothing_notable: items.length === 0 }, openTitles).items;
+}
+
+// --- the row the worker takes ----------------------------------------------
+
+/** "mm:ss" (the transcript marker) as milliseconds, or null when it is not one. */
+export function atMs(at: string | null): number | null {
+  if (!at) return null;
+  const m = /^(\d{1,2}):(\d{2})$/.exec(at.trim());
+  if (!m) return null;
+  return (Number(m[1]) * 60 + Number(m[2])) * 1000;
+}
+
+/** What worker_store_lesson_results reads off each element of p_followups. */
+export interface FollowupRow {
+  kind: FollowupKind;
+  action: FollowupAction;
+  priority: FollowupPriority;
+  title: string;
+  detail: string;
+  quote: string | null;
+  at_ms: number | null;
+  suggested_parent_message: string | null;
+}
+
+export function toFollowupRow(item: ExtractedFollowup): FollowupRow {
+  return {
+    kind: item.kind,
+    action: item.action,
+    priority: item.priority,
+    title: item.title,
+    detail: item.detail,
+    quote: item.quote,
+    at_ms: atMs(item.at),
+    suggested_parent_message: item.suggested_parent_message,
+  };
+}
diff --git a/supabase/functions/_shared/lessonMetrics.ts b/supabase/functions/_shared/lessonMetrics.ts
new file mode 100644
index 0000000..e42fe16
--- /dev/null
+++ b/supabase/functions/_shared/lessonMetrics.ts
@@ -0,0 +1,180 @@
+// A lesson's numbers, from its transcript. Pure, no Deno imports, so the
+// smoke suite holds the rules themselves rather than a regex over index.ts.
+//
+// Ported line for line from online-lms src/lib/coaching/metrics.ts (§7.1),
+// which the room's live coach also runs: the two must agree, because the
+// live nudge a teacher saw in the room and the row in lesson_metrics are the
+// same arithmetic and a disagreement would look like the lesson changed
+// after it ended. computeMetrics() is that port, unchanged. segmentsFrom() is
+// this side's own: the segments arrive as jsonb from lesson_transcripts, so
+// whatever is not a segment is dropped here rather than crashing the worker.
+
+export interface TranscriptSegment {
+  speaker: 'teacher' | 'student';
+  text: string;
+  start_ms: number;
+  end_ms: number;
+}
+
+export interface SessionMetrics {
+  teacher_talk_pct: number;
+  student_talk_pct: number;
+  question_count: number;
+  open_question_pct: number;
+  avg_wait_ms: number;
+  student_turns: number;
+  avg_student_turn_ms: number;
+  praise_count: number;
+}
+
+const OPEN_STARTERS = ['how', 'why', 'what', 'describe', 'explain', 'tell', 'walk', 'where', 'which'];
+const PRAISE = [
+  'great',
+  'good job',
+  'good work',
+  'well done',
+  'excellent',
+  'nice',
+  'exactly',
+  'perfect',
+  'brilliant',
+  'awesome',
+  'fantastic',
+  "that's right",
+  'thats right',
+  'well thought',
+  'good thinking',
+];
+
+function dur(s: TranscriptSegment) {
+  return Math.max(0, s.end_ms - s.start_ms);
+}
+
+function isQuestion(text: string) {
+  return text.trim().endsWith('?');
+}
+
+function isOpenQuestion(text: string) {
+  const first = text.trim().toLowerCase().split(/\s+/)[0] ?? '';
+  return OPEN_STARTERS.includes(first);
+}
+
+function hasPraise(text: string) {
+  const lower = text.toLowerCase();
+  return PRAISE.some((p) => lower.includes(p));
+}
+
+/** Compute the full metric set from an ordered transcript. */
+export function computeMetrics(segments: TranscriptSegment[]): SessionMetrics {
+  if (segments.length === 0) {
+    return {
+      teacher_talk_pct: 0,
+      student_talk_pct: 0,
+      question_count: 0,
+      open_question_pct: 0,
+      avg_wait_ms: 0,
+      student_turns: 0,
+      avg_student_turn_ms: 0,
+      praise_count: 0,
+    };
+  }
+
+  const ordered = [...segments].sort((a, b) => a.start_ms - b.start_ms);
+
+  let teacherMs = 0;
+  let studentMs = 0;
+  let questionCount = 0;
+  let openCount = 0;
+  let praiseCount = 0;
+  const waits: number[] = [];
+
+  for (let i = 0; i < ordered.length; i++) {
+    const seg = ordered[i];
+    if (seg.speaker === 'teacher') {
+      teacherMs += dur(seg);
+      if (hasPraise(seg.text)) praiseCount++;
+      if (isQuestion(seg.text)) {
+        questionCount++;
+        if (isOpenQuestion(seg.text)) openCount++;
+        // wait-time: silence until the next student turn starts
+        const next = ordered.slice(i + 1).find((s) => s.speaker === 'student');
+        if (next) waits.push(Math.max(0, next.start_ms - seg.end_ms));
+      }
+    } else {
+      studentMs += dur(seg);
+    }
+  }
+
+  // Student turns = contiguous runs of student speech.
+  const turns: number[] = [];
+  let runStart: number | null = null;
+  let runEnd = 0;
+  for (const seg of ordered) {
+    if (seg.speaker === 'student') {
+      if (runStart === null) runStart = seg.start_ms;
+      runEnd = seg.end_ms;
+    } else if (runStart !== null) {
+      turns.push(runEnd - runStart);
+      runStart = null;
+    }
+  }
+  if (runStart !== null) turns.push(runEnd - runStart);
+
+  const totalSpeech = teacherMs + studentMs || 1;
+  const avg = (xs: number[]) => (xs.length ? Math.round(xs.reduce((a, b) => a + b, 0) / xs.length) : 0);
+
+  return {
+    teacher_talk_pct: round2(teacherMs / totalSpeech),
+    student_talk_pct: round2(studentMs / totalSpeech),
+    question_count: questionCount,
+    open_question_pct: questionCount ? round2(openCount / questionCount) : 0,
+    avg_wait_ms: avg(waits),
+    student_turns: turns.length,
+    avg_student_turn_ms: avg(turns),
+    praise_count: praiseCount,
+  };
+}
+
+function round2(n: number) {
+  return Math.round(n * 100) / 100;
+}
+
+/**
+ * The segments a jsonb column holds, as typed segments.
+ *
+ * The room writes {speaker, text, start_ms, end_ms} with the host already
+ * named 'teacher' and the learner 'student'; a row that says 'host' or
+ * 'learner' instead is read the same way, and anything without a text and
+ * two numbers is not a segment and is left out. A worker that threw on one
+ * malformed row would lose the whole lesson's draft over it.
+ */
+export function segmentsFrom(raw: unknown): TranscriptSegment[] {
+  if (!Array.isArray(raw)) return [];
+  const out: TranscriptSegment[] = [];
+  for (const item of raw) {
+    if (!item || typeof item !== 'object') continue;
+    const r = item as Record<string, unknown>;
+    const text = typeof r.text === 'string' ? r.text : '';
+    const start = typeof r.start_ms === 'number' ? r.start_ms : Number(r.start_ms);
+    const end = typeof r.end_ms === 'number' ? r.end_ms : Number(r.end_ms);
+    if (!text.trim() || !Number.isFinite(start) || !Number.isFinite(end)) continue;
+    const who = String(r.speaker ?? '').toLowerCase();
+    out.push({
+      speaker: who === 'teacher' || who === 'host' ? 'teacher' : 'student',
+      text,
+      start_ms: start,
+      end_ms: Math.max(end, start),
+    });
+  }
+  return out;
+}
+
+/** The word count lesson_end stores: whitespace-split tokens of every non-blank segment. */
+export function wordCount(segments: TranscriptSegment[]): number {
+  let n = 0;
+  for (const s of segments) {
+    const t = s.text.trim();
+    if (t) n += t.split(/\s+/).length;
+  }
+  return n;
+}
diff --git a/supabase/functions/_shared/lessonNews.ts b/supabase/functions/_shared/lessonNews.ts
new file mode 100644
index 0000000..6213455
--- /dev/null
+++ b/supabase/functions/_shared/lessonNews.ts
@@ -0,0 +1,31 @@
+// Backfill or news: the one question every writer of a push-triggered row
+// has to answer, asked here for what lesson-finalize stores.
+//
+// A draft for a lesson that ended an hour ago is news: the teacher's phone
+// should say so. The same draft computed for a lesson three days back --
+// a re-read of a trailing window, a transcript that arrived late, a replay
+// after an outage -- is a mirror catching up, and it stays quiet
+// (worker_store_lesson_results takes p_quiet and sets app.push_quiet). The
+// expensive mistake is the quiet one in the wrong direction, and the loud
+// one is #489: pushes about days already over. A day is the line.
+
+/** A lesson whose start is further back than this is backfill, not news. */
+export const OLD_NEWS_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * Whether storing this lesson's results is old news. The booking's
+ * effective_start is the start that counts; a row without one falls back
+ * to the confirmed or requested start, and one with no start at all is
+ * treated as news -- better one notification about an odd row than a
+ * silence nobody can report.
+ */
+export function isOldNews(
+  session: { effective_start: string | null; confirmed_start: string | null; requested_start: string | null },
+  nowMs: number,
+): boolean {
+  const start = session.effective_start ?? session.confirmed_start ?? session.requested_start;
+  if (!start) return false;
+  const at = Date.parse(start);
+  if (!Number.isFinite(at)) return false;
+  return at < nowMs - OLD_NEWS_MS;
+}
diff --git a/supabase/functions/_shared/reportDraft.ts b/supabase/functions/_shared/reportDraft.ts
new file mode 100644
index 0000000..0dcc86d
--- /dev/null
+++ b/supabase/functions/_shared/reportDraft.ts
@@ -0,0 +1,330 @@
+// The per-session report, drafted in session_reports' own vocabulary: the
+// nine prev_hw strings, GP in quarters, OTR in bands of five, understanding
+// 1..10. The normalisers, the prompt, the reading of what the model said and
+// the notes-first fallback. Pure, no Deno imports, so the smoke suite can
+// hold the rules the way it holds _shared/familyAudience.ts.
+//
+// Ported from online-lms src/lib/reports/mvapp-template.ts (the vocabulary
+// and normalisers, "Mirrors mv-app/src/lib/reportFields.ts; keep the two in
+// step") and src/lib/reports/draft-session-report.ts (the prompt,
+// normaliseDraft and heuristicSessionReport), unchanged. These run BEFORE
+// lesson_report_drafts' own CHECKs (prev_hw in the nine, otr a band), so a
+// model that says "partly" or 83 is coerced here and the database never sees
+// a value the report form would not offer.
+
+/** Previous homework — the portal's nine answers, in the portal's order. */
+export const PREV_HW_OPTIONS = [
+  'Yes',
+  'Most of it Done',
+  'Partially Done',
+  'Little Done',
+  'Not Done',
+  'No Homework Given',
+  'Did Not Bring / Did Not Send Through Email/Whatsapp',
+  'Did Not Bring Exercise Book',
+  'Done And Sent Through Email/Skype/Whatsapp',
+] as const;
+export type PrevHw = (typeof PREV_HW_OPTIONS)[number];
+
+/** GP: 7.0 down to 1.0 in quarters, best first. */
+export const GP_OPTIONS: number[] = Array.from({ length: (7 - 1) * 4 + 1 }, (_, i) => 7 - i * 0.25);
+
+/** Understanding: 10 down to 1. */
+export const UNDERSTANDING_OPTIONS: number[] = Array.from({ length: 10 }, (_, i) => 10 - i);
+
+/** Oral test result: a band, stored as its lower bound (95 … 5). */
+export const OTR_BANDS: { lower: number; label: string }[] = Array.from({ length: 19 }, (_, i) => {
+  const val = 19 - i;
+  return { lower: val * 5, label: `${val * 5}% to ${(val + 1) * 5}%` };
+});
+
+export interface WrittenTest {
+  name: string;
+  score: number | null;
+  out_of: number | null;
+  percent: number | null;
+}
+
+/** The report as it is drafted, before submit_report. */
+export interface SessionReportDraft {
+  topic: string;
+  topic_completed: boolean;
+  topics_not_done: string | null;
+  understanding: number; // 1..10
+  otr: number | null; // band lower bound or null = no oral test
+  gp: number | null; // 1..7 in quarters; only when the author signs the report
+  prev_hw: PrevHw | null;
+  homework: string;
+  remarks: string;
+  written_tests: WrittenTest[];
+  has_upcoming_tests: boolean;
+}
+
+// --- normalisers for values that come from a model or free typing ----------
+
+/** Snap to the nearest quarter within 1..7, or null when absent. */
+export function normaliseGp(value: number | string | null | undefined): number | null {
+  if (value == null || value === '') return null;
+  const n = typeof value === 'number' ? value : Number(String(value).replace(/[^0-9.]/g, ''));
+  if (!Number.isFinite(n)) return null;
+  const snapped = Math.round(n * 4) / 4;
+  return Math.min(7, Math.max(1, snapped));
+}
+
+/** Snap to the nearest band lower bound (5..95), or null for no oral test. */
+export function normaliseOtr(value: number | string | null | undefined): number | null {
+  if (value == null || value === '') return null;
+  const n = typeof value === 'number' ? value : Number(String(value).replace(/[^0-9.]/g, ''));
+  if (!Number.isFinite(n) || n <= 0) return null;
+  const lower = Math.round(n / 5) * 5;
+  return Math.min(95, Math.max(5, lower));
+}
+
+export function normaliseUnderstanding(value: number | string | null | undefined): number | null {
+  if (value == null || value === '') return null;
+  const n = typeof value === 'number' ? value : Number(String(value).replace(/[^0-9.]/g, ''));
+  if (!Number.isFinite(n)) return null;
+  return Math.min(10, Math.max(1, Math.round(n)));
+}
+
+/** Map a loose phrase ("partly", "yes", "none set") onto one of the nine options. */
+export function normalisePrevHw(value: string | null | undefined): PrevHw | null {
+  if (!value) return null;
+  const v = value.trim().toLowerCase();
+  if (!v) return null;
+  const exact = PREV_HW_OPTIONS.find((o) => o.toLowerCase() === v);
+  if (exact) return exact;
+  if (/(no|none|wasn't|was not|not).*(given|set|assigned)/.test(v) || /^n\/?a$/.test(v)) return 'No Homework Given';
+  if (/sent|email|whatsapp|skype|online|uploaded/.test(v) && /done|complete|sent/.test(v)) return 'Done And Sent Through Email/Skype/Whatsapp';
+  if (/didn'?t bring|did not bring|forgot|left (it )?at home/.test(v)) {
+    return /book/.test(v) ? 'Did Not Bring Exercise Book' : 'Did Not Bring / Did Not Send Through Email/Whatsapp';
+  }
+  if (/^(yes|done|complete(d)?|all done|fully)/.test(v)) return 'Yes';
+  if (/most|mostly|nearly|almost/.test(v)) return 'Most of it Done';
+  if (/partial|partly|half|some/.test(v)) return 'Partially Done';
+  if (/little|few|barely|hardly|attempted/.test(v)) return 'Little Done';
+  if (/^(no|not done|none|nothing|incomplete|didn'?t do|did not do)/.test(v)) return 'Not Done';
+  return null;
+}
+
+/** The percentage the portal would compute, or null when the marks cannot produce one. */
+export function testPercent(score: number | null | undefined, outOf: number | null | undefined): number | null {
+  if (score == null || outOf == null) return null;
+  if (!Number.isFinite(score) || !Number.isFinite(outOf)) return null;
+  if (outOf <= 0 || score < 0 || score > outOf) return null;
+  return Math.round((score / outOf) * 1000) / 10;
+}
+
+export function normaliseWrittenTests(tests: Partial<WrittenTest>[] | null | undefined): WrittenTest[] {
+  return (tests ?? [])
+    .filter((t) => t && typeof t.name === 'string' && t.name.trim())
+    .map((t) => {
+      const score = t.score ?? null;
+      const out_of = t.out_of ?? null;
+      return { name: t.name!.trim(), score, out_of, percent: testPercent(score, out_of) };
+    });
+}
+
+/**
+ * What submit_report refuses, checked here first so the teacher sees it in the
+ * editor rather than as a database error. `signs` = the author's report
+ * publishes directly (staff, or a teacher with report_auto_approve), in which
+ * case a GP is required; otherwise the GP is the in-charge's to set and must be
+ * left null.
+ */
+export function validateReportDraft(d: SessionReportDraft, opts: { signs: boolean }): string[] {
+  const errors: string[] = [];
+  if (!d.topic || !d.topic.trim()) errors.push('A report needs the topic that was taught.');
+  if (!Number.isInteger(d.understanding) || d.understanding < 1 || d.understanding > 10)
+    errors.push('Understanding must be a whole number from 1 to 10.');
+  if (d.otr != null && !OTR_BANDS.some((b) => b.lower === d.otr)) errors.push('The oral test result must be one of the bands.');
+  if (opts.signs) {
+    if (d.gp == null) errors.push('A report needs a GP before it goes to the family.');
+    else if (!GP_OPTIONS.includes(d.gp)) errors.push('GP must be between 1 and 7 in quarters.');
+  } else if (d.gp != null) {
+    errors.push('The GP is set by the in-charge for this report.');
+  }
+  if (d.prev_hw != null && !PREV_HW_OPTIONS.includes(d.prev_hw)) errors.push('Previous homework must be one of the listed answers.');
+  if (d.topic_completed && d.topics_not_done && d.topics_not_done.trim())
+    errors.push('A completed topic cannot also list topics not done.');
+  for (const t of d.written_tests) {
+    if (t.score != null && t.out_of != null && testPercent(t.score, t.out_of) == null)
+      errors.push(`Written test "${t.name}": marks must be 0 to ${t.out_of ?? 'the total'}.`);
+  }
+  return errors;
+}
+
+// --- who signs ---------------------------------------------------------------
+
+/** What of a profile the signing rule reads. */
+export interface SigningProfile {
+  full_name: string | null;
+  role: string | null;
+  report_auto_approve: boolean | null;
+}
+
+/**
+ * submit_report's v_signs_it, read the same way: staff, support and admin
+ * sign, and a teacher only when their reports publish on their own
+ * (report_auto_approve). Whoever signs sets the GP; nobody else is offered
+ * one, and submit_report ignores a GP it is not owed.
+ */
+export function signsReports(teacher: SigningProfile | null): boolean {
+  if (!teacher) return false;
+  return ['staff', 'support', 'admin'].includes(teacher.role ?? '') || (teacher.role === 'teacher' && teacher.report_auto_approve === true);
+}
+
+// --- the draft ---------------------------------------------------------------
+
+export interface TranscriptLine {
+  speaker: 'teacher' | 'student';
+  text: string;
+}
+
+export interface DraftMetrics {
+  student_talk_pct: number;
+  question_count: number;
+  praise_count: number;
+}
+
+export interface DraftSessionReportInput {
+  notes: string;
+  segments: TranscriptLine[];
+  metrics: DraftMetrics | null;
+  studentName: string;
+  course: string;
+  /** Topic options for this course (course_topics); the topic should be one of these when one fits. */
+  topicOptions: string[];
+  /** The topic the booking named, if any. */
+  bookedTopic?: string | null;
+  /** What the previous report set as homework, so prev_hw can be judged. */
+  previousHomework?: string | null;
+  /** Evidence about the previous homework from the platform (submitted/verified/marks). */
+  previousHomeworkStatus?: string | null;
+  /** In-lesson practice or test results. */
+  testResults?: { name: string; score: number; out_of: number }[];
+  /** Whether the author's report publishes directly (then a GP is expected). */
+  signs: boolean;
+}
+
+export const REPORT_FORMAT = {
+  type: 'json_schema' as const,
+  schema: {
+    type: 'object',
+    additionalProperties: false,
+    properties: {
+      topic: { type: 'string' },
+      topic_completed: { type: 'boolean' },
+      topics_not_done: { type: ['string', 'null'] },
+      understanding: { type: 'integer' },
+      otr: { type: ['integer', 'null'] },
+      gp: { type: ['number', 'null'] },
+      prev_hw: { type: ['string', 'null'] },
+      homework: { type: 'string' },
+      remarks: { type: 'string' },
+      written_tests: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: false,
+          properties: { name: { type: 'string' }, score: { type: ['number', 'null'] }, out_of: { type: ['number', 'null'] } },
+          required: ['name', 'score', 'out_of'],
+        },
+      },
+      has_upcoming_tests: { type: 'boolean' },
+      rationale: { type: 'string' },
+    },
+    required: ['topic', 'topic_completed', 'topics_not_done', 'understanding', 'otr', 'gp', 'prev_hw', 'homework', 'remarks', 'written_tests', 'has_upcoming_tests', 'rationale'],
+  },
+};
+
+export const REPORT_SYSTEM = `You draft the centre's per-session report for a 1-1 maths lesson, which the teacher will edit and the parent will read. Base it on the teacher's notes first, then the transcript, metrics and results. Be honest and specific; never invent detail.
+
+Fields:
+- topic: the topic taught. Choose one of the provided topic options when one fits; otherwise a short label. Prefer the booked topic if the lesson matched it.
+- topic_completed: true if the planned topic was finished; if false, topics_not_done lists what was left (else null).
+- understanding: 1-10 whole number, the student's grasp of today's topic by the end.
+- otr: ONLY if an oral quiz/questioning round was clearly scored in the lesson, give the percentage as a multiple of 5 (5-95); otherwise null.
+- gp: ${'only when the author signs the report'} — a grade point 1-7 in quarters (7 best) reflecting overall performance; null if told not to.
+- prev_hw: one of exactly: ${PREV_HW_OPTIONS.join(' | ')} — or null if nothing can be said.
+- homework: concrete, short, what to do before next lesson (exercise numbers, practice set).
+- remarks: 3-5 warm, plain sentences to the parent: what was covered, how the student did, one strength, one thing to work on. First name only. No jargon.
+- written_tests: any test or practice set done in the lesson, with marks (score, out_of); empty list if none.
+- has_upcoming_tests: true if the student or teacher mentioned an upcoming school test or exam.
+- rationale: two sentences for the teacher on why you scored it this way.`;
+
+/** The user turn draft-session-report.ts sends. */
+export function reportUserPrompt(input: DraftSessionReportInput): string {
+  const transcript = input.segments.map((s) => `${s.speaker === 'teacher' ? 'Teacher' : 'Student'}: ${s.text}`).join('\n');
+  const first = input.studentName.split(' ')[0];
+  const m = input.metrics;
+  return `Student: ${input.studentName} (use "${first}"). Course: ${input.course}.
+Author signs the report (GP allowed): ${input.signs ? 'yes' : 'no — set gp to null'}.
+Booked topic: ${input.bookedTopic ?? '(none)'}.
+Topic options: ${input.topicOptions.length ? input.topicOptions.join(' | ') : '(none)'}.
+Previous homework set: ${input.previousHomework ?? '(unknown)'}. Platform evidence: ${input.previousHomeworkStatus ?? '(none)'}.
+In-lesson results: ${input.testResults?.length ? input.testResults.map((t) => `${t.name}: ${t.score}/${t.out_of}`).join('; ') : '(none)'}.
+
+Teacher's quick notes:
+${input.notes || '(none provided)'}
+
+${m ? `Metrics: student talked ${Math.round(m.student_talk_pct * 100)}%, ${m.question_count} questions asked, ${m.praise_count} praise moments.\n` : ''}${transcript ? `Transcript:\n${transcript}` : '(no transcript available)'}`;
+}
+
+/** Coerce whatever came back into the template's exact vocabulary. */
+export function normaliseDraft(raw: Record<string, unknown>, input: Pick<DraftSessionReportInput, 'signs' | 'topicOptions' | 'bookedTopic' | 'testResults'>): SessionReportDraft {
+  const topicRaw = String(raw.topic ?? '').trim();
+  const topic = input.topicOptions.find((t) => t.toLowerCase() === topicRaw.toLowerCase()) ?? topicRaw ?? input.bookedTopic ?? '';
+  const topic_completed = Boolean(raw.topic_completed);
+  const written = normaliseWrittenTests(
+    (Array.isArray(raw.written_tests) ? (raw.written_tests as Partial<WrittenTest>[]) : []).concat(
+      (input.testResults ?? []).map((t) => ({ name: t.name, score: t.score, out_of: t.out_of })),
+    ),
+  );
+  // Dedupe tests by name (AI may echo the ones we supplied).
+  const seen = new Set<string>();
+  const written_tests = written.filter((t) => (seen.has(t.name.toLowerCase()) ? false : (seen.add(t.name.toLowerCase()), true)));
+  return {
+    topic,
+    topic_completed,
+    topics_not_done: topic_completed ? null : (typeof raw.topics_not_done === 'string' && raw.topics_not_done.trim()) || null,
+    understanding: normaliseUnderstanding(raw.understanding as number | string | null) ?? 6,
+    otr: normaliseOtr(raw.otr as number | string | null),
+    gp: input.signs ? normaliseGp(raw.gp as number | string | null) : null,
+    prev_hw: normalisePrevHw(typeof raw.prev_hw === 'string' ? raw.prev_hw : null),
+    homework: String(raw.homework ?? '').trim(),
+    remarks: String(raw.remarks ?? '').trim(),
+    written_tests,
+    has_upcoming_tests: Boolean(raw.has_upcoming_tests),
+  };
+}
+
+/** Notes-first fallback so the editor always opens with something usable. */
+export function heuristicSessionReport(input: DraftSessionReportInput): { draft: SessionReportDraft; rationale: string } {
+  const first = input.studentName.split(' ')[0];
+  const n = input.notes.trim();
+  const topic = input.bookedTopic?.trim() || input.topicOptions[0] || `Continued work in ${input.course}`;
+  const tests = normaliseWrittenTests((input.testResults ?? []).map((t) => ({ name: t.name, score: t.score, out_of: t.out_of })));
+  const avg = tests.length ? tests.reduce((s, t) => s + (t.percent ?? 0), 0) / tests.length : null;
+  const understanding = avg == null ? 7 : Math.max(1, Math.min(10, Math.round(avg / 10)));
+  const prevStatus = (input.previousHomeworkStatus ?? '').toLowerCase();
+  const prev_hw = !input.previousHomework ? 'No Homework Given' : /verified|complete|done/.test(prevStatus) ? 'Yes' : /submitted|partial/.test(prevStatus) ? 'Partially Done' : /overdue|missing|not/.test(prevStatus) ? 'Not Done' : null;
+  return {
+    draft: {
+      topic,
+      topic_completed: true,
+      topics_not_done: null,
+      understanding,
+      otr: null,
+      gp: input.signs ? normaliseGp(Math.max(1, Math.min(7, understanding * 0.7))) : null,
+      prev_hw,
+      homework: "Complete the practice set from today's lesson.",
+      remarks: n
+        ? `${first} worked on ${topic} today. ${n}`
+        : `${first} worked steadily on ${topic} today and attempted the problems with a positive attitude. A little more independent practice would help consolidate the method.`,
+      written_tests: tests,
+      has_upcoming_tests: false,
+    },
+    rationale: "Heuristic draft from the teacher's notes and in-lesson results; no AI pass was run.",
+  };
+}
