+-- ---------------------------------------------------------------------------
+-- A lesson that ends asks for its draft.
+--
+-- Stage 4 of the lesson platform (online-lms/docs/INTEGRATION.md, "The
+-- draft"): lesson_end, after its three writes, asks the lesson-finalize edge
+-- function to compute what the lesson leaves behind -- the merged
+-- transcript, lesson_metrics, lesson_feedback, lesson_report_drafts and the
+-- proposed lesson_followups, all through worker_store_lesson_results.
+--
+-- AFTER THE WRITES, AND AFTER THE COMMIT. invoke_edge_function hands the
+-- request to pg_net, which sends it once this transaction is through, so the
+-- function reads the transcript this very call stored rather than the one
+-- before it. The body names the session and the reason ('end'); daily-webhook
+-- sends the same body with reason 'transcript' when Daily's stored transcript
+-- lands later, and the function replaces what it computed the first time.
+--
+-- NEVER IN THE WAY OF THE WRITE. A project with no functions_url in
+-- edge_config, or no service_role_key in Vault, is exactly the project
+-- invoke_edge_function was written to complain about -- and a teacher
+-- closing a lesson must not be the one it complains to. The ask is wrapped
+-- the way notify_push wraps its own: the exception becomes a warning in the
+-- Postgres log and a row on the lesson's own event log (kind
+-- finalize_not_asked, with the error), where the session's readers can see
+-- that no draft is coming and why. The booking's departed_at, the room's
+-- closed_at and the transcript are already written by then and stay written.
+--
+-- Re-emitted from pg_get_functiondef() against a database with every
+-- migration applied; the guarded perform at the end of the body is the only
+-- change. The comment, the revoke and the grant are restated so a paste of
+-- this file alone leaves the function exactly as 20261013152316 left it.
+-- ---------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.lesson_end(p_session_id uuid, p_segments jsonb DEFAULT '[]'::jsonb)
+ RETURNS void
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+declare
+  v_quiet text;
+  v_words integer;
+begin
+  if not public.reads_lesson(p_session_id)
+     or not exists (select 1 from public.session_requests s
+                     where s.id = p_session_id
+                       and s.mode = 'online'
+                       and s.status in ('confirmed', 'completed')) then
+    raise exception 'only the teacher, the room''s in-charge or an admin ends an online lesson'
+      using errcode = '42501';
+  end if;
+
+  v_quiet := coalesce(current_setting('app.push_quiet', true), '');
+  perform set_config('app.push_quiet', '1', true);
+
+  -- departed_at only. Not the booking's status: that is in
+  -- enqueue_session_sync's change list, and whatever closes online sessions
+  -- today keeps doing it.
+  update public.session_requests s
+     set departed_at = coalesce(s.departed_at, now())
+   where s.id = p_session_id;
+
+  insert into public.lesson_rooms (session_id, room_name, closed_at)
+  values (p_session_id, 'lesson-' || p_session_id::text, now())
+  on conflict (session_id) do update set closed_at = excluded.closed_at;
+
+  -- The transcript the room held. An end with no segments (a reconnect, a
+  -- second closer) leaves a transcript already written alone.
+  if jsonb_typeof(p_segments) = 'array' and jsonb_array_length(p_segments) > 0 then
+    select coalesce(sum(array_length(regexp_split_to_array(btrim(seg->>'text'), '\s+'), 1)), 0)::int
+      into v_words
+      from jsonb_array_elements(p_segments) seg
+     where nullif(btrim(coalesce(seg->>'text', '')), '') is not null;
+
+    insert into public.lesson_transcripts (session_id, segments, word_count)
+    values (p_session_id, p_segments, v_words)
+    on conflict (session_id) do update
+      set segments   = excluded.segments,
+          word_count = excluded.word_count,
+          updated_at = now();
+  end if;
+
+  perform set_config('app.push_quiet', v_quiet, true);
+
+  -- The draft, the coaching and the follow-ups are the worker's to compute,
+  -- once this has committed (pg_net sends after the transaction). Never in
+  -- the way of the writes above: a project that cannot ask still closes its
+  -- lessons, and the lesson's own log says the draft was not asked for.
+  begin
+    perform public.invoke_edge_function(
+      'lesson-finalize',
+      jsonb_build_object('session_id', p_session_id, 'reason', 'end'));
+  exception when others then
+    raise warning 'lesson_end(%) could not ask lesson-finalize for the draft: %', p_session_id, sqlerrm;
+    insert into public.lesson_events (session_id, kind, payload)
+    values (p_session_id, 'finalize_not_asked', jsonb_build_object('error', left(sqlerrm, 500)));
+  end;
+end;
+$function$;
+
+comment on function public.lesson_end(uuid, jsonb) is
+  'Closes an online lesson: departed_at on the booking (once, never the '
+  'status), closed_at on the room, and the transcript segments the room held '
+  'with their word count; then asks lesson-finalize for the draft, the '
+  'coaching and the follow-ups (a failure to ask is a finalize_not_asked '
+  'event, never a failed close). The teacher, the department''s in-charge '
+  'or an admin.';
+
+revoke all on function public.lesson_end(uuid, jsonb) from public;
+grant execute on function public.lesson_end(uuid, jsonb) to authenticated;
