+-- ---------------------------------------------------------------------------
+-- A lesson that ends asks for its draft
+-- (migration 20261013163945; online-lms/docs/INTEGRATION.md, "The draft")
+--
+-- Closing a lesson is the one moment the database asks lesson-finalize to
+-- work: once, after the booking, the room and the transcript are written,
+-- naming the session and the reason, with the service-role bearer every
+-- function door the database calls carries. Nobody who could not end the
+-- lesson can make it ask. A second closer asks again, and the function is
+-- built to be asked twice. And a project that cannot ask -- no functions URL
+-- -- still closes the lesson, and leaves a line on the lesson's own log
+-- saying no draft is coming, rather than a teacher who cannot leave the
+-- room. The request queue is read directly: "asked" is a row, not a hope.
+-- ---------------------------------------------------------------------------
+begin;
+set local role postgres;
+select set_config('request.jwt.claim.sub', '', true);
+
+insert into public.lesson_platform_rooms (department_id)
+values ('dddddddd-0000-0000-0000-0000000000fc')
+on conflict (department_id) do nothing;
+-- Erin is seated in Maths by the prologue; in charge of it is this section's
+-- to say, the way the two lesson sections before it do.
+update public.department_members set is_incharge = true
+ where department_id = 'dddddddd-0000-0000-0000-0000000000fc'
+   and user_id = '55555555-5555-5555-5555-555555555555';
+
+create function pg_temp.fin_fam() returns uuid language sql stable as $$
+  select family_id from public.profiles where id = '11111111-1111-1111-1111-111111111111'
+$$;
+
+-- 01 Ben with Frank, under way now; 02 the same, for the project that cannot ask.
+insert into public.session_requests
+  (id, family_id, requested_by, student_id, student_name, subject, topic, course_id,
+   department_id, assigned_teacher_id, mode, status, requested_start, confirmed_start,
+   duration_minutes, arrived_at)
+values
+  ('f1a15e00-0000-0000-0000-000000000001', pg_temp.fin_fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '55 minutes', now() - interval '55 minutes', 60, now() - interval '54 minutes'),
+  ('f1a15e00-0000-0000-0000-000000000002', pg_temp.fin_fam(), '11111111-1111-1111-1111-111111111111',
+   '22222222-2222-2222-2222-222222222222', 'Ben Ashford', 'IB Math AA HL', 'Vectors',
+   'cccccccc-0000-0000-0000-0000000000fa', 'dddddddd-0000-0000-0000-0000000000fc',
+   '66666666-6666-6666-6666-666666666666', 'online', 'confirmed',
+   now() - interval '55 minutes', now() - interval '55 minutes', 60, now() - interval '54 minutes');
+
+-- What the database asked for, read off pg_net's queue.
+create function pg_temp.asks(p_session uuid) returns bigint language sql stable as $$
+  select count(*) from net.http_request_queue q
+   where q.url = 'https://test.supabase.co/functions/v1/lesson-finalize'
+     and (q.body->>'session_id')::uuid = p_session
+$$;
+
+delete from net.http_request_queue;
+
+-- ---------------------------------------------------------------------------
+-- The teacher ends the lesson: three writes, then one ask.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank, assigned
+select public.lesson_end('f1a15e00-0000-0000-0000-000000000001',
+  '[{"speaker": "teacher", "text": "How do we expand this bracket?", "start_ms": 0, "end_ms": 2500},
+    {"speaker": "student", "text": "Multiply each term inside", "start_ms": 4000, "end_ms": 6000}]');
+
+set local role postgres;
+select test_ok(
+  'ending a lesson asks lesson-finalize once, naming the session and the reason',
+  pg_temp.asks('f1a15e00-0000-0000-0000-000000000001') = 1
+  and exists (select 1 from net.http_request_queue q
+               where q.url = 'https://test.supabase.co/functions/v1/lesson-finalize'
+                 and q.method = 'POST'
+                 and q.body->>'session_id' = 'f1a15e00-0000-0000-0000-000000000001'
+                 and q.body->>'reason' = 'end')
+);
+select test_ok(
+  'with the service-role bearer every function door the database calls carries',
+  (select q.headers->>'Authorization' = 'Bearer test-service-role-key'
+          and q.headers->>'Content-Type' = 'application/json'
+     from net.http_request_queue q
+    where q.url = 'https://test.supabase.co/functions/v1/lesson-finalize'
+    limit 1)
+);
+select test_ok(
+  'and the transcript, the room and the booking were written for it to read',
+  (select t.word_count = 10 and jsonb_array_length(t.segments) = 2
+     from public.lesson_transcripts t where t.session_id = 'f1a15e00-0000-0000-0000-000000000001')
+  and (select r.closed_at is not null from public.lesson_rooms r
+        where r.session_id = 'f1a15e00-0000-0000-0000-000000000001')
+  and (select s.departed_at is not null from public.session_requests s
+        where s.id = 'f1a15e00-0000-0000-0000-000000000001')
+);
+select test_ok(
+  'the ask is the only thing on the queue: the booking''s own update stayed quiet toward phones',
+  (select count(*) from net.http_request_queue q
+    where q.url <> 'https://test.supabase.co/functions/v1/lesson-finalize') = 0
+);
+select test_ok(
+  'and the quiet flag did not walk out of lesson_end',
+  coalesce(current_setting('app.push_quiet', true), '') = ''
+);
+
+-- ---------------------------------------------------------------------------
+-- Nobody who could not end the lesson can make it ask.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('77777777-7777-7777-7777-777777777777');   -- Gita, in Maths, not assigned
+select test_ok(
+  'a teacher who was not assigned cannot end it',
+  raises_matching($$select public.lesson_end('f1a15e00-0000-0000-0000-000000000001')$$,
+                  'only the teacher')
+);
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada, Ben's parent
+select test_ok(
+  'nor can the parent',
+  raises_matching($$select public.lesson_end('f1a15e00-0000-0000-0000-000000000001')$$,
+                  'only the teacher')
+);
+set local role anon;
+select set_config('request.jwt.claim.sub', '', true);
+select test_ok(
+  'nor a stranger',
+  raises($$select public.lesson_end('f1a15e00-0000-0000-0000-000000000001')$$)
+);
+set local role postgres;
+select test_ok(
+  'and none of them made it ask',
+  pg_temp.asks('f1a15e00-0000-0000-0000-000000000001') = 1
+);
+
+-- ---------------------------------------------------------------------------
+-- A second closer asks again; the function is built to be asked twice.
+-- ---------------------------------------------------------------------------
+set local role authenticated;
+select act_as('55555555-5555-5555-5555-555555555555');   -- Erin, in charge of Maths
+select public.lesson_end('f1a15e00-0000-0000-0000-000000000001');
+set local role postgres;
+select test_ok(
+  'the in-charge ending it again asks again and leaves the transcript already written alone',
+  pg_temp.asks('f1a15e00-0000-0000-0000-000000000001') = 2
+  and (select t.word_count = 10 from public.lesson_transcripts t
+        where t.session_id = 'f1a15e00-0000-0000-0000-000000000001')
+);
+
+-- ---------------------------------------------------------------------------
+-- A project that cannot ask still closes the lesson, and says so on the
+-- lesson's own log.
+-- ---------------------------------------------------------------------------
+update public.edge_config set functions_url = '' where id = 1;
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank
+select test_ok(
+  'with no functions URL the teacher still closes the lesson',
+  not raises($$select public.lesson_end('f1a15e00-0000-0000-0000-000000000002',
+                '[{"speaker": "teacher", "text": "Well done today", "start_ms": 0, "end_ms": 1500}]')$$)
+);
+set local role postgres;
+select test_ok(
+  'the writes landed',
+  (select s.departed_at is not null from public.session_requests s
+    where s.id = 'f1a15e00-0000-0000-0000-000000000002')
+  and exists (select 1 from public.lesson_transcripts t
+               where t.session_id = 'f1a15e00-0000-0000-0000-000000000002')
+);
+select test_ok(
+  'nothing was asked, and the lesson''s log says why',
+  pg_temp.asks('f1a15e00-0000-0000-0000-000000000002') = 0
+  and exists (select 1 from public.lesson_events e
+               where e.session_id = 'f1a15e00-0000-0000-0000-000000000002'
+                 and e.kind = 'finalize_not_asked'
+                 and e.payload->>'error' like '%functions_url%')
+);
+update public.edge_config set functions_url = 'https://test.supabase.co/functions/v1' where id = 1;
+
+set local role authenticated;
+select act_as('66666666-6666-6666-6666-666666666666');   -- Frank
+select test_ok(
+  'the teacher who taught the lesson reads that line',
+  (select count(*) from public.lesson_events
+    where session_id = 'f1a15e00-0000-0000-0000-000000000002' and kind = 'finalize_not_asked') = 1
+);
+select act_as('11111111-1111-1111-1111-111111111111');   -- Ada
+select test_ok(
+  'the parent does not',
+  (select count(*) from public.lesson_events
+    where session_id = 'f1a15e00-0000-0000-0000-000000000002') = 0
+);
+rollback;
-- 
2.43.0

