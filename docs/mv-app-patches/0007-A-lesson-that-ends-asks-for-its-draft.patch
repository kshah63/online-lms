+// Supabase Edge Function — what a lesson leaves behind, computed once it has
+// ended: the transcript made whole, the lesson's numbers, the teacher's
+// coaching, the report draft in the form's own vocabulary, and the
+// follow-ups a person will approve.
+//
+//   supabase functions deploy lesson-finalize
+//   (JWT verification ON. Called by the DATABASE — lesson_end, through
+//   invoke_edge_function, with reason 'end' — and by daily-webhook when
+//   Daily's stored transcript is ready, with reason 'transcript'. Never by a
+//   phone or a browser: the bearer must be the project's service-role key,
+//   compared in constant time, and anything else is a 401.)
+//
+// Secrets:
+//   ANTHROPIC_API_KEY   the three model passes. Without it every lesson gets
+//                       the heuristic draft and says so in lesson_report_drafts.source.
+//   DAILY_API_KEY       the stored transcript. Without it the room's own
+//                       segments are the transcript.
+//
+// WHAT IS A PORT AND WHAT IS NOT. The prompts, the readings of what the
+// model says, the policy on follow-ups and the normalisers are online-lms's
+// modules moved into _shared/ unchanged (each file says which). This file is
+// the plumbing around them: which rows to read, when to ask the model at all,
+// and the one door everything lands through — worker_store_lesson_results,
+// service role only, which is quiet toward phones when the lesson is old news.
+//
+// THE CONSENT IS THE FAMILY'S. lesson_consents says whether a model may read
+// this child's lesson (ai_analysis) and whether a transcript may be kept
+// (transcript). Without ai_analysis nothing of the lesson reaches Anthropic:
+// the metrics are computed here, the draft and the follow-ups come from the
+// keyword heuristics, and lesson_feedback stays empty. Without transcript
+// consent the stored WebVTT at Daily is not fetched, whatever the webhook
+// said was ready.
+//
+// IDEMPOTENT ON PURPOSE. A lesson is finalised at least twice when Daily's
+// transcript lands after the end: the second run replaces the metrics, the
+// coaching and the draft (a replaced draft tells the teacher nothing twice —
+// the push is on INSERT), and worker_store_lesson_results proposes
+// follow-ups only once per session.
+//
+// THE ANSWER GOES OUT BEFORE THE WORK. pg_net gives the database's call a few
+// seconds; three model passes take longer. So the request is checked, the
+// session read, a 200 returned, and the work runs under EdgeRuntime.waitUntil
+// — the same shape as daily-webhook. Anywhere without waitUntil the work is
+// awaited and the full result returned instead.
+
+import { createClient } from 'jsr:@supabase/supabase-js@2';
+
+import { CLAUDE_MODEL, askClaudeForJson, type ClaudeJsonResult } from '../_shared/claudeJson.ts';
+import {
+  ANALYSIS_SYSTEM,
+  FEEDBACK_FORMAT,
+  analysisUserPrompt,
+  heuristicFeedback,
+  parseFeedback,
+  type TeacherFeedback,
+} from '../_shared/lessonAnalysis.ts';
+import {
+  FOLLOWUP_FORMAT,
+  FOLLOWUP_SYSTEM,
+  followupUserPrompt,
+  heuristicFollowups,
+  parseFollowups,
+  toFollowupRow,
+  type ExtractedFollowup,
+} from '../_shared/lessonFollowups.ts';
+import { computeMetrics, segmentsFrom, wordCount } from '../_shared/lessonMetrics.ts';
+import { isOldNews } from '../_shared/lessonNews.ts';
+import { isUuid, secretMatches } from '../_shared/lessonRoom.ts';
+import { captureError } from '../_shared/report.ts';
+import {
+  REPORT_FORMAT,
+  REPORT_SYSTEM,
+  heuristicSessionReport,
+  normaliseDraft,
+  normaliseOtr,
+  reportUserPrompt,
+  signsReports,
+  type DraftSessionReportInput,
+  type SessionReportDraft,
+  type SigningProfile,
+} from '../_shared/reportDraft.ts';
+import { mergeTranscripts, vttToSegments } from '../_shared/transcript.ts';
+
+const SUPABASE_URL = Deno.env.get('SUPABASE_URL')!;
+const SERVICE_ROLE_KEY = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;
+
+const admin = createClient(SUPABASE_URL, SERVICE_ROLE_KEY, {
+  auth: { persistSession: false },
+});
+
+type Reason = 'end' | 'transcript';
+
+type Session = {
+  id: string;
+  topic: string | null;
+  subject: string | null;
+  course_id: string | null;
+  student_id: string | null;
+  student_name: string | null;
+  assigned_teacher_id: string | null;
+  department_id: string | null;
+  effective_start: string | null;
+  confirmed_start: string | null;
+  requested_start: string | null;
+  duration_minutes: number | null;
+};
+
+type Pass = 'analyze' | 'followup_extract' | 'report_draft';
+
+Deno.serve(async (req) => {
+  if (req.method !== 'POST') {
+    return json({ error: 'method not allowed' }, 405);
+  }
+
+  // The gateway has already checked the bearer is a JWT this project
+  // issued. That admits every signed-in person; this door is the database's
+  // and daily-webhook's only, both of which carry the service-role key.
+  const bearer = (req.headers.get('Authorization') ?? '').replace(/^Bearer\s+/i, '');
+  if (!(await secretMatches(bearer, SERVICE_ROLE_KEY))) {
+    return json({ error: 'unauthorised' }, 401);
+  }
+
+  let body: { session_id?: unknown; reason?: unknown };
+  try {
+    body = await req.json();
+  } catch {
+    body = {};
+  }
+  if (!isUuid(body.session_id)) return json({ error: 'session_id is required' }, 400);
+  const sessionId = body.session_id.toLowerCase();
+  const reason: Reason = body.reason === 'transcript' ? 'transcript' : 'end';
+
+  // Read before answering, so a session nobody booked is a 404 to the
+  // caller rather than a line in a log it never reads.
+  const { data: session, error: sessionError } = await admin
+    .from('session_requests')
+    .select(
+      'id, topic, subject, course_id, student_id, student_name, assigned_teacher_id, department_id, effective_start, confirmed_start, requested_start, duration_minutes',
+    )
+    .eq('id', sessionId)
+    .maybeSingle();
+  if (sessionError) {
+    await captureError(sessionError, 'lesson-finalize/session', { session_id: sessionId });
+    return json({ error: 'could not read the session' }, 500);
+  }
+  if (!session) return json({ error: 'no such session' }, 404);
+
+  const work = finalize(session as Session, reason).catch(async (error) => {
+    await captureError(error, 'lesson-finalize', { session_id: sessionId, reason });
+    return null;
+  });
+
+  const runtime = (globalThis as { EdgeRuntime?: { waitUntil(p: Promise<unknown>): void } }).EdgeRuntime;
+  if (runtime?.waitUntil) {
+    runtime.waitUntil(work);
+    return json({ ok: true, accepted: true, session_id: sessionId, reason });
+  }
+  const result = await work;
+  if (!result) return json({ ok: false, error: 'Could not finalise the lesson.' }, 500);
+  return json(result);
+});
+
+/** The whole of one run. Throws only for what captureError should hear. */
+async function finalize(session: Session, reason: Reason) {
+  const anthropicKey = Deno.env.get('ANTHROPIC_API_KEY');
+  const dailyKey = Deno.env.get('DAILY_API_KEY');
+
+  // --- 1. Everything the passes read, in one round of reads ---------------
+  const [teacher, student, room, transcriptRow, events, consents, course, topics, openTitles, previousHomework, quickChecks] =
+    await Promise.all([
+      profileOf(session.assigned_teacher_id),
+      profileOf(session.student_id),
+      roomOf(session.id),
+      transcriptOf(session.id),
+      eventsOf(session.id),
+      consentsOf(session.student_id),
+      courseNameOf(session.course_id),
+      topicLabelsOf(session.course_id),
+      openFollowupTitlesOf(session.student_id, session.id),
+      previousHomeworkOf(session.student_id, session.course_id, session.id),
+      quickChecksOf(session.id),
+    ]);
+
+  const teacherName = teacher?.full_name?.trim() || 'Teacher';
+  const studentName = student?.full_name?.trim() || session.student_name?.trim() || 'the student';
+  const courseName = course ?? session.subject ?? 'Maths';
+  const aiConsent = consents.has('ai_analysis');
+  const transcriptConsent = consents.has('transcript');
+
+  // --- 2. The transcript: the room's segments, and Daily's when ready -----
+  let segments = segmentsFrom(transcriptRow?.segments);
+  let transcriptSource: 'none' | 'live' | 'merged' = segments.length > 0 ? 'live' : 'none';
+  if (transcriptConsent && room?.transcript_status === 'ready' && room.provider_transcript_id && dailyKey?.trim()) {
+    try {
+      const vtt = await fetchDailyTranscript(room.provider_transcript_id, dailyKey.trim());
+      const stored = vttToSegments(vtt, { teacher: teacherName, student: studentName });
+      if (stored.length > 0) {
+        segments = mergeTranscripts(segments, stored);
+        transcriptSource = 'merged';
+        const { error } = await admin.from('lesson_transcripts').upsert(
+          {
+            session_id: session.id,
+            segments,
+            word_count: wordCount(segments),
+            updated_at: new Date().toISOString(),
+          },
+          { onConflict: 'session_id' },
+        );
+        if (error) throw error;
+      }
+    } catch (error) {
+      // The room's own segments are still a transcript; the lesson is
+      // finalised on those and the stored one is tried again on the next
+      // run. Reported, because a transcript that quietly never merges looks
+      // exactly like a lesson that had none.
+      await captureError(error, 'lesson-finalize/transcript', {
+        session_id: session.id,
+        provider_transcript_id: room.provider_transcript_id,
+      });
+    }
+  }
+
+  // --- 3. The numbers, and what the room recorded by hand -----------------
+  const metrics = computeMetrics(segments);
+  const notes = events
+    .filter((e) => e.kind === 'teacher_note')
+    .map((e) => noteText(e.payload))
+    .filter(Boolean)
+    .join('\n');
+  const oralChecks = events.filter((e) => e.kind === 'quick_check_result').map((e) => e.payload);
+  const testResults: { name: string; score: number; out_of: number }[] = [];
+  for (const p of oralChecks) {
+    const score = Number(p.score);
+    const outOf = Number(p.out_of);
+    if (typeof p.name === 'string' && p.name.trim() && Number.isFinite(score) && Number.isFinite(outOf)) {
+      testResults.push({ name: p.name.trim(), score, out_of: outOf });
+    }
+  }
+  for (const q of quickChecks) testResults.push(q);
+  // The oral test result the host recorded, if any: the only source the
+  // report's OTR may have. It is a band the teacher scored in the room,
+  // never a number inferred from how the talk went.
+  const recordedOtr = oralChecks.map((p) => Number(p.otr)).filter((n) => Number.isFinite(n) && n > 0).pop() ?? null;
+
+  const useAi = aiConsent && Boolean(anthropicKey?.trim());
+  const usage: { kind: Pass; result: ClaudeJsonResult }[] = [];
+  const record = (kind: Pass, result: ClaudeJsonResult) => {
+    usage.push({ kind, result });
+    if (!result.ok && result.reason !== 'refusal') {
+      console.warn(`[edge] lesson-finalize ${kind} fell back to the heuristic: ${result.reason} — ${result.detail}`);
+    }
+    return result;
+  };
+
+  const draftInput: DraftSessionReportInput = {
+    notes,
+    segments,
+    metrics: segments.length > 0 ? metrics : null,
+    studentName,
+    course: courseName,
+    topicOptions: topics,
+    bookedTopic: session.topic,
+    previousHomework,
+    previousHomeworkStatus: null,
+    testResults,
+    signs: signsReports(teacher),
+  };
+
+  // --- 4. The three passes, side by side, each falling back on its own ----
+  const [feedback, followups, drafted] = await Promise.all([
+    // The coaching. No consent: nothing, not even the heuristic — the row
+    // would be a reading of a lesson the family did not agree to have read.
+    (async (): Promise<TeacherFeedback | null> => {
+      if (!aiConsent) return null;
+      if (useAi && segments.length > 0) {
+        const result = record(
+          'analyze',
+          await askClaudeForJson({
+            apiKey: anthropicKey,
+            system: ANALYSIS_SYSTEM,
+            user: analysisUserPrompt(segments, metrics, { teacherName, studentName, course: courseName }),
+            format: FEEDBACK_FORMAT,
+          }),
+        );
+        if (result.ok) {
+          const parsed = parseFeedback(result.json);
+          if (parsed) return parsed;
+        }
+      }
+      return heuristicFeedback(metrics);
+    })(),
+
+    // The follow-ups. The keyword heuristic without a model; the policy in
+    // parseFollowups applies to both.
+    (async (): Promise<ExtractedFollowup[]> => {
+      if (useAi && segments.length > 0) {
+        const input = { segments, studentFirstName: studentName.split(' ')[0], course: courseName, openTitles };
+        const result = record(
+          'followup_extract',
+          await askClaudeForJson({
+            apiKey: anthropicKey,
+            system: FOLLOWUP_SYSTEM,
+            user: followupUserPrompt(input),
+            format: FOLLOWUP_FORMAT,
+            effort: 'high',
+          }),
+        );
+        if (result.ok) {
+          const parsed = parseFollowups(result.json, openTitles);
+          if (parsed.errors.length === 0) return parsed.items;
+        }
+      }
+      return heuristicFollowups(segments, openTitles);
+    })(),
+
+    // The draft, in the form's vocabulary before the database's CHECKs see it.
+    (async (): Promise<{ draft: SessionReportDraft; rationale: string; source: 'ai' | 'heuristic' }> => {
+      if (useAi) {
+        const result = record(
+          'report_draft',
+          await askClaudeForJson({
+            apiKey: anthropicKey,
+            system: REPORT_SYSTEM,
+            user: reportUserPrompt(draftInput),
+            format: REPORT_FORMAT,
+            effort: 'high',
+          }),
+        );
+        if (result.ok) {
+          const raw = result.json as Record<string, unknown>;
+          return { draft: normaliseDraft(raw, draftInput), rationale: String(raw.rationale ?? ''), source: 'ai' };
+        }
+      }
+      return { ...heuristicSessionReport(draftInput), source: 'heuristic' };
+    })(),
+  ]);
+
+  // Two rules the form holds that a model cannot be trusted with: the OTR is
+  // the band the host recorded or nothing, and an exam the follow-ups found
+  // is an upcoming test on the report.
+  const draft: SessionReportDraft = {
+    ...drafted.draft,
+    otr: recordedOtr !== null ? normaliseOtr(recordedOtr) : null,
+    has_upcoming_tests: drafted.draft.has_upcoming_tests || followups.some((f) => f.kind === 'exam_upcoming'),
+  };
+
+  // --- 5. The bill, one row per call, whatever the call came back with ----
+  for (const { kind, result } of usage) {
+    if (!result.usage) continue;
+    const { error } = await admin.from('ai_usage').insert({
+      user_id: null,
+      kind,
+      model: result.model ?? CLAUDE_MODEL,
+      tokens_in: result.usage.input_tokens,
+      tokens_out: result.usage.output_tokens,
+      session_id: session.id,
+    });
+    if (error) await captureError(error, 'lesson-finalize/ai_usage', { session_id: session.id, kind });
+  }
+
+  // --- 6. One door ---------------------------------------------------------
+  const rows = followups.map(toFollowupRow);
+  const { error: storeError } = await admin.rpc('worker_store_lesson_results', {
+    p_session_id: session.id,
+    p_metrics: metrics,
+    p_feedback: feedback,
+    p_draft: draft,
+    p_draft_rationale: drafted.rationale,
+    p_draft_source: drafted.source,
+    p_followups: rows,
+    p_quiet: isOldNews(session, Date.now()),
+  });
+  if (storeError) throw storeError;
+
+  return {
+    ok: true,
+    session_id: session.id,
+    reason,
+    source: drafted.source,
+    followups: rows.length,
+    transcript: transcriptSource,
+  };
+}
+
+// --- reads --------------------------------------------------------------------
+
+async function profileOf(id: string | null): Promise<SigningProfile | null> {
+  if (!id) return null;
+  const { data, error } = await admin.from('profiles').select('full_name, role, report_auto_approve').eq('id', id).maybeSingle();
+  if (error) throw error;
+  return (data as SigningProfile | null) ?? null;
+}
+
+async function roomOf(sessionId: string): Promise<{ transcript_status: string; provider_transcript_id: string | null } | null> {
+  const { data, error } = await admin.from('lesson_rooms').select('transcript_status, provider_transcript_id').eq('session_id', sessionId).maybeSingle();
+  if (error) throw error;
+  return data;
+}
+
+async function transcriptOf(sessionId: string): Promise<{ segments: unknown } | null> {
+  const { data, error } = await admin.from('lesson_transcripts').select('segments').eq('session_id', sessionId).maybeSingle();
+  if (error) throw error;
+  return data;
+}
+
+async function eventsOf(sessionId: string): Promise<{ kind: string; payload: Record<string, unknown> }[]> {
+  const { data, error } = await admin
+    .from('lesson_events')
+    .select('kind, payload')
+    .eq('session_id', sessionId)
+    .in('kind', ['teacher_note', 'quick_check_result'])
+    .order('at', { ascending: true });
+  if (error) throw error;
+  return ((data ?? []) as { kind: string; payload: unknown }[]).map((e) => ({
+    kind: e.kind,
+    payload: e.payload && typeof e.payload === 'object' ? (e.payload as Record<string, unknown>) : {},
+  }));
+}
+
+/** The kinds of consent in force for the student: granted and not revoked. */
+async function consentsOf(studentId: string | null): Promise<Set<string>> {
+  if (!studentId) return new Set();
+  const { data, error } = await admin.from('lesson_consents').select('kind').eq('student_id', studentId).is('revoked_at', null);
+  if (error) throw error;
+  return new Set(((data ?? []) as { kind: string }[]).map((c) => c.kind));
+}
+
+async function courseNameOf(courseId: string | null): Promise<string | null> {
+  if (!courseId) return null;
+  const { data, error } = await admin.from('courses').select('name').eq('id', courseId).maybeSingle();
+  if (error) throw error;
+  return (data as { name: string | null } | null)?.name ?? null;
+}
+
+async function topicLabelsOf(courseId: string | null): Promise<string[]> {
+  if (!courseId) return [];
+  const { data, error } = await admin
+    .from('course_topics')
+    .select('label')
+    .eq('course_id', courseId)
+    .eq('is_active', true)
+    .order('sort_order', { ascending: true });
+  if (error) throw error;
+  return ((data ?? []) as { label: string | null }[]).map((t) => t.label?.trim() ?? '').filter(Boolean);
+}
+
+/** Titles already proposed or approved for the student from other lessons, so nothing is proposed twice. */
+async function openFollowupTitlesOf(studentId: string | null, sessionId: string): Promise<string[]> {
+  if (!studentId) return [];
+  const { data, error } = await admin
+    .from('lesson_followups')
+    .select('title')
+    .eq('student_id', studentId)
+    .neq('session_id', sessionId)
+    .in('status', ['proposed', 'approved']);
+  if (error) throw error;
+  return ((data ?? []) as { title: string | null }[]).map((f) => f.title?.trim() ?? '').filter(Boolean);
+}
+
+/** The homework the last published report on this course set, for prev_hw. */
+async function previousHomeworkOf(studentId: string | null, courseId: string | null, sessionId: string): Promise<string | null> {
+  if (!studentId || !courseId) return null;
+  const { data: reports, error } = await admin
+    .from('session_reports')
+    .select('session_request_id, homework, published_at')
+    .eq('student_id', studentId)
+    .eq('status', 'published')
+    .neq('session_request_id', sessionId)
+    .order('published_at', { ascending: false })
+    .limit(25);
+  if (error) throw error;
+  const rows = (reports ?? []) as { session_request_id: string; homework: string | null }[];
+  if (rows.length === 0) return null;
+  const { data: sessions, error: sessionsError } = await admin
+    .from('session_requests')
+    .select('id, course_id')
+    .in('id', rows.map((r) => r.session_request_id));
+  if (sessionsError) throw sessionsError;
+  const onCourse = new Set(((sessions ?? []) as { id: string; course_id: string | null }[]).filter((s) => s.course_id === courseId).map((s) => s.id));
+  const last = rows.find((r) => onCourse.has(r.session_request_id));
+  return last?.homework?.trim() || null;
+}
+
+/**
+ * In-lesson quick checks the student submitted, as test results. The
+ * practice tables are another migration's; a project without them yet
+ * reads as "no quick checks" rather than as a worker that cannot run.
+ */
+async function quickChecksOf(sessionId: string): Promise<{ name: string; score: number; out_of: number }[]> {
+  try {
+    const { data, error } = await admin
+      .from('practice_attempts')
+      .select('score, out_of, status, set:practice_sets(title, kind)')
+      .eq('session_id', sessionId)
+      .in('status', ['submitted', 'marked']);
+    if (error) throw error;
+    type Set = { title: string | null; kind: string | null };
+    type Row = { score: number | null; out_of: number | null; set: Set | Set[] | null };
+    const out: { name: string; score: number; out_of: number }[] = [];
+    for (const row of (data ?? []) as unknown as Row[]) {
+      // A to-one embed is an object on the wire; the client's types say array.
+      const set = Array.isArray(row.set) ? row.set[0] : row.set;
+      if (set?.kind !== 'quick_check') continue;
+      if (typeof row.score !== 'number' || typeof row.out_of !== 'number') continue;
+      out.push({ name: set.title?.trim() || 'Quick check', score: row.score, out_of: row.out_of });
+    }
+    return out;
+  } catch (error) {
+    console.warn(`[edge] lesson-finalize read no quick checks for ${sessionId}: ${String((error as Error)?.message ?? error)}`);
+    return [];
+  }
+}
+
+// --- helpers --------------------------------------------------------------------
+
+/** The teacher's note as the room writes it, whichever key it used. */
+function noteText(payload: Record<string, unknown>): string {
+  for (const key of ['text', 'note', 'body']) {
+    const v = payload[key];
+    if (typeof v === 'string' && v.trim()) return v.trim();
+  }
+  return '';
+}
+
+/** Daily's stored WebVTT for a transcript: an access link first, then the file it points at. */
+async function fetchDailyTranscript(transcriptId: string, apiKey: string): Promise<string> {
+  const link = await fetch(`https://api.daily.co/v1/transcript/${encodeURIComponent(transcriptId)}/access-link`, {
+    headers: { Authorization: `Bearer ${apiKey}` },
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!link.ok) throw new Error(`Daily access-link returned ${link.status}`);
+  const { link: url } = (await link.json()) as { link?: string };
+  if (!url) throw new Error('Daily access-link returned no link');
+  const file = await fetch(url, { signal: AbortSignal.timeout(30_000) });
+  if (!file.ok) throw new Error(`Daily transcript download returned ${file.status}`);
+  return await file.text();
+}
+
+function json(body: unknown, status = 200): Response {
+  return Response.json(body, { status });
+}
