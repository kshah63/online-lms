+++ b/__smoke__/lesson-finalize-is-the-databases-door.test.ts
@@ -0,0 +1,197 @@
+import { webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+import {
+  CLAUDE_MODEL,
+  askClaudeForJson,
+  claudeJsonBody,
+  extractJson,
+  jsonOnlyInstruction,
+} from '../supabase/functions/_shared/claudeJson';
+import { FEEDBACK_FORMAT, heuristicFeedback, parseFeedback } from '../supabase/functions/_shared/lessonAnalysis';
+import { OLD_NEWS_MS, isOldNews } from '../supabase/functions/_shared/lessonNews';
+
+/**
+ * lesson-finalize is the database's door, and it loses nothing it can help.
+ *
+ * It is called by lesson_end (through invoke_edge_function) and by
+ * daily-webhook, both carrying the service-role key -- so the bearer is
+ * compared to that key in constant time, and a signed-in person's JWT,
+ * which the gateway admits, is a 401 here. What it computes lands through
+ * worker_store_lesson_results alone, quiet when the lesson is a day old,
+ * and every model call is billed to ai_usage whether or not it answered.
+ *
+ * The three passes are independent: a refusal, a 4xx, a reply that is not
+ * JSON or a timeout in one falls to that pass's heuristic and never throws
+ * away the other two. That half is run for real against a stubbed fetch;
+ * the rest is read off index.ts, which Deno.serve keeps out of jest.
+ */
+
+if (!globalThis.crypto?.subtle) {
+  Object.defineProperty(globalThis, 'crypto', { value: webcrypto, configurable: true });
+}
+
+const SOURCE = readFileSync(join(__dirname, '..', 'supabase', 'functions', 'lesson-finalize', 'index.ts'), 'utf8');
+
+describe('the door is the service role\'s', () => {
+  it('compares the bearer to SUPABASE_SERVICE_ROLE_KEY in constant time, before reading the body', () => {
+    expect(SOURCE).toMatch(/const bearer = \(req\.headers\.get\('Authorization'\) \?\? ''\)\.replace\(\/\^Bearer\\s\+\/i, ''\);/);
+    expect(SOURCE).toMatch(/if \(!\(await secretMatches\(bearer, SERVICE_ROLE_KEY\)\)\) \{\s*return json\(\{ error: 'unauthorised' \}, 401\);/);
+    expect(SOURCE.indexOf('secretMatches(bearer')).toBeLessThan(SOURCE.indexOf('await req.json()'));
+  });
+
+  it('answers before the work, and the work runs under waitUntil', () => {
+    expect(SOURCE).toMatch(/runtime\.waitUntil\(work\);\s*return json\(\{ ok: true, accepted: true/);
+  });
+
+  it('takes session_id as a uuid only, and reason as end or transcript', () => {
+    expect(SOURCE).toMatch(/if \(!isUuid\(body\.session_id\)\) return json\(\{ error: 'session_id is required' \}, 400\);/);
+    expect(SOURCE).toMatch(/const reason: Reason = body\.reason === 'transcript' \? 'transcript' : 'end';/);
+  });
+});
+
+describe('what it stores, and through which door', () => {
+  it('stores everything through worker_store_lesson_results, quiet when the lesson is old news', () => {
+    const call = SOURCE.slice(SOURCE.indexOf("admin.rpc('worker_store_lesson_results'"));
+    const args = call.slice(0, call.indexOf('});'));
+    for (const name of ['p_session_id', 'p_metrics', 'p_feedback', 'p_draft', 'p_draft_rationale', 'p_draft_source', 'p_followups']) {
+      expect(args).toContain(`${name}:`);
+    }
+    expect(args).toMatch(/p_quiet: isOldNews\(session, Date\.now\(\)\)/);
+    // No other write to the five result tables: the worker is the one door.
+    for (const table of ['lesson_metrics', 'lesson_feedback', 'lesson_report_drafts', 'lesson_followups']) {
+      expect(SOURCE).not.toMatch(new RegExp(`\\.from\\('${table}'\\)\\s*\\.(insert|upsert|update|delete)`));
+    }
+  });
+
+  it('a day is the line between news and backfill', () => {
+    expect(OLD_NEWS_MS).toBe(24 * 60 * 60 * 1000);
+    const now = Date.UTC(2026, 9, 13, 12, 0, 0);
+    const at = (hoursAgo: number) => new Date(now - hoursAgo * 60 * 60 * 1000).toISOString();
+    expect(isOldNews({ effective_start: at(1), confirmed_start: null, requested_start: null }, now)).toBe(false);
+    expect(isOldNews({ effective_start: at(23), confirmed_start: null, requested_start: null }, now)).toBe(false);
+    expect(isOldNews({ effective_start: at(25), confirmed_start: null, requested_start: null }, now)).toBe(true);
+    // effective_start is the start that counts; the others are fallbacks.
+    expect(isOldNews({ effective_start: at(1), confirmed_start: at(72), requested_start: null }, now)).toBe(false);
+    expect(isOldNews({ effective_start: null, confirmed_start: at(72), requested_start: at(1) }, now)).toBe(true);
+    expect(isOldNews({ effective_start: null, confirmed_start: null, requested_start: at(72) }, now)).toBe(true);
+    // No start at all is news: a notification about an odd row beats a silence nobody reports.
+    expect(isOldNews({ effective_start: null, confirmed_start: null, requested_start: null }, now)).toBe(false);
+    expect(isOldNews({ effective_start: 'not a date', confirmed_start: null, requested_start: null }, now)).toBe(false);
+  });
+
+  it("without the family's ai_analysis consent nothing goes to the model and the coaching stays empty", () => {
+    expect(SOURCE).toMatch(/const useAi = aiConsent && Boolean\(anthropicKey\?\.trim\(\)\);/);
+    expect(SOURCE).toMatch(/if \(!aiConsent\) return null;/);
+    expect(SOURCE).toMatch(/const aiConsent = consents\.has\('ai_analysis'\);/);
+    expect(SOURCE).toMatch(/const transcriptConsent = consents\.has\('transcript'\);/);
+    expect(SOURCE).toMatch(/if \(transcriptConsent && room\?\.transcript_status === 'ready' && room\.provider_transcript_id && dailyKey\?\.trim\(\)\)/);
+    expect(SOURCE).toMatch(/\.is\('revoked_at', null\)/);
+  });
+
+  it('bills every call to ai_usage, by pass, whether or not it answered', () => {
+    const bill = SOURCE.slice(SOURCE.indexOf("admin.from('ai_usage').insert("));
+    const row = bill.slice(0, bill.indexOf('});'));
+    expect(row).toMatch(/kind,/);
+    expect(row).toMatch(/model: result\.model \?\? CLAUDE_MODEL/);
+    expect(row).toMatch(/tokens_in: result\.usage\.input_tokens/);
+    expect(row).toMatch(/tokens_out: result\.usage\.output_tokens/);
+    expect(row).toMatch(/session_id: session\.id/);
+    expect(SOURCE).toMatch(/type Pass = 'analyze' \| 'followup_extract' \| 'report_draft';/);
+  });
+
+  it("the report's OTR is the band the host recorded or nothing -- never inferred from the talk", () => {
+    expect(SOURCE).toMatch(/otr: recordedOtr !== null \? normaliseOtr\(recordedOtr\) : null,/);
+    expect(SOURCE).toMatch(/has_upcoming_tests: drafted\.draft\.has_upcoming_tests \|\| followups\.some\(\(f\) => f\.kind === 'exam_upcoming'\)/);
+  });
+
+  it('a Daily transcript that will not download is reported and the lesson is finalised on the room\'s own segments', () => {
+    expect(SOURCE).toMatch(/captureError\(error, 'lesson-finalize\/transcript'/);
+    expect(SOURCE).toMatch(/api\.daily\.co\/v1\/transcript\/\$\{encodeURIComponent\(transcriptId\)\}\/access-link/);
+  });
+});
+
+describe('one question to Claude, one JSON object back', () => {
+  const request = {
+    apiKey: 'sk-test',
+    system: 'Be brief.',
+    user: 'Hello',
+    format: FEEDBACK_FORMAT,
+    effort: 'high' as const,
+  };
+
+  it('asks claude-opus-5-5 at the Messages API with the key, the version and the schema', async () => {
+    const seen: { url: string; init: RequestInit }[] = [];
+    const fetchImpl = (async (url: string | URL | Request, init?: RequestInit) => {
+      seen.push({ url: String(url), init: init! });
+      return new Response(JSON.stringify({ model: 'claude-opus-5-5', stop_reason: 'end_turn', usage: { input_tokens: 12, output_tokens: 3 }, content: [{ type: 'text', text: '{"ok":1}' }] }), { status: 200 });
+    }) as typeof fetch;
+    const result = await askClaudeForJson({ ...request, fetchImpl });
+    expect(result).toEqual({ ok: true, json: { ok: 1 }, model: 'claude-opus-5-5', usage: { input_tokens: 12, output_tokens: 3 }, stop_reason: 'end_turn' });
+    expect(seen).toHaveLength(1);
+    expect(seen[0].url).toBe('https://api.anthropic.com/v1/messages');
+    const headers = seen[0].init.headers as Record<string, string>;
+    expect(headers['x-api-key']).toBe('sk-test');
+    expect(headers['anthropic-version']).toBe('2023-06-01');
+    expect(headers['content-type']).toBe('application/json');
+    const body = JSON.parse(seen[0].init.body as string);
+    expect(body.model).toBe('claude-opus-5-5');
+    expect(CLAUDE_MODEL).toBe('claude-opus-5-5');
+    expect(body.output_config).toEqual({ format: FEEDBACK_FORMAT, effort: 'high' });
+    expect(body.messages).toEqual([{ role: 'user', content: 'Hello' }]);
+    expect(body.system[0]).toEqual({ type: 'text', text: 'Be brief.' });
+    expect(body.system[1].text).toBe(jsonOnlyInstruction(FEEDBACK_FORMAT));
+    expect(body.max_tokens).toBeGreaterThanOrEqual(16000);
+  });
+
+  it('the body is the SDK\'s wire shape, with the prompt verbatim as the first system block', () => {
+    const body = claudeJsonBody(request);
+    expect(body.model).toBe('claude-opus-5-5');
+    expect((body.system as { text: string }[])[0].text).toBe('Be brief.');
+    expect(body.fallbacks).toEqual([{ model: 'claude-opus-4-8' }]);
+    expect(claudeJsonBody({ ...request, effort: undefined }).output_config).toEqual({ format: FEEDBACK_FORMAT });
+  });
+
+  it('a refusal is no answer, and its tokens are still on the bill', async () => {
+    const fetchImpl = (async () =>
+      new Response(JSON.stringify({ model: 'claude-opus-5-5', stop_reason: 'refusal', usage: { input_tokens: 40, output_tokens: 0 }, content: [] }), { status: 200 })) as typeof fetch;
+    expect(await askClaudeForJson({ ...request, fetchImpl })).toEqual({ ok: false, reason: 'refusal', detail: 'the model declined', model: 'claude-opus-5-5', usage: { input_tokens: 40, output_tokens: 0 } });
+  });
+
+  it('a 4xx, a reply that is not JSON, and a network failure each come back as a reason rather than a throw', async () => {
+    const http = (async () => new Response(JSON.stringify({ type: 'error', error: { type: 'invalid_request_error', message: 'bad beta' } }), { status: 400 })) as typeof fetch;
+    expect(await askClaudeForJson({ ...request, fetchImpl: http })).toEqual({ ok: false, reason: 'http', detail: '400: bad beta', model: null, usage: null });
+
+    const prose = (async () => new Response(JSON.stringify({ model: 'claude-opus-5-5', stop_reason: 'end_turn', usage: { input_tokens: 1, output_tokens: 1 }, content: [{ type: 'text', text: 'Sorry, I cannot.' }] }), { status: 200 })) as typeof fetch;
+    expect(await askClaudeForJson({ ...request, fetchImpl: prose })).toMatchObject({ ok: false, reason: 'parse', usage: { input_tokens: 1, output_tokens: 1 } });
+
+    const down = (async () => {
+      throw new Error('connection reset');
+    }) as typeof fetch;
+    expect(await askClaudeForJson({ ...request, fetchImpl: down })).toEqual({ ok: false, reason: 'network', detail: 'connection reset', model: null, usage: null });
+
+    expect(await askClaudeForJson({ ...request, apiKey: undefined })).toMatchObject({ ok: false, reason: 'no_key' });
+  });
+
+  it('reads JSON out of a code fence or a sentence, and gives up honestly', () => {
+    expect(extractJson('{"a":1}')).toEqual({ a: 1 });
+    expect(extractJson('```json\n{"a":1}\n```')).toEqual({ a: 1 });
+    expect(extractJson('Here you go: {"a":{"b":[1,2]}} — hope that helps')).toEqual({ a: { b: [1, 2] } });
+    expect(extractJson('no json here')).toBeNull();
+    expect(extractJson('{"broken":')).toBeNull();
+  });
+
+  it('a near miss from the model is the heuristic, not a half-read row', () => {
+    const good = { summary: 's', strengths: ['a'], suggestions: ['b'], moments: [{ at: '01:00', kind: 'strength', quote: 'q', comment: 'c' }], dimension_scores: { engagement: 4, questioning: 3, clarity: 5, rapport: 4 } };
+    expect(parseFeedback(good)).toEqual(good);
+    expect(parseFeedback({ ...good, moments: [{ at: '01:00', kind: 'praise', quote: 'q', comment: 'c' }] })).toBeNull();
+    expect(parseFeedback({ ...good, dimension_scores: { engagement: 4, questioning: 3, clarity: 5 } })).toBeNull();
+    expect(parseFeedback({ ...good, strengths: 'a' })).toBeNull();
+    expect(parseFeedback(null)).toBeNull();
+    const fallback = heuristicFeedback({ teacher_talk_pct: 0.7, student_talk_pct: 0.3, question_count: 2, open_question_pct: 0, avg_wait_ms: 900, student_turns: 4, avg_student_turn_ms: 2000, praise_count: 0 });
+    expect(fallback.moments).toEqual([]);
+    expect(fallback.suggestions.length).toBeGreaterThanOrEqual(3);
+    expect(fallback.summary).toMatch(/^Student talked 30% of the lesson across 4 turns/);
+  });
+});
diff --git a/supabase/functions/_shared/claudeJson.ts b/supabase/functions/_shared/claudeJson.ts
new file mode 100644
index 0000000..e6da982
--- /dev/null
+++ b/supabase/functions/_shared/claudeJson.ts
@@ -0,0 +1,167 @@
+// One question to Claude, one JSON object back -- or a reason there is none.
+//
+// Plain fetch against the Messages API rather than the SDK, for the same
+// reason report.ts posts Sentry envelopes by hand: a top-level import that
+// fails to resolve does not degrade an edge function, it stops it booting,
+// and nothing here can prove an npm specifier resolves on the edge runtime
+// before a deploy. The request body is the SDK's wire shape exactly --
+// `output_config.format` for the JSON schema, `fallbacks` with its beta --
+// so swapping this for the SDK later changes this file and nothing that
+// calls it.
+//
+// Never throws. Every way a pass can come back empty is a value the caller
+// can read -- a refusal, an HTTP status, a body that is not JSON, a network
+// failure -- because the three passes lesson-finalize runs are independent
+// and a thrown error in one must not lose the other two. The usage comes
+// back even on a refusal: those tokens were billed and belong in ai_usage.
+
+export const CLAUDE_MODEL = 'claude-opus-5-5';
+export const CLAUDE_FALLBACK_MODEL = 'claude-opus-4-8';
+const MESSAGES_URL = 'https://api.anthropic.com/v1/messages';
+const ANTHROPIC_VERSION = '2023-06-01';
+/** The array-form server-side fallback, as online-lms sends it. */
+const FALLBACK_BETA = 'server-side-fallback-2026-06-01';
+
+export interface JsonFormat {
+  type: 'json_schema';
+  schema: Record<string, unknown>;
+}
+
+export interface ClaudeUsage {
+  input_tokens: number;
+  output_tokens: number;
+}
+
+export type ClaudeJsonResult =
+  | { ok: true; json: unknown; model: string; usage: ClaudeUsage | null; stop_reason: string | null }
+  | { ok: false; reason: 'refusal' | 'http' | 'parse' | 'network' | 'no_key'; detail: string; model: string | null; usage: ClaudeUsage | null };
+
+export interface ClaudeJsonRequest {
+  apiKey: string | undefined;
+  system: string;
+  user: string;
+  format: JsonFormat;
+  /** `output_config.effort`; omitted when undefined (the model's default). */
+  effort?: 'low' | 'medium' | 'high' | 'xhigh' | 'max';
+  maxTokens?: number;
+  /** How long to wait before giving the pass up as a network failure. */
+  timeoutMs?: number;
+  /** Test seam: the fetch to use. */
+  fetchImpl?: typeof fetch;
+}
+
+/**
+ * The second system block: the schema, said in words, so a reply is JSON
+ * and nothing else even where the structured output is not honoured.
+ */
+export function jsonOnlyInstruction(format: JsonFormat): string {
+  return `Reply with a single JSON object and nothing else: no prose before or after it, no code fence. It must match this JSON Schema exactly:\n${JSON.stringify(format.schema)}`;
+}
+
+/**
+ * The JSON object inside a reply. A model told to answer with JSON only
+ * mostly does; when it wraps the object in a code fence or a sentence, the
+ * first '{' to the last '}' is read instead of giving up. Anything that
+ * still does not parse is null -- the caller's heuristic answers then.
+ */
+export function extractJson(text: string): unknown {
+  const trimmed = text.trim();
+  try {
+    return JSON.parse(trimmed);
+  } catch {
+    // Fall through to the lenient read.
+  }
+  const unfenced = trimmed.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/, '');
+  try {
+    return JSON.parse(unfenced);
+  } catch {
+    // Fall through.
+  }
+  const first = trimmed.indexOf('{');
+  const last = trimmed.lastIndexOf('}');
+  if (first === -1 || last <= first) return null;
+  try {
+    return JSON.parse(trimmed.slice(first, last + 1));
+  } catch {
+    return null;
+  }
+}
+
+/** The request body, as the Messages API takes it. Pure, so a test can read it. */
+export function claudeJsonBody(req: ClaudeJsonRequest): Record<string, unknown> {
+  return {
+    model: CLAUDE_MODEL,
+    max_tokens: req.maxTokens ?? 16000,
+    system: [
+      { type: 'text', text: req.system },
+      { type: 'text', text: jsonOnlyInstruction(req.format) },
+    ],
+    messages: [{ role: 'user', content: req.user }],
+    output_config: {
+      format: req.format,
+      ...(req.effort ? { effort: req.effort } : {}),
+    },
+    fallbacks: [{ model: CLAUDE_FALLBACK_MODEL }],
+  };
+}
+
+function usageOf(body: Record<string, unknown> | null): ClaudeUsage | null {
+  const u = body?.usage as Record<string, unknown> | undefined;
+  if (!u) return null;
+  const input = Number(u.input_tokens);
+  const output = Number(u.output_tokens);
+  if (!Number.isFinite(input) || !Number.isFinite(output)) return null;
+  return { input_tokens: input, output_tokens: output };
+}
+
+export async function askClaudeForJson(req: ClaudeJsonRequest): Promise<ClaudeJsonResult> {
+  if (!req.apiKey?.trim()) {
+    return { ok: false, reason: 'no_key', detail: 'ANTHROPIC_API_KEY is not set', model: null, usage: null };
+  }
+  const doFetch = req.fetchImpl ?? fetch;
+  let response: Response;
+  try {
+    response = await doFetch(MESSAGES_URL, {
+      method: 'POST',
+      headers: {
+        'x-api-key': req.apiKey.trim(),
+        'anthropic-version': ANTHROPIC_VERSION,
+        'anthropic-beta': FALLBACK_BETA,
+        'content-type': 'application/json',
+      },
+      body: JSON.stringify(claudeJsonBody(req)),
+      signal: AbortSignal.timeout(req.timeoutMs ?? 110_000),
+    });
+  } catch (error) {
+    return { ok: false, reason: 'network', detail: String((error as Error)?.message ?? error), model: null, usage: null };
+  }
+
+  let body: Record<string, unknown> | null = null;
+  try {
+    body = (await response.json()) as Record<string, unknown>;
+  } catch {
+    body = null;
+  }
+  const model = typeof body?.model === 'string' ? body.model : null;
+  const usage = usageOf(body);
+
+  if (!response.ok) {
+    const detail = typeof body?.error === 'object' && body.error
+      ? String((body.error as Record<string, unknown>).message ?? response.status)
+      : `HTTP ${response.status}`;
+    return { ok: false, reason: 'http', detail: `${response.status}: ${detail}`, model, usage };
+  }
+
+  const stopReason = typeof body?.stop_reason === 'string' ? body.stop_reason : null;
+  if (stopReason === 'refusal') {
+    return { ok: false, reason: 'refusal', detail: 'the model declined', model, usage };
+  }
+
+  const content = Array.isArray(body?.content) ? (body!.content as { type?: string; text?: string }[]) : [];
+  const text = content.find((b) => b?.type === 'text' && typeof b.text === 'string')?.text;
+  const json = text ? extractJson(text) : null;
+  if (json === null || typeof json !== 'object') {
+    return { ok: false, reason: 'parse', detail: text ? 'the reply was not a JSON object' : 'the reply held no text', model, usage };
+  }
+  return { ok: true, json, model: model ?? CLAUDE_MODEL, usage, stop_reason: stopReason };
+}
diff --git a/supabase/functions/_shared/lessonAnalysis.ts b/supabase/functions/_shared/lessonAnalysis.ts
new file mode 100644
index 0000000..749b971
--- /dev/null
+++ b/supabase/functions/_shared/lessonAnalysis.ts
@@ -0,0 +1,209 @@
+// The post-session coaching for the teacher who taught: the prompt, the
+// shape the model is held to, the reading of what came back, and the
+// metrics-only fallback when there is no model. Pure, no Deno imports.
+//
+// Ported from online-lms src/lib/coaching/analyze.ts (§7.3). The prompt and
+// the heuristic are that file's, unchanged; what moved is the network call,
+// which lives in lesson-finalize/index.ts, and the zod schema, which is a
+// hand-written check here so the module needs nothing installed. What lands
+// in lesson_feedback is for the teacher and their in-charge -- never a
+// family's business -- so every string here is written to that reader.
+
+import type { SessionMetrics, TranscriptSegment } from './lessonMetrics.ts';
+
+/** A specific, timestamped moment in the lesson worth learning from. */
+export interface FeedbackMoment {
+  at: string; // "mm:ss" matching the transcript markers
+  kind: 'strength' | 'improvement';
+  quote: string; // short verbatim excerpt
+  comment: string; // why it worked / what to try instead
+}
+
+export interface TeacherFeedback {
+  summary: string;
+  strengths: string[];
+  suggestions: string[];
+  moments: FeedbackMoment[];
+  dimension_scores: {
+    engagement: number;
+    questioning: number;
+    clarity: number;
+    rapport: number;
+  };
+}
+
+// JSON Schema for structured outputs (no min/max — unsupported; enforced in prompt).
+export const FEEDBACK_FORMAT = {
+  type: 'json_schema' as const,
+  schema: {
+    type: 'object',
+    additionalProperties: false,
+    properties: {
+      summary: { type: 'string' },
+      strengths: { type: 'array', items: { type: 'string' } },
+      suggestions: { type: 'array', items: { type: 'string' } },
+      moments: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: false,
+          properties: {
+            at: { type: 'string' },
+            kind: { type: 'string', enum: ['strength', 'improvement'] },
+            quote: { type: 'string' },
+            comment: { type: 'string' },
+          },
+          required: ['at', 'kind', 'quote', 'comment'],
+        },
+      },
+      dimension_scores: {
+        type: 'object',
+        additionalProperties: false,
+        properties: {
+          engagement: { type: 'integer' },
+          questioning: { type: 'integer' },
+          clarity: { type: 'integer' },
+          rapport: { type: 'integer' },
+        },
+        required: ['engagement', 'questioning', 'clarity', 'rapport'],
+      },
+    },
+    required: ['summary', 'strengths', 'suggestions', 'moments', 'dimension_scores'],
+  },
+};
+
+export const ANALYSIS_SYSTEM = `You are a supportive tutoring coach reviewing a 1-1 lesson transcript and metrics.
+Lead with strengths. Be specific and actionable, grounded in the transcript and the numbers.
+Keep each strength and suggestion to one sentence. Score each dimension 1-5 (integers).
+
+Also extract 3-6 KEY MOMENTS from the transcript — the specific situations most worth learning
+from, balanced between what worked ("strength") and what could have gone better ("improvement").
+For each moment: "at" is the [mm:ss] timestamp of the line it refers to (copy it from the
+transcript), "quote" is a short verbatim excerpt (max ~20 words), and "comment" explains —
+for a strength, exactly what was effective; for an improvement, what to do instead, phrased as
+a concrete alternative the teacher could have said or done in that situation. Only reference
+things actually present in the transcript; if it is too short for meaningful moments, return fewer.`;
+
+/** The user turn: the lesson, its numbers, and the transcript with [mm:ss] markers. */
+export function analysisUserPrompt(
+  segments: TranscriptSegment[],
+  metrics: SessionMetrics,
+  ctx: { teacherName: string; studentName: string; course: string },
+): string {
+  const transcript = segments
+    .map((s) => `[${fmt(s.start_ms)}] ${s.speaker === 'teacher' ? 'Teacher' : 'Student'}: ${s.text}`)
+    .join('\n');
+
+  return `Lesson: ${ctx.course}. Teacher: ${ctx.teacherName}. Student: ${ctx.studentName}.
+
+Metrics:
+- Teacher talk: ${pct(metrics.teacher_talk_pct)} / Student talk: ${pct(metrics.student_talk_pct)}
+- Questions: ${metrics.question_count} (open ${pct(metrics.open_question_pct)})
+- Avg wait after a question: ${(metrics.avg_wait_ms / 1000).toFixed(1)}s
+- Student turns: ${metrics.student_turns} (avg ${(metrics.avg_student_turn_ms / 1000).toFixed(1)}s)
+- Praise moments: ${metrics.praise_count}
+
+Transcript:
+${transcript}`;
+}
+
+/**
+ * What the model returned, as TeacherFeedback, or null when it is not one.
+ * The same acceptance as analyze.ts's FeedbackSchema.safeParse: every field
+ * present and of its type, the moment kinds from the enum, the scores
+ * numbers. A near miss is a miss -- the heuristic is the answer then, not a
+ * half-read object stored as if it were whole.
+ */
+export function parseFeedback(raw: unknown): TeacherFeedback | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const r = raw as Record<string, unknown>;
+  if (typeof r.summary !== 'string') return null;
+  if (!isStringArray(r.strengths) || !isStringArray(r.suggestions)) return null;
+  if (!Array.isArray(r.moments)) return null;
+  const moments: FeedbackMoment[] = [];
+  for (const m of r.moments) {
+    if (!m || typeof m !== 'object') return null;
+    const x = m as Record<string, unknown>;
+    if (typeof x.at !== 'string' || typeof x.quote !== 'string' || typeof x.comment !== 'string') return null;
+    if (x.kind !== 'strength' && x.kind !== 'improvement') return null;
+    moments.push({ at: x.at, kind: x.kind, quote: x.quote, comment: x.comment });
+  }
+  const d = r.dimension_scores;
+  if (!d || typeof d !== 'object') return null;
+  const scores = d as Record<string, unknown>;
+  for (const key of ['engagement', 'questioning', 'clarity', 'rapport']) {
+    if (typeof scores[key] !== 'number' || Number.isNaN(scores[key])) return null;
+  }
+  return {
+    summary: r.summary,
+    strengths: r.strengths,
+    suggestions: r.suggestions,
+    moments,
+    dimension_scores: {
+      engagement: scores.engagement as number,
+      questioning: scores.questioning as number,
+      clarity: scores.clarity as number,
+      rapport: scores.rapport as number,
+    },
+  };
+}
+
+function isStringArray(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((v) => typeof v === 'string');
+}
+
+export function fmt(ms: number) {
+  const s = Math.floor(ms / 1000);
+  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
+}
+export function pct(x: number) {
+  return `${Math.round(x * 100)}%`;
+}
+
+/** Deterministic fallback so the dashboard is meaningful without an API key. */
+export function heuristicFeedback(m: SessionMetrics): TeacherFeedback {
+  const strengths: string[] = [];
+  const suggestions: string[] = [];
+
+  if (m.student_talk_pct >= 0.4)
+    strengths.push('Strong student voice — they did a healthy share of the talking and thinking.');
+  if (m.open_question_pct >= 0.4)
+    strengths.push("Good use of open questions to draw out the student's reasoning.");
+  if (m.praise_count >= 3)
+    strengths.push("Warm and encouraging — you reinforced the student's effort throughout.");
+  if (m.avg_wait_ms >= 2500)
+    strengths.push('You gave real wait-time after questions, letting the student think.');
+  if (strengths.length === 0)
+    strengths.push('You kept the lesson moving and covered the planned ground.');
+
+  if (m.teacher_talk_pct > 0.65)
+    suggestions.push('Aim to talk less — try handing the next step to the student to solve aloud.');
+  if (m.open_question_pct < 0.4)
+    suggestions.push("Mix in more open 'how/why' questions rather than yes/no checks.");
+  if (m.avg_wait_ms < 2000)
+    suggestions.push('Extend your wait-time after a question to ~3 seconds before stepping in.');
+  if (m.praise_count < 2)
+    suggestions.push('Name specific things the student did well to build their confidence.');
+  if (suggestions.length === 0)
+    suggestions.push("Keep doing what you're doing — consider stretching the student with a harder follow-up.");
+
+  const score = (good: boolean, mid: boolean) => (good ? 5 : mid ? 4 : 3);
+  return {
+    summary: `Student talked ${pct(m.student_talk_pct)} of the lesson across ${m.student_turns} turns, with ${m.question_count} questions asked. ${
+      m.teacher_talk_pct > 0.65 ? "There's room to hand more of the work to the student." : 'A nicely balanced session.'
+    }`,
+    strengths,
+    suggestions,
+    moments: [], // transcript-specific moments need the AI pass
+    dimension_scores: {
+      engagement: clamp(score(m.student_talk_pct >= 0.4, m.student_talk_pct >= 0.3)),
+      questioning: clamp(score(m.open_question_pct >= 0.4 && m.question_count >= 5, m.question_count >= 3)),
+      clarity: clamp(score(m.avg_wait_ms >= 2500, m.avg_wait_ms >= 1500)),
+      rapport: clamp(score(m.praise_count >= 3, m.praise_count >= 1)),
+    },
+  };
+}
+
+function clamp(n: number) {
+  return Math.max(1, Math.min(5, n));
+}
diff --git a/supabase/functions/_shared/lessonFollowups.ts b/supabase/functions/_shared/lessonFollowups.ts
