+import {
+  GP_OPTIONS,
+  OTR_BANDS,
+  PREV_HW_OPTIONS,
+  heuristicSessionReport,
+  normaliseDraft,
+  normaliseGp,
+  normaliseOtr,
+  normalisePrevHw,
+  normaliseUnderstanding,
+  normaliseWrittenTests,
+  signsReports,
+  testPercent,
+  validateReportDraft,
+  type SessionReportDraft,
+} from '../supabase/functions/_shared/reportDraft';
+
+/**
+ * A draft speaks the report form's vocabulary before the database sees it.
+ *
+ * lesson_report_drafts holds the draft lesson-finalize writes, with a CHECK
+ * on prev_hw (exactly the nine portal strings) and on otr (bands of five,
+ * 5..95). A model asked for prev_hw says "partly"; asked for an OTR it says
+ * 83. Both are coerced here -- "partly" to Partially Done, 83 to 85 -- so
+ * what reaches the database is a value the form would offer, and a draft
+ * is never lost to a constraint for a word the model chose. These are
+ * online-lms's tests (tests/mvapp-template.test.ts and
+ * draft-session-report.test.ts) against the ported module, so the port is
+ * held to the original's answers rather than to its own.
+ */
+
+const base: SessionReportDraft = {
+  topic: 'Quadratics — completing the square',
+  topic_completed: true,
+  topics_not_done: null,
+  understanding: 8,
+  otr: 85,
+  gp: 6.25,
+  prev_hw: 'Yes',
+  homework: 'Ex 4B 1-8',
+  remarks: 'Good session.',
+  written_tests: [],
+  has_upcoming_tests: false,
+};
+
+describe('the vocabulary is the form\'s', () => {
+  it("has the portal's option lists", () => {
+    expect(GP_OPTIONS[0]).toBe(7);
+    expect(GP_OPTIONS[GP_OPTIONS.length - 1]).toBe(1);
+    expect(GP_OPTIONS).toHaveLength(25);
+    expect(OTR_BANDS[0]).toEqual({ lower: 95, label: '95% to 100%' });
+    expect(OTR_BANDS).toHaveLength(19);
+  });
+
+  it('holds exactly the nine prev_hw strings the app\'s own form offers', () => {
+    // One rule, two places (the app's chips and the worker's normaliser) --
+    // so a test that fails when they diverge.
+    // eslint-disable-next-line @typescript-eslint/no-require-imports
+    const fields = require('../src/lib/reportFields');
+    const appList: string[] = fields.PREV_HW_OPTIONS ?? fields.PREV_HW ?? fields.prevHwOptions;
+    expect(Array.isArray(appList)).toBe(true);
+    expect([...PREV_HW_OPTIONS]).toEqual(appList.map((o: string | { value: string }) => (typeof o === 'string' ? o : o.value)));
+    expect(PREV_HW_OPTIONS).toHaveLength(9);
+  });
+
+  it('snaps GP to quarters and OTR to bands', () => {
+    expect(normaliseGp(6.3)).toBe(6.25);
+    expect(normaliseGp('5.9')).toBe(6);
+    expect(normaliseGp(9)).toBe(7);
+    expect(normaliseGp(null)).toBeNull();
+    expect(normaliseOtr(83)).toBe(85);
+    expect(normaliseOtr(0)).toBeNull();
+    expect(normaliseOtr(120)).toBe(95);
+    expect(normaliseUnderstanding(7.6)).toBe(8);
+    expect(normaliseUnderstanding(0)).toBe(1);
+  });
+
+  it('every OTR the normaliser can produce passes lesson_report_drafts_otr_check', () => {
+    for (let n = -5; n <= 130; n += 1) {
+      const otr = normaliseOtr(n);
+      if (otr === null) continue;
+      expect(otr % 5).toBe(0);
+      expect(otr).toBeGreaterThanOrEqual(5);
+      expect(otr).toBeLessThanOrEqual(95);
+    }
+  });
+
+  it('maps loose homework phrases onto the nine options', () => {
+    expect(normalisePrevHw('yes')).toBe('Yes');
+    expect(normalisePrevHw('Partly done')).toBe('Partially Done');
+    expect(normalisePrevHw('mostly complete')).toBe('Most of it Done');
+    expect(normalisePrevHw('none was given')).toBe('No Homework Given');
+    expect(normalisePrevHw('forgot his exercise book')).toBe('Did Not Bring Exercise Book');
+    expect(normalisePrevHw('not done')).toBe('Not Done');
+    expect(normalisePrevHw('sent it by whatsapp, done')).toBe('Done And Sent Through Email/Skype/Whatsapp');
+    expect(normalisePrevHw('unclear')).toBeNull();
+  });
+
+  it('derives written-test percentages from marks only', () => {
+    expect(testPercent(17, 20)).toBe(85);
+    expect(testPercent(21, 20)).toBeNull();
+    expect(normaliseWrittenTests([{ name: ' Topic test ', score: 17, out_of: 20 }, { name: '', score: 1, out_of: 2 }])).toEqual([
+      { name: 'Topic test', score: 17, out_of: 20, percent: 85 },
+    ]);
+  });
+
+  it('validates what submit_report would refuse', () => {
+    expect(validateReportDraft(base, { signs: true })).toEqual([]);
+    expect(validateReportDraft({ ...base, gp: null }, { signs: true })).toContain('A report needs a GP before it goes to the family.');
+    expect(validateReportDraft(base, { signs: false })).toContain('The GP is set by the in-charge for this report.');
+    expect(validateReportDraft({ ...base, gp: null }, { signs: false })).toEqual([]);
+    expect(validateReportDraft({ ...base, topic: ' ' }, { signs: true })).toContain('A report needs the topic that was taught.');
+    expect(validateReportDraft({ ...base, understanding: 11 }, { signs: true }).length).toBe(1);
+    expect(validateReportDraft({ ...base, topic_completed: true, topics_not_done: 'surds' }, { signs: true }).length).toBe(1);
+    expect(validateReportDraft({ ...base, otr: 83 }, { signs: true }).length).toBe(1);
+  });
+});
+
+const draftBase = {
+  notes: 'Good focus. Struggled with negative coefficients.',
+  segments: [],
+  metrics: null,
+  studentName: 'Aarav Sharma',
+  course: 'IGCSE Maths',
+  topicOptions: ['Quadratics', 'Surds'],
+  bookedTopic: 'Quadratics',
+  signs: true,
+};
+
+describe('the heuristic draft', () => {
+  it('produces a valid signed draft from notes and results', () => {
+    const { draft } = heuristicSessionReport({
+      ...draftBase,
+      testResults: [{ name: 'Quick check', score: 8, out_of: 10 }],
+      previousHomework: 'Ex 4B',
+      previousHomeworkStatus: 'verified',
+    });
+    expect(validateReportDraft(draft, { signs: true })).toEqual([]);
+    expect(draft).toMatchObject({ topic: 'Quadratics', understanding: 8, prev_hw: 'Yes', written_tests: [{ name: 'Quick check', score: 8, out_of: 10, percent: 80 }] });
+    expect(draft.remarks).toMatch(/^Aarav/);
+    expect(draft.gp).not.toBeNull();
+  });
+
+  it('leaves the GP for the in-charge when the author does not sign', () => {
+    const { draft } = heuristicSessionReport({ ...draftBase, signs: false });
+    expect(draft.gp).toBeNull();
+    expect(validateReportDraft(draft, { signs: false })).toEqual([]);
+  });
+
+  it('says it was no model', () => {
+    expect(heuristicSessionReport(draftBase).rationale).toMatch(/no AI pass was run/);
+  });
+});
+
+describe('what the model said, coerced', () => {
+  it('coerces model output into the template vocabulary', () => {
+    const draft = normaliseDraft(
+      {
+        topic: 'quadratics',
+        topic_completed: false,
+        topics_not_done: 'completing the square',
+        understanding: 7.4,
+        otr: 82,
+        gp: 5.9,
+        prev_hw: 'partly',
+        homework: 'Ex 5A',
+        remarks: 'Well done.',
+        written_tests: [{ name: 'Quick check', score: 8, out_of: 10 }],
+        has_upcoming_tests: 'yes',
+      },
+      { signs: true, topicOptions: ['Quadratics'], bookedTopic: null, testResults: [{ name: 'quick check', score: 8, out_of: 10 }] },
+    );
+    expect(draft).toMatchObject({ topic: 'Quadratics', topic_completed: false, topics_not_done: 'completing the square', understanding: 7, otr: 80, gp: 6, prev_hw: 'Partially Done', has_upcoming_tests: true });
+    expect(draft.written_tests).toHaveLength(1);
+    expect(validateReportDraft(draft, { signs: true })).toEqual([]);
+  });
+
+  it('drops the GP and topics_not_done when they are not allowed', () => {
+    const draft = normaliseDraft({ topic: 'X', topic_completed: true, topics_not_done: 'y', understanding: 5, gp: 6 }, { signs: false, topicOptions: [], bookedTopic: null, testResults: [] });
+    expect(draft.gp).toBeNull();
+    expect(draft.topics_not_done).toBeNull();
+  });
+
+  it('whatever the model says for prev_hw, the draft holds one of the nine or null -- never its own words', () => {
+    // 'Sometimes' reads as Partially Done (the normaliser is loose on
+    // purpose); 'Sort of' reads as nothing. Neither reaches the database as
+    // the word the model chose, which is what lesson_report_drafts_prev_hw_check
+    // would refuse.
+    for (const said of ['Sometimes', 'Sort of', 'Did it on the bus', 'TBD', '???', 'Yes!!', 'None was set this week']) {
+      const draft = normaliseDraft({ topic: 'X', understanding: 5, prev_hw: said }, { signs: false, topicOptions: [], bookedTopic: null, testResults: [] });
+      expect(draft.prev_hw === null || (PREV_HW_OPTIONS as readonly string[]).includes(draft.prev_hw)).toBe(true);
+      expect(draft.prev_hw).not.toBe(said === 'Yes!!' ? 'Yes!!' : said);
+    }
+    expect(normaliseDraft({ topic: 'X', understanding: 5, prev_hw: 'Sort of' }, { signs: false, topicOptions: [], bookedTopic: null, testResults: [] }).prev_hw).toBeNull();
+  });
+});
+
+describe('who signs a report', () => {
+  // submit_report's v_signs_it, read the same way: whoever's word is final
+  // on the report sets the GP, and nobody else is offered one.
+  it('staff, support and admin sign; a teacher only with report_auto_approve', () => {
+    expect(signsReports({ full_name: 'Dana', role: 'staff', report_auto_approve: false })).toBe(true);
+    expect(signsReports({ full_name: 'Hal', role: 'admin', report_auto_approve: null })).toBe(true);
+    expect(signsReports({ full_name: 'Frank', role: 'teacher', report_auto_approve: true })).toBe(true);
+    expect(signsReports({ full_name: 'Gita', role: 'teacher', report_auto_approve: false })).toBe(false);
+    expect(signsReports({ full_name: 'Ada', role: 'parent', report_auto_approve: true })).toBe(false);
+    expect(signsReports(null)).toBe(false);
+  });
+});
