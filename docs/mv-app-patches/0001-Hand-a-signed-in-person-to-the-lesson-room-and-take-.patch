--- /dev/null
+++ b/supabase/functions/_shared/base64.ts
@@ -0,0 +1,53 @@
+// Base64, both alphabets, over bytes.
+//
+// Its own module, with no Deno imports and no atob/btoa, because the two
+// modules that need it — lessonRoom.ts (a ticket's token) and dailyWebhook.ts
+// (Daily's HMAC secret and signature) — are run for real by the smoke suite,
+// and whether jest's environment has the browser globals is not something a
+// test about a signature should depend on. Thirty lines beats finding out.
+
+const STANDARD = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
+const URL_SAFE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
+
+/**
+ * Encode. The URL-safe alphabet (RFC 4648 §5) is unpadded, which is what a
+ * value headed for a URL fragment wants; the standard one is padded, which is
+ * what Daily compares a signature against.
+ */
+export function encodeBase64(bytes: Uint8Array, options: { url?: boolean } = {}): string {
+  const alphabet = options.url ? URL_SAFE : STANDARD;
+  const pad = options.url ? '' : '=';
+  let out = '';
+  for (let i = 0; i < bytes.length; i += 3) {
+    const hasB = i + 1 < bytes.length;
+    const hasC = i + 2 < bytes.length;
+    const n = (bytes[i] << 16) | ((hasB ? bytes[i + 1] : 0) << 8) | (hasC ? bytes[i + 2] : 0);
+    out += alphabet[(n >>> 18) & 63] + alphabet[(n >>> 12) & 63];
+    out += hasB ? alphabet[(n >>> 6) & 63] : pad;
+    out += hasC ? alphabet[n & 63] : pad;
+  }
+  return out;
+}
+
+/**
+ * Decode either alphabet, padded or not. Null for anything that is not
+ * base64 at all — a caller comparing bytes wants "no bytes", never a throw
+ * inside a signature check.
+ */
+export function decodeBase64(text: string): Uint8Array<ArrayBuffer> | null {
+  const clean = text.trim().replace(/-/g, '+').replace(/_/g, '/').replace(/=+$/, '');
+  if (clean === '' || /[^A-Za-z0-9+/]/.test(clean) || clean.length % 4 === 1) return null;
+  const out = new Uint8Array(Math.floor((clean.length * 3) / 4));
+  let buffer = 0;
+  let bits = 0;
+  let n = 0;
+  for (const ch of clean) {
+    buffer = ((buffer << 6) | STANDARD.indexOf(ch)) & 0xffffff;
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out[n++] = (buffer >>> bits) & 0xff;
+    }
+  }
+  return out;
+}
