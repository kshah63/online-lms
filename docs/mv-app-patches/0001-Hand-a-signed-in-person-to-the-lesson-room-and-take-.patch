+  it('the whitelist is the five surfaces the room serves by ticket', () => {
+    expect([...PAGE_PREFIXES]).toEqual(['/home/', '/bank', '/syllabus', '/test/', '/tests/']);
+  });
+});
+
+describe('room-ticket asks the rule', () => {
