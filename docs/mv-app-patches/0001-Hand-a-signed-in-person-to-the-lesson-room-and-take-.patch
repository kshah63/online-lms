--- /dev/null
+++ b/supabase/functions/room-ticket/index.ts
@@ -0,0 +1,248 @@
+// Supabase Edge Function — mints the ticket that hands a signed-in person to
+// the lesson room (room.mathvisionapp.com) with no second login.
+//
+// The app and the room share one Supabase project and one auth.users, but a
+// phone's session lives in the app's storage and a browser's in a cookie, and
+// there is no safe way to carry the first into the second through a URL. So
+// the app asks here for a TICKET instead: 32 random bytes, two minutes, one
+// use, whose hash alone is stored. The room's /join page hands the token back
+// through room-redeem, which turns it into a magic-link sign-in for the same
+// person. The token rides in the URL fragment, which a browser never sends to
+// a server, so it is in no access log and no Referer.
+//
+// Who may have a ticket is decided in the database, not here:
+//   'join'  room_access(p_session_id, uid) must name a seat — host, learner
+//           or observer — and the ticket lands on that lesson and nowhere
+//           else; the path is the session's, never the caller's.
+//   'page'  an approved account (profiles.approved_at) may land on one of
+//           the room's own pages — practice, progress, the bank, a test —
+//           and only on those (PAGE_PREFIXES in _shared/lessonRoom.ts).
+//
+//   supabase functions deploy room-ticket
+//
+// Secrets:
+//   ROOM_URL   where the room is served, e.g. https://room.mathvisionapp.com.
+//              Falls back to edge_config.room_url, the same value the
+//              database stamps on a session's meeting_url, so one setting can
+//              serve both when that is simpler.
+
+import { createClient } from 'jsr:@supabase/supabase-js@2';
+
+import {
+  TICKET_TTL_MS,
+  isUuid,
+  joinPath,
+  lessonRoomName,
+  pageNextIsAllowed,
+  sha256Hex,
+  ticketUrl,
+  tokenFrom,
+} from '../_shared/lessonRoom.ts';
+import { captureError } from '../_shared/report.ts';
+
+const SUPABASE_URL = Deno.env.get('SUPABASE_URL')!;
+const SERVICE_ROLE_KEY = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;
+/**
+ * The key the functions use to talk to their own project.
+ *
+ * MV_ANON_KEY is checked FIRST, and that order is the point. Supabase has
+ * moved to publishable/secret API keys issued through JWT Signing Keys, and
+ * the dashboard now lists SUPABASE_ANON_KEY as deprecated. On a project that
+ * has moved, the legacy variable is still injected but the key it holds is no
+ * longer honoured — so createClient succeeds, auth.getUser is rejected, and
+ * every call dies with a 401 that says nothing about keys.
+ *
+ * Preferring the legacy value would make MV_ANON_KEY useless in exactly the
+ * situation it exists for: there would be no way to override a key that is
+ * present but dead. SUPABASE_ANON_KEY stays as the fallback for projects still
+ * on legacy keys, where it is correct and nobody has to set anything.
+ *
+ * Set MV_ANON_KEY to the same value the app ships in
+ * EXPO_PUBLIC_SUPABASE_ANON_KEY. The app reaching PostgREST with it is proof
+ * the project accepts it. The SUPABASE_ prefix is reserved, which is why this
+ * needs a name of its own rather than correcting the original in place.
+ *
+ * Not a secret in any real sense: this key ships inside the app and is
+ * readable by anyone holding the binary. Row-level security protects the data;
+ * the key only says which project to talk to.
+ */
+const ANON_KEY =
+  Deno.env.get('MV_ANON_KEY') ?? Deno.env.get('SUPABASE_ANON_KEY');
+
+const CORS = {
+  'Access-Control-Allow-Origin': '*',
+  'Access-Control-Allow-Headers': 'authorization, content-type',
+  'Access-Control-Allow-Methods': 'POST, OPTIONS',
+};
+
+type TicketRequest = {
+  purpose?: unknown;
+  session_id?: unknown;
+  next?: unknown;
+};
+
+const admin = createClient(SUPABASE_URL, SERVICE_ROLE_KEY, {
+  auth: { persistSession: false },
+});
+
+/**
+ * Who is asking, resolved from their own bearer token.
+ *
+ * Every failure here used to come back as the single word "invalid session",
+ * which on a phone is an alert that tells nobody anything. It covers at least
+ * four different problems: no anon key on the function, an expired token, a
+ * token signed for another project, and Auth being unreachable. They need
+ * different fixes, so they say different things and the real error is logged.
+ *
+ * The token is passed to getUser explicitly rather than left to the client's
+ * Authorization header. Both work, but the header route depends on the client
+ * finding no stored session first, which is a subtlety worth not resting a
+ * feature on.
+ */
+async function resolveCaller(authHeader: string) {
+  if (!ANON_KEY) {
+    console.error('SUPABASE_ANON_KEY is not set on this function');
+    return { user: null, status: 500, error: 'the lesson room is not configured on the server' };
+  }
+
+  const token = authHeader.replace(/^Bearer\s+/i, '').trim();
+  if (!token) return { user: null, status: 401, error: 'no sign-in token was sent' };
+
+  const asCaller = createClient(SUPABASE_URL, ANON_KEY, {
+    auth: { persistSession: false },
+  });
+
+  const { data, error } = await asCaller.auth.getUser(token);
+  if (error || !data?.user) {
+    console.error('could not verify the caller', error);
+    return {
+      user: null,
+      status: 401,
+      error: error?.message
+        ? `your sign-in could not be verified: ${error.message}`
+        : 'your sign-in could not be verified — sign out and back in',
+    };
+  }
+
+  return { user: data.user, status: 200, error: null };
+}
+
+/**
+ * Where the room lives. The secret first; failing that, the row the database
+ * itself reads when it stamps meeting_url, so the two can never point at
+ * different hosts unless somebody set both. Null means the lesson platform
+ * is simply not switched on for this project yet.
+ */
+async function roomUrl(): Promise<string | null> {
+  const fromEnv = (Deno.env.get('ROOM_URL') ?? '').trim();
+  if (fromEnv) return fromEnv;
+  const { data } = await admin.from('edge_config').select('room_url').eq('id', 1).maybeSingle();
+  const fromConfig = typeof data?.room_url === 'string' ? data.room_url.trim() : '';
+  return fromConfig || null;
+}
+
+Deno.serve(async (req) => {
+  if (req.method === 'OPTIONS') return new Response('ok', { headers: CORS });
+  if (req.method !== 'POST') return json({ error: 'method not allowed' }, 405);
+
+  const authHeader = req.headers.get('Authorization');
+  if (!authHeader) return json({ error: 'missing authorization' }, 401);
+
+  const resolved = await resolveCaller(authHeader);
+  if (!resolved.user) return json({ error: resolved.error }, resolved.status);
+  const caller = resolved.user;
+
+  let body: TicketRequest;
+  try {
+    body = await req.json();
+  } catch {
+    return json({ error: 'bad request' }, 400);
+  }
+
+  try {
+    // ---- Authorisation, decided in the database ----------------------------
+    let next: string;
+    let sessionId: string | null = null;
+
+    if (body.purpose === 'join') {
+      if (!isUuid(body.session_id)) return json({ error: 'session_id is required' }, 400);
+      sessionId = body.session_id.toLowerCase();
+
+      // One rule for every seat in the room — the same function the room's
+      // own pages ask before showing a lesson. Null is "no seat": not the
+      // teacher, not the student, not an observer, or not an online lesson
+      // in an enabled room inside its time window.
+      const { data: seat, error } = await admin.rpc('room_access', {
+        p_session_id: sessionId,
+        uid: caller.id,
+      });
+      if (error) throw error;
+      if (!seat) return json({ error: 'That lesson is not yours to join.' }, 403);
+
+      // The room's own row, under the name Daily will say back in every
+      // webhook, from the FIRST host or learner ticket: a teacher usually
+      // arrives before the student, and the student's lesson_join is
+      // otherwise the first writer, so the teacher's joined event would
+      // find no room to land on. Idempotent — an existing row is left as it
+      // is, opened_at and all. The Daily room itself (room_url) is the room
+      // app's to create; the provider's key is not held here.
+      if (seat === 'host' || seat === 'learner') {
+        const { error: roomError } = await admin
+          .from('lesson_rooms')
+          .upsert(
+            { session_id: sessionId, room_name: lessonRoomName(sessionId) },
+            { onConflict: 'session_id', ignoreDuplicates: true },
+          );
+        if (roomError) throw roomError;
+      }
+
+      next = joinPath(sessionId);
+    } else if (body.purpose === 'page') {
+      const { data: profile, error } = await admin
+        .from('profiles')
+        .select('approved_at')
+        .eq('id', caller.id)
+        .maybeSingle();
+      if (error) throw error;
+      if (!profile?.approved_at) {
+        return json({ error: 'Your account has not been approved yet.' }, 403);
+      }
+      if (!pageNextIsAllowed(body.next)) {
+        return json({ error: 'next must be one of the room\'s own pages' }, 400);
+      }
+      next = body.next;
+    } else {
+      return json({ error: "purpose must be 'join' or 'page'" }, 400);
+    }
+
+    const host = await roomUrl();
+    if (!host) return json({ error: 'The lesson room is not set up on the server.' }, 503);
+
+    // ---- The ticket --------------------------------------------------------
+    // The token is drawn here, hashed here, and leaves only in the response.
+    // Nothing below may log it: the row holds the hash and the response is
+    // the one copy.
+    const token = tokenFrom(crypto.getRandomValues(new Uint8Array(32)));
+    const { error: insertError } = await admin.from('lesson_tickets').insert({
+      token_hash: await sha256Hex(token),
+      user_id: caller.id,
+      session_id: sessionId,
+      purpose: body.purpose,
+      next_path: next,
+      expires_at: new Date(Date.now() + TICKET_TTL_MS).toISOString(),
+    });
+    if (insertError) throw insertError;
+
+    return json({ url: ticketUrl(host, token, next) });
+  } catch (error) {
+    await captureError(error, 'room-ticket', {
+      purpose: typeof body.purpose === 'string' ? body.purpose : null,
+      session_id: isUuid(body.session_id) ? body.session_id : null,
+    });
+    return json({ error: 'Could not open the lesson room. Please try again.' }, 500);
+  }
+});
+
+function json(body: unknown, status = 200): Response {
+  return Response.json(body, { status, headers: CORS });
+}
-- 
