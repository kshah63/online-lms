+import { createHash, webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { URL } from 'node:url';
+
+/**
+ * A ticket's token exists in exactly one place: the URL the app opens.
+ *
+ * room-ticket hands a signed-in person to the lesson room with no second
+ * login, which makes the token a sign-in in its own right for two minutes.
+ * So the row holds sha256(token) and never the token — a copy of
+ * lesson_tickets is worth nothing — the token rides in the URL FRAGMENT,
+ * which a browser never sends to a server, so no access log and no Referer
+ * holds it, and no console line may mention it. Each of those is a failure
+ * nothing else notices: a token in a log looks exactly like a log.
+ *
+ * The hashing is run for real against node's own digest, because the other
+ * side of it — room-redeem hashing what the room hands back, then
+ * redeem_lesson_ticket matching token_hash — only works if this side hashes
+ * the way everybody else does.
+ */
+
+// The Deno runtime this ships to has crypto.subtle; jest's environment may
+// not. Node's own WebCrypto is the same algorithm.
+if (!globalThis.crypto?.subtle) {
+  Object.defineProperty(globalThis, 'crypto', { value: webcrypto, configurable: true });
+}
+
+const {
+  TICKET_TTL_MS,
+  joinPath,
+  lessonRoomName,
+  sha256Hex,
+  ticketUrl,
+  tokenFrom,
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+} = require('../supabase/functions/_shared/lessonRoom');
+
+const SOURCE = readFileSync(
+  join(__dirname, '..', 'supabase', 'functions', 'room-ticket', 'index.ts'),
+  'utf8',
+);
+
+const SESSION = '11111111-2222-3333-4444-555555555555';
+const bytes = Uint8Array.from({ length: 32 }, (_, i) => (i * 37 + 11) & 0xff);
+const token = tokenFrom(bytes);
+
+describe('a ticket is hashed, never stored', () => {
+  it('the token is 32 bytes, URL-safe and unpadded', () => {
+    expect(token).toHaveLength(43);
+    expect(token).toMatch(/^[A-Za-z0-9_-]+$/);
+  });
+
+  it('the hash is hex sha256 of the token, the same digest everybody else computes', async () => {
+    const hash = await sha256Hex(token);
+    expect(hash).toMatch(/^[0-9a-f]{64}$/);
+    expect(hash).toBe(createHash('sha256').update(token).digest('hex'));
+    expect(hash).not.toContain(token);
+  });
+
+  it('fewer than 32 random bytes is refused rather than padded', () => {
+    expect(() => tokenFrom(new Uint8Array(16))).toThrow(/32 random bytes/);
+  });
+
+  it('a different draw is a different token', () => {
+    const other = tokenFrom(Uint8Array.from({ length: 32 }, (_, i) => (i * 37 + 12) & 0xff));
+    expect(other).not.toBe(token);
+  });
+});
+
+describe('room-ticket writes the hash and says the token once', () => {
+  it('inserts token_hash and no token column', () => {
+    const insert = SOURCE.slice(SOURCE.indexOf(".from('lesson_tickets')"));
+    const row = insert.slice(0, insert.indexOf('});'));
+    expect(row).toMatch(/token_hash: await sha256Hex\(token\)/);
+    expect(row).not.toMatch(/\btoken:/);
+  });
+
+  it('draws 32 bytes from crypto.getRandomValues', () => {
+    expect(SOURCE).toMatch(/tokenFrom\(crypto\.getRandomValues\(new Uint8Array\(32\)\)\)/);
+  });
+
+  it('never logs the token', () => {
+    const consoleLines = SOURCE.split('\n').filter((line) =>
+      /console\.(log|error|warn|info)\(/.test(line),
+    );
+    expect(consoleLines.length).toBeGreaterThan(0);
+    for (const line of consoleLines) expect(line).not.toMatch(/\btoken\b/);
+    // The error sink's context names the purpose and the session, not the token.
+    const reported = SOURCE.slice(SOURCE.indexOf("captureError(error, 'room-ticket'"));
+    expect(reported.slice(0, reported.indexOf('});'))).not.toMatch(/\btoken\b/);
+  });
+
+  it('and the row expires two minutes out', () => {
+    expect(TICKET_TTL_MS).toBe(2 * 60 * 1000);
+    expect(SOURCE).toMatch(/expires_at: new Date\(Date\.now\(\) \+ TICKET_TTL_MS\)/);
+  });
+});
+
+describe('the URL keeps the token out of every server log', () => {
+  it('the token is in the fragment, after the join page', () => {
+    const url = new URL(ticketUrl('https://room.mathvisionapp.com', token, joinPath(SESSION)));
+    expect(url.pathname).toBe('/join');
+    expect(url.search).toBe('');
+    expect(url.hash).toBe(`#t=${token}&next=%2Flesson%2F${SESSION}`);
+  });
+
+  it('a trailing slash on ROOM_URL does not double up', () => {
+    expect(ticketUrl('https://room.mathvisionapp.com/', token, '/bank')).toBe(
+      `https://room.mathvisionapp.com/join#t=${token}&next=%2Fbank`,
+    );
+  });
+
+  it("a query string inside next stays inside next", () => {
+    const url = ticketUrl('https://room.test', token, '/home/practice?set=1&x=2');
+    expect(url.endsWith('&next=%2Fhome%2Fpractice%3Fset%3D1%26x%3D2')).toBe(true);
+  });
+
+  it('a join ticket lands on the lesson and nowhere the caller typed', () => {
+    expect(joinPath(SESSION)).toBe(`/lesson/${SESSION}`);
+    expect(SOURCE).toMatch(/next = joinPath\(sessionId\)/);
+  });
+
+  it("a join ticket makes sure the room's row exists under the name Daily will say back", () => {
+    // The webhook places events by lesson_rooms.room_name; a teacher who
+    // arrives before the student would otherwise land on no row at all.
+    expect(lessonRoomName(SESSION.toUpperCase())).toBe(`lesson-${SESSION}`);
+    expect(SOURCE).toMatch(
+      /\.from\('lesson_rooms'\)\s*\.upsert\(\s*\{ session_id: sessionId, room_name: lessonRoomName\(sessionId\) \},\s*\{ onConflict: 'session_id', ignoreDuplicates: true \},/,
+    );
+    expect(SOURCE).toMatch(/if \(seat === 'host' \|\| seat === 'learner'\)/);
+  });
+});
