@@ -0,0 +1,93 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+import { PAGE_PREFIXES, pageNextIsAllowed } from '../supabase/functions/_shared/lessonRoom';
+
+/**
+ * A 'page' ticket lands on one of the room's own pages, and nowhere else.
+ *
+ * The app asks room-ticket for a ticket with a `next`, and the room's /join
+ * redirects there once the person is signed in. That makes `next` a redirect
+ * chosen by whoever holds a signed-in app session — which is every family on
+ * a phone — so it is a relative path under a short whitelist, and nothing a
