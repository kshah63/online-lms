diff --git a/__smoke__/a-daily-event-becomes-a-room-fact.test.ts b/__smoke__/a-daily-event-becomes-a-room-fact.test.ts
new file mode 100644
index 0000000..847159b
--- /dev/null
+++ b/__smoke__/a-daily-event-becomes-a-room-fact.test.ts
@@ -0,0 +1,168 @@
+import {
+  classify,
+  lessonSessionIdOf,
+  outcomeOf,
+  recordingReadyOf,
+  roomFactOf,
+  roomNameOf,
+} from '../supabase/functions/_shared/dailyWebhook';
+
+/**
+ * What Daily says becomes exactly one row for the database door, or nothing.
+ *
+ * import_lesson_room_facts takes [{room_name, event, user_id, at}] and is
+ * the one writer of arrived_at and departed_at for online lessons. What it
+ * is given therefore has to be right in three ways nothing downstream can
+ * check: the room is one of ours (`lesson-<session id>`, so an event about
+ * some other room on the same Daily account writes nothing); the person is
+ * named by the profile id the room minted their token with, never guessed
+ * from a display name (never fake identity); and the time is the event's
+ * own clock, not when the webhook happened to arrive.
+ *
+ * Daily has used both naming styles — participant events are snake_case,
+ * transcript events arrived camelCase — so both are read; a family of events
+ * silently ignored for its spelling is a quiet day that was not one.
+ */
+
+const SESSION = '11111111-2222-3333-4444-555555555555';
+const ROOM = `lesson-${SESSION}`;
+const STUDENT = 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee';
+const RECEIVED = Date.UTC(2026, 9, 13, 9, 0, 0);
+
+describe('a Daily event becomes a room fact', () => {
+  it('a student joining is a joined row at the moment they joined', () => {
+    expect(
+      roomFactOf(
+        {
+          type: 'participant.joined',
+          event_ts: 1760000100,
+          payload: { room: ROOM, user_id: STUDENT, user_name: 'Aarav', joined_at: 1760000090, session_id: 'daily-own-id' },
+        },
+        RECEIVED,
+      ),
+    ).toEqual({ room_name: ROOM, event: 'joined', user_id: STUDENT, at: '2025-10-09T08:54:50.000Z' });
+  });
+
+  it('a student leaving is a left row at the event time', () => {
+    expect(
+      roomFactOf(
+        { type: 'participant.left', event_ts: 1760003600, payload: { room: ROOM, user_id: STUDENT, joined_at: 1760000090, duration: 3510 } },
+        RECEIVED,
+      ),
+    ).toEqual({ room_name: ROOM, event: 'left', user_id: STUDENT, at: '2025-10-09T09:53:20.000Z' });
+  });
+
+  it('without an event time, a leaving is joined_at plus the duration', () => {
+    expect(
+      roomFactOf({ type: 'participant.left', payload: { room: ROOM, user_id: STUDENT, joined_at: 1760000000, duration: 60 } }, RECEIVED)!.at,
+    ).toBe('2025-10-09T08:54:20.000Z');
+  });
+
+  it('the meeting ending is an ended row with nobody on it', () => {
+    expect(
+      roomFactOf({ type: 'meeting.ended', event_ts: 1760003700, payload: { room: ROOM, start_ts: 1760000000, end_ts: 1760003650 } }, RECEIVED),
+    ).toEqual({ room_name: ROOM, event: 'ended', user_id: null, at: '2025-10-09T09:54:10.000Z' });
+  });
+
+  it('with no clock of its own, the row is stamped when it arrived', () => {
+    expect(roomFactOf({ type: 'participant.joined', payload: { room: ROOM, user_id: STUDENT } }, RECEIVED)!.at).toBe(
+      new Date(RECEIVED).toISOString(),
+    );
+  });
+
+  it('a participant the booking cannot name is dropped, not guessed', () => {
+    expect(roomFactOf({ type: 'participant.joined', payload: { room: ROOM, user_name: 'Aarav Sharma' } }, RECEIVED)).toBeNull();
+    expect(roomFactOf({ type: 'participant.joined', payload: { room: ROOM, user_id: 'aarav' } }, RECEIVED)).toBeNull();
+  });
+
+  it('a room that is not a lesson room writes nothing', () => {
+    expect(roomFactOf({ type: 'participant.joined', payload: { room: 'standup', user_id: STUDENT } }, RECEIVED)).toBeNull();
+    expect(roomFactOf({ type: 'participant.joined', payload: { room: 'lesson-not-a-uuid', user_id: STUDENT } }, RECEIVED)).toBeNull();
+    expect(roomFactOf({ type: 'participant.joined', payload: { user_id: STUDENT } }, RECEIVED)).toBeNull();
+  });
+
+  it('reads either spelling of the room and the person', () => {
+    expect(roomNameOf({ type: 'participant.joined', payload: { room_name: ROOM } })).toBe(ROOM);
+    expect(roomNameOf({ type: 'participant.joined', payload: { roomName: ROOM } })).toBe(ROOM);
+    expect(roomNameOf({ type: 'participant.joined', payload: { room: ROOM } })).toBe(ROOM);
+    expect(
+      roomFactOf({ type: 'participant.joined', payload: { roomName: ROOM, userId: STUDENT.toUpperCase(), joinedAt: 1760000000 } }, RECEIVED),
+    ).toEqual({ room_name: ROOM, event: 'joined', user_id: STUDENT, at: '2025-10-09T08:53:20.000Z' });
+  });
+
+  it('a millisecond clock is read as one', () => {
+    expect(roomFactOf({ type: 'participant.joined', event_ts: 1760000000000, payload: { room: ROOM, user_id: STUDENT } }, RECEIVED)!.at).toBe(
+      '2025-10-09T08:53:20.000Z',
+    );
+  });
+});
+
+describe('a recording or a transcript is tied to its lesson', () => {
+  it('a ready recording names the session, the provider id, the length and the start', () => {
+    expect(
+      recordingReadyOf({
+        type: 'recording.ready-to-download',
+        payload: { recording_id: 'rec-1', room_name: ROOM, start_ts: 1760000000, duration: 3599.6, status: 'finished' },
+      }),
+    ).toEqual({ room_name: ROOM, session_id: SESSION, provider_recording_id: 'rec-1', duration_s: 3600, recorded_at: '2025-10-09T08:53:20.000Z' });
+  });
+
+  it('a recording for another room, or with no id, is nothing', () => {
+    expect(recordingReadyOf({ type: 'recording.ready-to-download', payload: { recording_id: 'rec-1', room_name: 'standup' } })).toBeNull();
+    expect(recordingReadyOf({ type: 'recording.ready-to-download', payload: { room_name: ROOM } })).toBeNull();
+  });
+
+  it('a transcript, in the camelCase Daily sends it', () => {
+    expect(outcomeOf({ type: 'transcript.ready-to-download', payload: { transcriptId: 't-1', roomName: ROOM } })).toEqual({
+      room_name: ROOM,
+      session_id: SESSION,
+      provider_id: 't-1',
+      error: null,
+    });
+  });
+
+  it("an error carries Daily's words and the id it failed on", () => {
+    expect(outcomeOf({ type: 'recording.error', payload: { recording_id: 'rec-2', room_name: ROOM, error_msg: 'storage refused' } })).toEqual({
+      room_name: ROOM,
+      session_id: SESSION,
+      provider_id: 'rec-2',
+      error: 'storage refused',
+    });
+    expect(outcomeOf({ type: 'transcript.error', payload: { room_name: ROOM } })).toEqual({
+      room_name: ROOM,
+      session_id: SESSION,
+      provider_id: null,
+      error: null,
+    });
+  });
+
+  it('the session id is read out of the room name, case folded', () => {
+    expect(lessonSessionIdOf(ROOM)).toBe(SESSION);
+    expect(lessonSessionIdOf(ROOM.toUpperCase())).toBe(SESSION);
+    expect(lessonSessionIdOf('lesson-x')).toBeNull();
+    expect(lessonSessionIdOf(null)).toBeNull();
+  });
+});
+
+describe('every delivery is one of seven things', () => {
+  it.each([
+    ['participant.joined', 'fact'],
+    ['participant.left', 'fact'],
+    ['meeting.ended', 'fact'],
+    ['recording.ready-to-download', 'recording_ready'],
+    ['recording.error', 'recording_error'],
+    ['transcript.ready-to-download', 'transcript_ready'],
+    ['transcript.error', 'transcript_error'],
+    ['meeting.started', 'ignored'],
+    ['recording.started', 'ignored'],
+    ['something.new', 'ignored'],
+  ])('%s is %s', (type, kind) => {
+    expect(classify({ type, payload: {} })).toBe(kind);
+  });
+
+  it("Daily's typeless creation ping is the test, and only that", () => {
+    expect(classify({ test: 'test' } as never)).toBe('test');
+    expect(classify({} as never)).toBe('test');
+    expect(classify(null as never)).toBe('test');
+  });
+});
diff --git a/__smoke__/a-daily-event-that-is-not-signed-is-dropped.test.ts b/__smoke__/a-daily-event-that-is-not-signed-is-dropped.test.ts
new file mode 100644
index 0000000..6010a87
--- /dev/null
+++ b/__smoke__/a-daily-event-that-is-not-signed-is-dropped.test.ts
@@ -0,0 +1,164 @@
+import { Buffer } from 'node:buffer';
+import { createHmac, webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * A Daily delivery that is not Daily's is dropped before it writes anything.
+ *
+ * daily-webhook is deployed --no-verify-jwt, because Daily has no Supabase
+ * session, so the HMAC on each delivery is the only thing between a public
+ * URL and import_lesson_room_facts — a door that writes arrived_at on a
+ * booking. The signature is over the RAW body and the timestamp header, and
+ * a delivery more than five minutes old is refused however well it is
+ * signed, so a captured request cannot be replayed on another day.
+ *
+ * The signing is cross-checked against node's own HMAC, which is what Daily
+ * computes (and what online-lms verified with before this port to Web
+ * Crypto): a verifier that only agrees with its own signer proves nothing.
+ */
+
+// The Deno runtime this ships to has crypto.subtle; jest's environment may
+// not. Node's own WebCrypto is the same algorithm.
+if (!globalThis.crypto?.subtle) {
+  Object.defineProperty(globalThis, 'crypto', { value: webcrypto, configurable: true });
+}
+
+const {
+  SIGNATURE_TOLERANCE_S,
+  signDailyDelivery,
+  verifyDailySignature,
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+} = require('../supabase/functions/_shared/dailyWebhook');
+
+const ROOT = join(__dirname, '..');
+const SOURCE = readFileSync(join(ROOT, 'supabase', 'functions', 'daily-webhook', 'index.ts'), 'utf8');
+const WORKFLOW = readFileSync(join(ROOT, '.github', 'workflows', 'functions.yml'), 'utf8');
+
+/** As Daily hands it over: the hmac field, base64. */
+const SECRET = Buffer.from('a-very-secret-key-of-reasonable-length').toString('base64');
+const BODY = JSON.stringify({
+  type: 'participant.joined',
+  payload: { room: 'lesson-11111111-2222-3333-4444-555555555555', user_id: 'u' },
+  event_ts: 1760000000,
+});
+const NOW = 1760000000 * 1000;
+const TS = String(1760000000);
+
+/** What Daily computes, in node's words. */
+function dailySigns(body: string, timestamp: string, secret = SECRET): string {
+  return createHmac('sha256', Buffer.from(secret, 'base64'))
+    .update(`${timestamp}.${body}`)
+    .digest('base64');
+}
+
+async function verdict(overrides: Record<string, unknown> = {}) {
+  return verifyDailySignature({
+    secretBase64: SECRET,
+    timestamp: TS,
+    signature: dailySigns(BODY, TS),
+    rawBody: BODY,
+    nowMs: NOW,
+    ...overrides,
+  });
+}
+
+describe('a Daily event that is not signed is dropped', () => {
+  it('our signer agrees with the HMAC Daily computes', async () => {
+    await expect(signDailyDelivery(SECRET, TS, BODY)).resolves.toBe(dailySigns(BODY, TS));
+  });
+
+  it('a correctly signed, fresh delivery passes', async () => {
+    await expect(verdict()).resolves.toEqual({ ok: true });
+  });
+
+  it('a tampered body fails: the signature is over the raw bytes', async () => {
+    await expect(verdict({ rawBody: `${BODY} ` })).resolves.toEqual({ ok: false, reason: 'mismatch' });
+    const reordered = JSON.stringify({ ...JSON.parse(BODY), payload: { user_id: 'u', room: 'lesson-11111111-2222-3333-4444-555555555555' } });
+    await expect(verdict({ rawBody: reordered })).resolves.toEqual({ ok: false, reason: 'mismatch' });
+  });
+
+  it('a signature with another secret fails', async () => {
+    const other = Buffer.from('other').toString('base64');
+    await expect(verdict({ signature: dailySigns(BODY, TS, other) })).resolves.toEqual({
+      ok: false,
+      reason: 'mismatch',
+    });
+  });
+
+  it('a near-miss fails as flatly as nonsense', async () => {
+    const real = dailySigns(BODY, TS);
+    const nearMiss = `${real.slice(0, -2)}${real.endsWith('A=') ? 'B=' : 'A='}`;
+    await expect(verdict({ signature: nearMiss })).resolves.toEqual({ ok: false, reason: 'mismatch' });
+    await expect(verdict({ signature: 'not base64 at all!' })).resolves.toEqual({ ok: false, reason: 'mismatch' });
+  });
+
+  it('a signed delivery from more than five minutes away is a replay', async () => {
+    const old = String(1760000000 - SIGNATURE_TOLERANCE_S - 1);
+    await expect(verdict({ timestamp: old, signature: dailySigns(BODY, old) })).resolves.toEqual({
+      ok: false,
+      reason: 'stale',
+    });
+    const future = String(1760000000 + SIGNATURE_TOLERANCE_S + 1);
+    await expect(verdict({ timestamp: future, signature: dailySigns(BODY, future) })).resolves.toEqual({
+      ok: false,
+      reason: 'stale',
+    });
+    // Inside the window, either side, is fine.
+    const edge = String(1760000000 - SIGNATURE_TOLERANCE_S + 5);
+    await expect(verdict({ timestamp: edge, signature: dailySigns(BODY, edge) })).resolves.toEqual({ ok: true });
+    expect(SIGNATURE_TOLERANCE_S).toBe(5 * 60);
+  });
+
+  it('the timestamp that is signed is the header text, not a number read from it', async () => {
+    // A signature over "1760000000" is not a signature over "1760000000.0".
+    await expect(verdict({ timestamp: '1760000000.0' })).resolves.toEqual({ ok: false, reason: 'mismatch' });
+  });
+
+  it('a delivery missing either header fails', async () => {
+    await expect(verdict({ timestamp: null })).resolves.toEqual({ ok: false, reason: 'missing_headers' });
+    await expect(verdict({ signature: null })).resolves.toEqual({ ok: false, reason: 'missing_headers' });
+    await expect(verdict({ signature: '' })).resolves.toEqual({ ok: false, reason: 'missing_headers' });
+  });
+
+  it('a server with no secret refuses everything, however it is signed', async () => {
+    await expect(verdict({ secretBase64: undefined })).resolves.toEqual({ ok: false, reason: 'no_secret' });
+    await expect(verdict({ secretBase64: '' })).resolves.toEqual({ ok: false, reason: 'no_secret' });
+    await expect(verdict({ secretBase64: '***' })).resolves.toEqual({ ok: false, reason: 'no_secret' });
+  });
+});
+
+describe('daily-webhook stands behind the rule', () => {
+  it('verifies before anything is written', () => {
+    const verify = SOURCE.indexOf('verifyDailySignature({');
+    expect(verify).toBeGreaterThan(-1);
+    expect(verify).toBeLessThan(SOURCE.indexOf('admin.rpc('));
+    expect(verify).toBeLessThan(SOURCE.indexOf('admin.from('));
+    expect(SOURCE).toMatch(/if \(!verdict\.ok\) \{[\s\S]*?401\)/);
+  });
+
+  it('reads the raw body, and signs over that', () => {
+    expect(SOURCE).toMatch(/const rawBody = await req\.text\(\);/);
+    expect(SOURCE).toMatch(/rawBody,\s*nowMs: Date\.now\(\)/);
+  });
+
+  it("answers Daily's typeless creation ping before asking for a secret it cannot have yet", () => {
+    const ping = SOURCE.indexOf("classify(event) === 'test'");
+    expect(ping).toBeGreaterThan(-1);
+    expect(ping).toBeLessThan(SOURCE.indexOf("Deno.env.get('DAILY_WEBHOOK_SECRET')"));
+  });
+
+  it('is deployed without JWT verification, so Daily can reach it at all', () => {
+    const list = WORKFLOW.match(/NO_JWT="([^"]+)"/);
+    expect(list).not.toBeNull();
+    expect(list![1].split(/\s+/)).toEqual(expect.arrayContaining(['daily-webhook', 'portal-notify', 'signup-household']));
+    expect(SOURCE).toMatch(/supabase functions deploy daily-webhook --no-verify-jwt/);
+  });
+
+  it('is on the deploy menu with the other two new doors', () => {
+    const menu = WORKFLOW.slice(WORKFLOW.indexOf('- all'), WORKFLOW.indexOf('workflow_call:'));
+    for (const name of ['daily-webhook', 'room-redeem', 'room-ticket']) {
+      expect(menu).toMatch(new RegExp(`^\\s+- ${name}\\s*$`, 'm'));
+    }
+  });
+});
