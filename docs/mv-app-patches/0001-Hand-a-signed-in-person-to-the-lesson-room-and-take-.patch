+// What Daily sends, and what the lesson platform makes of it.
+//
+// Pure — Web Crypto only, no Deno imports — so the smoke suite can sign a
+// delivery and watch an unsigned one dropped, rather than trusting a regex
+// over daily-webhook/index.ts. The function is deployed without JWT
+// verification (Daily has no Supabase session), so the signature check here
+// is the only thing between a public URL and a write to a booking's
+// attendance.
+//
+// Daily signs every delivery: X-Webhook-Timestamp and X-Webhook-Signature,
+// where signature = base64(HMAC-SHA256(base64decode(secret),
+// `${timestamp}.${rawBody}`)). The secret is the `hmac` Daily returned when
+// the webhook was created. Verified over the RAW body — re-serialising JSON
+// reorders nothing on purpose and everything by accident — and refused when
+// the timestamp is more than five minutes from now, so a captured delivery
+// cannot be replayed on another day.
+
+import { decodeBase64, encodeBase64 } from './base64.ts';
+import { isUuid, sameBytes } from './lessonRoom.ts';
+
+/** Daily's envelope. `payload` is whatever the event type carries. */
+export type DailyEvent = {
+  version?: string;
+  type?: string;
+  id?: string;
+  /** Seconds since the epoch, when the event happened. */
+  event_ts?: number;
+  payload?: Record<string, unknown>;
+};
+
+export const SIGNATURE_TOLERANCE_S = 5 * 60;
+
+export type Verdict =
+  | { ok: true }
+  | { ok: false; reason: 'no_secret' | 'missing_headers' | 'stale' | 'mismatch' };
+
+/** The signature Daily would put on this delivery. */
+export async function signDailyDelivery(
+  secretBase64: string,
+  timestamp: string,
+  rawBody: string,
+): Promise<string> {
+  const keyBytes = decodeBase64(secretBase64);
+  if (!keyBytes || keyBytes.length === 0) throw new Error('the webhook secret is not base64');
+  const key = await crypto.subtle.importKey(
+    'raw',
+    keyBytes,
+    { name: 'HMAC', hash: 'SHA-256' },
+    false,
+    ['sign'],
+  );
+  const mac = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(`${timestamp}.${rawBody}`));
+  return encodeBase64(new Uint8Array(mac));
+}
+
+/**
+ * Is this delivery Daily's, and recent?
+ *
+ * The timestamp that is signed is the HEADER's text, not a number parsed
+ * from it — a signature over "1700000000" is not a signature over "1.7e9".
+ * The comparison is over the MAC bytes, every byte every time.
+ */
+export async function verifyDailySignature(args: {
+  secretBase64: string | null | undefined;
+  timestamp: string | null | undefined;
+  signature: string | null | undefined;
+  rawBody: string;
+  nowMs: number;
+}): Promise<Verdict> {
+  const secret = (args.secretBase64 ?? '').trim();
+  if (secret === '' || !decodeBase64(secret)?.length) return { ok: false, reason: 'no_secret' };
+  const timestamp = (args.timestamp ?? '').trim();
+  const signature = (args.signature ?? '').trim();
+  if (timestamp === '' || signature === '') return { ok: false, reason: 'missing_headers' };
+
+  const sent = Number(timestamp);
+  // Daily sends seconds; a millisecond value is tolerated rather than
+  // refused as a year-50000 delivery.
+  const sentSeconds = sent > 1e12 ? sent / 1000 : sent;
+  if (!Number.isFinite(sentSeconds) || Math.abs(args.nowMs / 1000 - sentSeconds) > SIGNATURE_TOLERANCE_S) {
+    return { ok: false, reason: 'stale' };
+  }
+
+  const expected = decodeBase64(await signDailyDelivery(secret, timestamp, args.rawBody));
+  const given = decodeBase64(signature);
+  if (!expected || !given || !sameBytes(given, expected)) return { ok: false, reason: 'mismatch' };
+  return { ok: true };
+}
+
+// ---------------------------------------------------------------------------
+// Reading an event
+// ---------------------------------------------------------------------------
+
+/**
+ * A payload field, in either naming style Daily has used. The participant
+ * events are snake_case (`room`, `user_id`, `joined_at`); the transcript
+ * events arrived camelCase (`transcriptId`, `roomName`); the recording ones
+ * are snake_case again. Asking for both costs nothing and the alternative is
+ * a webhook that silently ignores one family of events.
+ */
+function text(payload: Record<string, unknown> | undefined, ...keys: string[]): string | null {
+  for (const key of keys) {
+    const value = payload?.[key];
+    if (typeof value === 'string' && value.trim() !== '') return value.trim();
+  }
+  return null;
+}
+
+function number(payload: Record<string, unknown> | undefined, ...keys: string[]): number | null {
+  for (const key of keys) {
+    const value = payload?.[key];
+    if (typeof value === 'number' && Number.isFinite(value)) return value;
+  }
+  return null;
+}
+
+/** Seconds (Daily's unit) or milliseconds, as an ISO timestamp. */
+function isoOf(epoch: number | null): string | null {
+  if (epoch === null || !Number.isFinite(epoch) || epoch <= 0) return null;
+  return new Date(epoch > 1e12 ? epoch : epoch * 1000).toISOString();
+}
+
+/** Daily room names are `lesson-<session_requests.id>` (room/src/lib/video/daily.ts). */
+const LESSON_ROOM = /^lesson-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i;
+
+export function lessonSessionIdOf(roomName: string | null): string | null {
+  const match = roomName?.match(LESSON_ROOM);
+  return match ? match[1].toLowerCase() : null;
+}
+
+/**
+ * The lesson room an event is about, or null when it is about some other
+ * room on the same Daily account. Only `lesson-<uuid>` rooms are ours to
+ * write for; everything else is ignored, not refused — Daily retries a
+ * refusal, and a room we do not know is not an error.
+ */
+export function roomNameOf(event: DailyEvent): string | null {
+  const name = text(event.payload, 'room_name', 'roomName', 'room');
+  return name && LESSON_ROOM.test(name) ? name : null;
+}
+
+export type Kind =
+  | 'test'
+  | 'fact'
+  | 'recording_ready'
+  | 'recording_error'
+  | 'transcript_ready'
+  | 'transcript_error'
+  | 'ignored';
+
+/**
+ * What to do with a delivery. Daily's test POST on webhook creation carries
+ * no `type` at all (`{"test": "test"}`), and the webhook is only created if
+ * it gets a 200 back, so that one is answered before anything else is asked.
+ */
+export function classify(event: DailyEvent): Kind {
+  if (typeof event?.type !== 'string') return 'test';
+  switch (event.type) {
+    case 'participant.joined':
+    case 'participant.left':
+    case 'meeting.ended':
+      return 'fact';
+    case 'recording.ready-to-download':
+      return 'recording_ready';
+    case 'recording.error':
+      return 'recording_error';
+    case 'transcript.ready-to-download':
+      return 'transcript_ready';
+    case 'transcript.error':
+      return 'transcript_error';
+    default:
+      return 'ignored';
+  }
+}
+
+/** One row of import_lesson_room_facts(p_rows). */
+export type RoomFact = {
+  room_name: string;
+  event: 'joined' | 'left' | 'ended';
+  /** The profile id the room minted the Daily token with; null for meeting.ended. */
+  user_id: string | null;
+  at: string;
+};
+
+/**
+ * A participant or meeting event as the row the database door takes.
+ *
+ * `user_id` is the participant's Daily user_id, which the room sets to the
+ * person's profile id when it mints their meeting token. A participant
+ * without one — a token minted some other way — is nobody the booking can
+ * name, so the row is dropped rather than guessed (never fake identity).
+ * meeting.ended has no participant and goes through with user_id null: the
+ * door closes the room on it.
+ *
+ * `at` is the event's own clock where it has one (joined_at, end_ts), else
+ * Daily's event_ts, else when it reached us.
+ */
+export function roomFactOf(event: DailyEvent, receivedAtMs: number): RoomFact | null {
+  const roomName = roomNameOf(event);
+  if (!roomName) return null;
+  const payload = event.payload;
+  const eventAt = isoOf(number(event, 'event_ts', 'eventTs'));
+  const fallback = eventAt ?? new Date(receivedAtMs).toISOString();
+
+  if (event.type === 'meeting.ended') {
+    return {
+      room_name: roomName,
+      event: 'ended',
+      user_id: null,
+      at: isoOf(number(payload, 'end_ts', 'endTs')) ?? fallback,
+    };
+  }
+
+  const userId = text(payload, 'user_id', 'userId');
+  if (!isUuid(userId)) return null;
+
+  if (event.type === 'participant.joined') {
+    return {
+      room_name: roomName,
+      event: 'joined',
+      user_id: userId.toLowerCase(),
+      at: isoOf(number(payload, 'joined_at', 'joinedAt')) ?? fallback,
+    };
+  }
+  if (event.type === 'participant.left') {
+    const joinedAt = number(payload, 'joined_at', 'joinedAt');
+    const duration = number(payload, 'duration');
+    return {
+      room_name: roomName,
+      event: 'left',
+      user_id: userId.toLowerCase(),
+      at: eventAt ?? (joinedAt !== null && duration !== null ? isoOf(joinedAt + duration) : null) ?? fallback,
+    };
+  }
+  return null;
+}
+
+export type RecordingReady = {
+  room_name: string;
+  session_id: string;
+  provider_recording_id: string;
+  duration_s: number | null;
+  recorded_at: string | null;
+};
+
+export function recordingReadyOf(event: DailyEvent): RecordingReady | null {
+  const roomName = roomNameOf(event);
+  const sessionId = lessonSessionIdOf(roomName);
+  const recordingId = text(event.payload, 'recording_id', 'recordingId', 'id');
+  if (!roomName || !sessionId || !recordingId) return null;
+  const duration = number(event.payload, 'duration');
+  return {
+    room_name: roomName,
+    session_id: sessionId,
+    provider_recording_id: recordingId,
+    duration_s: duration === null ? null : Math.round(duration),
+    recorded_at: isoOf(number(event.payload, 'start_ts', 'startTs')),
+  };
+}
+
+export type ProviderOutcome = {
+  room_name: string;
+  session_id: string;
+  /** The recording or transcript id, when the event names one. */
+  provider_id: string | null;
+  /** Daily's own words for what went wrong, when it did. */
+  error: string | null;
+};
+
+/** The room and ids behind a transcript or error event. */
+export function outcomeOf(event: DailyEvent): ProviderOutcome | null {
+  const roomName = roomNameOf(event);
+  const sessionId = lessonSessionIdOf(roomName);
+  if (!roomName || !sessionId) return null;
+  const transcript = event.type?.startsWith('transcript.');
+  return {
+    room_name: roomName,
+    session_id: sessionId,
+    provider_id: transcript
+      ? text(event.payload, 'transcript_id', 'transcriptId')
+      : text(event.payload, 'recording_id', 'recordingId'),
+    error: text(event.payload, 'error_msg', 'errorMsg', 'error', 'message'),
+  };
+}
diff --git a/supabase/functions/_shared/lessonRoom.ts b/supabase/functions/_shared/lessonRoom.ts
new file mode 100644
index 0000000..de6cb87
--- /dev/null
+++ b/supabase/functions/_shared/lessonRoom.ts
@@ -0,0 +1,135 @@
+// The room hand-off's pure half: a ticket's token and its hash, the URL the
+// app opens, which pages a 'page' ticket may land on, and the constant-time
+// secret check at room-redeem's door.
+//
+// Its own module, with no Deno imports, so the smoke suite can hold the rules
+// themselves rather than a regex over index.ts. Each guards a failure nothing
+// else notices: a token that reached a log, a hand-off that landed on a page
+// it was never minted for, and a door that refuses a near-miss faster than a
+// wild guess (#397, the same lesson as portal-notify's).
+
+import { encodeBase64 } from './base64.ts';
+
+/**
+ * How long a ticket is good for: long enough to open a browser from a phone,
+ * no longer. A ticket is single use as well (redeem_lesson_ticket), so this
+ * only bounds how long an unredeemed one is worth stealing.
+ */
+export const TICKET_TTL_MS = 2 * 60 * 1000;
+
+/**
+ * Where a 'page' ticket may land. Everything else the room serves is either a
+ * lesson — a 'join' ticket, whose path is the session's and never typed by a
+ * caller — or nothing a hand-off from the app should reach. A prefix ending
+ * in '/' is a directory; the others are a page and whatever sits under it.
+ */
+export const PAGE_PREFIXES = ['/home/', '/bank', '/syllabus', '/test/', '/tests/'] as const;
+
+/** A path with a query string is fine; a character outside this is not. */
+const PATH_CHARACTERS = /^[A-Za-z0-9/_\-.?=&]+$/;
+
+export function hex(bytes: Uint8Array): string {
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export async function sha256Hex(text: string): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
+  return hex(new Uint8Array(digest));
+}
+
+/**
+ * The token itself, from 32 random bytes the caller drew
+ * (crypto.getRandomValues). URL-safe and unpadded, so it survives a URL
+ * fragment untouched; 43 characters.
+ *
+ * It is the one thing never written down: the row holds sha256Hex(token),
+ * so a copy of lesson_tickets is worth nothing, and a log line that
+ * mentions it is a bug.
+ */
+export function tokenFrom(bytes: Uint8Array): string {
+  if (bytes.length < 32) throw new Error(`a ticket needs 32 random bytes, got ${bytes.length}`);
+  return encodeBase64(bytes, { url: true });
+}
+
+/** The lesson a 'join' ticket opens. */
+export function joinPath(sessionId: string): string {
+  return `/lesson/${sessionId}`;
+}
+
+/**
+ * The provider's name for a session's room — lesson_rooms.room_name, what
+ * the room app asks Daily for (room/src/lib/video/daily.ts) and what Daily
+ * says back in every webhook. Lower-cased, because Postgres prints a uuid
+ * that way and the webhook matches by this exact string.
+ */
+export function lessonRoomName(sessionId: string): string {
+  return `lesson-${sessionId.toLowerCase()}`;
+}
+
+/**
+ * The URL the app opens. The token rides in the FRAGMENT, which a browser
+ * never sends to the server, so it is in no access log and no Referer; the
+ * room's /join page reads it client-side and POSTs it to /api/join.
+ */
+export function ticketUrl(roomUrl: string, token: string, next: string): string {
+  return `${roomUrl.trim().replace(/\/+$/, '')}/join#t=${token}&next=${encodeURIComponent(next)}`;
+}
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function isUuid(value: unknown): value is string {
+  return typeof value === 'string' && UUID.test(value);
+}
+
+/**
+ * Whether a 'page' ticket may land on `next`.
+ *
+ * A relative path on the room's own host, under one of PAGE_PREFIXES, and
+ * nothing a browser would read as somewhere else: '//evil' is a
+ * protocol-relative URL, a '..' segment walks out of the prefix, '\' is a
+ * '/' to some browsers, and '%' could be any of those once decoded.
+ */
+export function pageNextIsAllowed(next: unknown): next is string {
+  if (typeof next !== 'string' || next.length === 0 || next.length > 512) return false;
+  if (!next.startsWith('/') || next.startsWith('//')) return false;
+  if (!PATH_CHARACTERS.test(next)) return false;
+  const path = next.split('?')[0];
+  if (path.split('/').some((segment) => segment === '.' || segment === '..')) return false;
+  return PAGE_PREFIXES.some((prefix) => {
+    const directory = prefix.endsWith('/') ? prefix : `${prefix}/`;
+    return path === prefix || path.startsWith(directory);
+  });
+}
+
+/** No early return: every byte of both digests is read, every time. */
+export function sameBytes(a: Uint8Array, b: Uint8Array): boolean {
+  let diff = a.length ^ b.length;
+  const length = Math.max(a.length, b.length);
+  for (let i = 0; i < length; i++) diff |= (a[i] ?? 0) ^ (b[i] ?? 0);
+  return diff === 0;
+}
+
+/**
+ * Whether the caller presented the shared secret — answered in the same time
+ * whatever the answer, over SHA-256 digests rather than the strings, so
+ * neither a byte nor the length of a guess leaks (portal-notify/secret.ts
+ * says what `!==` gave away, #397).
+ *
+ * Both sides are trimmed: `supabase secrets set` keeps the trailing newline
+ * off a paste more often than not. Blank on either side is never a match,
+ * so an unset secret closes the door rather than opening it.
+ */
+export async function secretMatches(
+  presented: string | null | undefined,
+  expected: string | null | undefined,
+): Promise<boolean> {
+  const want = (expected ?? '').trim();
+  const got = (presented ?? '').trim();
+  if (want === '' || got === '') return false;
+  const encoder = new TextEncoder();
+  const [a, b] = await Promise.all([
+    crypto.subtle.digest('SHA-256', encoder.encode(got)),
+    crypto.subtle.digest('SHA-256', encoder.encode(want)),
+  ]);
+  return sameBytes(new Uint8Array(a), new Uint8Array(b));
+}
