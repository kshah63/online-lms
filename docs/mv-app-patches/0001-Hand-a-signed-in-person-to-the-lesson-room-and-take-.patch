@@ -0,0 +1,104 @@
+import { webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * room-redeem refuses a wrong secret in the same time every time.
+ *
+ * It is the portal doorbell's lesson (#397) at a more expensive door: the
+ * gateway accepts the anon key, which ships inside every app build, so
+ * `x-room-secret` is the one thing between a public URL and a sign-in for
+ * whoever's ticket is in flight. A `!==` returns at the first differing byte
+ * and so takes measurably longer the more of a guess was right — enough,
+ * given requests, to walk the secret out one byte at a time.
+ *
+ * What this pins is the property that makes the timing constant — every
+ * comparison is over two fixed-length SHA-256 digests, read to the end — and
+ * the answers themselves: a near-miss is refused as flatly as a wild guess,
+ * and a missing secret on the server is a closed door, not an open one.
+ */
+
+// The Deno runtime this ships to has crypto.subtle; jest's environment may
+// not. Node's own WebCrypto is the same algorithm.
+if (!globalThis.crypto?.subtle) {
+  Object.defineProperty(globalThis, 'crypto', { value: webcrypto, configurable: true });
+}
+
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const { sameBytes, secretMatches } = require('../supabase/functions/_shared/lessonRoom');
+
+const SOURCE = readFileSync(
+  join(__dirname, '..', 'supabase', 'functions', 'room-redeem', 'index.ts'),
+  'utf8',
+);
+
+describe('the room door compares its secret in constant time', () => {
+  it('lets the right secret through', async () => {
+    await expect(secretMatches('opensesame', 'opensesame')).resolves.toBe(true);
+  });
+
+  it('trims a pasted newline off either side', async () => {
+    await expect(secretMatches('opensesame\n', 'opensesame')).resolves.toBe(true);
+    await expect(secretMatches('opensesame', ' opensesame\n')).resolves.toBe(true);
+  });
+
+  it('refuses a guess that got the whole prefix but the last byte', async () => {
+    await expect(
+      secretMatches('correct-horse-battery-stapld', 'correct-horse-battery-staple'),
+    ).resolves.toBe(false);
+    await expect(
+      secretMatches('zzzzzzzzzzzzzzzzzzzzzzzzzzzz', 'correct-horse-battery-staple'),
+    ).resolves.toBe(false);
+  });
+
+  it('refuses a prefix of the secret, and the secret plus anything', async () => {
+    await expect(secretMatches('correct-horse', 'correct-horse-battery-staple')).resolves.toBe(false);
+    await expect(
+      secretMatches('correct-horse-battery-staple!', 'correct-horse-battery-staple'),
+    ).resolves.toBe(false);
+  });
+
+  it('refuses a caller who sent nothing, and a server that holds nothing', async () => {
+    await expect(secretMatches(null, 'opensesame')).resolves.toBe(false);
+    await expect(secretMatches('', 'opensesame')).resolves.toBe(false);
+    await expect(secretMatches('opensesame', '')).resolves.toBe(false);
+    await expect(secretMatches('', '')).resolves.toBe(false);
+    await expect(secretMatches(undefined, undefined)).resolves.toBe(false);
+  });
+
+  it('the byte comparison reads to the end and folds the length in', () => {
+    expect(sameBytes(new Uint8Array([1, 2, 3]), new Uint8Array([1, 2, 3]))).toBe(true);
+    expect(sameBytes(new Uint8Array([1, 2, 3]), new Uint8Array([1, 2, 4]))).toBe(false);
+    expect(sameBytes(new Uint8Array([1, 2, 3]), new Uint8Array([1, 2]))).toBe(false);
+    expect(sameBytes(new Uint8Array([1, 2]), new Uint8Array([1, 2, 3]))).toBe(false);
+    expect(sameBytes(new Uint8Array([]), new Uint8Array([]))).toBe(true);
+  });
+});
+
+describe('room-redeem stands behind the rule', () => {
+  it('does not gate on a short-circuiting string comparison', () => {
+    const gate = SOURCE.slice(SOURCE.indexOf('ROOM_REDEEM_SECRET'));
+    expect(gate).not.toMatch(/x-room-secret'\)\s*!==/);
+    expect(gate).not.toMatch(/!==\s*secret/);
+    expect(gate).toMatch(/secretMatches\(req\.headers\.get\('x-room-secret'\), secret\)/);
+  });
+
+  it('a server with no secret answers 503 and says so, rather than opening', () => {
+    expect(SOURCE).toMatch(/if \(!secret\?\.trim\(\)\) \{[\s\S]*?503\)/);
+    expect(SOURCE).toMatch(/room-redeem has no ROOM_REDEEM_SECRET set/);
+  });
+
+  it('the secret is checked before the body is read', () => {
+    expect(SOURCE.indexOf('secretMatches(')).toBeLessThan(SOURCE.indexOf('await req.json()'));
+  });
+
+  it('hashes the token before the database ever sees it, and spends it in one call', () => {
+    expect(SOURCE).toMatch(/admin\.rpc\('redeem_lesson_ticket', \{\s*p_token_hash: await sha256Hex\(token\),\s*\}\)/);
+    expect(SOURCE).toMatch(/ticket expired or used/);
+  });
+
+  it('mints the sign-in without sending an email', () => {
+    expect(SOURCE).toMatch(/generateLink\(\{\s*type: 'magiclink',\s*email,\s*\}\)/);
+    expect(SOURCE).not.toMatch(/signInWithOtp|inviteUserByEmail/);
+  });
+});
