new file mode 100644
index 0000000..9f9e3ed
--- /dev/null
+++ b/supabase/functions/room-redeem/index.ts
@@ -0,0 +1,141 @@
+// Supabase Edge Function — the room's half of the hand-off: a ticket becomes
+// a sign-in.
+//
+// Called by the room web server (room/src/app/api/join), never by a phone or
+// a browser. room-ticket minted the token and stored only its hash; this
+// hashes what the room was handed, spends the row — redeem_lesson_ticket is
+// one UPDATE that succeeds once — and mints a magic-link token for the same
+// person, which the room's cookie-bound client exchanges with verifyOtp. The
+// service-role key never leaves Supabase: the room holds the anon key and
+// this secret, and that is all it needs.
+//
+// Two gates, both required. The gateway checks the Authorization header (the
+// room sends the anon key, which is a JWT the gateway accepts), and this
+// function checks x-room-secret against ROOM_REDEEM_SECRET in constant time.
+// A caller with only the anon key — which ships inside every app build — gets
+// a 401 and learns nothing about how close its guess was.
+//
+//   supabase functions deploy room-redeem
+//   supabase secrets set ROOM_REDEEM_SECRET=<long random string>
+//
+// The same value goes in the room's Vercel environment as ROOM_REDEEM_SECRET.
+
+import { createClient } from 'jsr:@supabase/supabase-js@2';
+
+import { secretMatches, sha256Hex } from '../_shared/lessonRoom.ts';
+import { captureError } from '../_shared/report.ts';
+
+const admin = createClient(
+  Deno.env.get('SUPABASE_URL')!,
+  Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!,
+  { auth: { persistSession: false } },
+);
+
+/** What redeem_lesson_ticket returns, one row or none. */
+type Ticket = {
+  user_id: string;
+  session_id: string | null;
+  purpose: string;
+  next_path: string;
+  attempt_id: string | null;
+};
+
+/** So the line below is worth reading when it appears. See its comment. */
+let saidTheSecretIsMissing = false;
+
+Deno.serve(async (req) => {
+  if (req.method !== 'POST') {
+    return json({ error: 'method not allowed' }, 405);
+  }
+
+  // A missing secret is said out loud, once per isolate, because every call
+  // then answers 503 and the room's server has nowhere better to report why
+  // than its own logs — this line is where the reason exists.
+  const secret = Deno.env.get('ROOM_REDEEM_SECRET');
+  if (!secret?.trim()) {
+    if (!saidTheSecretIsMissing) {
+      saidTheSecretIsMissing = true;
+      console.error('room-redeem has no ROOM_REDEEM_SECRET set. Refusing every request.');
+    }
+    return json({ error: 'the room hand-off is not configured on the server' }, 503);
+  }
+  // Constant-time, over digests — portal-notify/secret.ts says what `!==`
+  // gave away (#397). secretMatches is the same rule in _shared.
+  if (!(await secretMatches(req.headers.get('x-room-secret'), secret))) {
+    return json({ error: 'unauthorised' }, 401);
+  }
+
+  let body: { token?: unknown };
+  try {
+    body = await req.json();
+  } catch {
+    body = {};
+  }
+  const token = typeof body.token === 'string' ? body.token.trim() : '';
+  // 43 characters is what room-ticket mints; anything much longer is not a
+  // ticket and is not worth hashing.
+  if (!token || token.length > 128) return json({ error: 'token is required' }, 400);
+
+  try {
+    // Single use, decided by the database: the row is updated where
+    // redeemed_at is null and expires_at > now(), and returned only then. A
+    // second redemption of the same token finds nothing, exactly like a
+    // token that never existed.
+    const { data: rows, error: redeemError } = await admin.rpc('redeem_lesson_ticket', {
+      p_token_hash: await sha256Hex(token),
+    });
+    if (redeemError) throw redeemError;
+    const ticket = ((rows ?? []) as Ticket[])[0];
+    if (!ticket) return json({ error: 'ticket expired or used' }, 404);
+
+    // The person's email, read with the service role — the one sanctioned
+    // reader behind the profiles column wall (authenticated cannot select
+    // profiles.email). It is used for the link and goes nowhere else.
+    const { data: found, error: userError } = await admin.auth.admin.getUserById(ticket.user_id);
+    if (userError) throw userError;
+    const email = found?.user?.email;
+    if (!email) return json({ error: 'that account has no email address' }, 409);
+
+    // No email is sent: generateLink only mints the token a magic link would
+    // carry, and the room exchanges it directly. A student whose address is
+    // the office's placeholder (c<id>@pending.mathvisionapp.com) therefore
+    // signs in here exactly as anybody else does.
+    const { data: link, error: linkError } = await admin.auth.admin.generateLink({
+      type: 'magiclink',
+      email,
+    });
+    if (linkError) throw linkError;
+    const hashedToken = link?.properties?.hashed_token;
+    if (!hashedToken) throw new Error('generateLink returned no hashed_token');
+
+    // The audit line, after the sign-in exists and never in its way: the
+    // ticket is already spent, so failing the request here would strand the
+    // person with no session and no ticket. record_audit runs as the service
+    // role, so the actor is 'system' and the detail names the person.
+    const { error: auditError } = await admin.rpc('record_audit', {
+      p_action: 'lesson_ticket_redeemed',
+      p_entity_type: ticket.session_id ? 'session_request' : 'profile',
+      p_entity_id: ticket.session_id ?? ticket.user_id,
+      p_summary: `A ${ticket.purpose} ticket was redeemed for ${ticket.next_path}`,
+      p_detail: {
+        user_id: ticket.user_id,
+        session_id: ticket.session_id,
+        purpose: ticket.purpose,
+        next: ticket.next_path,
+        attempt_id: ticket.attempt_id,
+      },
+    });
+    if (auditError) {
+      await captureError(auditError, 'room-redeem/audit', { session_id: ticket.session_id });
+    }
+
+    return json({ hashed_token: hashedToken, user_id: ticket.user_id, next: ticket.next_path });
+  } catch (error) {
+    await captureError(error, 'room-redeem');
+    return json({ error: 'Could not redeem the ticket. Please try again.' }, 500);
+  }
+});
+
+function json(body: unknown, status = 200): Response {
+  return Response.json(body, { status });
+}
