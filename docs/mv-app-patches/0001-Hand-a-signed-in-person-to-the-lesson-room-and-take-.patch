+    ['/admin', 'a page the ticket was not minted for'],
+    ['/lesson/11111111-2222-3333-4444-555555555555', 'a lesson, which only a join ticket opens'],
+    ['/bankrupt', 'a prefix that is not a page boundary'],
+    ['/home', 'the directory prefix without its slash'],
+    ['/home/../admin', 'a path that walks out of its prefix'],
+    ['/home/./x', 'a dot segment'],
