new file mode 100644
index 0000000..5f1ac9d
--- /dev/null
+++ b/supabase/functions/daily-webhook/index.ts
@@ -0,0 +1,192 @@
+// Supabase Edge Function — Daily's webhook: what happened in a lesson room,
+// told by the video provider rather than by a browser that may have closed.
+//
+// A student's own browser calls lesson_join when they arrive; this is the
+// other witness, for everything a browser cannot be trusted to report — the
+// tab that was closed mid-lesson, the teacher who ended the call, the
+// recording and the transcript that were ready an hour later. Every room
+// event becomes one row for import_lesson_room_facts, the database door that
+// may write arrived_at and departed_at and nothing else (its probe asserts
+// that by regex over its source); the rest lands on lesson_rooms and
+// lesson_recordings with the service role.
+//
+// Deploy WITHOUT JWT verification (Daily has no Supabase session); its HMAC
+// signature is the gate, checked in _shared/dailyWebhook.ts over the raw body
+// and refused when older than five minutes:
+//
+//   supabase functions deploy daily-webhook --no-verify-jwt
+//   supabase secrets set DAILY_WEBHOOK_SECRET=<the hmac Daily returned>
+//
+// Creating the webhook, once per Daily account (REST, not the dashboard):
+//
+//   curl -X POST https://api.daily.co/v1/webhooks \
+//     -H "Authorization: Bearer $DAILY_API_KEY" -H 'Content-Type: application/json' \
+//     -d '{"url": "https://<project-ref>.supabase.co/functions/v1/daily-webhook",
+//          "eventTypes": ["participant.joined", "participant.left", "meeting.ended",
+//                         "recording.ready-to-download", "recording.error",
+//                         "transcript.ready-to-download", "transcript.error"]}'
+//
+// Daily POSTs a test body with no event type to the URL first and only
+// creates the webhook on a 200, THEN returns the `hmac` to set as the secret —
+// so the test ping is answered before the signature is asked for; nothing is
+// done with it. Daily expects a fast 200 on every delivery and retries (then
+// disables the webhook) on anything else, so the response goes out before the
+// writes, which run after it on EdgeRuntime.waitUntil.
+
+import { createClient } from 'jsr:@supabase/supabase-js@2';
+
+import {
+  type DailyEvent,
+  classify,
+  outcomeOf,
+  recordingReadyOf,
+  roomFactOf,
+  verifyDailySignature,
+} from '../_shared/dailyWebhook.ts';
+import { captureError } from '../_shared/report.ts';
+
+const admin = createClient(
+  Deno.env.get('SUPABASE_URL')!,
+  Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!,
+  { auth: { persistSession: false } },
+);
+
+/** So the line below is worth reading when it appears. See its comment. */
+let saidTheSecretIsMissing = false;
+
+Deno.serve(async (req) => {
+  if (req.method !== 'POST') {
+    return json({ error: 'method not allowed' }, 405);
+  }
+
+  // The RAW body, because that is what Daily signed. Parsed afterwards; a
+  // body that is not JSON is nobody's event.
+  const rawBody = await req.text();
+  let event: DailyEvent;
+  try {
+    event = JSON.parse(rawBody);
+  } catch {
+    return json({ error: 'bad request' }, 400);
+  }
+
+  // Daily's test POST on creation: no type, nothing to do, and the webhook
+  // (and its secret) does not exist until this answers 200. Unsigned by
+  // construction, and harmless — nothing below runs for it.
+  if (classify(event) === 'test') return json({ ok: true });
+
+  // Said out loud, once per isolate: every delivery now 401s, Daily will
+  // retry and then switch the webhook off, and this line is the only place
+  // the reason exists.
+  const secret = Deno.env.get('DAILY_WEBHOOK_SECRET');
+  if (!secret?.trim() && !saidTheSecretIsMissing) {
+    saidTheSecretIsMissing = true;
+    console.error('daily-webhook has no DAILY_WEBHOOK_SECRET set. Refusing every delivery.');
+  }
+  const verdict = await verifyDailySignature({
+    secretBase64: secret,
+    timestamp: req.headers.get('x-webhook-timestamp'),
+    signature: req.headers.get('x-webhook-signature'),
+    rawBody,
+    nowMs: Date.now(),
+  });
+  if (!verdict.ok) {
+    // An expected fact about the world, not a failure to report: a wrong
+    // signature is a stranger, a stale one is a replay. The shape of the
+    // refusal is logged, never the headers.
+    console.error(`daily-webhook refused a ${event.type} delivery: ${verdict.reason}`);
+    return json({ error: 'unauthorised' }, 401);
+  }
+
+  // Verified. The 200 goes out now; the writes follow it. waitUntil keeps
+  // the isolate alive for them on Supabase's runtime; anywhere without it,
+  // the work is done before answering, which is slower and still correct.
+  const work = apply(event).catch(async (error) => {
+    await captureError(error, `daily-webhook/${event.type}`, { room: event.payload?.room_name ?? event.payload?.room ?? null });
+  });
+  const runtime = (globalThis as { EdgeRuntime?: { waitUntil(p: Promise<unknown>): void } }).EdgeRuntime;
+  if (runtime?.waitUntil) runtime.waitUntil(work);
+  else await work;
+
+  return json({ ok: true });
+});
+
+/**
+ * One delivery's writes. An event about a room that is not a lesson room, or
+ * a participant the booking cannot name, is dropped here without a word —
+ * Daily retries a refusal, and a room we do not know is not an error.
+ */
+async function apply(event: DailyEvent): Promise<void> {
+  switch (classify(event)) {
+    case 'fact': {
+      const row = roomFactOf(event, Date.now());
+      if (!row) return;
+      const { error } = await admin.rpc('import_lesson_room_facts', { p_rows: [row] });
+      if (error) throw error;
+      return;
+    }
+
+    case 'recording_ready': {
+      const ready = recordingReadyOf(event);
+      if (!ready) return;
+      // The recording exists at Daily; where it is stored here (storage_path)
+      // and when it expires are the retention sweep's to write, not this.
+      const { error } = await admin.from('lesson_recordings').upsert(
+        {
+          session_id: ready.session_id,
+          provider_recording_id: ready.provider_recording_id,
+          duration_s: ready.duration_s,
+          recorded_at: ready.recorded_at,
+        },
+        { onConflict: 'session_id' },
+      );
+      if (error) throw error;
+      const { error: roomError } = await admin
+        .from('lesson_rooms')
+        .update({ provider_recording_id: ready.provider_recording_id })
+        .eq('session_id', ready.session_id);
+      if (roomError) throw roomError;
+      return;
+    }
+
+    case 'transcript_ready':
+    case 'transcript_error': {
+      const outcome = outcomeOf(event);
+      if (!outcome) return;
+      const { error } = await admin
+        .from('lesson_rooms')
+        .update({
+          transcript_status: event.type === 'transcript.ready-to-download' ? 'ready' : 'failed',
+          ...(outcome.provider_id ? { provider_transcript_id: outcome.provider_id } : {}),
+        })
+        .eq('session_id', outcome.session_id);
+      if (error) throw error;
+      return;
+    }
+
+    case 'recording_error': {
+      // lesson_rooms has no recording status to fail, so the fact lands on
+      // the lesson's own event log, where the session's readers can see it,
+      // and in the error sink, where somebody who can ask Daily why will.
+      const outcome = outcomeOf(event);
+      if (!outcome) return;
+      const { error } = await admin.from('lesson_events').insert({
+        session_id: outcome.session_id,
+        kind: 'recording_error',
+        payload: { provider_recording_id: outcome.provider_id, error: outcome.error },
+      });
+      if (error) throw error;
+      await captureError(new Error(outcome.error ?? 'Daily reported a recording error'), 'daily-webhook/recording.error', {
+        session_id: outcome.session_id,
+        provider_recording_id: outcome.provider_id,
+      });
+      return;
+    }
+
+    default:
+      return;
+  }
+}
+
+function json(body: unknown, status = 200): Response {
+  return Response.json(body, { status });
+}
