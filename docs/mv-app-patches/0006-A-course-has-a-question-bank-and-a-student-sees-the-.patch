+  and (select q.answer = '0.75'::jsonb and jsonb_typeof(q.answer) = 'number'
+         from public.practice_questions q where q.id = pg_temp.q('3/4 as a decimal'))
+  and (select q.answer = '25'::jsonb and q.unit = 'cm'
+         from public.practice_questions q where q.id = pg_temp.q('5²'))
+  and (select q.answer = '"x = 5"'::jsonb and q.accepted = '["5"]'::jsonb
+         from public.practice_questions q where q.id = pg_temp.q('Solve x+2=7'))
+  and (select q.answer is null and q.accepted is null and q.marks = 3 and q.worked_solution = '(x-2)(x-3)'
+         from public.practice_questions q where q.id = pg_temp.q('Factorise x²-5x+6'))
