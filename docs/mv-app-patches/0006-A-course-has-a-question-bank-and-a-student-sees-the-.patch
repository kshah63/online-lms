+-- ---------------------------------------------------------------------------
+-- A course has a question bank, and a student sees the answer only after
+-- submitting.
+--
+-- Stage 4 of the lesson platform, section B of the shared contracts
+-- (CONTRACTS-stage4.md; online-lms/docs/INTEGRATION.md, "Practice and
+-- tests"). A course's bank of questions, the sets made from them, who each
+-- set was given to, each attempt at it, every answer, and the integrity
+-- events a timed test records. Every write is a door; the tables are read
+-- under policies that say who may.
+--
+-- THE BANK IS THE IN-CHARGE'S. practice_questions is written only by
+-- whoever manages_course (an admin, or an in-charge whose room the course
+-- routes to), through store_extracted_questions and upsert_question, and a
+-- question is approved and retired by the same hands. A teacher with a
+-- lesson on the course this fortnight reads the approved ones, to make a
+-- quick check from. STUDENTS AND FAMILIES NEVER SELECT THIS TABLE: a
+-- question reaches a student only through attempt_questions, which masks
+-- the answer and the worked solution while the attempt is open and shows
+-- them after submission unless the set says to hide them. The policy on
+-- the table has no family clause at all, and the RLS section asserts a
+-- student reads zero rows of it even with an attempt in hand.
+--
+-- THE MARKING IS THE ROOM'S, PORTED EXACTLY. online-lms marks in
+-- TypeScript (src/lib/practice/marking.ts, numbers.ts): a typed number is
+-- read in any spelling a student uses ("3/4", "7 1/2", "−2.5", "12 cm",
+-- "1,250", "x = 5", "3e2", "50%"); an answer key with decimals accepts half
+-- a unit in its last place and an integer key is strict; a short answer is
+-- normalised (case, whitespace, unicode minus, trailing punctuation, spaces
+-- around operators) and also accepted when it is the same number in another
+-- form; multi-select earns proportional credit with a penalty for wrong
+-- picks; a worked question waits for a person. The pure functions below are
+-- that module in SQL, and the RLS section replays the room's own test file
+-- (tests/practice-marking.test.ts) against them, so the two cannot drift
+-- without a test saying so. answer_question returns the mark and never the
+-- key.
+--
+-- WHO SEES WHAT. An assignment and an attempt are read by the student, the
+-- household, whoever assigned it, whoever manages the course, the room's
+-- in-charge (room_reaches), and an admin. The answers themselves are the
+-- student's own, the assigner's, the course's and the admin's -- a family
+-- reads the score, never the script. Integrity events are the assigner's,
+-- the course's and the admin's only: not the student's after the fact, not
+-- the family's.
+--
+-- WHAT NOTIFIES. notify_push is wired to practice_assignments INSERT (a set
+-- to do at home, to the student and the household) and practice_attempts
+-- UPDATE OF status (an at-home set finished, to whoever set it). A quick
+-- check given in the lesson is not news to a phone -- the student is in the
+-- room -- so assign_practice inserts in_session rows under app.push_quiet,
+-- and the RLS section counts the queue to say so. send-push decides which
+-- status moves it tells anybody about.
+--
+-- practice_attempts joins the supabase_realtime publication: the room's
+-- teacher view listens to postgres_changes on it, filtered by session.
+--
+-- TWO BUCKETS. test-snapshots holds the camera frames a timed test takes,
+-- under <uid>/<attempt>/<ts>.jpg: written only under the caller's own
+-- prefix, read by its owner and by whoever may review the attempt the
+-- snapshot was logged against. practice-images holds a question's picture
+-- under <course_id>/<file>: written by whoever manages the course, read by
+-- them, by a teacher on the course this fortnight, and by a student with an
+-- attempt at a set that carries the question -- the one widening of the
+-- contract's rule here, because a student who cannot load the picture
+-- cannot answer the question.
+--
+-- Two more foreign keys into courses, so retire_seed_course_twins is
+-- re-emitted at the bottom with practice_questions and practice_sets among
+-- its moves.
+-- ---------------------------------------------------------------------------
+
+-- ---------------------------------------------------------------------------
+-- Tables
+-- ---------------------------------------------------------------------------
+create table if not exists public.practice_questions (
+  id                uuid primary key default gen_random_uuid(),
+  course_id         uuid not null references public.courses (id) on delete cascade,
+  syllabus_topic_id uuid references public.syllabus_topics (id) on delete set null,
+  type              text not null
+                    check (type in ('mcq', 'multi_select', 'numeric', 'short', 'worked')),
+  stem              text not null,
+  options           jsonb,
+  answer            jsonb,
+  tolerance         numeric,
+  unit              text,
+  accepted          jsonb,
+  difficulty        integer not null default 3 check (difficulty between 1 and 5),
+  marks             numeric not null default 1,
+  worked_solution   text,
+  image_path        text,
+  source            jsonb not null default '{}'::jsonb,
+  status            text not null default 'draft'
+                    check (status in ('draft', 'approved', 'retired')),
+  created_by        uuid references public.profiles (id) on delete set null,
+  reviewed_by       uuid references public.profiles (id) on delete set null,
+  reviewed_at       timestamptz,
+  created_at        timestamptz not null default now(),
+  updated_at        timestamptz not null default now()
+);
+
+comment on table public.practice_questions is
+  'A course''s question bank. Written only by store_extracted_questions, '
+  'upsert_question, approve_question and retire_question (manages_course). '
+  'Read by whoever manages the course and, approved rows only, by a teacher '
+  'with a lesson on it this fortnight; never by a student or a family, who '
+  'see a question only through attempt_questions.';
+
+create index if not exists practice_questions_course_idx
+  on public.practice_questions (course_id, status);
+create index if not exists practice_questions_topic_idx
+  on public.practice_questions (syllabus_topic_id);
+
+create table if not exists public.practice_sets (
+  id                 uuid primary key default gen_random_uuid(),
+  course_id          uuid not null references public.courses (id) on delete cascade,
+  kind               text not null check (kind in ('practice', 'quick_check', 'test')),
+  title              text not null,
+  syllabus_topic_id  uuid references public.syllabus_topics (id) on delete set null,
+  time_limit_minutes integer,
+  integrity_settings jsonb not null default '{}'::jsonb,
+  status             text not null default 'live' check (status in ('draft', 'live', 'retired')),
+  created_by         uuid references public.profiles (id) on delete set null,
+  created_at         timestamptz not null default now()
+);
+
+comment on table public.practice_sets is
+  'A set of questions to give out: practice, a quick check in the lesson, or '
+  'a timed test. Written only by create_practice_set. Read by the bank''s '
+  'readers and by a student or household through their own assignments.';
+
+create index if not exists practice_sets_course_idx
+  on public.practice_sets (course_id, created_at desc);
+
+create table if not exists public.practice_set_items (
+  set_id      uuid not null references public.practice_sets (id) on delete cascade,
+  question_id uuid not null references public.practice_questions (id),
+  sort_order  integer not null,
+  primary key (set_id, question_id)
+);
+
+comment on table public.practice_set_items is
+  'Which questions a set holds, in order. Ids only: the question itself is '
+  'read through attempt_questions or the bank''s own policy.';
+
+create index if not exists practice_set_items_question_idx
+  on public.practice_set_items (question_id);
+
+create table if not exists public.practice_assignments (
+  id          uuid primary key default gen_random_uuid(),
+  set_id      uuid not null references public.practice_sets (id) on delete cascade,
+  student_id  uuid not null references public.profiles (id) on delete cascade,
+  session_id  uuid references public.session_requests (id) on delete set null,
+  assigned_by uuid references public.profiles (id) on delete set null,
+  due_at      timestamptz,
+  mode        text not null check (mode in ('in_session', 'at_home')),
+  created_at  timestamptz not null default now()
+);
+
+comment on table public.practice_assignments is
+  'A set given to one student: in the lesson (quiet) or to do at home (the '
+  'student and the household are told). Written only by assign_practice.';
+
+create index if not exists practice_assignments_student_idx
+  on public.practice_assignments (student_id, created_at desc);
+create index if not exists practice_assignments_set_idx
+  on public.practice_assignments (set_id, student_id);
+create index if not exists practice_assignments_session_idx
+  on public.practice_assignments (session_id);
+create index if not exists practice_assignments_assigned_by_idx
+  on public.practice_assignments (assigned_by, created_at desc);
+
+create table if not exists public.practice_attempts (
+  id                 uuid primary key default gen_random_uuid(),
+  assignment_id      uuid references public.practice_assignments (id) on delete set null,
+  set_id             uuid not null references public.practice_sets (id) on delete cascade,
+  student_id         uuid not null references public.profiles (id) on delete cascade,
+  session_id         uuid references public.session_requests (id) on delete set null,
+  started_at         timestamptz not null default now(),
+  submitted_at       timestamptz,
+  time_limit_minutes integer,
+  score              numeric,
+  out_of             numeric,
+  integrity_flagged  boolean not null default false,
+  integrity_summary  jsonb,
+  status             text not null default 'in_progress'
+                     check (status in ('in_progress', 'submitted', 'marked', 'void'))
+);
+
+comment on table public.practice_attempts is
+  'One go at a set. Opened by start_attempt, closed by submit_attempt, '
+  'finished by mark_answer, struck out by void_attempt. The family reads the '
+  'row (the score); the answers are the student''s, the assigner''s, the '
+  'course''s and the admin''s. In the supabase_realtime publication for the '
+  'room''s live view.';
+
+-- One open attempt per assignment is a fact of the schema, not a habit of
+-- start_attempt.
+create unique index if not exists practice_attempts_one_open_per_assignment
+  on public.practice_attempts (assignment_id)
+  where status = 'in_progress' and assignment_id is not null;
+create index if not exists practice_attempts_student_idx
+  on public.practice_attempts (student_id, started_at desc);
+create index if not exists practice_attempts_session_idx
+  on public.practice_attempts (session_id);
+create index if not exists practice_attempts_set_idx
+  on public.practice_attempts (set_id);
+
+create table if not exists public.practice_answers (
+  attempt_id    uuid not null references public.practice_attempts (id) on delete cascade,
+  question_id   uuid not null references public.practice_questions (id),
+  response      jsonb not null,
+  is_correct    boolean,
+  marks_awarded numeric,
+  marked_by     uuid references public.profiles (id) on delete set null,
+  feedback      text,
+  answered_at   timestamptz not null default now(),
+  primary key (attempt_id, question_id)
+);
+
+comment on table public.practice_answers is
+  'What the student answered and what it earned. Auto-marked by '
+  'answer_question; a worked question is marked by a person through '
+  'mark_answer. Never readable by a family.';
+
+create index if not exists practice_answers_question_idx
+  on public.practice_answers (question_id);
+
+create table if not exists public.practice_integrity_events (
+  id            bigserial primary key,
+  attempt_id    uuid not null references public.practice_attempts (id) on delete cascade,
+  at            timestamptz not null default now(),
+  kind          text not null
+                check (kind in ('fullscreen_exit', 'visibility_hidden', 'window_blur', 'resize',
+                                'paste', 'copy', 'context_menu', 'devtools', 'offline',
+                                'camera_off', 'snapshot', 'resume', 'warned', 'paused')),
+  detail        text,
+  snapshot_path text
+);
+
+comment on table public.practice_integrity_events is
+  'What a timed test saw while it was open: written only by '
+  'log_integrity_event while the attempt is in progress, read only by whoever '
+  'may review the attempt -- never by the student afterwards, never by the '
+  'family.';
+
+create index if not exists practice_integrity_events_attempt_idx
+  on public.practice_integrity_events (attempt_id, at);
+create index if not exists practice_integrity_events_snapshot_idx
+  on public.practice_integrity_events (snapshot_path)
+  where snapshot_path is not null;
+
+alter table public.practice_questions        enable row level security;
+alter table public.practice_sets             enable row level security;
+alter table public.practice_set_items        enable row level security;
+alter table public.practice_assignments      enable row level security;
+alter table public.practice_attempts         enable row level security;
+alter table public.practice_answers          enable row level security;
+alter table public.practice_integrity_events enable row level security;
+
+-- A stranger with the publishable key holds no write on any of these
+-- (20260901060458): the default grant to anon is taken back on every new
+-- table.
+revoke insert, update, delete, truncate, references, trigger on public.practice_questions        from anon;
+revoke insert, update, delete, truncate, references, trigger on public.practice_sets             from anon;
+revoke insert, update, delete, truncate, references, trigger on public.practice_set_items        from anon;
+revoke insert, update, delete, truncate, references, trigger on public.practice_assignments      from anon;
+revoke insert, update, delete, truncate, references, trigger on public.practice_attempts         from anon;
+revoke insert, update, delete, truncate, references, trigger on public.practice_answers          from anon;
+revoke insert, update, delete, truncate, references, trigger on public.practice_integrity_events from anon;
+
+-- ---------------------------------------------------------------------------
+-- Who may: the four questions every policy and door below asks.
+--
+-- teaches_course_within: the assigned teacher of a live booking on this
+-- course within p_days either way of now -- teaches_student_within
+-- (20261013163422) without the student, for the bank, which is about a
+-- course rather than a child.
+-- ---------------------------------------------------------------------------
+create or replace function public.teaches_course_within(
+  p_course_id uuid, p_days integer, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and p_course_id is not null
+     and exists (
+           select 1
+             from public.session_requests s
+            where s.course_id = p_course_id
+              and s.assigned_teacher_id = uid
+              and s.status not in ('cancelled', 'declined')
+              and s.effective_start between now() - make_interval(days => p_days)
+                                        and now() + make_interval(days => p_days)
+         );
+$$;
+
+comment on function public.teaches_course_within(uuid, integer, uuid) is
+  'True when uid is the assigned teacher of a live booking on the course '
+  'within p_days either side of now.';
+
+revoke all on function public.teaches_course_within(uuid, integer, uuid) from public;
+grant execute on function public.teaches_course_within(uuid, integer, uuid) to authenticated;
+
+-- A set is read by the bank's readers and by whoever it was given to (and
+-- their household). One rule for practice_sets and practice_set_items.
+create or replace function public.reads_practice_set(p_set_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and exists (
+           select 1
+             from public.practice_sets s
+            where s.id = p_set_id
+              and (public.manages_course(s.course_id, uid)
+                   or public.teaches_course_within(s.course_id, 14, uid)
+                   or exists (select 1
+                                from public.practice_assignments g
+                               where g.set_id = s.id
+                                 and (g.student_id = uid or public.shares_family(g.student_id, uid))))
+         );
+$$;
+
+comment on function public.reads_practice_set(uuid, uuid) is
+  'True when uid manages the set''s course, teaches it this fortnight, or '
+  'was given the set (or shares a household with somebody who was).';
+
+revoke all on function public.reads_practice_set(uuid, uuid) from public;
+grant execute on function public.reads_practice_set(uuid, uuid) to authenticated;
+
+-- Whoever marks, voids and reviews an attempt, and reads its answers and
+-- its integrity events: the person who assigned it, whoever manages the
+-- set's course, an admin (manages_course already says yes to one).
+create or replace function public.marks_practice_attempt(p_attempt_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and exists (
+           select 1
+             from public.practice_attempts a
+             join public.practice_sets s on s.id = a.set_id
+             left join public.practice_assignments g on g.id = a.assignment_id
+            where a.id = p_attempt_id
+              and (g.assigned_by = uid or public.manages_course(s.course_id, uid))
+         );
+$$;
+
+comment on function public.marks_practice_attempt(uuid, uuid) is
+  'True when uid assigned the attempt''s set, manages its course, or is an '
+  'admin: the readers of its answers and integrity events, and the hands '
+  'that mark, void and review it.';
+
+revoke all on function public.marks_practice_attempt(uuid, uuid) from public;
+grant execute on function public.marks_practice_attempt(uuid, uuid) to authenticated;
+
+-- Who reads the attempt row itself: the student, the household, the
+-- markers above, and the room's in-charge.
+create or replace function public.reads_practice_attempt(p_attempt_id uuid, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and exists (
+           select 1
+             from public.practice_attempts a
+             join public.profiles p on p.id = a.student_id
+            where a.id = p_attempt_id
+              and (a.student_id = uid
+                   or public.shares_family(a.student_id, uid)
+                   or public.marks_practice_attempt(a.id, uid)
+                   or public.room_reaches(p.family_id, a.student_id, false, uid))
+         );
+$$;
+
+comment on function public.reads_practice_attempt(uuid, uuid) is
+  'True when uid is the attempt''s student, shares their household, may mark '
+  'it, or is an in-charge whose room reaches the student.';
+
+revoke all on function public.reads_practice_attempt(uuid, uuid) from public;
+grant execute on function public.reads_practice_attempt(uuid, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Policies: reads only. Every write is a door below.
+-- ---------------------------------------------------------------------------
+drop policy if exists practice_questions_select on public.practice_questions;
+create policy practice_questions_select on public.practice_questions
+  for select to authenticated using (
+    public.manages_course(course_id)
+    or (status = 'approved' and public.teaches_course_within(course_id, 14))
+  );
+
+drop policy if exists practice_sets_select on public.practice_sets;
+create policy practice_sets_select on public.practice_sets
+  for select to authenticated using (public.reads_practice_set(id));
+
+drop policy if exists practice_set_items_select on public.practice_set_items;
+create policy practice_set_items_select on public.practice_set_items
+  for select to authenticated using (public.reads_practice_set(set_id));
+
+drop policy if exists practice_assignments_select on public.practice_assignments;
+create policy practice_assignments_select on public.practice_assignments
+  for select to authenticated using (
+    student_id = auth.uid()
+    or public.shares_family(student_id)
+    or assigned_by = auth.uid()
+    or public.manages_course((select s.course_id from public.practice_sets s
+                               where s.id = practice_assignments.set_id))
+    or public.room_reaches(
+         (select p.family_id from public.profiles p where p.id = practice_assignments.student_id),
+         student_id, false)
+  );
+
+drop policy if exists practice_attempts_select on public.practice_attempts;
+create policy practice_attempts_select on public.practice_attempts
+  for select to authenticated using (public.reads_practice_attempt(id));
+
+-- The student's own script, and the markers'. No household clause: a family
+-- reads the score on the attempt row and never the answers.
+drop policy if exists practice_answers_select on public.practice_answers;
+create policy practice_answers_select on public.practice_answers
+  for select to authenticated using (
+    exists (select 1 from public.practice_attempts a
+             where a.id = practice_answers.attempt_id and a.student_id = auth.uid())
+    or public.marks_practice_attempt(attempt_id)
+  );
+
+drop policy if exists practice_integrity_events_select on public.practice_integrity_events;
+create policy practice_integrity_events_select on public.practice_integrity_events
+  for select to authenticated using (public.marks_practice_attempt(attempt_id));
+
+-- ---------------------------------------------------------------------------
+-- The marking, as the room does it (online-lms/src/lib/practice/numbers.ts
+-- and marking.ts), pure and immutable. The RLS section replays the room's
+-- own test cases against these.
+-- ---------------------------------------------------------------------------
+
+-- normaliseNumericText: strip units and decoration, keep digits, signs,
+-- separators, fraction bars and exponents. The two character classes are
+-- the room's: unicode minus, en dash, em dash; thin space, narrow no-break
+-- space, no-break space.
+create or replace function public.practice_normalise_numeric_text(p_raw text)
+returns text
+language sql
+immutable
+as $$
+  select regexp_replace(
+           regexp_replace(
+             regexp_replace(
+               regexp_replace(
+                 regexp_replace(
+                   regexp_replace(
+                     regexp_replace(
+                       regexp_replace(coalesce(p_raw, ''), E'[−–—]', '-', 'g'),
+                       E'[   ]', ' ', 'g'),
+                     '[%$£€]', '', 'g'),
+                   '^\s+|\s+$', '', 'g'),
+                 '^[a-zA-Z=\s:]+', ''),                                      -- "x = 5", "ans: 5"
+               '\s*(cm|mm|m|km|kg|g|ml|l|s|h|min|deg|°|units?)\.?\s*$', '', 'i'),
+             ',(?=\d{3}\y)', '', 'g'),                                       -- thousands separators
+           '^\s+|\s+$', '', 'g');
+$$;
+
+comment on function public.practice_normalise_numeric_text(text) is
+  'normaliseNumericText from the room''s numbers.ts: units, currency, a '
+  'leading "x =" and thousands separators removed, unicode minus and spaces '
+  'folded, so a typed number can be read.';
+
+-- parseNumber: decimals, fractions, mixed numbers, scientific notation, a
+-- leading sign. Null when it is not a number, or a division by zero.
+create or replace function public.practice_parse_number(p_raw text)
+returns numeric
+language plpgsql
+immutable
+as $$
+declare
+  t   text;
+  m   text[];
+  den numeric;
+begin
+  t := public.practice_normalise_numeric_text(p_raw);
+  if t = '' then
+    return null;
+  end if;
+
+  -- Mixed number: "7 1/2" or "-2 3/4"
+  m := regexp_match(t, '^(-?)(\d+)\s+(\d+)\s*/\s*(\d+)$');
+  if m is not null then
+    den := m[4]::numeric;
+    if den = 0 then
+      return null;
+    end if;
+    return (case when m[1] = '-' then -1 else 1 end) * (m[2]::numeric + m[3]::numeric / den);
+  end if;
+
+  -- Fraction: "3/4", "-3/4", "3 / 4"
+  m := regexp_match(t, '^(-?\d+(?:\.\d+)?)\s*/\s*(-?\d+(?:\.\d+)?)$');
+  if m is not null then
+    den := m[2]::numeric;
+    if den = 0 then
+      return null;
+    end if;
+    return m[1]::numeric / den;
+  end if;
+
+  -- Plain decimal / scientific
+  if t ~* '^-?(\d+\.?\d*|\.\d+)(e-?\d+)?$' then
+    return t::numeric;
+  end if;
+  return null;
+end;
+$$;
+
+comment on function public.practice_parse_number(text) is
+  'parseNumber from the room''s numbers.ts: "0.75", "3/4", "7 1/2", "−2.5", '
+  '"12 cm", "1,250", "x = 5", "3e2" and "50%" all read; "five", "1/0" and '
+  '"2x+1" are null.';
+
+-- decimalPlaces: in the canonical decimal form, so 2.350 has two.
+create or replace function public.practice_decimal_places(p_n numeric)
+returns integer
+language sql
+immutable
+as $$
+  select case
+           when p_n is null then 0
+           when position('.' in p_n::text) = 0 then 0
+           else length(rtrim(split_part(p_n::text, '.', 2), '0'))
+         end;
+$$;
+
+-- defaultTolerance: half a unit in the key's last decimal place, with a
+-- floor against float noise.
+create or replace function public.practice_default_tolerance(p_answer numeric)
+returns numeric
+language sql
+immutable
+as $$
+  select greatest(0.5 * power(10::numeric, -public.practice_decimal_places(p_answer)),
+                  0.000000001::numeric);
+$$;
+
+-- numbersMatch. A percentage tolerance wins when given; an integer key with
+-- no explicit tolerance is strict ("half a unit" would accept 5.4 for 5);
+-- otherwise the explicit absolute tolerance, else the default.
+create or replace function public.practice_numbers_match(
+  p_given numeric, p_answer numeric, p_tolerance numeric default null, p_tolerance_pct numeric default null)
+returns boolean
+language sql
+immutable
+as $$
+  select case
+           when p_given is null or p_answer is null then false
+           when p_tolerance_pct is not null and p_tolerance_pct > 0
+             then abs(p_given - p_answer) <= abs(p_answer) * (p_tolerance_pct / 100) + 0.000000000001
+           when p_tolerance is null and p_answer = trunc(p_answer)
+             then abs(p_given - p_answer) < 0.000000001
+           else abs(p_given - p_answer)
+                  <= (case when p_tolerance is not null and p_tolerance >= 0
+                           then p_tolerance
+                           else public.practice_default_tolerance(p_answer) end)
+                     + 0.000000000001
+         end;
+$$;
+
+comment on function public.practice_numbers_match(numeric, numeric, numeric, numeric) is
+  'numbersMatch from the room''s numbers.ts: a percentage tolerance when '
+  'given, strict for an integer key with no tolerance, else the absolute '
+  'tolerance or half a unit in the key''s last decimal place.';
+
+-- normaliseShortText: case, whitespace, unicode minus, trailing
+-- punctuation, and the spaces around operators ("x = 5" is "x=5").
+create or replace function public.practice_normalise_short_text(
+  p_text text, p_case_insensitive boolean default true)
+returns text
+language plpgsql
+immutable
+as $$
+declare
+  t text;
+begin
+  t := regexp_replace(coalesce(p_text, ''), E'[−–—]', '-', 'g');
+  t := regexp_replace(t, E'[   ]', ' ', 'g');
+  t := regexp_replace(t, '\s+', ' ', 'g');
+  t := btrim(t);
+  t := regexp_replace(t, '[.;:!]+$', '');
+  t := btrim(t);
+  t := regexp_replace(t, '\s*([=+*/^(),-])\s*', '\1', 'g');
+  return case when coalesce(p_case_insensitive, true) then lower(t) else t end;
+end;
+$$;
+
+comment on function public.practice_normalise_short_text(text, boolean) is
+  'normaliseShortText from the room''s marking.ts: "X = 5." becomes "x=5".';
+
+-- markQuestion. A question's type, key, accepted alternatives, tolerance and
+-- marks, and the response the student sent (the room's Response shape: a
+-- type, then key / keys / text / final_answer + evidence). Returns
+-- {status, score, max, feedback}: status is correct, incorrect, partial,
+-- unanswered or pending_review; the feedback never holds the key.
+create or replace function public.practice_mark_question(
+  p_type text, p_answer jsonb, p_accepted jsonb, p_tolerance numeric, p_marks numeric, p_response jsonb)
+returns jsonb
+language plpgsql
+immutable
+as $$
+declare
+  v_marks    numeric := coalesce(p_marks, 1);
+  v_rtype    text;
+  v_key      text;
+  v_text     text;
+  v_given    numeric;
+  v_answer   numeric;
+  v_key_text text;
+  v_keys     text[];
+  v_want     text[];
+  v_right    integer;
+  v_wrong    integer;
+  v_fraction numeric;
+  v_score    numeric;
+  v_status   text;
+  v_feedback text;
+  v_answers  text[];
+  v_ok       boolean;
+  v_evidence integer;
+  v_final    text;
+  v_n        numeric;
+begin
+  if p_response is null or jsonb_typeof(p_response) <> 'object' then
+    return jsonb_build_object('status', 'unanswered', 'score', 0, 'max', v_marks,
+                              'feedback', 'No answer given.');
+  end if;
+
+  v_rtype := p_response ->> 'type';
+  if v_rtype is not null and v_rtype <> p_type then
+    return jsonb_build_object('status', 'incorrect', 'score', 0, 'max', v_marks,
+                              'feedback', 'Answer did not match the question type.');
+  end if;
+
+  case p_type
+  when 'mcq' then
+    v_key := nullif(p_response ->> 'key', '');
+    if v_key is null then
+      return jsonb_build_object('status', 'unanswered', 'score', 0, 'max', v_marks,
+                                'feedback', 'No answer given.');
+    end if;
+    v_key_text := case when jsonb_typeof(p_answer) = 'string' then p_answer #>> '{}' end;
+    if v_key_text is null then
+      -- No key to mark against: a person decides.
+      return jsonb_build_object('status', 'pending_review', 'score', 0, 'max', v_marks,
+                                'feedback', 'Submitted — your answer will be marked.');
+    end if;
+    v_ok := v_key = v_key_text;
+    return jsonb_build_object(
+      'status', case when v_ok then 'correct' else 'incorrect' end,
+      'score', case when v_ok then v_marks else 0 end,
+      'max', v_marks,
+      'feedback', case when v_ok then 'Correct.' else 'Not quite — have another look at the options.' end);
+
+  when 'multi_select' then
+    select coalesce(array_agg(distinct x), '{}'::text[]) into v_keys
+      from jsonb_array_elements_text(
+             case when jsonb_typeof(p_response -> 'keys') = 'array' then p_response -> 'keys' else '[]'::jsonb end) x
+     where x is not null and x <> '';
+    if cardinality(v_keys) = 0 then
+      return jsonb_build_object('status', 'unanswered', 'score', 0, 'max', v_marks,
+                                'feedback', 'No answer given.');
+    end if;
+    if jsonb_typeof(p_answer) <> 'array' then
+      return jsonb_build_object('status', 'pending_review', 'score', 0, 'max', v_marks,
+                                'feedback', 'Submitted — your answer will be marked.');
+    end if;
+    select coalesce(array_agg(distinct x), '{}'::text[]) into v_want
+      from jsonb_array_elements_text(p_answer) x;
+    select count(*) into v_right from unnest(v_keys) k where k = any (v_want);
+    v_wrong := cardinality(v_keys) - v_right;
+    -- Proportional credit with a penalty for wrong picks, floored at zero.
+    v_fraction := greatest(0, (v_right - v_wrong)::numeric / greatest(1, cardinality(v_want)));
+    v_score := round(v_fraction * v_marks, 2);
+    v_status := case when v_fraction >= 1 then 'correct'
+                     when v_score > 0 then 'partial'
+                     else 'incorrect' end;
+    v_feedback := case v_status
+                    when 'correct' then 'Correct.'
+                    when 'partial' then format('%s of %s right%s.', v_right, cardinality(v_want),
+                                               case when v_wrong > 0
+                                                    then format(', %s wrong pick%s', v_wrong,
+                                                                case when v_wrong > 1 then 's' else '' end)
+                                                    else '' end)
+                    else 'Not quite — check which options actually hold.' end;
+    return jsonb_build_object('status', v_status, 'score', v_score, 'max', v_marks, 'feedback', v_feedback);
+
+  when 'numeric' then
+    v_text := coalesce(p_response ->> 'text', p_response ->> 'value', '');
+    if regexp_replace(v_text, '^\s+|\s+$', '', 'g') = '' then
+      return jsonb_build_object('status', 'unanswered', 'score', 0, 'max', v_marks,
+                                'feedback', 'No answer given.');
+    end if;
+    v_given := public.practice_parse_number(v_text);
+    if v_given is null then
+      return jsonb_build_object('status', 'incorrect', 'score', 0, 'max', v_marks,
+                                'feedback', 'That is not a number we could read — try a decimal or a fraction.');
+    end if;
+    v_answer := case jsonb_typeof(p_answer)
+                  when 'number' then (p_answer #>> '{}')::numeric
+                  when 'string' then public.practice_parse_number(p_answer #>> '{}')
+                end;
+    if v_answer is null then
+      return jsonb_build_object('status', 'pending_review', 'score', 0, 'max', v_marks,
+                                'feedback', 'Submitted — your answer will be marked.');
+    end if;
+    v_ok := public.practice_numbers_match(v_given, v_answer, p_tolerance, null);
+    return jsonb_build_object(
+      'status', case when v_ok then 'correct' else 'incorrect' end,
+      'score', case when v_ok then v_marks else 0 end,
+      'max', v_marks,
+      'feedback', case when v_ok then 'Correct.' else 'Not quite — check your working and the units.' end);
+
+  when 'short' then
+    v_text := coalesce(p_response ->> 'text', '');
+    if regexp_replace(v_text, '^\s+|\s+$', '', 'g') = '' then
+      return jsonb_build_object('status', 'unanswered', 'score', 0, 'max', v_marks,
+                                'feedback', 'No answer given.');
+    end if;
+    -- The key and every accepted alternative, any of which earns the marks.
+    select coalesce(array_agg(x), '{}'::text[]) into v_answers
+      from (
+        select p_answer #>> '{}' as x where jsonb_typeof(p_answer) = 'string'
+        union all
+        select y from jsonb_array_elements_text(
+                        case when jsonb_typeof(p_answer) = 'array' then p_answer else '[]'::jsonb end) y
+        union all
+        select z from jsonb_array_elements_text(
+                        case when jsonb_typeof(p_accepted) = 'array' then p_accepted else '[]'::jsonb end) z
+      ) a
+     where x is not null and x <> '';
+    if cardinality(v_answers) = 0 then
+      return jsonb_build_object('status', 'pending_review', 'score', 0, 'max', v_marks,
+                                'feedback', 'Submitted — your answer will be marked.');
+    end if;
+    v_key := public.practice_normalise_short_text(v_text, true);
+    v_ok := exists (select 1 from unnest(v_answers) a
+                     where public.practice_normalise_short_text(a, true) = v_key);
+    -- Numeric equivalence: "0.5" is "1/2" when both sides parse.
+    if not v_ok then
+      v_given := public.practice_parse_number(v_text);
+      if v_given is not null then
+        v_ok := exists (select 1 from unnest(v_answers) a
+                         where public.practice_parse_number(a) is not null
+                           and public.practice_numbers_match(v_given, public.practice_parse_number(a)));
+      end if;
+    end if;
+    return jsonb_build_object(
+      'status', case when v_ok then 'correct' else 'incorrect' end,
+      'score', case when v_ok then v_marks else 0 end,
+      'max', v_marks,
+      'feedback', case when v_ok then 'Correct.' else 'Not quite — check the form of your answer.' end);
+
+  when 'worked' then
+    v_evidence := case when jsonb_typeof(p_response -> 'evidence') = 'array'
+                       then jsonb_array_length(p_response -> 'evidence') else 0 end;
+    v_final := nullif(regexp_replace(coalesce(p_response ->> 'final_answer', ''), '^\s+|\s+$', '', 'g'), '');
+    if v_evidence = 0 and v_final is null then
+      return jsonb_build_object('status', 'unanswered', 'score', 0, 'max', v_marks,
+                                'feedback', 'No answer given.');
+    end if;
+    -- A quick final-answer check gives instant signal; marks wait for review.
+    v_feedback := 'Submitted — your working will be marked.';
+    v_key_text := case when jsonb_typeof(p_answer) = 'string' then p_answer #>> '{}' end;
+    if v_final is not null and v_key_text is not null then
+      v_given := public.practice_parse_number(v_final);
+      v_n     := public.practice_parse_number(v_key_text);
+      v_ok := case when v_given is not null and v_n is not null
+                   then public.practice_numbers_match(v_given, v_n)
+                   else public.practice_normalise_short_text(v_final) = public.practice_normalise_short_text(v_key_text)
+              end;
+      v_feedback := case when v_ok
+                         then 'Final answer matches — your working will be marked.'
+                         else 'Final answer does not match — your working will be marked and may still earn method marks.'
+                    end;
+    end if;
+    return jsonb_build_object('status', 'pending_review', 'score', 0, 'max', v_marks, 'feedback', v_feedback);
+
+  else
+    raise exception 'a question is one of mcq, multi_select, numeric, short, worked'
+      using errcode = '22023';
+  end case;
+end;
+$$;
+
+comment on function public.practice_mark_question(text, jsonb, jsonb, numeric, numeric, jsonb) is
+  'markQuestion from the room''s marking.ts, exactly: returns {status, score, '
+  'max, feedback} for one question and one response; the feedback never '
+  'carries the key. Worked questions are pending_review until mark_answer.';
+
+revoke all on function public.practice_normalise_numeric_text(text) from public;
+revoke all on function public.practice_parse_number(text) from public;
+revoke all on function public.practice_decimal_places(numeric) from public;
+revoke all on function public.practice_default_tolerance(numeric) from public;
+revoke all on function public.practice_numbers_match(numeric, numeric, numeric, numeric) from public;
+revoke all on function public.practice_normalise_short_text(text, boolean) from public;
+revoke all on function public.practice_mark_question(text, jsonb, jsonb, numeric, numeric, jsonb) from public;
+grant execute on function public.practice_normalise_numeric_text(text) to authenticated;
+grant execute on function public.practice_parse_number(text) to authenticated;
+grant execute on function public.practice_decimal_places(numeric) to authenticated;
+grant execute on function public.practice_default_tolerance(numeric) to authenticated;
+grant execute on function public.practice_numbers_match(numeric, numeric, numeric, numeric) to authenticated;
+grant execute on function public.practice_normalise_short_text(text, boolean) to authenticated;
+grant execute on function public.practice_mark_question(text, jsonb, jsonb, numeric, numeric, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- The bank: one mapping from the room's Question shape to a row, used by
+-- both doors that write a question. Not callable by clients.
+--
+-- The key is stored as jsonb the way the contract says: mcq a string, the
+-- option key; multi_select an array of keys; numeric a number; short a
+-- string with the alternatives in accepted; worked null, marks wait for a
+-- person. A topic that is not a syllabus topic of this course is stored as
+-- null -- visibly missing, for the bank editor to set -- never guessed.
+-- ---------------------------------------------------------------------------
+create or replace function public.practice_question_fields(p_course_id uuid, p_q jsonb)
+returns public.practice_questions
+language plpgsql
+stable
+set search_path to 'public'
+as $$
+declare
+  r         public.practice_questions;
+  v_answers jsonb;
+  v_topic   uuid;
+begin
+  if p_q is null or jsonb_typeof(p_q) <> 'object' then
+    raise exception 'a question is an object' using errcode = '22023';
+  end if;
+
+  r.type := p_q ->> 'type';
+  if r.type is null or r.type not in ('mcq', 'multi_select', 'numeric', 'short', 'worked') then
+    raise exception 'a question''s type is one of mcq, multi_select, numeric, short, worked'
+      using errcode = '22023';
+  end if;
+
+  r.stem := nullif(btrim(coalesce(p_q ->> 'stem', '')), '');
+  if r.stem is null then
+    raise exception 'a question needs a stem' using errcode = '22023';
+  end if;
+
+  if r.type in ('mcq', 'multi_select') then
+    if jsonb_typeof(p_q -> 'options') <> 'array' or jsonb_array_length(p_q -> 'options') < 2 then
+      raise exception 'a choice question needs its options' using errcode = '22023';
+    end if;
+    r.options := p_q -> 'options';
+  end if;
+
+  v_answers := case when jsonb_typeof(p_q -> 'answers') = 'array' then p_q -> 'answers' else '[]'::jsonb end;
+  case r.type
+    when 'mcq' then
+      r.answer := case when jsonb_typeof(p_q -> 'answer') = 'string' then p_q -> 'answer'
+                       when jsonb_array_length(v_answers) > 0 then v_answers -> 0 end;
+    when 'multi_select' then
+      r.answer := case when jsonb_array_length(v_answers) > 0 then v_answers
+                       when jsonb_typeof(p_q -> 'answer') = 'array' then p_q -> 'answer' end;
+    when 'numeric' then
+      r.answer := case when jsonb_typeof(p_q -> 'answer') = 'number' then p_q -> 'answer'
+                       when jsonb_typeof(p_q -> 'answer') = 'string'
+                         then to_jsonb(public.practice_parse_number(p_q ->> 'answer')) end;
+      r.tolerance := case when jsonb_typeof(p_q -> 'tolerance') = 'number' then (p_q ->> 'tolerance')::numeric end;
+      r.unit := nullif(btrim(coalesce(p_q ->> 'unit', '')), '');
+    when 'short' then
+      r.answer := case when jsonb_typeof(p_q -> 'answer') = 'string' then p_q -> 'answer'
+                       when jsonb_array_length(v_answers) > 0 then v_answers -> 0 end;
+      select nullif(jsonb_agg(distinct x), '[]'::jsonb) into r.accepted
+        from (
+          select y from jsonb_array_elements_text(v_answers) with ordinality o(y, n) where o.n > 1
+          union all
+          select z from jsonb_array_elements_text(
+                          case when jsonb_typeof(p_q -> 'accepted') = 'array' then p_q -> 'accepted' else '[]'::jsonb end) z
+        ) a(x)
+       where x is not null and x <> '' and to_jsonb(x) is distinct from r.answer;
+    else
+      r.answer := null;
+      r.accepted := null;
+  end case;
+
+  r.difficulty := least(5, greatest(1, coalesce(nullif(p_q ->> 'difficulty', '')::integer, 3)));
+  r.marks := coalesce(nullif(p_q ->> 'marks', '')::numeric, 1);
+  if r.marks <= 0 then
+    raise exception 'a question''s marks are positive' using errcode = '22023';
+  end if;
+  r.worked_solution := nullif(btrim(coalesce(p_q ->> 'worked_solution', '')), '');
+  r.image_path := nullif(btrim(coalesce(p_q ->> 'image_path', p_q ->> 'image_url', '')), '');
+
+  v_topic := nullif(p_q ->> 'topic_id', '')::uuid;
+  select t.id into r.syllabus_topic_id
+    from public.syllabus_topics t
+   where t.id = v_topic and t.course_id = p_course_id;
+
+  r.source := case when jsonb_typeof(p_q -> 'source') = 'object' then p_q -> 'source' else '{}'::jsonb end;
+  return r;
+end;
+$$;
+
+comment on function public.practice_question_fields(uuid, jsonb) is
+  'The room''s Question object as a practice_questions row: validated and '
+  'mapped once, for store_extracted_questions and upsert_question. Not a door.';
+
+revoke all on function public.practice_question_fields(uuid, jsonb) from public, anon, authenticated;
+
+-- ---------------------------------------------------------------------------
+-- store_extracted_questions: what the room's extraction pipeline read out of
+-- a PDF, as drafts, by the caller. Returns how many landed.
+-- ---------------------------------------------------------------------------
+create or replace function public.store_extracted_questions(p_course_id uuid, p_questions jsonb, p_source jsonb)
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  q jsonb;
+  r public.practice_questions;
+  n integer := 0;
+begin
+  if not public.manages_course(p_course_id) then
+    raise exception 'only the course''s in-charge or an admin edits its question bank'
+      using errcode = '42501';
+  end if;
+  if p_questions is null or jsonb_typeof(p_questions) <> 'array' then
+    raise exception 'p_questions is an array of questions' using errcode = '22023';
+  end if;
+
+  for q in select value from jsonb_array_elements(p_questions) loop
+    r := public.practice_question_fields(p_course_id, q);
+    insert into public.practice_questions
+      (course_id, syllabus_topic_id, type, stem, options, answer, tolerance, unit, accepted,
+       difficulty, marks, worked_solution, image_path, source, status, created_by)
+    values
+      (p_course_id, r.syllabus_topic_id, r.type, r.stem, r.options, r.answer, r.tolerance, r.unit, r.accepted,
+       r.difficulty, r.marks, r.worked_solution, r.image_path,
+       coalesce(p_source, '{}'::jsonb) || r.source, 'draft', auth.uid());
+    n := n + 1;
+  end loop;
+  return n;
+end;
+$$;
+
+comment on function public.store_extracted_questions(uuid, jsonb, jsonb) is
+  'manages_course. Stores an array of the room''s Question objects as draft '
+  'questions on the course, by the caller, each carrying p_source under its '
+  'own; returns how many.';
+
+revoke all on function public.store_extracted_questions(uuid, jsonb, jsonb) from public;
+grant execute on function public.store_extracted_questions(uuid, jsonb, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- upsert_question: p_question.id null inserts a draft; otherwise the
+-- question, which must be on this course, has its editable fields replaced.
+-- Status is not among them: a retired row stays retired.
+-- ---------------------------------------------------------------------------
+create or replace function public.upsert_question(p_course_id uuid, p_question jsonb)
+returns uuid
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_id uuid;
+  r    public.practice_questions;
+begin
+  -- The course's manager edits the bank. A teacher with a lesson on the
+  -- course today may also write a DRAFT of their own — the one-off question
+  -- the activity panel sends in a quick check — and edit their own drafts;
+  -- approving stays the manager's (approve_question), so nothing a teacher
+  -- wrote reaches a set at home before somebody who manages the course read it.
+  v_id := nullif(p_question ->> 'id', '')::uuid;
+  if not public.manages_course(p_course_id) then
+    if not public.teaches_course_within(p_course_id, 1) then
+      raise exception 'only the course''s in-charge or an admin edits its question bank'
+        using errcode = '42501';
+    end if;
+    if v_id is not null and not exists (
+      select 1 from public.practice_questions q
+       where q.id = v_id and q.course_id = p_course_id
+         and q.status = 'draft' and q.created_by = auth.uid()) then
+      raise exception 'a teacher edits only their own drafts' using errcode = '42501';
+    end if;
+  end if;
+
+  r := public.practice_question_fields(p_course_id, p_question);
+
+  if v_id is null then
+    insert into public.practice_questions
+      (course_id, syllabus_topic_id, type, stem, options, answer, tolerance, unit, accepted,
+       difficulty, marks, worked_solution, image_path, source, status, created_by)
+    values
+      (p_course_id, r.syllabus_topic_id, r.type, r.stem, r.options, r.answer, r.tolerance, r.unit, r.accepted,
+       r.difficulty, r.marks, r.worked_solution, r.image_path, r.source, 'draft', auth.uid())
+    returning id into v_id;
+    return v_id;
+  end if;
+
+  update public.practice_questions q
+     set syllabus_topic_id = r.syllabus_topic_id,
+         type              = r.type,
+         stem              = r.stem,
+         options           = r.options,
+         answer            = r.answer,
+         tolerance         = r.tolerance,
+         unit              = r.unit,
+         accepted          = r.accepted,
+         difficulty        = r.difficulty,
+         marks             = r.marks,
+         worked_solution   = r.worked_solution,
+         image_path        = r.image_path,
+         source            = case when jsonb_typeof(p_question -> 'source') = 'object' then r.source else q.source end,
+         updated_at        = now()
+   where q.id = v_id
+     and q.course_id = p_course_id
+  returning q.id into v_id;
+  if v_id is null then
+    raise exception 'no such question on this course' using errcode = 'P0002';
+  end if;
+  return v_id;
+end;
+$$;
+
+comment on function public.upsert_question(uuid, jsonb) is
+  'manages_course. Adds (id null, as a draft) or edits a question of the '
+  'course; returns its id. Status is never written here, so a retired row '
+  'stays retired. A question on another course is "no such question".';
+
+revoke all on function public.upsert_question(uuid, jsonb) from public;
+grant execute on function public.upsert_question(uuid, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- approve_question / retire_question: the in-charge's word on a question.
+-- An approved question has a key (worked ones wait for a person anyway);
+-- a retired one is not approved back -- it is added again.
+-- ---------------------------------------------------------------------------
+create or replace function public.approve_question(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  q public.practice_questions;
+begin
+  select * into q from public.practice_questions x where x.id = p_id;
+  if not found then
+    raise exception 'no such question' using errcode = 'P0002';
+  end if;
+  if not public.manages_course(q.course_id) then
+    raise exception 'only the course''s in-charge or an admin approves a question'
+      using errcode = '42501';
+  end if;
+  if q.status = 'retired' then
+    raise exception 'a retired question is not approved back; add it again' using errcode = '22023';
+  end if;
+  if q.type <> 'worked' and q.answer is null then
+    raise exception 'a question needs an answer key before it is approved' using errcode = '22023';
+  end if;
+
+  update public.practice_questions
+     set status = 'approved', reviewed_by = auth.uid(), reviewed_at = now(), updated_at = now()
+   where id = p_id;
+end;
+$$;
+
+comment on function public.approve_question(uuid) is
+  'manages_course(question.course_id). Marks a draft approved, with who and '
+  'when; a question without a key (worked ones aside) and a retired one are '
+  'refused.';
+
+revoke all on function public.approve_question(uuid) from public;
+grant execute on function public.approve_question(uuid) to authenticated;
+
+create or replace function public.retire_question(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_course uuid;
+begin
+  select course_id into v_course from public.practice_questions where id = p_id;
+  if v_course is null then
+    raise exception 'no such question' using errcode = 'P0002';
+  end if;
+  if not public.manages_course(v_course) then
+    raise exception 'only the course''s in-charge or an admin retires a question'
+      using errcode = '42501';
+  end if;
+
+  update public.practice_questions
+     set status = 'retired', reviewed_by = auth.uid(), reviewed_at = now(), updated_at = now()
+   where id = p_id
+     and status <> 'retired';
+end;
+$$;
+
+comment on function public.retire_question(uuid) is
+  'manages_course(question.course_id). Marks a question retired; the sets '
+  'that already hold it keep it.';
+
+revoke all on function public.retire_question(uuid) from public;
+grant execute on function public.retire_question(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- create_practice_set: whoever manages the course, or -- for a quick check
+-- -- the host of a live lesson on it. Every question must be approved and on
+-- the course; a quick check may also use the caller's own drafts. Items in
+-- the order given, a repeat counted once.
+-- ---------------------------------------------------------------------------
+create or replace function public.create_practice_set(
+  p_course_id uuid, p_kind text, p_title text, p_question_ids uuid[],
+  p_topic_id uuid default null, p_time_limit_minutes integer default null,
+  p_integrity_settings jsonb default '{}'::jsonb, p_session_id uuid default null)
+returns uuid
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_title text;
+  v_ids   uuid[];
+  v_host  boolean := false;
+  v_id    uuid;
+begin
+  if p_kind is null or p_kind not in ('practice', 'quick_check', 'test') then
+    raise exception 'a set is one of practice, quick_check, test' using errcode = '22023';
+  end if;
+  v_title := nullif(btrim(coalesce(p_title, '')), '');
+  if v_title is null or length(v_title) > 200 then
+    raise exception 'a set needs a title of up to 200 characters' using errcode = '22023';
+  end if;
+
+  -- room_access is null for somebody with no seat, and a null here would
+  -- slip past the `if not` below: a seat is a seat only when it says so.
+  if p_kind = 'quick_check' and p_session_id is not null then
+    v_host := coalesce(public.room_access(p_session_id) = 'host', false)
+              and exists (select 1 from public.session_requests s
+                           where s.id = p_session_id
+                             and (s.course_id is null or s.course_id = p_course_id));
+  end if;
+  if not (public.manages_course(p_course_id) or v_host) then
+    raise exception 'only the course''s in-charge, an admin, or the host of a live lesson on it (for a quick check) makes a set'
+      using errcode = '42501';
+  end if;
+
+  -- Distinct, in the order first given.
+  select coalesce(array_agg(x.id order by x.n), '{}'::uuid[]) into v_ids
+    from (select distinct on (u.id) u.id, u.n
+            from unnest(coalesce(p_question_ids, '{}'::uuid[])) with ordinality u(id, n)
+           where u.id is not null
+           order by u.id, u.n) x;
+  if cardinality(v_ids) = 0 then
+    raise exception 'a set needs at least one question' using errcode = '22023';
+  end if;
+  if exists (select 1
+               from unnest(v_ids) x(id)
+               left join public.practice_questions q on q.id = x.id
+              where q.id is null
+                 or q.course_id <> p_course_id
+                 or not (q.status = 'approved'
+                         or (p_kind = 'quick_check' and q.status = 'draft' and q.created_by = auth.uid()))) then
+    raise exception 'every question must be an approved question on this course'
+      using errcode = '22023';
+  end if;
+  if p_topic_id is not null
+     and not exists (select 1 from public.syllabus_topics t
+                      where t.id = p_topic_id and t.course_id = p_course_id) then
+    raise exception 'the topic is not a syllabus topic of this course' using errcode = '22023';
+  end if;
+  if p_time_limit_minutes is not null and p_time_limit_minutes <= 0 then
+    raise exception 'a time limit is a positive number of minutes' using errcode = '22023';
+  end if;
+  if jsonb_typeof(coalesce(p_integrity_settings, '{}'::jsonb)) <> 'object' then
+    raise exception 'integrity settings are an object' using errcode = '22023';
+  end if;
+
+  insert into public.practice_sets
+    (course_id, kind, title, syllabus_topic_id, time_limit_minutes, integrity_settings, status, created_by)
+  values
+    (p_course_id, p_kind, v_title, p_topic_id, p_time_limit_minutes,
+     coalesce(p_integrity_settings, '{}'::jsonb), 'live', auth.uid())
+  returning id into v_id;
+
+  insert into public.practice_set_items (set_id, question_id, sort_order)
+  select v_id, u.id, u.n from unnest(v_ids) with ordinality u(id, n);
+
+  return v_id;
+end;
+$$;
+
+comment on function public.create_practice_set(uuid, text, text, uuid[], uuid, integer, jsonb, uuid) is
+  'Makes a live set from approved questions on the course (a quick check '
+  'may use the caller''s own drafts too), in the order given: whoever '
+  'manages the course, an admin, or -- quick checks only -- the host of a '
+  'live lesson on it. Returns the set id.';
+
+revoke all on function public.create_practice_set(uuid, text, text, uuid[], uuid, integer, jsonb, uuid) from public;
+grant execute on function public.create_practice_set(uuid, text, text, uuid[], uuid, integer, jsonb, uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- assign_practice: a live set, to each student named. Whoever manages the
+-- course, or the host of a live lesson giving it in_session to exactly that
+-- lesson's student. A student who already holds an open assignment for the
+-- set and session (none finished yet) is skipped. In-session rows are quiet:
+-- the student is in the room, and nothing about it is news to a phone.
+-- ---------------------------------------------------------------------------
+create or replace function public.assign_practice(
+  p_set_id uuid, p_student_ids uuid[], p_mode text,
+  p_session_id uuid default null, p_due_at timestamptz default null)
+returns integer
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  s       public.practice_sets;
+  v_ids   uuid[];
+  v_host  boolean := false;
+  v_quiet text;
+  n       integer;
+begin
+  if p_mode is null or p_mode not in ('in_session', 'at_home') then
+    raise exception 'a set is given in_session or at_home' using errcode = '22023';
+  end if;
+  select * into s from public.practice_sets x where x.id = p_set_id;
+  if not found then
+    raise exception 'no such set' using errcode = 'P0002';
+  end if;
+
+  select coalesce(array_agg(distinct x.id), '{}'::uuid[]) into v_ids
+    from unnest(coalesce(p_student_ids, '{}'::uuid[])) x(id)
+   where x.id is not null;
+  if cardinality(v_ids) = 0 then
+    raise exception 'a set is given to at least one student' using errcode = '22023';
+  end if;
+
+  -- room_access is null for somebody with no seat, and a null here would
+  -- slip past the `if not` below: a seat is a seat only when it says so.
+  if p_mode = 'in_session' and p_session_id is not null then
+    v_host := coalesce(public.room_access(p_session_id) = 'host', false)
+              and coalesce(v_ids = (select array[x.student_id] from public.session_requests x
+                                     where x.id = p_session_id and x.student_id is not null), false);
+  end if;
+  if not (public.manages_course(s.course_id) or v_host) then
+    raise exception 'only the course''s in-charge, an admin, or the host of a live lesson giving it to that lesson''s student sets practice'
+      using errcode = '42501';
+  end if;
+  if s.status <> 'live' then
+    raise exception 'only a live set is given out' using errcode = '55000';
+  end if;
+  if exists (select 1 from unnest(v_ids) x(id)
+              left join public.profiles p on p.id = x.id and p.role = 'student'
+             where p.id is null) then
+    raise exception 'every id must be a student' using errcode = '22023';
+  end if;
+
+  -- Quiet in the room; saved and restored, not cleared.
+  v_quiet := coalesce(current_setting('app.push_quiet', true), '');
+  if p_mode = 'in_session' then
+    perform set_config('app.push_quiet', '1', true);
+  end if;
+
+  insert into public.practice_assignments (set_id, student_id, session_id, assigned_by, due_at, mode)
+  select p_set_id, x.id, p_session_id, auth.uid(), p_due_at, p_mode
+    from unnest(v_ids) x(id)
+   where not exists (
+           select 1
+             from public.practice_assignments g
+            where g.set_id = p_set_id
+              and g.student_id = x.id
+              and g.session_id is not distinct from p_session_id
+              and not exists (select 1 from public.practice_attempts a
+                               where a.assignment_id = g.id
+                                 and a.status in ('submitted', 'marked')));
+  get diagnostics n = row_count;
+
+  perform set_config('app.push_quiet', v_quiet, true);
+  return n;
+end;
+$$;
+
+comment on function public.assign_practice(uuid, uuid[], text, uuid, timestamptz) is
+  'Gives a live set to each student named, in the lesson (quiet) or at home '
+  '(the student and the household are told): whoever manages the course, an '
+  'admin, or the host of a live lesson giving it in_session to that lesson''s '
+  'own student. A student with an open assignment for the set and session is '
+  'skipped. Returns how many were made.';
+
+revoke all on function public.assign_practice(uuid, uuid[], text, uuid, timestamptz) from public;
+grant execute on function public.assign_practice(uuid, uuid[], text, uuid, timestamptz) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- start_attempt: the student it was given to, and nobody else -- not a
+-- sibling, not a parent. The open attempt, or a new one carrying the set's
+-- time limit and the assignment's session.
+-- ---------------------------------------------------------------------------
+create or replace function public.start_attempt(p_assignment_id uuid)
+returns uuid
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  g       public.practice_assignments;
+  v_limit integer;
+  v_id    uuid;
+begin
+  select * into g from public.practice_assignments x where x.id = p_assignment_id;
+  if not found then
+    raise exception 'no such assignment' using errcode = 'P0002';
+  end if;
+  if auth.uid() is null or g.student_id <> auth.uid() then
+    raise exception 'only the student it was given to starts an attempt' using errcode = '42501';
+  end if;
+
+  select a.id into v_id
+    from public.practice_attempts a
+   where a.assignment_id = g.id and a.status = 'in_progress';
+  if v_id is not null then
+    return v_id;
+  end if;
+
+  select s.time_limit_minutes into v_limit from public.practice_sets s where s.id = g.set_id;
+  insert into public.practice_attempts (assignment_id, set_id, student_id, session_id, time_limit_minutes)
+  values (g.id, g.set_id, g.student_id, g.session_id, v_limit)
+  returning id into v_id;
+  return v_id;
+end;
+$$;
+
+comment on function public.start_attempt(uuid) is
+  'The assignment''s student only. Returns the open attempt, or opens one '
+  'with the set''s time limit and the assignment''s session.';
+
+revoke all on function public.start_attempt(uuid) from public;
+grant execute on function public.start_attempt(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- attempt_questions: the set, with what the student has answered so far.
+-- The key and the worked solution are null for the student while the
+-- attempt is open (or struck out), and after submission unless the set's
+-- integrity_settings hide them; the markers see them throughout.
+-- ---------------------------------------------------------------------------
+create or replace function public.attempt_questions(p_attempt_id uuid)
+returns jsonb
+language plpgsql
+stable security definer
+set search_path to 'public'
+as $$
+declare
+  a         public.practice_attempts;
+  v_student boolean;
+  v_hide    boolean;
+  v_out     jsonb;
+begin
+  select * into a from public.practice_attempts x where x.id = p_attempt_id;
+  if not found then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  v_student := auth.uid() is not null and a.student_id = auth.uid();
+  if not (v_student or public.marks_practice_attempt(a.id)) then
+    raise exception 'this attempt is not yours to read' using errcode = '42501';
+  end if;
+
+  v_hide := v_student
+            and (a.status in ('in_progress', 'void')
+                 or coalesce((select s.integrity_settings ->> 'hide_solutions'
+                                from public.practice_sets s where s.id = a.set_id), '') = 'true');
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'id',              q.id,
+           'type',            q.type,
+           'stem',            q.stem,
+           'image_path',      q.image_path,
+           'options',         q.options,
+           'difficulty',      q.difficulty,
+           'marks',           q.marks,
+           'topic_id',        q.syllabus_topic_id,
+           'topic_label',     t.label,
+           'sort_order',      i.sort_order,
+           'response',        ans.response,
+           'is_correct',      ans.is_correct,
+           'marks_awarded',   ans.marks_awarded,
+           'feedback',        ans.feedback,
+           'answer',          case when v_hide then null else q.answer end,
+           'worked_solution', case when v_hide then null else q.worked_solution end,
+           'unit',            q.unit)
+         order by i.sort_order, q.id), '[]'::jsonb)
+    into v_out
+    from public.practice_set_items i
+    join public.practice_questions q on q.id = i.question_id
+    left join public.syllabus_topics t on t.id = q.syllabus_topic_id
+    left join public.practice_answers ans on ans.attempt_id = a.id and ans.question_id = q.id
+   where i.set_id = a.set_id;
+  return v_out;
+end;
+$$;
+
+comment on function public.attempt_questions(uuid) is
+  'The attempt''s questions in order, each with the saved response and its '
+  'mark: the student (own), the assigner, the course''s in-charge, an admin. '
+  'The key and worked solution are null for the student while the attempt '
+  'is open, and afterwards when the set hides solutions.';
+
+revoke all on function public.attempt_questions(uuid) from public;
+grant execute on function public.attempt_questions(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- answer_question: the student, while the attempt is open and inside its
+-- time (the limit, two minutes' grace, and whatever the integrity summary
+-- says the test was paused for). Saves the response and marks it the way
+-- the room would; returns the mark and never the key.
+-- ---------------------------------------------------------------------------
+create or replace function public.answer_question(p_attempt_id uuid, p_question_id uuid, p_response jsonb)
+returns jsonb
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  a          public.practice_attempts;
+  q          public.practice_questions;
+  v_paused   numeric;
+  v_mark     jsonb;
+  v_status   text;
+  v_correct  boolean;
+  v_awarded  numeric;
+begin
+  select * into a from public.practice_attempts x where x.id = p_attempt_id for update;
+  if not found then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  if auth.uid() is null or a.student_id <> auth.uid() then
+    raise exception 'only the student answers their own attempt' using errcode = '42501';
+  end if;
+  if a.status <> 'in_progress' then
+    raise exception 'this attempt is no longer open' using errcode = '55000';
+  end if;
+  if p_response is null or jsonb_typeof(p_response) <> 'object' then
+    raise exception 'a response is an object' using errcode = '22023';
+  end if;
+
+  select x.* into q
+    from public.practice_questions x
+    join public.practice_set_items i on i.question_id = x.id and i.set_id = a.set_id
+   where x.id = p_question_id;
+  if not found then
+    raise exception 'that question is not in this set' using errcode = '22023';
+  end if;
+
+  if a.time_limit_minutes is not null then
+    v_paused := coalesce((a.integrity_summary ->> 'total_paused_ms')::numeric / 1000,
+                         (a.integrity_summary ->> 'paused_seconds')::numeric, 0);
+    if now() > a.started_at
+                 + make_interval(mins => a.time_limit_minutes)
+                 + interval '2 minutes'
+                 + make_interval(secs => v_paused::double precision) then
+      raise exception 'the time for this attempt is up' using errcode = '55000';
+    end if;
+  end if;
+
+  v_mark := public.practice_mark_question(q.type, q.answer, q.accepted, q.tolerance, q.marks, p_response);
+  v_status := v_mark ->> 'status';
+  if v_status = 'pending_review' then
+    v_correct := null;
+    v_awarded := null;
+  else
+    v_correct := v_status = 'correct';
+    v_awarded := (v_mark ->> 'score')::numeric;
+  end if;
+
+  insert into public.practice_answers
+    (attempt_id, question_id, response, is_correct, marks_awarded, marked_by, feedback, answered_at)
+  values
+    (a.id, q.id, p_response, v_correct, v_awarded, null, v_mark ->> 'feedback', now())
+  on conflict (attempt_id, question_id) do update
+    set response      = excluded.response,
+        is_correct    = excluded.is_correct,
+        marks_awarded = excluded.marks_awarded,
+        marked_by     = null,
+        feedback      = excluded.feedback,
+        answered_at   = excluded.answered_at;
+
+  return jsonb_build_object(
+    'is_correct',    v_correct,
+    'marks_awarded', v_awarded,
+    'status',        v_status,
+    'feedback',      v_mark ->> 'feedback');
+end;
+$$;
+
+comment on function public.answer_question(uuid, uuid, jsonb) is
+  'The student, on an open attempt, inside its time: saves the response and '
+  'auto-marks it (the room''s marking, ported); a worked question is '
+  'pending_review. Returns {is_correct, marks_awarded, status, feedback} and '
+  'never the key.';
+
+revoke all on function public.answer_question(uuid, uuid, jsonb) from public;
+grant execute on function public.answer_question(uuid, uuid, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- submit_attempt: the student closes it. The score is what the auto-marked
+-- answers earned; out_of is every question's marks; marked when nothing
+-- waits for a person, else submitted. The integrity summary the room
+-- computed lands here, and its flag.
+-- ---------------------------------------------------------------------------
+create or replace function public.submit_attempt(p_attempt_id uuid, p_integrity_summary jsonb default null)
+returns jsonb
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  a        public.practice_attempts;
+  v_score  numeric;
+  v_out_of numeric;
+  v_status text;
+begin
+  select * into a from public.practice_attempts x where x.id = p_attempt_id for update;
+  if not found then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  if auth.uid() is null or a.student_id <> auth.uid() then
+    raise exception 'only the student submits their own attempt' using errcode = '42501';
+  end if;
+  if a.status <> 'in_progress' then
+    raise exception 'this attempt is no longer open' using errcode = '55000';
+  end if;
+  if p_integrity_summary is not null and jsonb_typeof(p_integrity_summary) <> 'object' then
+    raise exception 'an integrity summary is an object' using errcode = '22023';
+  end if;
+
+  select coalesce(sum(x.marks_awarded), 0) into v_score
+    from public.practice_answers x
+   where x.attempt_id = a.id and x.marks_awarded is not null;
+  select coalesce(sum(q.marks), 0) into v_out_of
+    from public.practice_set_items i
+    join public.practice_questions q on q.id = i.question_id
+   where i.set_id = a.set_id;
+  v_status := case when exists (select 1 from public.practice_answers x
+                                 where x.attempt_id = a.id and x.is_correct is null)
+                   then 'submitted' else 'marked' end;
+
+  update public.practice_attempts
+     set status            = v_status,
+         submitted_at      = now(),
+         score             = v_score,
+         out_of            = v_out_of,
+         integrity_flagged = coalesce((p_integrity_summary ->> 'flagged')::boolean, false),
+         integrity_summary = case when p_integrity_summary is null then integrity_summary
+                                  else coalesce(integrity_summary, '{}'::jsonb) || p_integrity_summary end
+   where id = a.id;
+
+  return jsonb_build_object('score', v_score, 'out_of', v_out_of, 'status', v_status);
+end;
+$$;
+
+comment on function public.submit_attempt(uuid, jsonb) is
+  'The student closes an open attempt: score over the auto-marked answers, '
+  'out_of over every question, marked when nothing waits for a person else '
+  'submitted; the room''s integrity summary and its flag are kept. Returns '
+  '{score, out_of, status}.';
+
+revoke all on function public.submit_attempt(uuid, jsonb) from public;
+grant execute on function public.submit_attempt(uuid, jsonb) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- mark_answer: a person's marks on a submitted answer (a worked question,
+-- or a correction). When nothing is left unmarked the attempt is marked.
+-- ---------------------------------------------------------------------------
+create or replace function public.mark_answer(
+  p_attempt_id uuid, p_question_id uuid, p_marks numeric, p_feedback text default null)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  a     public.practice_attempts;
+  v_max numeric;
+begin
+  select * into a from public.practice_attempts x where x.id = p_attempt_id for update;
+  if not found then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  if not public.marks_practice_attempt(a.id) then
+    raise exception 'only the teacher who set it, the course''s in-charge or an admin marks an answer'
+      using errcode = '42501';
+  end if;
+  if a.status not in ('submitted', 'marked') then
+    raise exception 'an attempt is marked once it is submitted' using errcode = '55000';
+  end if;
+
+  select q.marks into v_max
+    from public.practice_questions q
+    join public.practice_set_items i on i.question_id = q.id and i.set_id = a.set_id
+   where q.id = p_question_id;
+  if v_max is null then
+    raise exception 'that question is not in this set' using errcode = '22023';
+  end if;
+  if p_marks is null or p_marks < 0 or p_marks > v_max then
+    raise exception 'marks are between 0 and the question''s marks' using errcode = '22023';
+  end if;
+
+  update public.practice_answers x
+     set marks_awarded = p_marks,
+         is_correct    = (p_marks = v_max),
+         marked_by     = auth.uid(),
+         feedback      = coalesce(nullif(btrim(coalesce(p_feedback, '')), ''), x.feedback)
+   where x.attempt_id = a.id and x.question_id = p_question_id;
+  if not found then
+    raise exception 'the student left that question unanswered; there is nothing to mark'
+      using errcode = 'P0002';
+  end if;
+
+  update public.practice_attempts t
+     set score  = (select coalesce(sum(x.marks_awarded), 0) from public.practice_answers x
+                    where x.attempt_id = t.id and x.marks_awarded is not null),
+         status = case when exists (select 1 from public.practice_answers x
+                                     where x.attempt_id = t.id and x.is_correct is null)
+                       then t.status else 'marked' end
+   where t.id = a.id;
+end;
+$$;
+
+comment on function public.mark_answer(uuid, uuid, numeric, text) is
+  'The assigner, the course''s in-charge or an admin awards marks (0 to the '
+  'question''s) on a submitted answer, with who and optional feedback; the '
+  'score is recomputed and the attempt is marked once no answer waits.';
+
+revoke all on function public.mark_answer(uuid, uuid, numeric, text) from public;
+grant execute on function public.mark_answer(uuid, uuid, numeric, text) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- void_attempt: struck out by the assigner, the course or an admin.
+-- ---------------------------------------------------------------------------
+create or replace function public.void_attempt(p_attempt_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+begin
+  if not exists (select 1 from public.practice_attempts where id = p_attempt_id) then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  if not public.marks_practice_attempt(p_attempt_id) then
+    raise exception 'only the teacher who set it, the course''s in-charge or an admin voids an attempt'
+      using errcode = '42501';
+  end if;
+  update public.practice_attempts set status = 'void' where id = p_attempt_id and status <> 'void';
+end;
+$$;
+
+comment on function public.void_attempt(uuid) is
+  'The assigner, the course''s in-charge or an admin strikes an attempt out.';
+
+revoke all on function public.void_attempt(uuid) from public;
+grant execute on function public.void_attempt(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- log_integrity_event: what the test saw, written by the student's own
+-- browser while the attempt is open. Insert only; nothing here is ever
+-- read back by the student.
+-- ---------------------------------------------------------------------------
+create or replace function public.log_integrity_event(
+  p_attempt_id uuid, p_kind text, p_detail text default null, p_snapshot_path text default null)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  a public.practice_attempts;
+begin
+  select * into a from public.practice_attempts x where x.id = p_attempt_id;
+  if not found then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  if auth.uid() is null or a.student_id <> auth.uid() then
+    raise exception 'only the student''s own test logs its events' using errcode = '42501';
+  end if;
+  if a.status <> 'in_progress' then
+    raise exception 'an integrity event is logged while the attempt is open' using errcode = '55000';
+  end if;
+  if p_kind is null
+     or p_kind not in ('fullscreen_exit', 'visibility_hidden', 'window_blur', 'resize',
+                       'paste', 'copy', 'context_menu', 'devtools', 'offline',
+                       'camera_off', 'snapshot', 'resume', 'warned', 'paused') then
+    raise exception 'not a kind of integrity event' using errcode = '22023';
+  end if;
+
+  insert into public.practice_integrity_events (attempt_id, kind, detail, snapshot_path)
+  values (a.id, p_kind, nullif(btrim(coalesce(p_detail, '')), ''),
+          nullif(btrim(coalesce(p_snapshot_path, '')), ''));
+
+  -- A resume says how long the test was paused ("42 s away"); the attempt
+  -- keeps the running total so answer_question can allow for it while the
+  -- test is still open, not only once the summary arrives at submit.
+  if p_kind = 'resume' and p_detail ~ '^\s*[0-9]+' then
+    update public.practice_attempts x
+       set integrity_summary = coalesce(x.integrity_summary, '{}'::jsonb)
+             || jsonb_build_object(
+                  'total_paused_ms',
+                  coalesce((x.integrity_summary ->> 'total_paused_ms')::numeric, 0)
+                    + (substring(p_detail from '^\s*([0-9]+)'))::numeric * 1000)
+     where x.id = a.id;
+  end if;
+end;
+$$;
+
+comment on function public.log_integrity_event(uuid, text, text, text) is
+  'The student, on an open attempt: records one integrity event (and the '
+  'storage path of a snapshot, when there is one). Insert only.';
+
+revoke all on function public.log_integrity_event(uuid, text, text, text) from public;
+grant execute on function public.log_integrity_event(uuid, text, text, text) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- my_practice: the assignments the caller may read, newest first, with the
+-- latest attempt on each. A student's own; a parent's household; a
+-- teacher's own hand-outs; an in-charge's room and courses; an admin's all.
+-- Limited to 200, and total_count says when it stopped (CLAUDE.md: a list
+-- that quietly ends is read as all of them).
+-- ---------------------------------------------------------------------------
+create or replace function public.my_practice(p_days integer default 30)
+returns table (
+  assignment_id     uuid,
+  set_id            uuid,
+  set_title         text,
+  kind              text,
+  course_id         uuid,
+  course_name       text,
+  student_id        uuid,
+  student_name      text,
+  mode              text,
+  due_at            timestamptz,
+  assigned_at       timestamptz,
+  attempt_id        uuid,
+  attempt_status    text,
+  score             numeric,
+  out_of            numeric,
+  integrity_flagged boolean,
+  submitted_at      timestamptz,
+  question_count    integer,
+  total_count       bigint,
+  session_id        uuid
+)
+language plpgsql
+stable security definer
+set search_path to 'public'
+as $$
+#variable_conflict use_column
+declare
+  v_admin  boolean := public.is_admin();
+  -- The household clause is a parent's: a student lists their own and not
+  -- a sibling's, although the table lets the household read the rows.
+  v_parent boolean := exists (select 1 from public.profiles p
+                               where p.id = auth.uid() and p.role = 'parent');
+begin
+  return query
+    with mine as (
+      select g.id, g.set_id, g.student_id, g.mode, g.due_at, g.created_at, g.session_id,
+             s.title, s.kind, s.course_id as s_course_id
+        from public.practice_assignments g
+        join public.practice_sets s on s.id = g.set_id
+       where g.created_at >= now() - make_interval(days => greatest(coalesce(p_days, 30), 1))
+         and (v_admin
+              or g.student_id = auth.uid()
+              or (v_parent and public.shares_family(g.student_id))
+              or g.assigned_by = auth.uid()
+              or public.manages_course(s.course_id)
+              or public.room_reaches((select p.family_id from public.profiles p where p.id = g.student_id),
+                                     g.student_id, false))
+    ),
+    counted as (select count(*) as n from mine)
+    select m.id,
+           m.set_id,
+           m.title,
+           m.kind,
+           m.s_course_id,
+           c.name,
+           m.student_id,
+           public.display_name(p.full_name, p.preferred_name),
+           m.mode,
+           m.due_at,
+           m.created_at,
+           att.id,
+           att.status,
+           att.score,
+           att.out_of,
+           att.integrity_flagged,
+           att.submitted_at,
+           (select count(*)::integer from public.practice_set_items i where i.set_id = m.set_id),
+           (select n from counted),
+           m.session_id
+      from mine m
+      join public.courses c on c.id = m.s_course_id
+      join public.profiles p on p.id = m.student_id
+      left join lateral (
+        select a.id, a.status, a.score, a.out_of, a.integrity_flagged, a.submitted_at
+          from public.practice_attempts a
+         where a.assignment_id = m.id
+         order by a.started_at desc
+         limit 1
+      ) att on true
+     order by m.created_at desc, m.id
+     limit 200;
+end;
+$$;
+
+comment on function public.my_practice(integer) is
+  'The assignments of the last p_days the caller may read (a student''s own; '
+  'a parent''s household; a teacher''s own hand-outs; an in-charge''s room '
+  'and courses; an admin''s all), newest first, each with its latest attempt. '
+  'The first 200, with total_count saying how many there are.';
+
+revoke all on function public.my_practice(integer) from public;
+grant execute on function public.my_practice(integer) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- live_attempts: what the room's teacher view watches -- every attempt in
+-- this lesson and the answers so far. The host, or an observer.
+-- ---------------------------------------------------------------------------
+create or replace function public.live_attempts(p_session_id uuid)
+returns jsonb
+language plpgsql
+stable security definer
+set search_path to 'public'
+as $$
+declare
+  v_out jsonb;
+begin
+  if coalesce(public.room_access(p_session_id), '') not in ('host', 'observer') then
+    raise exception 'only the lesson''s host or an observer watches its attempts' using errcode = '42501';
+  end if;
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'attempt_id',        a.id,
+           'student_id',        a.student_id,
+           'set_id',            a.set_id,
+           'set_title',         s.title,
+           'kind',              s.kind,
+           'status',            a.status,
+           'score',             a.score,
+           'out_of',            a.out_of,
+           'started_at',        a.started_at,
+           'submitted_at',      a.submitted_at,
+           'integrity_flagged', a.integrity_flagged,
+           'answers', coalesce((
+             select jsonb_agg(jsonb_build_object(
+                      'question_id', x.question_id, 'is_correct', x.is_correct,
+                      'marks_awarded', x.marks_awarded, 'answered_at', x.answered_at)
+                    order by x.answered_at, x.question_id)
+               from public.practice_answers x where x.attempt_id = a.id), '[]'::jsonb))
+         order by a.started_at, a.id), '[]'::jsonb)
+    into v_out
+    from public.practice_attempts a
+    join public.practice_sets s on s.id = a.set_id
+   where a.session_id = p_session_id;
+  return v_out;
+end;
+$$;
+
+comment on function public.live_attempts(uuid) is
+  'Every attempt in the lesson with its answers so far, for the room''s '
+  'teacher view: the host or an observer (room_access).';
+
+revoke all on function public.live_attempts(uuid) from public;
+grant execute on function public.live_attempts(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- flagged_attempt_review: the attempt, what the test saw, and the script --
+-- for whoever may mark it.
+-- ---------------------------------------------------------------------------
+create or replace function public.flagged_attempt_review(p_attempt_id uuid)
+returns jsonb
+language plpgsql
+stable security definer
+set search_path to 'public'
+as $$
+declare
+  v_attempt jsonb;
+  v_events  jsonb;
+  v_answers jsonb;
+begin
+  if not exists (select 1 from public.practice_attempts where id = p_attempt_id) then
+    raise exception 'no such attempt' using errcode = 'P0002';
+  end if;
+  if not public.marks_practice_attempt(p_attempt_id) then
+    raise exception 'only the teacher who set it, the course''s in-charge or an admin reviews an attempt'
+      using errcode = '42501';
+  end if;
+
+  select to_jsonb(a) || jsonb_build_object(
+           'set_title', s.title, 'kind', s.kind,
+           'student_name', public.display_name(p.full_name, p.preferred_name))
+    into v_attempt
+    from public.practice_attempts a
+    join public.practice_sets s on s.id = a.set_id
+    join public.profiles p on p.id = a.student_id
+   where a.id = p_attempt_id;
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'at', e.at, 'kind', e.kind, 'detail', e.detail, 'snapshot_path', e.snapshot_path)
+         order by e.at, e.id), '[]'::jsonb)
+    into v_events
+    from public.practice_integrity_events e
+   where e.attempt_id = p_attempt_id;
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'question_id',     q.id,
+           'sort_order',      i.sort_order,
+           'type',            q.type,
+           'stem',            q.stem,
+           'marks',           q.marks,
+           'answer',          q.answer,
+           'worked_solution', q.worked_solution,
+           'response',        x.response,
+           'is_correct',      x.is_correct,
+           'marks_awarded',   x.marks_awarded,
+           'feedback',        x.feedback,
+           'answered_at',     x.answered_at,
+           'marked_by',       x.marked_by)
+         order by i.sort_order, q.id), '[]'::jsonb)
+    into v_answers
+    from public.practice_attempts a
+    join public.practice_set_items i on i.set_id = a.set_id
+    join public.practice_questions q on q.id = i.question_id
+    left join public.practice_answers x on x.attempt_id = a.id and x.question_id = q.id
+   where a.id = p_attempt_id;
+
+  return jsonb_build_object('attempt', v_attempt, 'events', v_events, 'answers', v_answers);
+end;
+$$;
+
+comment on function public.flagged_attempt_review(uuid) is
+  'The attempt row, its integrity events in order, and every question with '
+  'the answer given: the assigner, the course''s in-charge or an admin.';
+
+revoke all on function public.flagged_attempt_review(uuid) from public;
+grant execute on function public.flagged_attempt_review(uuid) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- Push. Two more pairs on notify_push, the way every other table carries it
+-- (20260809000100): AFTER, FOR EACH ROW. A set given out is news to the
+-- student and the household (at home; assign_practice keeps in-session rows
+-- quiet); an attempt's status moving is news to whoever set it.
+-- ---------------------------------------------------------------------------
+drop trigger if exists push_practice_assignments_insert on public.practice_assignments;
+create trigger push_practice_assignments_insert
+  after insert on public.practice_assignments
+  for each row execute function public.notify_push();
+
+drop trigger if exists push_practice_attempts_update on public.practice_attempts;
+create trigger push_practice_attempts_update
+  after update of status on public.practice_attempts
+  for each row execute function public.notify_push();
+
+-- The room's teacher view listens to postgres_changes on attempts, filtered
+-- by session; RLS decides what each listener is handed.
+do $$
+begin
+  if not exists (select 1 from pg_publication_tables
+                  where pubname = 'supabase_realtime'
+                    and schemaname = 'public'
+                    and tablename = 'practice_attempts') then
+    alter publication supabase_realtime add table public.practice_attempts;
+  end if;
+end
+$$;
+
+-- ---------------------------------------------------------------------------
+-- Buckets.
+--
+-- test-snapshots: <uid>/<attempt>/<ts>.jpg, written by the student under
+-- their own prefix only, read by them and by whoever may review an attempt
+-- a logged event names it on. practice-images: <course_id>/<file>, written
+-- by whoever manages the course, read by the course's readers and by a
+-- student with an attempt at a set carrying the question that uses it.
+-- ---------------------------------------------------------------------------
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values ('test-snapshots', 'test-snapshots', false, 2097152,  -- 2 MB
+        array['image/jpeg', 'image/png', 'image/webp'])
+on conflict (id) do nothing;
+
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values ('practice-images', 'practice-images', false, 10485760,  -- 10 MB
+        array['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/svg+xml'])
+on conflict (id) do nothing;
+
+create or replace function public.reads_test_snapshot(p_name text, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and (split_part(coalesce(p_name, ''), '/', 1) = uid::text
+          or exists (select 1
+                       from public.practice_integrity_events e
+                      where e.snapshot_path = p_name
+                        and public.marks_practice_attempt(e.attempt_id, uid)));
+$$;
+
+comment on function public.reads_test_snapshot(text, uuid) is
+  'True for the owner of the snapshot''s path prefix, and for whoever may '
+  'review the attempt an integrity event logged it on.';
+
+revoke all on function public.reads_test_snapshot(text, uuid) from public;
+grant execute on function public.reads_test_snapshot(text, uuid) to authenticated;
+
+-- The course in a practice-images path, or null when the prefix is not a
+-- uuid -- so a stray object can never make the whole bucket error.
+create or replace function public.practice_image_course(p_name text)
+returns uuid
+language sql
+immutable
+as $$
+  select case when split_part(coalesce(p_name, ''), '/', 1)
+                   ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
+              then split_part(p_name, '/', 1)::uuid end;
+$$;
+
+revoke all on function public.practice_image_course(text) from public;
+grant execute on function public.practice_image_course(text) to authenticated;
+
+create or replace function public.reads_practice_image(p_name text, uid uuid default auth.uid())
+returns boolean
+language sql
+stable security definer
+set search_path to 'public'
+as $$
+  select uid is not null
+     and public.practice_image_course(p_name) is not null
+     and (public.manages_course(public.practice_image_course(p_name), uid)
+          or public.teaches_course_within(public.practice_image_course(p_name), 14, uid)
+          or exists (select 1
+                       from public.practice_questions q
+                       join public.practice_set_items i on i.question_id = q.id
+                       join public.practice_attempts a on a.set_id = i.set_id
+                      where q.image_path = p_name
+                        and a.student_id = uid));
+$$;
+
+comment on function public.reads_practice_image(text, uuid) is
+  'True for whoever manages the course in the path, a teacher on it this '
+  'fortnight, or a student with an attempt at a set holding the question '
+  'that uses the picture.';
+
+revoke all on function public.reads_practice_image(text, uuid) from public;
+grant execute on function public.reads_practice_image(text, uuid) to authenticated;
+
+drop policy if exists test_snapshots_storage_write on storage.objects;
+create policy test_snapshots_storage_write on storage.objects
+  for insert to authenticated
+  with check (bucket_id = 'test-snapshots'
+              and split_part(name, '/', 1) = auth.uid()::text);
+
+drop policy if exists test_snapshots_storage_read on storage.objects;
+create policy test_snapshots_storage_read on storage.objects
+  for select to authenticated
+  using (bucket_id = 'test-snapshots' and public.reads_test_snapshot(name));
+
+drop policy if exists practice_images_storage_write on storage.objects;
+create policy practice_images_storage_write on storage.objects
+  for insert to authenticated
+  with check (bucket_id = 'practice-images'
+              and public.practice_image_course(name) is not null
+              and public.manages_course(public.practice_image_course(name)));
+
+drop policy if exists practice_images_storage_read on storage.objects;
+create policy practice_images_storage_read on storage.objects
+  for select to authenticated
+  using (bucket_id = 'practice-images' and public.reads_practice_image(name));
+
+drop policy if exists practice_images_storage_delete on storage.objects;
+create policy practice_images_storage_delete on storage.objects
+  for delete to authenticated
+  using (bucket_id = 'practice-images'
+         and public.practice_image_course(name) is not null
+         and public.manages_course(public.practice_image_course(name)));
+
+-- ---------------------------------------------------------------------------
+-- Two more tables point at a course, so the twin merge learns them.
+--
+-- retire_seed_course_twins (20261006101925) moves every row that references
+-- a seed course onto its portal twin, and the RLS suite reads the list of
+-- foreign keys into courses out of the catalogue and fails when the
+-- function does not name one of them. Nothing in practice_questions or
+-- practice_sets is unique by course, so both move whole, like
+-- session_requests.
+--
+-- Re-emitted from pg_get_functiondef() against a database with every
+-- migration applied (20261013163422 included); the two moves are the only
+-- change.
+-- ---------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.retire_seed_course_twins()
+ RETURNS jsonb
+ LANGUAGE plpgsql
+ SET search_path TO 'public'
+AS $function$
+declare
+  locked  regclass[];
+  tbl     regclass;
+  n       int;
+  retired int   := 0;
+  revived int   := 0;
+  rooms   int   := 0;
+  names   text[] := '{}';
+  moved   jsonb := '{}';
+  skipped jsonb := '{}';
+begin
+  -- The pairs, once: every seed row beside a keyed row of its name, live or
+  -- not, and one portal row per seed (a live one first) so no row is asked
+  -- to move twice.
+  if to_regclass('pg_temp.course_twins') is not null then
+    drop table pg_temp.course_twins;
+  end if;
+  create temp table course_twins as
+    select distinct on (seed.id)
+           seed.id            as seed_id,
+           seed.name          as name,
+           seed.is_active     as seed_live,
+           seed.department_id as seed_room,
+           real.id            as portal_id
+      from public.courses seed
+      join public.courses real
+        on real.name = seed.name
+       and real.external_id is not null
+       and real.id <> seed.id
+     where seed.external_id is null
+     order by seed.id, real.is_active desc, real.id;
+
+  -- Nothing below is news to anybody (see the migration header). The flag
+  -- is what every import door sets and what the outbox, the pushes and the
+  -- guards read; the triggers that do not read it -- the schedule-change
+  -- stamp among them -- are switched off, on exactly the tables that carry
+  -- one. Both sets are read from the catalogue.
+  perform set_config('app.portal_import', '1', true);
+  select coalesce(array_agg(distinct c.conrelid::regclass), '{}')
+    into locked
+    from pg_constraint c
+    join pg_trigger t on t.tgrelid = c.conrelid and not t.tgisinternal
+   where c.contype = 'f' and c.confrelid = 'public.courses'::regclass;
+  foreach tbl in array locked loop
+    execute format('alter table %s disable trigger user', tbl);
+  end loop;
+
+  -- Plain moves: nothing on these tables is unique by course. One
+  -- statement per table, so the big one is read once, not once per pair.
+  update public.session_requests s set course_id = t.portal_id
+    from course_twins t where s.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('session_requests', n);
+
+  update public.booking_rules b set course_id = t.portal_id
+    from course_twins t where b.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('booking_rules', n);
+
+  update public.conversations c set course_id = t.portal_id
+    from course_twins t where c.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('conversations', n);
+
+  update public.announcements a set course_id = t.portal_id
+    from course_twins t where a.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('announcements', n);
+
+  update public.portal_attendance a set course_id = t.portal_id
+    from course_twins t where a.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('portal_attendance', n);
+
+  update public.portal_mismatches m set course_id = t.portal_id
+    from course_twins t where m.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('portal_mismatches', n);
+
+  -- Moves guarded by each table's own key: a row the portal twin already
+  -- has stays on the retired row and is counted as left behind.
+  update public.student_courses sc set course_id = t.portal_id
+    from course_twins t
+   where sc.course_id = t.seed_id
+     and not exists (select 1 from public.student_courses p
+                      where p.student_id = sc.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('student_courses', n);
+
+  update public.routing_rules rr set course_id = t.portal_id
+    from course_twins t
+   where rr.course_id = t.seed_id
+     and not exists (select 1 from public.routing_rules p
+                      where p.course_id = t.portal_id
+                        and p.school_id   is not distinct from rr.school_id
+                        and p.grade_level is not distinct from rr.grade_level);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('routing_rules', n);
+
+  -- (course, grade, label), nulls not distinct: a year-11 Vectors beside an
+  -- all-years Vectors is two topics, not one.
+  update public.course_topics ct set course_id = t.portal_id
+    from course_twins t
+   where ct.course_id = t.seed_id
+     and not exists (select 1 from public.course_topics p
+                      where p.course_id = t.portal_id
+                        and p.grade_level is not distinct from ct.grade_level
+                        and p.label = ct.label);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('course_topics', n);
+
+  update public.department_hours dh set course_id = t.portal_id
+    from course_twins t
+   where dh.course_id = t.seed_id
+     and not exists (select 1 from public.department_hours p
+                      where p.course_id = t.portal_id
+                        and p.weekday = dh.weekday
+                        and p.open_minutes = dh.open_minutes
+                        and p.kind = dh.kind);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('department_hours', n);
+
+  -- One OPEN request per student and course; a decided one moves freely.
+  update public.enrolment_change_requests e set course_id = t.portal_id
+    from course_twins t
+   where e.course_id = t.seed_id
+     and not (e.status = 'pending'
+              and exists (select 1 from public.enrolment_change_requests p
+                           where p.student_id = e.student_id
+                             and p.course_id = t.portal_id
+                             and p.status = 'pending'));
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('enrolment_change_requests', n);
+
+  -- First-course history: where both twins hold a day, the portal row
+  -- takes the earlier; where only the seed does, the row moves.
+  update public.student_course_first p
+     set first_on        = least(p.first_on, s.first_on),
+         portal_first_on = least(p.portal_first_on, s.portal_first_on)
+    from public.student_course_first s
+    join course_twins t on t.seed_id = s.course_id
+   where p.course_id = t.portal_id
+     and p.student_id = s.student_id;
+  update public.student_course_first s set course_id = t.portal_id
+    from course_twins t
+   where s.course_id = t.seed_id
+     and not exists (select 1 from public.student_course_first p
+                      where p.student_id = s.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('student_course_first', n);
+
+  -- One notebook per student and course (20261013152316): a student who
+  -- already has one on the portal twin keeps it; the seed's stays behind.
+  update public.lesson_notebooks ln set course_id = t.portal_id
+    from course_twins t
+   where ln.course_id = t.seed_id
+     and not exists (select 1 from public.lesson_notebooks p
+                      where p.student_id = ln.student_id and p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('lesson_notebooks', n);
+
+  -- One materials mapping per course: a twin already mapped keeps its own.
+  update public.lesson_course_materials lm set course_id = t.portal_id
+    from course_twins t
+   where lm.course_id = t.seed_id
+     and not exists (select 1 from public.lesson_course_materials p
+                      where p.course_id = t.portal_id);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('lesson_course_materials', n);
+
+  -- A syllabus topic by label (20261013163422): the twin's syllabus
+  -- already holding that label keeps its own; the seed's stays behind.
+  update public.syllabus_topics st set course_id = t.portal_id
+    from course_twins t
+   where st.course_id = t.seed_id
+     and not exists (select 1 from public.syllabus_topics p
+                      where p.course_id = t.portal_id and p.label = st.label);
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('syllabus_topics', n);
+
+  -- The question bank and its sets (20261013170702): nothing in either is
+  -- unique by course, so both move whole.
+  update public.practice_questions pq set course_id = t.portal_id
+    from course_twins t where pq.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('practice_questions', n);
+
+  update public.practice_sets ps set course_id = t.portal_id
+    from course_twins t where ps.course_id = t.seed_id;
+  get diagnostics n = row_count;
+  moved := moved || jsonb_build_object('practice_sets', n);
+
+  -- The seed row's default room, only where the portal row has none.
+  update public.courses c set department_id = t.seed_room
+    from course_twins t
+   where c.id = t.portal_id and c.department_id is null and t.seed_room is not null;
+  get diagnostics rooms = row_count;
+
+  -- A live course must still have a live row: a portal twin somebody
+  -- switched off by hand (the twins were the symptom) comes back when the
+  -- seed row it replaces was the live one. The sync never writes is_active.
+  update public.courses c set is_active = true
+    from course_twins t
+   where c.id = t.portal_id and t.seed_live and not c.is_active;
+  get diagnostics revived = row_count;
+
+  update public.courses c set is_active = false
+    from course_twins t
+   where c.id = t.seed_id and c.is_active;
+  get diagnostics retired = row_count;
+  select coalesce(array_agg(t.name order by t.name), '{}') into names
+    from course_twins t where t.seed_live;
+
+  foreach tbl in array locked loop
+    execute format('alter table %s enable trigger user', tbl);
+  end loop;
+
+  -- What stayed behind on the rows this run retired, by table, so the
+  -- notice in the release log says it rather than leaving it to be found.
+  select coalesce(jsonb_object_agg(x.tbl, x.n) filter (where x.n > 0), '{}'::jsonb)
+    into skipped
+    from (
+      select 'student_courses' as tbl, count(*) as n
+        from public.student_courses r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'routing_rules', count(*)
+        from public.routing_rules r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'course_topics', count(*)
+        from public.course_topics r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'department_hours', count(*)
+        from public.department_hours r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'enrolment_change_requests', count(*)
+        from public.enrolment_change_requests r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'student_course_first', count(*)
+        from public.student_course_first r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'lesson_notebooks', count(*)
+        from public.lesson_notebooks r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'lesson_course_materials', count(*)
+        from public.lesson_course_materials r join course_twins t on t.seed_id = r.course_id
+      union all
+      select 'syllabus_topics', count(*)
+        from public.syllabus_topics r join course_twins t on t.seed_id = r.course_id
+    ) x;
+
+  drop table pg_temp.course_twins;
+
+  return jsonb_build_object(
+    'retired',       retired,
+    'names',         to_jsonb(names),
+    'revived',       revived,
+    'rooms_carried', rooms,
+    'moved',         moved,
+    'left_on_retired_rows', skipped
+  );
+end;
+$function$;
+
+notify pgrst, 'reload schema';
diff --git a/supabase/probes/20261013170702.sql b/supabase/probes/20261013170702.sql
new file mode 100644
index 0000000..3cd6b67
--- /dev/null
+++ b/supabase/probes/20261013170702.sql
@@ -0,0 +1,132 @@
+  -- The bank, the sets, the assignments, the attempts, the answers and the
+  -- integrity events are there, row-secured, with a select policy each and
+  -- no write for a stranger; the bank's policy names no student or family
+  -- clause, and one open attempt per assignment is a unique index.
+  select '20261013170702', 'a course has a question bank and a student sees the answer only after submitting',
+         'the seven practice tables exist with RLS on and a select policy each; anon holds no write on any; practice_questions is read through manages_course and never a family clause; one open attempt per assignment is a unique partial index',
+         (select count(*) = 7 and bool_and(c.relrowsecurity)
+                 and bool_and(exists (select 1 from pg_policy p
+                                       where p.polrelid = c.oid and p.polcmd = 'r'))
+                 and bool_and(not has_table_privilege('anon', c.oid, 'insert')
+                              and not has_table_privilege('anon', c.oid, 'update')
+                              and not has_table_privilege('anon', c.oid, 'delete'))
+            from pg_class c
+            join pg_namespace n on n.oid = c.relnamespace
+           where n.nspname = 'public'
+             and c.relname in ('practice_questions', 'practice_sets', 'practice_set_items',
+                               'practice_assignments', 'practice_attempts', 'practice_answers',
+                               'practice_integrity_events'))
+           and coalesce((select pg_get_expr(p.polqual, p.polrelid) like '%manages_course%'
+                            and pg_get_expr(p.polqual, p.polrelid) not like '%shares_family%'
+                            and pg_get_expr(p.polqual, p.polrelid) not like '%auth.uid()%'
+                           from pg_policy p
+                          where p.polrelid = to_regclass('public.practice_questions')
+                            and p.polname = 'practice_questions_select'), false)
+           and coalesce((select i.indisunique and pg_get_expr(i.indpred, i.indrelid) like '%in_progress%'
+                           from pg_index i
+                          where i.indexrelid = to_regclass('public.practice_attempts_one_open_per_assignment')), false)
+
+  union all
+
+  -- The seventeen doors and readers are SECURITY DEFINER and callable by
+  -- authenticated; the five that answer in jsonb do.
+  select '20261013170702', 'a course has a question bank and a student sees the answer only after submitting',
+         'the seventeen practice RPCs are SECURITY DEFINER and executable by authenticated; attempt_questions, answer_question, submit_attempt, live_attempts and flagged_attempt_review return jsonb; my_practice returns a set',
+         (select count(*) = 17 and bool_and(p.prosecdef)
+                 and bool_and(has_function_privilege('authenticated', p.oid, 'execute'))
+            from pg_proc p
+           where p.oid in (to_regprocedure('public.store_extracted_questions(uuid, jsonb, jsonb)'),
+                           to_regprocedure('public.upsert_question(uuid, jsonb)'),
+                           to_regprocedure('public.approve_question(uuid)'),
+                           to_regprocedure('public.retire_question(uuid)'),
+                           to_regprocedure('public.create_practice_set(uuid, text, text, uuid[], uuid, integer, jsonb, uuid)'),
+                           to_regprocedure('public.assign_practice(uuid, uuid[], text, uuid, timestamptz)'),
+                           to_regprocedure('public.start_attempt(uuid)'),
+                           to_regprocedure('public.attempt_questions(uuid)'),
+                           to_regprocedure('public.answer_question(uuid, uuid, jsonb)'),
+                           to_regprocedure('public.submit_attempt(uuid, jsonb)'),
+                           to_regprocedure('public.mark_answer(uuid, uuid, numeric, text)'),
+                           to_regprocedure('public.void_attempt(uuid)'),
+                           to_regprocedure('public.log_integrity_event(uuid, text, text, text)'),
+                           to_regprocedure('public.my_practice(integer)'),
+                           to_regprocedure('public.live_attempts(uuid)'),
+                           to_regprocedure('public.flagged_attempt_review(uuid)'),
+                           to_regprocedure('public.teaches_course_within(uuid, integer, uuid)')))
+           and (select count(*) = 5 and bool_and(p.prorettype = 'jsonb'::regtype)
+                  from pg_proc p
+                 where p.oid in (to_regprocedure('public.attempt_questions(uuid)'),
+                                 to_regprocedure('public.answer_question(uuid, uuid, jsonb)'),
+                                 to_regprocedure('public.submit_attempt(uuid, jsonb)'),
+                                 to_regprocedure('public.live_attempts(uuid)'),
+                                 to_regprocedure('public.flagged_attempt_review(uuid)')))
+           and coalesce((select p.proretset from pg_proc p
+                          where p.oid = to_regprocedure('public.my_practice(integer)')), false)
+
+  union all
+
+  -- The marking is the room's: its own test cases hold here, so the SQL and
+  -- the TypeScript cannot drift without this row saying NO.
+  select '20261013170702', 'a course has a question bank and a student sees the answer only after submitting',
+         'the SQL marking agrees with the room''s on its own test cases: "7 1/2" reads 7.5, "X = 5." is "x=5", an integer key is strict, multi-select earns partial credit with a penalty, a worked question is pending_review',
+         public.practice_parse_number('7 1/2') = 7.5
+           and public.practice_parse_number('1,250') = 1250
+           and public.practice_parse_number('1/0') is null
+           and public.practice_normalise_short_text('X = 5.') = 'x=5'
+           and public.practice_numbers_match(2.354, 2.35)
+           and not public.practice_numbers_match(25.3, 25)
+           and public.practice_mark_question('multi_select', '["A","C"]', null, null, 2,
+                                             '{"type":"multi_select","keys":["A","C","B"]}')
+               = '{"max": 2, "score": 1.00, "status": "partial", "feedback": "2 of 2 right, 1 wrong pick."}'::jsonb
+           and public.practice_mark_question('short', '"x = 5"', '["5"]', null, 1,
+                                             '{"type":"short","text":"5.0"}') ->> 'status' = 'correct'
+           and public.practice_mark_question('worked', null, null, null, 3,
+                                             '{"type":"worked","evidence":[{"kind":"image","ref":"i"}]}') ->> 'status'
+               = 'pending_review'
+
+  union all
+
+  -- The two push pairs are AFTER, FOR EACH ROW, on the right tables and
+  -- events, and attempts are in the realtime publication.
+  select '20261013170702', 'a course has a question bank and a student sees the answer only after submitting',
+         'notify_push is wired after each row to practice_assignments INSERT and practice_attempts UPDATE OF status, and practice_attempts is in the supabase_realtime publication',
+         (select count(*) = 2
+            from pg_trigger t
+            join pg_class c on c.oid = t.tgrelid
+            join pg_proc p  on p.oid = t.tgfoid
+           where not t.tgisinternal
+             and p.proname = 'notify_push'
+             and (t.tgtype & 1) = 1 and (t.tgtype & 2) = 0
+             and ((c.oid = to_regclass('public.practice_assignments') and (t.tgtype & 4) <> 0)
+                  -- Column-scoped to status alone. tgattr is an int2vector, which
+                  -- casts to a zero-based array, so it is read by membership and length.
+                  or (c.oid = to_regclass('public.practice_attempts') and (t.tgtype & 16) <> 0
+                      and array_length(t.tgattr::int2[], 1) = 1
+                      and (select a.attnum from pg_attribute a
+                            where a.attrelid = to_regclass('public.practice_attempts')
+                              and a.attname = 'status') = any (t.tgattr::int2[]))))
+           and exists (select 1 from pg_publication_tables
+                        where pubname = 'supabase_realtime'
+                          and schemaname = 'public' and tablename = 'practice_attempts')
+
+  union all
+
+  -- Two private buckets, each with its read and write policy on the bytes.
+  select '20261013170702', 'a course has a question bank and a student sees the answer only after submitting',
+         'the test-snapshots and practice-images buckets exist, private, with a read and a write policy each on storage.objects',
+         (select count(*) = 2 and bool_and(not coalesce(b.public, false))
+            from storage.buckets b where b.id in ('test-snapshots', 'practice-images'))
+           and (select count(*) = 4
+                  from pg_policy p
+                 where p.polrelid = to_regclass('storage.objects')
+                   and p.polname in ('test_snapshots_storage_read', 'test_snapshots_storage_write',
+                                     'practice_images_storage_read', 'practice_images_storage_write'))
+
+  union all
+
+  -- The twin merge knows the two more tables that point at a course.
+  select '20261013170702', 'a course has a question bank and a student sees the answer only after submitting',
+         'retire_seed_course_twins moves practice_questions and practice_sets',
+         coalesce((select prosrc ~ 'update\s+public\.practice_questions\y'
+                      and prosrc ~ 'update\s+public\.practice_sets\y'
+                     from pg_proc
+                    where oid = to_regprocedure('public.retire_seed_course_twins()')), false)
