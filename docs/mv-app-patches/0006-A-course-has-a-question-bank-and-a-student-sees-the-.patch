+-- Ids by name, past RLS, so a test can speak of "the mcq" whoever is asking.
+create function pg_temp.q(p_stem text) returns uuid language sql stable security definer as $$
+  select id from public.practice_questions where stem = p_stem order by created_at, id limit 1
+$$;
+create function pg_temp.s(p_title text) returns uuid language sql stable security definer as $$
+  select id from public.practice_sets where title = p_title order by created_at, id limit 1
+$$;
+create function pg_temp.g(p_title text, p_student uuid) returns uuid language sql stable security definer as $$
+  select g.id from public.practice_assignments g
+   where g.set_id = pg_temp.s(p_title) and g.student_id = p_student
+   order by g.created_at, g.id limit 1
+$$;
+create function pg_temp.att(p_title text, p_student uuid) returns uuid language sql stable security definer as $$
+  select a.id from public.practice_attempts a
+   where a.set_id = pg_temp.s(p_title) and a.student_id = p_student
+   order by a.started_at desc, a.id limit 1
+$$;
+
+-- Where the listeners stand, so "quiet" is measured rather than assumed.
+create temp table marks (what text, pushes bigint);
+create function pg_temp.mark(p_what text) returns void language sql as $$
+  insert into marks select p_what, (select count(*) from net.http_request_queue)
+$$;
+create function pg_temp.quiet_since(p_what text) returns boolean language sql stable as $$
+  select (select count(*) from net.http_request_queue) = (select pushes from marks where what = p_what)
+$$;
