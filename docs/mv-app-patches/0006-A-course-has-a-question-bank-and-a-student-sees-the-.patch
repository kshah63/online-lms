diff --git a/supabase/tests/rls/20261013170703-a_course_has_a_question_bank_and_a_student_sees_the_answer_only_after_submitting.sql b/supabase/tests/rls/20261013170703-a_course_has_a_question_bank_and_a_student_sees_the_answer_only_after_submitting.sql
