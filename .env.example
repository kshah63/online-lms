# ============================================================================
# Lessons Platform — environment
# Copy to .env.local and fill in. With NO Supabase keys set, the app runs in
# DEMO MODE (built-in data + persona switcher), so you can explore it offline.
# ============================================================================

# --- Supabase (Postgres + Auth + Realtime) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. REQUIRED for Pencil Spaces (provisioning, join URLs, webhooks,
# jobs all run through the service role); also used by privileged jobs/cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- Materials Portal API (§6) ---------------------------------------------
# When unset, the Materials panel shows sample files.
MATERIALS_PORTAL_URL=
MATERIALS_PORTAL_SERVICE_KEY=

# --- Pencil Spaces (live lesson room) (§4/§5) --------------------------------
# The lesson room is one persistent Pencil Space per (student, course). When
# PENCIL_SPACES_API_KEY is unset — or in demo mode — the room renders the
# built-in MOCK Space panel and no Pencil call is ever made.
# Pencil needs the SERVICE ROLE key above: users/Spaces/opt-outs live in
# service-only tables written after an explicit authorization check, so with
# SUPABASE_SERVICE_ROLE_KEY empty the Space routes answer {configured:false}.
# Generate the key as an Institution Admin: Spaces Manager > Settings > API Key
# (view-once; use a generic admin account — it appears as a host in every
# Space, so give it a family-facing name. Regenerating or revoking the key
# signs that account out everywhere and the old key stops working: update this
# variable in every environment at once. Keep "Grant admins access to all
# Spaces" ON.)
PENCIL_SPACES_API_KEY=
# Production default; staging is https://staging-apis.pencilapp.com/public/api/
# PENCIL_API_BASE_URL=https://apis.pencilapp.com/public/api/
# Bearer secret Pencil sends with every webhook delivery (Settings > API &
# Integrations > Webhooks, or POST /webhooks). Unused until the post-session
# pipeline (Phase 2); the webhook route fails closed (503) while it is empty.
# Pencil redelivers a non-2xx up to 10 times over about an hour and then drops
# the event, so set this BEFORE registering the webhook URL.
PENCIL_WEBHOOK_SECRET=
# Where the Space iframe/redirect lives — only used for the postMessage origin
# allowlist (the production + staging origins are always accepted as well).
# NEXT_PUBLIC_PENCIL_APP_ORIGIN=https://my.pencilapp.com
# Outage fallback: ONE master Zoom meeting link for the whole school —
# `https://` + a zoom.us host, e.g. https://us02web.zoom.us/j/5550001111?pwd=…
# Nothing is stored per teacher; an admin can override it for a single lesson
# in sessions.fallback_join_url (resolution: override → LESSON_FALLBACK_URL →
# "No backup link — contact admin"). Invalid values are ignored with a warning.
LESSON_FALLBACK_URL=
# Outage switch: `on` forces every lesson onto the fallback link (planned
# outage). Leave unset/`off` normally. Never unset the API key as the outage
# path — the webhook pipeline must keep processing finished lessons.
# LESSON_FALLBACK_MODE=off
# Set to `on` at the start of Phase 2, when institution always-on recording is
# switched on in Pencil. Until then nothing is recorded, so no screen says
# "Recorded" (the opt-out flag and Space setting are still enforced).
# Unset = off (demo mode shows the full product).
# PENCIL_RECORDING_ENABLED=off

# --- AI coaching + report drafts (Anthropic) (§7) --------------------------
# When unset, post-session coaching falls back to a metrics-derived heuristic.
ANTHROPIC_API_KEY=

# --- WhatsApp (§11) — Meta WhatsApp Cloud API ------------------------------
# When unset, all WhatsApp messages are SIMULATED (logged, not delivered), so
# the notification flow is fully testable in development.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WHATSAPP_GRAPH_VERSION=v21.0
#
# Proactive notifications (reminders, report-ready, booking confirmations) are
# business-initiated, so WhatsApp only delivers them via APPROVED TEMPLATES.
# Create templates in Meta Business Manager whose body uses {{1}}, {{2}}, …
# placeholders, then map each event kind to its template name below. If a kind
# is left unset we fall back to free-form text (delivers only inside the 24h
# customer-service window — fine for testing). Placeholder order per kind:
#   REPORT_PUBLISHED   {{1}}=student first name {{2}}=course
#   BOOKING_CONFIRMED  {{1}}=student {{2}}=course {{3}}=date/time
#   BOOKING_RESCHEDULED {{1}}=student {{2}}=course {{3}}=date/time
#   BOOKING_CANCELLED  {{1}}=student {{2}}=course
#   LESSON_REMINDER    {{1}}=student {{2}}=course {{3}}=date/time
# WHATSAPP_TEMPLATE_REPORT_PUBLISHED=
# WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
# WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=
# WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
# WHATSAPP_TEMPLATE_LESSON_REMINDER=

# --- Scheduled jobs (Vercel Cron) ------------------------------------------
# Protects /api/cron/reminders. Set the SAME value in Vercel; Vercel Cron sends
# it automatically as `Authorization: Bearer <CRON_SECRET>`. Without it the cron
# endpoint refuses all requests (fail closed).
CRON_SECRET=

# --- Error monitoring (Sentry) ---------------------------------------------
# All optional. With NO DSN set, Sentry is fully disabled (no-op) and builds
# are untouched. NEXT_PUBLIC_SENTRY_DSN is needed for browser errors; the
# server reuses it (or set SENTRY_DSN separately). Source maps upload at build
# time only when SENTRY_AUTH_TOKEN + SENTRY_ORG + SENTRY_PROJECT are all set.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Later build steps (not required for the foundation) -------------------
# Billing (Stripe):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
