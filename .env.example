# ============================================================================
# Lessons Platform — environment
# Copy to .env.local and fill in. With NO Supabase keys set, the app runs in
# DEMO MODE (built-in data + persona switcher), so you can explore it offline.
# ============================================================================

# --- Supabase (Postgres + Auth + Realtime) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (used by future webhooks / privileged jobs):
SUPABASE_SERVICE_ROLE_KEY=

# --- Materials Portal API (§6) ---------------------------------------------
# When unset, the Materials panel shows sample files.
MATERIALS_PORTAL_URL=
MATERIALS_PORTAL_SERVICE_KEY=

# --- Video SDK (Daily) (§4) -------------------------------------------------
# When unset, the lesson room uses the built-in mock video panel.
# Daily provides recording + transcription that feed the AI coaching pipeline.
DAILY_API_KEY=

# --- AI coaching + report drafts (Anthropic) (§7) --------------------------
# When unset, post-session coaching falls back to a metrics-derived heuristic.
ANTHROPIC_API_KEY=

# --- WhatsApp (§11) — Meta WhatsApp Cloud API ------------------------------
# When unset, parent follow-up messages are SIMULATED (logged, not delivered).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WHATSAPP_GRAPH_VERSION=v21.0

# --- Later build steps (not required for the foundation) -------------------
# Streaming STT (Deepgram / AssemblyAI) — only if not using Daily transcription:
# DEEPGRAM_API_KEY=
# Billing (Stripe):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
