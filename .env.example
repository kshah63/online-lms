# ============================================================================
# MathVision lesson room — environment
# Copy to .env.local and fill in. With NO Supabase keys set, the app runs in
# DEMO MODE (built-in data + persona switcher), so you can explore it offline.
# This app runs on the MathVision centre app's Supabase project; see
# docs/INTEGRATION.md. There is no service-role key here, by design.
# ============================================================================

# --- Supabase: the mv-app project (anon key only) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared with mv-app's room-redeem edge function; /api/join sends it as
# x-room-secret when redeeming a lesson ticket from the app.
ROOM_REDEEM_SECRET=

# --- Video (Daily) ----------------------------------------------------------
# When unset, the lesson room uses the built-in mock video panel.
DAILY_API_KEY=
# Also used by GET /api/lesson/[sessionId]/recording to fetch a short-lived playback link.
# Verifies Daily's webhook signatures (src/lib/video/daily-webhooks.ts).
DAILY_WEBHOOK_SECRET=

# --- AI: live coach, post-lesson analysis, report drafts (Anthropic) --------
# When unset, coaching and drafts fall back to a metrics-derived heuristic.
ANTHROPIC_API_KEY=

# --- Materials portal (server-to-server read API) ---------------------------
# When unset, the Materials panel shows sample files.
MATERIALS_PORTAL_URL=
MATERIALS_PORTAL_SERVICE_KEY=

# --- Error monitoring (Sentry) ---------------------------------------------
# All optional. With NO DSN set, Sentry is fully disabled (no-op) and builds
# are untouched. NEXT_PUBLIC_SENTRY_DSN is needed for browser errors; the
# server reuses it (or set SENTRY_DSN separately). Source maps upload at build
# time only when SENTRY_AUTH_TOKEN + SENTRY_ORG + SENTRY_PROJECT are all set.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
